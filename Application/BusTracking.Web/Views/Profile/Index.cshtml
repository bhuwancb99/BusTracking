@model BusTracking.Common.DTOs.User.UserProfileDto
@{
    ViewData["Title"] = "My Profile - " + Model.FullName;
    var hasPhoto = !string.IsNullOrEmpty(Model?.ProfileImageUrl);
}

<div class="container-fluid p-0">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="fw-bold m-0 text-dark">
                <i class="bi bi-person-circle text-primary me-2"></i>My Profile
            </h2>
            <nav aria-label="breadcrumb" class="mt-1">
                <ol class="breadcrumb mb-0 small text-muted">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Dashboard")" class="text-decoration-none text-muted">Dashboard</a></li>
                    <li class="breadcrumb-item active text-primary" aria-current="page">My Profile</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Edit")" class="btn btn-primary rounded-3 px-3 shadow-sm">
                <i class="bi bi-pencil-fill me-1"></i> Edit Profile
            </a>
            <a href="@Url.Action("ChangePassword", "Auth")" class="btn btn-outline-secondary rounded-3 px-3">
                <i class="bi bi-key-fill me-1"></i> Change Password
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8 col-12">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-4 mb-4 pb-4 border-bottom flex-wrap">
                        <div class="position-relative" id="imgWidget_myProfile">
                            @if (hasPhoto)
                            {
                                <img id="profileAvatar" src="@Model!.ProfileImageUrl" alt="@Model.FullName"
                                     class="rounded-circle border shadow-sm"
                                     style="width: 110px; height: 110px; object-fit: cover;"
                                     onerror="this.onerror=null;this.src='/images/default-avatar.svg';" />
                            }
                            else
                            {
                                <img id="profileAvatar" src="/images/default-avatar.svg" alt="@Model.FullName"
                                     class="rounded-circle border shadow-sm"
                                     style="width: 110px; height: 110px; object-fit: cover;" />
                            }
                            <label for="profileFileInput"
                                   class="position-absolute bottom-0 end-0 btn btn-sm btn-primary rounded-circle p-1 shadow-sm"
                                   style="width:32px;height:32px;line-height:1;cursor:pointer;" title="Change photo">
                                <i class="bi bi-camera-fill" style="font-size:0.85rem;"></i>
                                <input type="file" id="profileFileInput" class="d-none"
                                       accept="image/jpeg,image/png,image/webp"
                                       onchange="uploadMyProfile(this)" />
                            </label>
                        </div>
                        <div>
                            <h3 class="fw-bold text-dark mb-1">@Model.FullName</h3>
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace px-3 py-1">@Model.Role</span>
                            </div>
                            <div id="profileImgMsg" class="small"></div>
                            @if (hasPhoto)
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger rounded-3 mt-1" onclick="deleteMyProfile()">
                                    <i class="bi bi-trash me-1"></i>Remove Photo
                                </button>
                            }
                        </div>
                    </div>

                    <h6 class="fw-bold text-primary text-uppercase fs-7 mb-3"><i class="bi bi-card-heading me-2"></i>Account Information</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6 col-12">
                            <small class="text-muted d-block">Full Name</small>
                            <span class="fw-bold text-dark fs-6">@Model.FullName</span>
                        </div>
                        <div class="col-md-6 col-12">
                            <small class="text-muted d-block">System Role</small>
                            <span class="fw-semibold text-dark">@Model.Role</span>
                        </div>
                        <div class="col-md-6 col-12">
                            <small class="text-muted d-block">Email Address</small>
                            <span class="fw-semibold text-dark">@(string.IsNullOrWhiteSpace(Model.Email) ? "N/A" : Model.Email)</span>
                        </div>
                        <div class="col-md-6 col-12">
                            <small class="text-muted d-block">Phone Number</small>
                            <span class="fw-semibold text-dark">@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "N/A" : Model.PhoneNumber)</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        const _tok = () => document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

        async function uploadMyProfile(input) {
            if (!input.files || !input.files[0]) return;
            const msg = document.getElementById('profileImgMsg');
            msg.innerHTML = '<span class="text-muted"><span class="spinner-border spinner-border-sm me-1"></span>Uploading…</span>';
            const fd = new FormData();
            fd.append('file', input.files[0]);

            try {
                const res = await fetch('/Image/UploadMyProfile', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': _tok() },
                    body: fd
                });
                const json = await res.json();
                if (json.success) {
                    msg.innerHTML = '<span class="text-success"><i class="bi bi-check-circle me-1"></i>Saved.</span>';
                    setTimeout(() => location.reload(), 800);
                } else {
                    msg.innerHTML = `<span class="text-danger">${json.message}</span>`;
                }
            } catch {
                msg.innerHTML = '<span class="text-danger">Upload failed.</span>';
            }
            input.value = '';
        }

        async function deleteMyProfile() {
            if (!confirm('Remove profile photo?')) return;
            const msg = document.getElementById('profileImgMsg');
            msg.innerHTML = '<span class="text-muted">Removing…</span>';
            try {
                const res = await fetch('/Image/DeleteMyProfile', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': _tok() }
                });
                const json = await res.json();
                if (json.success) location.reload();
                else msg.innerHTML = '<span class="text-danger">Error removing photo.</span>';
            } catch {
                msg.innerHTML = '<span class="text-danger">Error.</span>';
            }
        }
    </script>
}
