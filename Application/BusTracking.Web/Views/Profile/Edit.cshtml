@model BusTracking.Common.DTOs.User.UpdateProfileDto
@{
    ViewData["Title"] = "Edit My Profile";
}

<div class="container-fluid p-0">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="fw-bold m-0 text-dark">
                <i class="bi bi-person-gear text-primary me-2"></i>Edit My Profile
            </h2>
            <nav aria-label="breadcrumb" class="mt-1">
                <ol class="breadcrumb mb-0 small text-muted">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Dashboard")" class="text-decoration-none text-muted">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("Index")" class="text-decoration-none text-muted">My Profile</a></li>
                    <li class="breadcrumb-item active text-primary" aria-current="page">Edit Profile</li>
                </ol>
            </nav>
        </div>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary rounded-3 px-3">
            <i class="bi bi-arrow-left me-1"></i> Back to Profile
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-7 col-12">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger py-2 border-0 rounded-3 mb-4" style="background-color: rgba(239, 68, 68, 0.15); color: #ef4444;">
                                <div asp-validation-summary="All"></div>
                            </div>
                        }

                        <div class="mb-4">
                            <h6 class="fw-bold text-primary text-uppercase fs-7 mb-3"><i class="bi bi-person me-2"></i>Personal Details</h6>
                            <div class="row g-3">
                                <div class="col-12">
                                    <label asp-for="FullName" class="form-label fw-bold">Full Name <span class="text-danger">*</span></label>
                                    <input asp-for="FullName" class="form-control rounded-3" required />
                                    <span asp-validation-for="FullName" class="text-danger small"></span>
                                </div>

                                <div class="col-12">
                                    <label asp-for="PhoneNumber" class="form-label fw-bold">Phone Number</label>
                                    <input asp-for="PhoneNumber" class="form-control rounded-3" placeholder="+91 98765 43210" />
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 border-top pt-4">
                            <a href="@Url.Action("Index")" class="btn btn-light rounded-3 px-4">Cancel</a>
                            <button type="submit" class="btn btn-primary rounded-3 px-4 shadow-sm"><i class="bi bi-save me-2"></i>Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
