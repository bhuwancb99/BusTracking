@model BusTracking.Common.DTOs.Attendance.AttendanceSummaryReportDto
@{
    ViewData["Title"] = "Classroom Daily Attendance";
    var years = ViewBag.AcademicYears as List<BusTracking.Common.DTOs.AcademicYear.AcademicYearDto> ?? new();
    var standards = ViewBag.Standards as List<BusTracking.Common.DTOs.Standard.StandardDto> ?? new();
    var sections = ViewBag.Sections as List<BusTracking.Common.DTOs.Section.SectionDto> ?? new();

    int selectedYearId = ViewBag.SelectedYearId ?? 0;
    int selectedStandardId = ViewBag.SelectedStandardId ?? 0;
    int? selectedSectionId = ViewBag.SelectedSectionId;
    DateTime selectedDate = ViewBag.SelectedDate ?? DateTime.Today;
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
    <div>
        <h2 class="fw-bold m-0 text-dark">
            <i class="bi bi-check2-square text-primary me-2"></i>Classroom Daily Attendance
        </h2>
        <nav aria-label="breadcrumb" class="mt-1">
            <ol class="breadcrumb mb-0 small text-muted">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Dashboard")" class="text-decoration-none text-muted">Dashboard</a></li>
                <li class="breadcrumb-item active text-primary" aria-current="page">Classroom Daily Attendance</li>
            </ol>
        </nav>
    </div>
</div>

<!-- Attendance Filters -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted mb-1">Academic Session</label>
                <select name="academicYearId" class="form-select bg-light border-0">
                    @foreach (var y in years)
                    {
                        <option value="@y.AcademicYearId" selected="@(y.AcademicYearId == selectedYearId ? "selected" : null)">@y.YearName @(y.IsCurrent ? "(Active)" : "")</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted mb-1">Class / Standard</label>
                <select name="standardId" class="form-select bg-light border-0">
                    @foreach (var s in standards)
                    {
                        <option value="@s.StandardId" selected="@(s.StandardId == selectedStandardId ? "selected" : null)">@s.StandardName</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted mb-1">Section (Optional)</label>
                <select name="sectionId" class="form-select bg-light border-0">
                    <option value="">-- All Sections --</option>
                    @foreach (var sec in sections)
                    {
                        <option value="@sec.SectionId" selected="@(sec.SectionId == selectedSectionId ? "selected" : null)">Section @sec.SectionName</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted mb-1">Date</label>
                <input type="date" name="date" value="@selectedDate.ToString("yyyy-MM-dd")" class="form-control bg-light border-0" />
            </div>
            <div class="col-12 d-flex justify-content-end gap-2 pt-2">
                <button type="submit" class="btn btn-primary rounded-3 px-4"><i class="bi bi-filter me-1"></i>Fetch Attendance</button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary rounded-3 px-3"><i class="bi bi-arrow-counterclockwise"></i> Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Attendance KPI Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 bg-primary text-white p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="fs-7 fw-semibold opacity-75 text-uppercase">Total Students</span>
                    <h3 class="fw-bold m-0 mt-1">@(Model?.TotalStudents ?? 0)</h3>
                </div>
                <i class="bi bi-people-fill display-5 opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 bg-success text-white p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="fs-7 fw-semibold opacity-75 text-uppercase">Present Students</span>
                    <h3 class="fw-bold m-0 mt-1">@(Model?.PresentCount ?? 0)</h3>
                </div>
                <i class="bi bi-check-circle-fill display-5 opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 bg-danger text-white p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="fs-7 fw-semibold opacity-75 text-uppercase">Absent Students</span>
                    <h3 class="fw-bold m-0 mt-1">@(Model?.AbsentCount ?? 0)</h3>
                </div>
                <i class="bi bi-x-circle-fill display-5 opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 bg-warning text-dark p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="fs-7 fw-semibold opacity-75 text-uppercase">Attendance Rate</span>
                    <h3 class="fw-bold m-0 mt-1">@((Model?.PresentPercentage ?? 0).ToString("F1"))%</h3>
                </div>
                <i class="bi bi-pie-chart-fill display-5 opacity-50"></i>
            </div>
        </div>
    </div>
</div>
