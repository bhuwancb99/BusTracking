@model List<BusTracking.Common.DTOs.AcademicYear.AcademicYearDto>
@{
    ViewData["Title"] = "Academic Years";
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
    <div>
        <h2 class="fw-bold m-0 text-dark">
            <i class="bi bi-calendar-event text-primary me-2"></i>Academic Years &amp; Sessions
        </h2>
        <nav aria-label="breadcrumb" class="mt-1">
            <ol class="breadcrumb mb-0 small text-muted">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Dashboard")" class="text-decoration-none text-muted">Dashboard</a></li>
                <li class="breadcrumb-item active text-primary" aria-current="page">Academic Years</li>
            </ol>
        </nav>
    </div>
    <a href="@Url.Action("Create")" class="btn btn-primary rounded-3 shadow-sm px-4">
        <i class="bi bi-plus-lg me-2"></i>New Academic Year
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light-subtle border-bottom">
                <tr class="text-uppercase fs-7 text-muted fw-bold">
                    <th class="ps-4">Academic Year</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th class="text-center">Active Working Session</th>
                    <th class="text-center">Status</th>
                    <th class="text-center pe-4" style="width: 220px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-calendar-x text-secondary opacity-50 display-4 d-block mb-2"></i>
                            <span class="fw-semibold fs-6">No Academic Years configured yet.</span>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <span class="fw-bold text-dark fs-6">@item.YearName</span>
                            </td>
                            <td>
                                <span class="text-secondary fw-semibold">@item.StartDate.ToString("dd MMM yyyy")</span>
                            </td>
                            <td>
                                <span class="text-secondary fw-semibold">@item.EndDate.ToString("dd MMM yyyy")</span>
                            </td>
                            <td class="text-center">
                                @if (item.IsCurrent)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill fw-bold">
                                        <i class="bi bi-star-fill me-1"></i>Active Session
                                    </span>
                                }
                                else if (item.IsActive)
                                {
                                    <form method="post" action="@Url.Action("SetActive", new { id = item.AcademicYearId })" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-3">
                                            Make Active
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">Inactive</span>
                                }
                            </td>
                            <td class="text-center">
                                <form method="post" action="@Url.Action("ToggleStatus", new { id = item.AcademicYearId })" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    @if (item.IsActive)
                                    {
                                        <button type="submit" class="btn btn-sm btn-success-subtle text-success border border-success-subtle rounded-pill px-3 fw-bold" title="Click to Deactivate">
                                            Active
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-sm btn-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3 fw-bold" title="Click to Activate">
                                            Inactive
                                        </button>
                                    }
                                </form>
                            </td>
                            <td class="text-center pe-4">
                                <a href="@Url.Action("Edit", new { id = item.AcademicYearId })" class="btn btn-sm btn-outline-primary rounded-3" title="Edit">
                                    <i class="bi bi-pencil me-1"></i> Edit
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
