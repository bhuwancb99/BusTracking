@model BusTracking.Common.DTOs.Section.CreateSectionDto
@{
    ViewData["Title"] = "Add Section";
    var standards = ViewBag.Standards as List<BusTracking.Common.DTOs.Standard.StandardDto> ?? new();
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h2 class="fw-bold m-0 text-dark">
            <i class="bi bi-plus-circle text-primary me-2"></i>Add Section
        </h2>
        <nav aria-label="breadcrumb" class="mt-1">
            <ol class="breadcrumb mb-0 small text-muted">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Dashboard")" class="text-decoration-none text-muted">Dashboard</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Index")" class="text-decoration-none text-muted">Class Sections</a></li>
                <li class="breadcrumb-item active text-primary" aria-current="page">Add Section</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="StandardId" class="form-label fw-bold">Class / Standard <span class="text-danger">*</span></label>
                        <select asp-for="StandardId" class="form-select rounded-3">
                            @foreach (var s in standards)
                            {
                                <option value="@s.StandardId">@s.StandardName</option>
                            }
                        </select>
                        <span asp-validation-for="StandardId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="SectionName" class="form-label fw-bold">Section Name <span class="text-danger">*</span></label>
                        <input asp-for="SectionName" class="form-control rounded-3" placeholder="e.g. B, C, D" required />
                        <span asp-validation-for="SectionName" class="text-danger small"></span>
                        <div class="form-text small text-muted">Section 'A' is created automatically for every class.</div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ClassTeacherId" class="form-label fw-bold">Class Teacher (Optional)</label>
                        <select asp-for="ClassTeacherId" class="form-select rounded-3">
                            <option value="">-- Select Class Teacher --</option>
                            @if (ViewBag.Teachers is List<BusTracking.Common.DTOs.Teacher.TeacherDto> teachers)
                            {
                                @foreach (var t in teachers)
                                {
                                    <option value="@t.TeacherId">@t.FullName (@t.Email)</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary rounded-3 px-4 flex-fill"><i class="bi bi-check-lg me-1"></i>Save Section</button>
                        <a href="@Url.Action("Index", new { standardId = Model.StandardId })" class="btn btn-outline-secondary rounded-3 px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
