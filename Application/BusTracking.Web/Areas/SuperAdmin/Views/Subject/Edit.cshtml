@model BusTracking.Common.DTOs.Subject.UpdateSubjectDto
@{
    ViewData["Title"] = "Edit Subject";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h2 class="fw-bold m-0 text-dark">
            <i class="bi bi-pencil-square text-primary me-2"></i>Edit Subject
        </h2>
        <nav aria-label="breadcrumb" class="mt-1">
            <ol class="breadcrumb mb-0 small text-muted">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Dashboard")" class="text-decoration-none text-muted">Dashboard</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Index")" class="text-decoration-none text-muted">Subjects Master</a></li>
                <li class="breadcrumb-item active text-primary" aria-current="page">Edit Subject</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="SubjectName" class="form-label fw-bold">Subject Name <span class="text-danger">*</span></label>
                        <input asp-for="SubjectName" class="form-control rounded-3" required />
                        <span asp-validation-for="SubjectName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="SubjectCode" class="form-label fw-bold">Subject Code</label>
                        <input asp-for="SubjectCode" class="form-control rounded-3" />
                        <span asp-validation-for="SubjectCode" class="text-danger small"></span>
                    </div>

                    <div class="mb-4 form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="isActiveSwitch">
                        <label class="form-check-label fw-semibold" for="isActiveSwitch">Active Status</label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary rounded-3 px-4 flex-fill"><i class="bi bi-check-lg me-1"></i>Update Subject</button>
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary rounded-3 px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
