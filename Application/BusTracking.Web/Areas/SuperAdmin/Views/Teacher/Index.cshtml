@using BusTracking.Web.Helpers
@using BusTracking.Common.Models
@using BusTracking.Common.DTOs.Teacher
@model PagedResult<TeacherDto>
@{
    ViewData["Title"] = "Teachers Directory";
    bool canAdd = PermissionHelper.Can(User, "teachers.add", Context);
    bool canEdit = PermissionHelper.Can(User, "teachers.edit", Context);

    var created = TempData["CreatedUser"] as string;
    BusTracking.Common.DTOs.User.CreatedUserResultDto? newUser = null;
    if (!string.IsNullOrEmpty(created))
        newUser = System.Text.Json.JsonSerializer.Deserialize<BusTracking.Common.DTOs.User.CreatedUserResultDto>(created);
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
    <div>
        <h2 class="fw-bold m-0 text-dark">
            <i class="bi bi-person-workspace text-primary me-2"></i>Teachers Directory
        </h2>
        <nav aria-label="breadcrumb" class="mt-1">
            <ol class="breadcrumb mb-0 small text-muted">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Dashboard")" class="text-decoration-none text-muted">Dashboard</a></li>
                <li class="breadcrumb-item active text-primary" aria-current="page">Teachers</li>
            </ol>
        </nav>
    </div>
    @if (canAdd)
    {
        <a href="@Url.Action("Create")" class="btn btn-primary rounded-3 shadow-sm px-4">
            <i class="bi bi-plus-lg me-2"></i>Register New Teacher
        </a>
    }
</div>

@if (newUser is not null)
{
    <div id="createdUserBanner" class="card border-0 shadow-sm rounded-4 mb-4 bg-success-subtle border-start border-4 border-success position-relative">
        <div class="card-body p-4">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h6 class="fw-bold text-success mb-0"><i class="bi bi-check-circle-fill me-2"></i>Teacher Account Created Successfully</h6>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-success text-white">New Teacher</span>
                    <button type="button" class="btn-close ms-2" onclick="closeCreatedBanner()" title="Close"></button>
                </div>
            </div>
            <div class="row g-3">
                <div class="col-md-3 col-6">
                    <small class="text-muted d-block">Full Name</small>
                    <span class="fw-bold text-dark">@newUser.FullName</span>
                </div>
                <div class="col-md-3 col-6">
                    <small class="text-muted d-block">Role</small>
                    <span class="badge bg-info-subtle text-info border border-info-subtle font-monospace">@newUser.Role</span>
                </div>
                <div class="col-md-3 col-6">
                    <small class="text-muted d-block">Username / Email</small>
                    <span class="fw-semibold text-dark">@newUser.Email</span>
                </div>
                <div class="col-md-3 col-6">
                    <small class="text-muted d-block">Password</small>
                    <div class="d-flex align-items-center gap-2">
                        <span id="pwdDisplay" class="fw-bold font-monospace text-dark">••••••••••••</span>
                        <button type="button" class="btn btn-sm btn-light rounded-circle" onclick="togglePwd()"><i class="bi bi-eye" id="pwdEye"></i></button>
                        <button type="button" class="btn btn-sm btn-light rounded-circle" onclick="copyPwd()"><i class="bi bi-clipboard"></i></button>
                    </div>
                    <input type="hidden" id="pwdValue" value="@newUser.PlainPassword" />
                </div>
            </div>
        </div>
    </div>
}


<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-7 col-lg-8">
                <div class="input-group">
                    <span class="input-group-text bg-light border-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control bg-light border-0" placeholder="Search by teacher name, username, email, emp code, department..." />
                </div>
            </div>
            <div class="col-md-5 col-lg-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill rounded-3"><i class="bi bi-filter me-1"></i>Filter</button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary rounded-3"><i class="bi bi-arrow-counterclockwise"></i> Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light-subtle border-bottom">
                <tr class="text-uppercase fs-7 text-muted fw-bold">
                    <th style="width: 65px;" class="ps-4">Photo</th>
                    <th>Teacher Name</th>
                    <th>Username</th>
                    <th>Emp. Code</th>
                    <th>Designation</th>
                    <th>Department</th>
                    <th>Email</th>
                    <th style="width: 100px;" class="text-center">Status</th>
                    <th style="width: 120px;" class="text-center pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="bi bi-person-x text-secondary opacity-50 display-4"></i>
                            <p class="mt-2 mb-0 fw-semibold fs-6">No teachers found</p>
                            <span class="small">Try adjusting your search criteria or register a new teacher.</span>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var teacher in Model.Items)
                    {
                        <tr>
                            <td class="ps-4">
                                @if (!string.IsNullOrEmpty(teacher.ProfileImageUrl))
                                {
                                    <img src="@teacher.ProfileImageUrl" alt="@teacher.FullName" class="rounded-circle border shadow-sm" style="width: 42px; height: 42px; object-fit: cover;" onerror="this.onerror=null;this.src='/images/default-avatar.svg';" />
                                }
                                else
                                {
                                    <div class="rounded-circle bg-primary-subtle text-primary fw-bold d-flex align-items-center justify-content-center border" style="width: 42px; height: 42px; font-size: 1rem;">
                                        @(string.IsNullOrEmpty(teacher.FullName) ? "T" : teacher.FullName.Substring(0, 1).ToUpper())
                                    </div>
                                }
                            </td>
                            <td class="fw-bold text-dark fs-6">@teacher.FullName</td>
                            <td>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace px-2 py-1">@@@teacher.UserName</span>
                            </td>
                            <td>
                                @if (string.IsNullOrWhiteSpace(teacher.EmployeeCode))
                                {
                                    <span class="text-muted small">-</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-dark border font-monospace">@teacher.EmployeeCode</span>
                                }
                            </td>
                            <td class="fw-semibold text-dark">
                                @(string.IsNullOrWhiteSpace(teacher.Designation) ? "-" : teacher.Designation)
                            </td>
                            <td class="text-secondary">
                                @(string.IsNullOrWhiteSpace(teacher.Department) ? "-" : teacher.Department)
                            </td>
                            <td>
                                @if (string.IsNullOrWhiteSpace(teacher.Email))
                                {
                                    <span class="text-muted small">-</span>
                                }
                                else
                                {
                                    <span><i class="bi bi-envelope me-1 text-muted"></i>@teacher.Email</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="form-check form-switch d-inline-block">
                                    <input type="checkbox" class="form-check-input teacher-toggle" style="cursor: pointer; width: 38px; height: 20px;" data-id="@teacher.TeacherId" @(teacher.IsActive ? "checked" : "") @(!canEdit ? "disabled" : "") />
                                </div>
                            </td>
                            <td class="text-center pe-4">
                                <a href="@Url.Action("Details", new { id = teacher.TeacherId })" class="btn btn-outline-info btn-sm rounded-3 px-2 py-1 me-1" title="View Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                @if (canEdit)
                                {
                                    <a href="@Url.Action("Edit", new { id = teacher.TeacherId })" class="btn btn-outline-primary btn-sm rounded-3 px-2 py-1" title="Edit Teacher">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pagination" model="Model" />

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.teacher-toggle').change(function() {
                var teacherId = $(this).data('id');
                var isChecked = $(this).is(':checked');
                var $checkbox = $(this);

                $.ajax({
                    url: '@Url.Action("ToggleActive")',
                    type: 'POST',
                    data: { id: teacherId },
                    success: function(response) {
                        if (!response.success) {
                            $checkbox.prop('checked', !isChecked);
                            alert(response.message || 'Failed to update status.');
                        }
                    },
                    error: function() {
                        $checkbox.prop('checked', !isChecked);
                        alert('An error occurred while updating teacher status.');
                    }
                });
            });
        });

        function togglePwd() {
            const el = document.getElementById('pwdDisplay');
            const val = document.getElementById('pwdValue').value;
            const icon = document.getElementById('pwdEye');
            if (el.textContent.includes('•')) { el.textContent = val; icon.className = 'bi bi-eye-slash'; }
            else { el.textContent = '••••••••••••'; icon.className = 'bi bi-eye'; }
        }

        function copyPwd() {
            navigator.clipboard.writeText(document.getElementById('pwdValue').value);
            alert('Password copied!');
        }

        function closeCreatedBanner() {
            const banner = document.getElementById('createdUserBanner');
            if (banner) banner.remove();
        }
    </script>
}
