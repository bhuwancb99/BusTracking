@model BusTracking.Common.DTOs.Teacher.TeacherDto
@{
    ViewData["Title"] = "Teacher Details - " + Model.FullName;
}

<div class="container-fluid p-0">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="fw-bold m-0 text-dark">
                <i class="bi bi-person-workspace text-primary me-2"></i>Teacher Profile Details
            </h2>
            <nav aria-label="breadcrumb" class="mt-1">
                <ol class="breadcrumb mb-0 small text-muted">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Dashboard")" class="text-decoration-none text-muted">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("Index")" class="text-decoration-none text-muted">Teachers</a></li>
                    <li class="breadcrumb-item active text-primary" aria-current="page">Teacher Details</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Edit", new { id = Model.TeacherId })" class="btn btn-primary rounded-3 px-3 shadow-sm">
                <i class="bi bi-pencil-fill me-1"></i> Edit Profile
            </a>
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary rounded-3 px-3">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-4 col-12">
            <div class="card border-0 shadow-sm rounded-4 text-center p-4 h-100">
                <div class="position-relative d-inline-block mx-auto mb-3" id="imgWidget_@Model.UserId">
                    @if (!string.IsNullOrEmpty(Model.ProfileImageUrl))
                    {
                        <img id="imgWidget_@(Model.UserId)_preview" src="@Model.ProfileImageUrl" alt="@Model.FullName"
                             class="rounded-circle border shadow-sm"
                             style="width: 110px; height: 110px; object-fit: cover;"
                             onerror="this.onerror=null;this.src='/images/default-avatar.svg';" />
                    }
                    else
                    {
                        <img id="imgWidget_@(Model.UserId)_preview" src="/images/default-avatar.svg" alt="@Model.FullName"
                             class="rounded-circle border shadow-sm"
                             style="width: 110px; height: 110px; object-fit: cover;" />
                    }
                    <label for="imgInput_@Model.UserId"
                           class="position-absolute bottom-0 end-0 btn btn-sm btn-primary rounded-circle p-1 shadow-sm"
                           style="width:32px;height:32px;line-height:1;cursor:pointer;" title="Change photo">
                        <i class="bi bi-camera-fill" style="font-size:0.85rem;"></i>
                        <input type="file" id="imgInput_@Model.UserId" class="d-none"
                               accept="image/jpeg,image/png,image/webp"
                               onchange="uploadUserProfile(@Model.UserId, this, 'imgWidget_@Model.UserId')" />
                    </label>
                </div>
                <div id="imgWidget_@(Model.UserId)_msg" class="small mb-2"></div>
                @if (!string.IsNullOrEmpty(Model.ProfileImageUrl))
                {
                    <button type="button" class="btn btn-sm btn-outline-danger rounded-3 mb-3"
                            onclick="deleteUserProfile(@Model.UserId, 'imgWidget_@Model.UserId')">
                        <i class="bi bi-trash me-1"></i>Remove Photo
                    </button>
                }

                <h4 class="fw-bold text-dark mb-1">@Model.FullName</h4>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace px-3 py-1 mb-2">@@@Model.UserName</span>
                <p class="text-secondary small mb-3">@(string.IsNullOrWhiteSpace(Model.Designation) ? "Teacher" : Model.Designation) • @(string.IsNullOrWhiteSpace(Model.Department) ? "General" : Model.Department)</p>

                <div class="d-flex justify-content-center gap-2">
                    <span class="badge @(Model.IsActive ? "bg-success-subtle text-success border border-success-subtle" : "bg-danger-subtle text-danger border border-danger-subtle") rounded-pill px-3 py-2">
                        <i class="bi bi-circle-fill me-1 fs-7"></i>@(Model.IsActive ? "Active Account" : "Inactive Account")
                    </span>
                </div>
            </div>
        </div>

        <div class="col-lg-8 col-12">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
                <div class="card-body p-4">
                    <h6 class="fw-bold text-primary text-uppercase fs-7 mb-3"><i class="bi bi-card-heading me-2"></i>Professional & Employment Information</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6 col-12">
                            <small class="text-muted d-block">Employee Code</small>
                            <span class="fw-bold text-dark font-monospace">@(string.IsNullOrWhiteSpace(Model.EmployeeCode) ? "N/A" : Model.EmployeeCode)</span>
                        </div>
                        <div class="col-md-6 col-12">
                            <small class="text-muted d-block">Qualification</small>
                            <span class="fw-semibold text-dark">@(string.IsNullOrWhiteSpace(Model.Qualification) ? "N/A" : Model.Qualification)</span>
                        </div>
                        <div class="col-md-6 col-12">
                            <small class="text-muted d-block">Department</small>
                            <span class="fw-semibold text-dark">@(string.IsNullOrWhiteSpace(Model.Department) ? "N/A" : Model.Department)</span>
                        </div>
                        <div class="col-md-6 col-12">
                            <small class="text-muted d-block">Designation</small>
                            <span class="fw-semibold text-dark">@(string.IsNullOrWhiteSpace(Model.Designation) ? "N/A" : Model.Designation)</span>
                        </div>
                        <div class="col-md-6 col-12">
                            <small class="text-muted d-block">Joining Date</small>
                            <span class="fw-semibold text-dark">@(Model.JoiningDate.HasValue ? Model.JoiningDate.Value.ToString("dd MMM yyyy") : "N/A")</span>
                        </div>
                        <div class="col-md-6 col-12">
                            <small class="text-muted d-block">Gender</small>
                            <span class="fw-semibold text-dark">@(string.IsNullOrWhiteSpace(Model.Gender) ? "N/A" : Model.Gender)</span>
                        </div>
                    </div>

                    <h6 class="fw-bold text-primary text-uppercase fs-7 mb-3 pt-3 border-top"><i class="bi bi-envelope me-2"></i>Contact Information</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6 col-12">
                            <small class="text-muted d-block">Email Address</small>
                            <span class="fw-semibold text-dark">@(string.IsNullOrWhiteSpace(Model.Email) ? "N/A" : Model.Email)</span>
                        </div>
                        <div class="col-md-6 col-12">
                            <small class="text-muted d-block">Phone Number</small>
                            <span class="fw-semibold text-dark">@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "N/A" : Model.PhoneNumber)</span>
                        </div>
                        <div class="col-md-6 col-12">
                            <small class="text-muted d-block">Emergency Contact</small>
                            <span class="fw-semibold text-dark">@(string.IsNullOrWhiteSpace(Model.EmergencyContact) ? "N/A" : Model.EmergencyContact)</span>
                        </div>
                        <div class="col-md-6 col-12">
                            <small class="text-muted d-block">Account Created</small>
                            <span class="fw-semibold text-dark">@Model.CreatedAt.ToString("dd MMM yyyy hh:mm tt")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        const _tok = () => document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

        async function uploadUserProfile(userId, input, widgetId) {
            if (!input.files || !input.files[0]) return;
            const msg = document.getElementById(widgetId + '_msg');
            msg.innerHTML = '<span class="text-muted">Uploading…</span>';
            const fd = new FormData(); fd.append('file', input.files[0]);
            try {
                const res = await fetch('/Image/UploadUserProfile?userId=' + userId, { method: 'POST', headers: { 'RequestVerificationToken': _tok() }, body: fd });
                const json = await res.json();
                if (json.success) { msg.innerHTML = '<span class="text-success"><i class="bi bi-check-circle me-1"></i>Saved.</span>'; setTimeout(() => location.reload(), 800); }
                else { msg.innerHTML = `<span class="text-danger">${json.message}</span>`; }
            } catch { msg.innerHTML = '<span class="text-danger">Upload failed.</span>'; }
            input.value = '';
        }

        async function deleteUserProfile(userId, widgetId) {
            if (!confirm('Remove this profile photo?')) return;
            const msg = document.getElementById(widgetId + '_msg');
            try {
                const res = await fetch('/Image/DeleteUserProfile?userId=' + userId, { method: 'POST', headers: { 'RequestVerificationToken': _tok() } });
                const json = await res.json();
                if (json.success) location.reload();
            } catch { msg.innerHTML = '<span class="text-danger">Error.</span>'; }
        }
    </script>
}
