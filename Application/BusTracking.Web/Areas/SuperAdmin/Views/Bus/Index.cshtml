@model BusTracking.Common.DTOs.Common.PagedResult<BusTracking.Common.DTOs.Bus.BusListDto>
@{
    ViewData["Title"] = "Buses";
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
    <div>
        <h2 class="fw-bold m-0 text-dark">
            <i class="bi bi-bus-front text-primary me-2"></i>Buses Directory
        </h2>
        <nav aria-label="breadcrumb" class="mt-1">
            <ol class="breadcrumb mb-0 small text-muted">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Dashboard")" class="text-decoration-none text-muted">Dashboard</a></li>
                <li class="breadcrumb-item active text-primary" aria-current="page">Buses</li>
            </ol>
        </nav>
    </div>
    <a href="@Url.Action("Create")" class="btn btn-primary rounded-3 shadow-sm px-4">
        <i class="bi bi-plus-lg me-2"></i>Add Bus
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-7 col-lg-8">
                <div class="input-group">
                    <span class="input-group-text bg-light border-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control bg-light border-0" placeholder="Search bus name or number..." />
                </div>
            </div>
            <div class="col-md-5 col-lg-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill rounded-3"><i class="bi bi-filter me-1"></i>Filter</button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary rounded-3"><i class="bi bi-arrow-counterclockwise"></i> Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light-subtle border-bottom">
                <tr class="text-uppercase fs-7 text-muted fw-bold">
                    <th style="width: 65px;" class="ps-4">#</th>
                    <th>Bus Name</th>
                    <th>Bus Number</th>
                    <th>Route</th>
                    <th>Type</th>
                    <th>Driver</th>
                    <th class="text-center">Capacity</th>
                    <th class="text-center">Students</th>
                    <th style="width: 100px;" class="text-center">Status</th>
                    <th style="width: 160px;" class="text-center pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model?.Items.Count == 0)
                {
                    <tr>
                        <td colspan="10" class="text-center py-5 text-muted">
                            <i class="bi bi-bus-front text-secondary opacity-50 display-4"></i>
                            <p class="mt-2 mb-0 fw-semibold fs-6">No buses found</p>
                            <span class="small">Try adjusting search criteria or add a new bus.</span>
                        </td>
                    </tr>
                }
                else
                {
                    int idx = (Model!.PageNumber - 1) * Model.PageSize + 1;
                    @foreach (var b in Model?.Items ?? [])
                    {
                        <tr>
                            <td class="ps-4 text-muted small">@idx</td>
                            <td class="fw-bold text-dark fs-6">@b.BusName</td>
                            <td>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace px-2 py-1">@b.BusNumber</span>
                            </td>
                            <td class="text-secondary small">@(b.RouteName ?? "-")</td>
                            <td><span class="badge bg-secondary-subtle text-dark border">@(b.BusTypeName ?? "-")</span></td>
                            <td class="text-secondary small">
                                @if (b.DriverName is not null)
                                {
                                    <span class="fw-semibold text-dark"><i class="bi bi-person-badge me-1 text-primary"></i>@b.DriverName</span>
                                }
                                else
                                {
                                    <span class="text-muted">Unassigned</span>
                                }
                            </td>
                            <td class="text-center font-monospace text-dark">@(b.Capacity?.ToString() ?? "-")</td>
                            <td class="text-center">
                                <span class="badge bg-info-subtle text-info border border-info-subtle font-monospace">@b.StudentCount</span>
                            </td>
                            <td class="text-center">
                                <div class="form-check form-switch d-inline-block">
                                    <input type="checkbox" class="form-check-input btn-toggle-bus" style="cursor: pointer; width: 38px; height: 20px;" data-id="@b.BusId" @(b.IsActive ? "checked" : "") />
                                </div>
                            </td>
                            <td class="text-center pe-4">
                                <a href="@Url.Action("Details", new { id = b.BusId })" class="btn btn-outline-info btn-sm rounded-3 px-2 py-1 me-1" title="View Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a href="@Url.Action("Edit", new { id = b.BusId })" class="btn btn-outline-primary btn-sm rounded-3 px-2 py-1 me-1" title="Edit Bus">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@b.BusId" method="post" class="d-inline" onsubmit="return confirm('Deactivate bus \'@b.BusName\'?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-3 px-2 py-1" title="Delete Bus">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                        idx++;
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pagination" model="Model" />

@section Scripts {
    <script>
        document.querySelectorAll('.btn-toggle-bus').forEach(btn => {
            btn.addEventListener('change', async function () {
                const id = this.dataset.id;
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
                const res = await fetch('@Url.Action("Toggle")?id=' + id, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token }
                });
                const data = await res.json();
                if (!data.success) {
                    this.checked = !this.checked;
                    alert(data.message || 'Failed to update status.');
                }
            });
        });
    </script>
}
