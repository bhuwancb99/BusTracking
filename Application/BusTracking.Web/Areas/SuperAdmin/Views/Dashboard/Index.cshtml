@model BusTracking.Common.DTOs.Dashboard.DashboardSummaryDto
@using BusTracking.Common.Helpers
@inject BusTracking.Common.Data.AppDbContext DbContext
@inject BusTracking.Common.Interfaces.ICurrentUserService CurrentUser
@{
    ViewData["Title"] = "Dashboard";
    string? userPhoto = null;
    var uId = CurrentUser.UserId;
    if (uId.HasValue)
    {
        var dbUser = DbContext.Users.IgnoreQueryFilters().FirstOrDefault(u => u.UserId == uId.Value);
        if (dbUser != null)
        {
            userPhoto = dbUser.ProfileImageUrl;
        }
    }
    var adminName = User.GetFullName();
}

<div class="container-fluid p-0">
    <div class="row g-4 mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-white" style="background: linear-gradient(135deg, #3d5af1 0%, #2241d7 100%);">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <img src="@(string.IsNullOrWhiteSpace(userPhoto) ? "/images/default-avatar.svg" : userPhoto)" class="rounded-circle border border-2 border-white shadow-sm" style="width: 65px; height: 65px; object-fit: cover;" onerror="this.onerror=null;this.src='/images/default-avatar.svg';" />
                        <div>
                            <h3 class="fw-bold mb-1">Welcome back, @adminName!</h3>
                            <p class="mb-0 text-white-50">Super Admin Workspace • System Overview & Control Panel</p>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <a href="@Url.Action("Index", "Notification", new { area = "SuperAdmin" })" class="btn btn-light rounded-3 px-4 fw-semibold position-relative">
                            <i class="bi bi-bell me-2"></i>Notifications
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (Model is not null)
    {
        <!-- Stats row -->
        <div class="row g-3 mb-4">
            @{
                var cards = new[]
                {
                    (Model.TotalBuses.ToString(),           "Buses",            "bi-bus-front-fill",    "text-primary",   "Bus",      "SuperAdmin"),
                    (Model.TotalDrivers.ToString(),         "Drivers",          "bi-person-video2",     "text-success",   "Driver",   "SuperAdmin"),
                    (Model.TotalBusCoordinators.ToString(), "Coordinators",     "bi-person-badge",      "text-warning",   "SubAdmin", "SuperAdmin"),
                    (Model.TotalParents.ToString(),         "Parents",          "bi-people-fill",       "text-info",      "Parent",   "SuperAdmin"),
                    (Model.TotalStudents.ToString(),        "Students",         "bi-mortarboard-fill",  "text-secondary", "Student",  "SuperAdmin"),
                    (Model.ActiveTrips.ToString(),          "Active Trips",     "bi-geo-alt-fill",      "text-danger",    "",         ""),
                };
            }
            @foreach (var (val, lbl, icon, color, c, area) in cards)
            {
                <div class="col-6 col-md-4 col-xl-2">
                    <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                        <div class="card-body text-center py-4">
                            <i class="bi @icon @color mb-2 d-block" style="font-size:2rem"></i>
                            <div class="fw-bold fs-2 text-dark">@val</div>
                            <div class="text-muted small">@lbl</div>
                        </div>
                        @if (!string.IsNullOrEmpty(c))
                        {
                            <div class="card-footer bg-transparent border-0 text-center pb-3 pt-0">
                                <a asp-area="@area" asp-controller="@c" asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-3">View</a>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Quick Actions -->
        <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
            <div class="card-header bg-white border-0 pt-4 px-4 fw-bold text-primary text-uppercase fs-7">
                <i class="bi bi-lightning-charge me-2 text-warning"></i>Quick Actions
            </div>
            <div class="card-body px-4 pb-4">
                <div class="d-flex flex-wrap gap-2">
                    <a asp-area="SuperAdmin" asp-controller="SubAdmin" asp-action="Create" class="btn btn-outline-warning rounded-3"><i class="bi bi-plus me-1"></i>Add Coordinator</a>
                    <a asp-area="SuperAdmin" asp-controller="Driver" asp-action="Create" class="btn btn-outline-success rounded-3"><i class="bi bi-plus me-1"></i>Add Driver</a>
                    <a asp-area="SuperAdmin" asp-controller="Teacher" asp-action="Create" class="btn btn-outline-info rounded-3"><i class="bi bi-plus me-1"></i>Add Teacher</a>
                    <a asp-area="SuperAdmin" asp-controller="Student" asp-action="Create" class="btn btn-outline-info rounded-3"><i class="bi bi-plus me-1"></i>Add Student</a>
                    <a asp-area="SuperAdmin" asp-controller="Parent" asp-action="Create" class="btn btn-outline-primary rounded-3"><i class="bi bi-plus me-1"></i>Add Parent</a>
                    <a asp-area="SuperAdmin" asp-controller="Bus" asp-action="Create" class="btn btn-outline-primary rounded-3"><i class="bi bi-plus me-1"></i>Add Bus</a>
                    <a asp-area="SuperAdmin" asp-controller="Route" asp-action="Create" class="btn btn-outline-secondary rounded-3"><i class="bi bi-plus me-1"></i>Add Route</a>
                    <a asp-area="SuperAdmin" asp-controller="Trip" asp-action="Create" class="btn btn-outline-primary rounded-3"><i class="bi bi-plus me-1"></i>Create Trip</a>
                    <a asp-area="SuperAdmin" asp-controller="Trip" asp-action="Index" class="btn btn-outline-dark rounded-3"><i class="bi bi-list me-1"></i>All Trips</a>
                </div>
            </div>
        </div>
    }
</div>
