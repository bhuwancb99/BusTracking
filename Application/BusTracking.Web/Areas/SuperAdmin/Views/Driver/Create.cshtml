@model BusTracking.Common.DTOs.Driver.CreateDriverDto
@{
    ViewData["Title"] = "Register New Driver";
}

<div class="container-fluid p-0">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="fw-bold m-0 text-dark">
                <i class="bi bi-person-plus-fill text-primary me-2"></i>Register New Driver
            </h2>
            <nav aria-label="breadcrumb" class="mt-1">
                <ol class="breadcrumb mb-0 small text-muted">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Dashboard")" class="text-decoration-none text-muted">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("Index")" class="text-decoration-none text-muted">Drivers</a></li>
                    <li class="breadcrumb-item active text-primary" aria-current="page">Register Driver</li>
                </ol>
            </nav>
        </div>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary rounded-3 px-3">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-body p-4">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2 border-0 rounded-3 mb-4" style="background-color: rgba(239, 68, 68, 0.15); color: #ef4444;">
                        <div asp-validation-summary="All"></div>
                    </div>
                }

                <!-- Section 1: Account Credentials -->
                <div class="mb-4">
                    <h6 class="fw-bold text-primary text-uppercase fs-7 mb-3"><i class="bi bi-shield-lock me-2"></i>Account Credentials</h6>
                    <div class="row g-3">
                        <div class="col-md-4 col-12">
                            <label asp-for="FullName" class="form-label fw-bold">Full Name <span class="text-danger">*</span></label>
                            <input asp-for="FullName" class="form-control rounded-3" placeholder="e.g. John Doe" required />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4 col-12">
                            <label asp-for="UserName" class="form-label fw-bold">Username <span class="text-danger">*</span></label>
                            <input asp-for="UserName" id="UserNameInput" class="form-control rounded-3" placeholder="e.g. john.doe" required autocomplete="off" />
                            <span asp-validation-for="UserName" class="text-danger small"></span>
                            <div id="usernameCheckMsg" class="small mt-1"></div>
                        </div>

                        <div class="col-md-4 col-12">
                            <label asp-for="Password" class="form-label fw-bold">Password <span class="text-muted fw-normal">(Optional)</span></label>
                            <input asp-for="Password" type="password" class="form-control rounded-3" placeholder="Leave blank to auto-generate" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- Section 2: Contact & License Details -->
                <div class="mb-4 pt-3 border-top">
                    <h6 class="fw-bold text-primary text-uppercase fs-7 mb-3"><i class="bi bi-card-heading me-2"></i>Contact & License Details</h6>
                    <div class="row g-3 mb-3">
                        <div class="col-md-4 col-12">
                            <label asp-for="Email" class="form-label fw-bold">Email Address</label>
                            <input asp-for="Email" type="email" class="form-control rounded-3" placeholder="driver@school.edu" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4 col-12">
                            <label asp-for="PhoneNumber" class="form-label fw-bold">Phone Number</label>
                            <input asp-for="PhoneNumber" class="form-control rounded-3" placeholder="+91 9876543210" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4 col-12">
                            <label asp-for="LicenseNumber" class="form-label fw-bold">License Number</label>
                            <input asp-for="LicenseNumber" class="form-control rounded-3" placeholder="e.g. DL-9876543210" />
                            <span asp-validation-for="LicenseNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-4 col-12">
                            <label asp-for="LicenseExpiry" class="form-label fw-bold">License Expiry Date</label>
                            <input asp-for="LicenseExpiry" type="date" class="form-control rounded-3" />
                            <span asp-validation-for="LicenseExpiry" class="text-danger small"></span>
                        </div>

                        <div class="col-md-8 col-12 d-flex align-items-end">
                            <div class="form-check form-switch mb-2">
                                <input asp-for="SendEmail" class="form-check-input" type="checkbox" role="switch" id="sendEmailChk" style="width: 40px; height: 20px; cursor: pointer;" />
                                <label class="form-check-label fw-semibold ms-2" for="sendEmailChk">
                                    Send welcome email with login credentials
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 border-top pt-4">
                    <a href="@Url.Action("Index")" class="btn btn-light rounded-3 px-4">Cancel</a>
                    <button type="submit" id="submitBtn" class="btn btn-primary rounded-3 px-4 shadow-sm"><i class="bi bi-check-circle me-2"></i>Register Driver</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var input = document.getElementById('UserNameInput');
            var msg = document.getElementById('usernameCheckMsg');
            var btn = document.getElementById('submitBtn');
            var timeout = null;

            if (input) {
                input.addEventListener('input', function() {
                    var val = input.value.trim();
                    clearTimeout(timeout);

                    if (val.length === 0) {
                        if (msg) msg.textContent = '';
                        if (btn) btn.disabled = false;
                        return;
                    }

                    timeout = setTimeout(function() {
                        fetch('/Auth/CheckUsername?userName=' + encodeURIComponent(val))
                            .then(function(r) { return r.json(); })
                            .then(function(res) {
                                if (res.success) {
                                    if (msg) {
                                        msg.className = 'small mt-1 text-success';
                                        msg.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i>Username is available';
                                    }
                                    if (btn) btn.disabled = false;
                                } else {
                                    if (msg) {
                                        msg.className = 'small mt-1 text-danger';
                                        msg.innerHTML = '<i class="bi bi-x-circle-fill me-1"></i>' + res.message;
                                    }
                                    if (btn) btn.disabled = true;
                                }
                            })
                            .catch(function() {
                                if (btn) btn.disabled = false;
                            });
                    }, 400);
                });
            }
        });
    </script>
}
