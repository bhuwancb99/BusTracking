@model BusTracking.Common.DTOs.SubAdmin.CreateSubAdminDto
@{
    ViewData["Title"] = "Add Coordinator";
}

<div class="container-fluid p-0">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="fw-bold m-0 text-dark">
                <i class="bi bi-person-plus-fill text-primary me-2"></i>Add Bus Coordinator
            </h2>
            <nav aria-label="breadcrumb" class="mt-1">
                <ol class="breadcrumb mb-0 small text-muted">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Dashboard")" class="text-decoration-none text-muted">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("Index")" class="text-decoration-none text-muted">Bus Coordinators</a></li>
                    <li class="breadcrumb-item active text-primary" aria-current="page">Add Coordinator</li>
                </ol>
            </nav>
        </div>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary rounded-3 px-3">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-body p-4">
            <form asp-action="Create" method="post" id="createForm">
                @Html.AntiForgeryToken()

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2 border-0 rounded-3 mb-4" style="background-color: rgba(239, 68, 68, 0.15); color: #ef4444;">
                        <div asp-validation-summary="All"></div>
                    </div>
                }

                <!-- Section 1: Account Credentials -->
                <div class="mb-4">
                    <h6 class="fw-bold text-primary text-uppercase fs-7 mb-3"><i class="bi bi-shield-lock me-2"></i>Account Credentials</h6>
                    <div class="row g-3">
                        <div class="col-md-4 col-12">
                            <label asp-for="FullName" class="form-label fw-bold">Full Name <span class="text-danger">*</span></label>
                            <input asp-for="FullName" class="form-control rounded-3" placeholder="Coordinator full name" required />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4 col-12">
                            <label asp-for="UserName" class="form-label fw-bold">Username <span class="text-danger">*</span></label>
                            <input asp-for="UserName" class="form-control rounded-3" placeholder="unique_username" id="usernameInput" autocomplete="off" required />
                            <span asp-validation-for="UserName" class="text-danger small"></span>
                            <div id="usernameMsg" class="small mt-1"></div>
                        </div>

                        <div class="col-md-4 col-12">
                            <label asp-for="Password" class="form-label fw-bold">Password <span class="text-muted fw-normal">(Optional)</span></label>
                            <div class="input-group">
                                <input asp-for="Password" type="password" class="form-control rounded-3" placeholder="Leave blank to auto-generate" id="pwdInput" autocomplete="new-password" />
                                <button type="button" class="btn btn-outline-secondary" id="togglePwd"><i class="bi bi-eye" id="eyeIcon"></i></button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- Section 2: Contact Details -->
                <div class="mb-4 pt-3 border-top">
                    <h6 class="fw-bold text-primary text-uppercase fs-7 mb-3"><i class="bi bi-envelope me-2"></i>Contact Details</h6>
                    <div class="row g-3">
                        <div class="col-md-6 col-12">
                            <label asp-for="Email" class="form-label fw-bold">Email Address</label>
                            <input asp-for="Email" type="email" class="form-control rounded-3" placeholder="coordinator@school.edu" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 col-12">
                            <label asp-for="PhoneNumber" class="form-label fw-bold">Phone Number</label>
                            <input asp-for="PhoneNumber" class="form-control rounded-3" placeholder="+91 98765 43210" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- Section 3: Permissions -->
                <div class="mb-4 pt-3 border-top">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h6 class="fw-bold text-primary text-uppercase fs-7 m-0"><i class="bi bi-key me-2"></i>Assign Permissions</h6>
                        <button type="button" class="btn btn-sm btn-outline-primary rounded-3" id="btnSelectAll">Select All</button>
                    </div>
                    @{
                        var allPerms = ViewBag.AllPermissions as List<(int Id, string ModuleName, string Key, string Description)>
                                      ?? new List<(int, string, string, string)>();
                        var permGroups = allPerms.GroupBy(p => p.ModuleName).OrderBy(g => g.Key);
                    }
                    <div class="row g-3">
                        @foreach (var group in permGroups)
                        {
                            var modKey = group.Key.Replace(" ", "_").Replace("&", "");
                            <div class="col-md-4 col-12">
                                <div class="border rounded-4 p-3 bg-light-subtle">
                                    <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                                        <span class="fw-bold small text-uppercase text-primary">@group.Key.Replace("Manage", "")</span>
                                        <button type="button" class="btn btn-link btn-sm p-0 text-primary fw-semibold btn-module-all" data-mod="@modKey">All</button>
                                    </div>
                                    @foreach (var perm in group)
                                    {
                                        <div class="form-check my-1">
                                            <input class="form-check-input perm-@modKey" type="checkbox" name="PermissionIds" value="@perm.Id" id="perm_@perm.Id" />
                                            <label class="form-check-label small text-dark" for="perm_@perm.Id">@perm.Description</label>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Section 4: Options -->
                <div class="mb-4 pt-3 border-top">
                    <h6 class="fw-bold text-primary text-uppercase fs-7 mb-3"><i class="bi bi-gear me-2"></i>Additional Options</h6>
                    <div class="form-check form-switch">
                        <input asp-for="SendEmail" class="form-check-input" type="checkbox" role="switch" id="sendEmailChk" style="width: 40px; height: 20px; cursor: pointer;" />
                        <label class="form-check-label fw-semibold text-dark ms-2" for="sendEmailChk">
                            Send welcome email with login credentials
                        </label>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 border-top pt-4">
                    <a href="@Url.Action("Index")" class="btn btn-light rounded-3 px-4">Cancel</a>
                    <button type="submit" id="submitBtn" class="btn btn-primary rounded-3 px-4 shadow-sm"><i class="bi bi-check-circle me-2"></i>Create Coordinator</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('togglePwd').addEventListener('click', function() {
            const inp = document.getElementById('pwdInput');
            const icon = document.getElementById('eyeIcon');
            inp.type = inp.type === 'password' ? 'text' : 'password';
            icon.className = inp.type === 'password' ? 'bi bi-eye' : 'bi bi-eye-slash';
        });

        document.querySelectorAll('.btn-module-all').forEach(btn => {
            btn.addEventListener('click', function() {
                const cls = `.perm-${this.dataset.mod}`;
                const checks = [...document.querySelectorAll(cls)];
                const all = checks.every(c => c.checked);
                checks.forEach(c => c.checked = !all);
                this.textContent = all ? 'All' : 'None';
            });
        });

        document.getElementById('btnSelectAll').addEventListener('click', function() {
            const checks = [...document.querySelectorAll('input[name="PermissionIds"]')];
            const all = checks.every(c => c.checked);
            checks.forEach(c => c.checked = !all);
            this.textContent = all ? 'Select All' : 'Deselect All';
        });

        const _unInput = document.getElementById('usernameInput');
        const _unMsg = document.getElementById('usernameMsg');
        let _unTimer = null;

        _unInput.addEventListener('keyup', () => {
            clearTimeout(_unTimer);
            _unTimer = setTimeout(liveCheckUsername, 350);
        });

        async function liveCheckUsername() {
            const val = _unInput.value.trim();
            _unMsg.innerHTML = '';
            _unMsg.className = 'small mt-1';
            if (val.length === 0) return;
            if (val.length < 5) {
                _unMsg.innerHTML = '<i class="bi bi-exclamation-circle me-1"></i>Username must have at least 5 characters';
                _unMsg.className = 'small mt-1 text-danger';
                return;
            }
            try {
                const res = await fetch(`/Auth/CheckUsername?userName=${encodeURIComponent(val)}`);
                if (!res.ok) return;
                const data = await res.json();
                if (!data.success) {
                    _unMsg.innerHTML = `<i class="bi bi-x-circle me-1"></i>The username <strong>${escHtml(val)}</strong> is already taken`;
                    _unMsg.className = 'small mt-1 text-danger';
                } else {
                    _unMsg.innerHTML = `<i class="bi bi-check-circle me-1"></i><strong>${escHtml(val)}</strong> is available`;
                    _unMsg.className = 'small mt-1 text-success fw-semibold';
                }
            } catch (_) { }
        }
        function escHtml(s) {
            return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
        }
    </script>
}
