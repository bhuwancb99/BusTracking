@model IEnumerable<BusTracking.Common.Entities.Logger>
@using System.Text.Json
@{
    ViewData["Title"] = "System Logs";

    var platform = ViewBag.Platform as string;
    var search = ViewBag.Search as string;
    var fromDate = ViewBag.FromDate as string;
    var toDate = ViewBag.ToDate as string;
    var sortBy = ViewBag.SortBy as string;
    var sortOrder = ViewBag.SortOrder as string;

    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    int totalItems = ViewBag.TotalItems;
    int pageSize = ViewBag.PageSize;

    var startItem = (currentPage - 1) * pageSize + 1;
    var endItem = Math.Min(currentPage * pageSize, totalItems);

    string GetSortUrl(string field)
    {
        var order = sortBy == field && sortOrder == "asc" ? "desc" : "asc";
        return $"?platform={platform}&search={search}&fromDate={fromDate}&toDate={toDate}&sortBy={field}&sortOrder={order}&page=1";
    }

    string GetPageUrl(int p)
    {
        return $"?platform={platform}&search={search}&fromDate={fromDate}&toDate={toDate}&sortBy={sortBy}&sortOrder={sortOrder}&page={p}";
    }
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
    <div>
        <h2 class="fw-bold m-0 text-dark">
            <i class="bi bi-journal-text text-primary me-2"></i>System Logs & Audit Trail
        </h2>
        <nav aria-label="breadcrumb" class="mt-1">
            <ol class="breadcrumb mb-0 small text-muted">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Dashboard")" class="text-decoration-none text-muted">Dashboard</a></li>
                <li class="breadcrumb-item active text-primary" aria-current="page">System Logs</li>
            </ol>
        </nav>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <input type="hidden" name="sortBy" value="@sortBy" />
            <input type="hidden" name="sortOrder" value="@sortOrder" />
            <input type="hidden" name="page" value="1" />

            <div class="col-md-2 col-6">
                <label class="form-label fw-bold small text-muted mb-1">Platform</label>
                <select name="platform" class="form-select bg-light border-0 rounded-3" onchange="this.form.submit()">
                    <option value="All" selected="@(platform == "All")">All Platforms</option>
                    <option value="WEB" selected="@(platform == "WEB")">Web App</option>
                    <option value="API" selected="@(platform == "API")">Web API</option>
                    <option value="Android" selected="@(platform == "Android")">Android</option>
                    <option value="iOS" selected="@(platform == "iOS")">iOS</option>
                    <option value="Windows" selected="@(platform == "Windows")">Windows</option>
                    <option value="macOS" selected="@(platform == "macOS")">macOS</option>
                </select>
            </div>

            <div class="col-md-2 col-6">
                <label class="form-label fw-bold small text-muted mb-1">From Date</label>
                <input type="date" name="fromDate" value="@fromDate" class="form-control bg-light border-0 rounded-3" />
            </div>

            <div class="col-md-2 col-6">
                <label class="form-label fw-bold small text-muted mb-1">To Date</label>
                <input type="date" name="toDate" value="@toDate" class="form-control bg-light border-0 rounded-3" />
            </div>

            <div class="col-md-4 col-12">
                <label class="form-label fw-bold small text-muted mb-1">Search Keywords</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" value="@search" class="form-control bg-light border-0" placeholder="Search exceptions, traces, users..." />
                </div>
            </div>

            <div class="col-md-2 col-12 d-flex gap-2 align-self-end">
                <button type="submit" class="btn btn-primary flex-fill rounded-3"><i class="bi bi-filter me-1"></i>Filter</button>
                <a href="?page=1" class="btn btn-outline-secondary rounded-3" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light-subtle border-bottom">
                <tr class="text-uppercase fs-7 text-muted fw-bold">
                    <th class="ps-4" style="width: 80px;">
                        <a href="@GetSortUrl("logid")" class="text-decoration-none text-muted">ID @(sortBy == "logid" ? (sortOrder == "asc" ? "▲" : "▼") : "")</a>
                    </th>
                    <th style="width: 110px;">
                        <a href="@GetSortUrl("platform")" class="text-decoration-none text-muted">Platform @(sortBy == "platform" ? (sortOrder == "asc" ? "▲" : "▼") : "")</a>
                    </th>
                    <th style="width: 170px;">
                        <a href="@GetSortUrl("timestamp")" class="text-decoration-none text-muted">Logged At @(sortBy == "timestamp" ? (sortOrder == "asc" ? "▲" : "▼") : "")</a>
                    </th>
                    <th>Message</th>
                    <th>
                        <a href="@GetSortUrl("module")" class="text-decoration-none text-muted">Module / Action @(sortBy == "module" ? (sortOrder == "asc" ? "▲" : "▼") : "")</a>
                    </th>
                    <th>
                        <a href="@GetSortUrl("username")" class="text-decoration-none text-muted">User @(sortBy == "username" ? (sortOrder == "asc" ? "▲" : "▼") : "")</a>
                    </th>
                    <th style="width: 90px;" class="text-center pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-journal-text text-secondary opacity-50 display-4"></i>
                            <p class="mt-2 mb-0 fw-semibold fs-6">No system logs found</p>
                            <span class="small">Try adjusting search criteria or date ranges.</span>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var log in Model)
                    {
                        var badgeClass = log.Platform switch
                        {
                            "WEB" => "bg-success-subtle text-success border border-success-subtle",
                            "API" => "bg-primary-subtle text-primary border border-primary-subtle",
                            "Android" => "bg-warning-subtle text-dark border border-warning-subtle",
                            "iOS" => "bg-info-subtle text-info border border-info-subtle",
                            "Windows" => "bg-secondary-subtle text-dark border",
                            "macOS" => "bg-dark text-white",
                            _ => "bg-light text-dark border"
                        };

                        <tr style="cursor: pointer;" onclick="showLogDetails(@JsonSerializer.Serialize(log))">
                            <td class="ps-4 fw-bold text-muted small">#@log.LogId</td>
                            <td>
                                <span class="badge @badgeClass font-monospace px-2 py-1">@log.Platform</span>
                            </td>
                            <td class="text-secondary small">@log.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td style="max-width: 320px;">
                                <div class="text-truncate fw-semibold text-danger" title="@log.ExceptionMessage">
                                    @log.ExceptionMessage
                                </div>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(log.ModuleName))
                                {
                                    <span class="badge bg-light text-dark border small">@log.ModuleName / @log.ActionName</span>
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(log.Username))
                                {
                                    <div class="small fw-bold text-dark">@log.Username</div>
                                    <div class="small text-muted font-monospace" style="font-size: 0.72rem;">@log.Role (ID: @log.UserId)</div>
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </td>
                            <td class="text-center pe-4" onclick="event.stopPropagation();">
                                <button type="button" class="btn btn-outline-info btn-sm rounded-3 px-2 py-1" onclick="showLogDetails(@JsonSerializer.Serialize(log))" title="View Log Details">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if (totalPages > 1)
{
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body py-2 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span class="text-muted small">Showing @startItem to @endItem of @totalItems logs</span>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link rounded-2" href="@GetPageUrl(currentPage - 1)"><i class="bi bi-chevron-left"></i></a>
                    </li>
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        if (i == 1 || i == totalPages || Math.Abs(i - currentPage) <= 2)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link rounded-2" href="@GetPageUrl(i)">@i</a>
                            </li>
                        }
                        else if (i == 2 || i == totalPages - 1)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }
                    }
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link rounded-2" href="@GetPageUrl(currentPage + 1)"><i class="bi bi-chevron-right"></i></a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
}

<!-- Log Details Modal -->
<div class="modal fade" id="logDetailsModal" tabindex="-1" aria-labelledby="logDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-dark text-white border-0 py-3">
                <h5 class="modal-title fw-bold m-0" id="logDetailsModalLabel"><i class="bi bi-journal-text me-2"></i>Log Details</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <small class="text-muted d-block">Log ID</small>
                        <span class="fw-bold font-monospace text-dark" id="modalLogId"></span>
                    </div>
                    <div class="col-md-3">
                        <small class="text-muted d-block">Platform</small>
                        <span class="badge font-monospace" id="modalPlatform"></span>
                    </div>
                    <div class="col-md-6">
                        <small class="text-muted d-block">Logged At (Local Time)</small>
                        <span class="fw-semibold text-dark" id="modalTimestamp"></span>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <small class="text-muted d-block">Module / Action</small>
                        <span id="modalModuleAction" class="fw-semibold text-dark"></span>
                    </div>
                    <div class="col-md-6">
                        <small class="text-muted d-block">User Context</small>
                        <span id="modalUserContext" class="fw-semibold text-dark"></span>
                    </div>
                </div>

                <div class="mb-4" id="modalUrlSection">
                    <small class="text-muted d-block">Request URL</small>
                    <code class="text-primary fw-semibold font-monospace" id="modalRequestUrl" style="word-break: break-all;"></code>
                </div>

                <div class="mb-4">
                    <small class="text-muted d-block mb-1">Exception Message</small>
                    <div class="alert alert-danger border-0 rounded-3 p-3 mb-0 fw-bold" id="modalExceptionMessage"></div>
                </div>

                <div class="mb-4" id="modalStackSection">
                    <small class="text-muted d-block mb-1">Stack Trace</small>
                    <pre class="bg-light p-3 border rounded-3 text-danger mb-0" id="modalStackTrace" style="max-height: 280px; overflow: auto; font-size: .78rem; font-family: monospace;"></pre>
                </div>

                <div class="mb-0" id="modalDetailsSection">
                    <small class="text-muted d-block mb-1">Additional Details</small>
                    <div class="bg-light p-3 border rounded-3 text-dark" id="modalAdditionalDetails" style="font-size: .85rem; max-height: 120px; overflow: auto;"></div>
                </div>
            </div>
            <div class="modal-footer border-top-0 pt-0">
                <button type="button" class="btn btn-light rounded-3 px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showLogDetails(log) {
            document.getElementById('modalLogId').innerText = '#' + log.LogId;

            const platformBadge = document.getElementById('modalPlatform');
            platformBadge.innerText = log.Platform;
            platformBadge.className = 'badge font-monospace';

            if (log.Platform === 'WEB') platformBadge.classList.add('bg-success-subtle', 'text-success', 'border', 'border-success-subtle');
            else if (log.Platform === 'API') platformBadge.classList.add('bg-primary-subtle', 'text-primary', 'border', 'border-primary-subtle');
            else if (log.Platform === 'Android') platformBadge.classList.add('bg-warning-subtle', 'text-dark', 'border', 'border-warning-subtle');
            else if (log.Platform === 'iOS') platformBadge.classList.add('bg-info-subtle', 'text-info', 'border', 'border-info-subtle');
            else platformBadge.classList.add('bg-light', 'text-dark', 'border');

            const date = new Date(log.Timestamp);
            document.getElementById('modalTimestamp').innerText = date.toLocaleString();

            document.getElementById('modalModuleAction').innerText = log.ModuleName
                ? (log.ModuleName + ' / ' + log.ActionName)
                : '-';

            document.getElementById('modalUserContext').innerText = log.Username
                ? (log.Username + ' (' + log.Role + ', ID: ' + log.UserId + ')')
                : '-';

            if (log.RequestUrl) {
                document.getElementById('modalUrlSection').style.display = 'block';
                document.getElementById('modalRequestUrl').innerText = log.RequestUrl;
            } else {
                document.getElementById('modalUrlSection').style.display = 'none';
            }

            document.getElementById('modalExceptionMessage').innerText = log.ExceptionMessage || '-';

            if (log.StackTrace) {
                document.getElementById('modalStackSection').style.display = 'block';
                document.getElementById('modalStackTrace').innerText = log.StackTrace;
            } else {
                document.getElementById('modalStackSection').style.display = 'none';
            }

            if (log.AdditionalDetails) {
                document.getElementById('modalDetailsSection').style.display = 'block';
                document.getElementById('modalAdditionalDetails').innerText = log.AdditionalDetails;
            } else {
                document.getElementById('modalDetailsSection').style.display = 'none';
            }

            const modal = new bootstrap.Modal(document.getElementById('logDetailsModal'));
            modal.show();
        }
    </script>
}
