@model List<BusTracking.Common.DTOs.ClassMapping.ClassSubjectTeacherDto>
@{
    ViewData["Title"] = "Class - Subject - Teacher Mapping";
    var years = ViewBag.AcademicYears as List<BusTracking.Common.DTOs.AcademicYear.AcademicYearDto> ?? new();
    var standards = ViewBag.Standards as List<BusTracking.Common.DTOs.Standard.StandardDto> ?? new();
    var sections = ViewBag.Sections as List<BusTracking.Common.DTOs.Section.SectionDto> ?? new();
    var subjects = ViewBag.Subjects as List<BusTracking.Common.DTOs.Subject.SubjectDto> ?? new();
    var teachers = ViewBag.Teachers as List<BusTracking.Common.DTOs.Teacher.TeacherDto> ?? new();

    int selectedYearId = ViewBag.SelectedYearId ?? 0;
    int selectedStandardId = ViewBag.SelectedStandardId ?? 0;
    int selectedSectionId = ViewBag.SelectedSectionId ?? 0;
    bool isFilterApplied = ViewBag.IsFilterApplied ?? false;
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
    <div>
        <h2 class="fw-bold m-0 text-dark">
            <i class="bi bi-diagram-2 text-primary me-2"></i>Class Subject & Teacher Mapping
        </h2>
        <nav aria-label="breadcrumb" class="mt-1">
            <ol class="breadcrumb mb-0 small text-muted">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Dashboard")" class="text-decoration-none text-muted">Dashboard</a></li>
                <li class="breadcrumb-item active text-primary" aria-current="page">Class Subject Teacher Mapping</li>
            </ol>
        </nav>
    </div>
    <button type="button" class="btn btn-primary rounded-3 shadow-sm px-4" data-bs-toggle="modal" data-bs-target="#assignMappingModal">
        <i class="bi bi-plus-lg me-2"></i>Assign Subject & Teacher
    </button>
</div>

<!-- Filter Bar -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted mb-1">Academic Session <span class="text-danger">*</span></label>
                <select name="academicYearId" class="form-select bg-light border-0" required>
                    <option value="">-- Select Academic Session --</option>
                    @foreach (var y in years)
                    {
                        <option value="@y.AcademicYearId" selected="@(y.AcademicYearId == selectedYearId ? "selected" : null)">@y.YearName @(y.IsCurrent ? "(Active)" : "")</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted mb-1">Class / Standard <span class="text-danger">*</span></label>
                <select name="standardId" id="filterStandardSelect" class="form-select bg-light border-0" onchange="loadFilterSections(this.value)" required>
                    <option value="">-- Select Class --</option>
                    @foreach (var s in standards)
                    {
                        <option value="@s.StandardId" selected="@(s.StandardId == selectedStandardId ? "selected" : null)">@s.StandardName</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted mb-1">Section <span class="text-danger">*</span></label>
                <select name="sectionId" id="filterSectionSelect" class="form-select bg-light border-0" required>
                    <option value="">-- Select Section --</option>
                    @foreach (var sec in sections)
                    {
                        <option value="@sec.SectionId" selected="@(sec.SectionId == selectedSectionId ? "selected" : null)">Section @sec.SectionName</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end gap-2 pt-4">
                <button type="submit" class="btn btn-primary flex-fill rounded-3"><i class="bi bi-filter me-1"></i>Filter</button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary rounded-3"><i class="bi bi-arrow-counterclockwise"></i> Reset</a>
            </div>
        </form>
    </div>
</div>

@if (!isFilterApplied)
{
    <div class="card border-0 shadow-sm rounded-4 text-center py-5 mb-4">
        <div class="card-body">
            <i class="bi bi-funnel text-primary display-4 opacity-75 mb-3 d-block"></i>
            <h5 class="fw-bold text-dark mb-2">Please Select Filter Criteria and Click Search</h5>
            <p class="text-muted mb-0">Select <strong>Academic Session <span class="text-danger">*</span></strong>, <strong>Class / Standard <span class="text-danger">*</span></strong>, and <strong>Section <span class="text-danger">*</span></strong> to fetch class subject teacher assignments.</p>
        </div>
    </div>
}
else
{
    <!-- Mapping List Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light-subtle border-bottom">
                    <tr class="text-uppercase fs-7 text-muted fw-bold">
                        <th style="width: 80px;" class="ps-4">ID</th>
                        <th>Subject Name</th>
                        <th>Class & Section</th>
                        <th>Assigned Teacher</th>
                        <th style="width: 180px;" class="text-center pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || Model.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-diagram-2 text-secondary opacity-50 display-4"></i>
                                <p class="mt-2 mb-0 fw-semibold fs-6">No subject-teacher assignments found for selection</p>
                                <span class="small">Click "Assign Subject & Teacher" above to map subjects to teachers.</span>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var m in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="badge bg-secondary-subtle text-dark border font-monospace">#@m.ClassSubjectTeacherId</span>
                                </td>
                                <td>
                                    <span class="fw-bold text-dark fs-6">@m.SubjectName</span>
                                </td>
                                <td class="fw-semibold text-secondary">
                                    @m.StandardName
                                    @if (!string.IsNullOrEmpty(m.SectionName))
                                    {
                                        <span class="badge bg-light text-dark border ms-1">Section @m.SectionName</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar avatar-sm bg-primary-subtle text-primary rounded-circle me-2 d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px;">
                                            @(string.IsNullOrEmpty(m.TeacherName) ? "T" : m.TeacherName[0])
                                        </div>
                                        <span class="fw-bold text-dark">@m.TeacherName</span>
                                    </div>
                                </td>
                                <td class="text-center pe-4">
                                    <button type="button" class="btn btn-outline-primary btn-sm rounded-3 px-2 py-1 me-1 btn-edit-mapping"
                                            data-id="@m.ClassSubjectTeacherId"
                                            data-year="@m.AcademicYearId"
                                            data-standard="@m.StandardId"
                                            data-section="@m.SectionId"
                                            data-subject="@m.SubjectId"
                                            data-teacher="@m.TeacherId"
                                            title="Edit Mapping">
                                        <i class="bi bi-pencil-fill me-1"></i>Edit
                                    </button>
                                    <form asp-action="Unassign" method="post" class="d-inline" onsubmit="return confirm('Unassign subject \'@m.SubjectName\' from teacher \'@m.TeacherName\'?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@m.ClassSubjectTeacherId" />
                                        <input type="hidden" name="academicYearId" value="@selectedYearId" />
                                        <input type="hidden" name="standardId" value="@selectedStandardId" />
                                        <input type="hidden" name="sectionId" value="@selectedSectionId" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-3 px-2 py-1" title="Unassign">
                                            <i class="bi bi-trash-fill me-1"></i>Unassign
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Assign Modal -->
<div class="modal fade" id="assignMappingModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-diagram-2 text-primary me-2"></i>Assign Subject & Teacher</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Assign" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body py-3">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Academic Session <span class="text-danger">*</span></label>
                        <select name="AcademicYearId" class="form-select rounded-3" required>
                            <option value="">-- Select Academic Session --</option>
                            @foreach (var y in years)
                            {
                                <option value="@y.AcademicYearId" selected="@(y.AcademicYearId == selectedYearId ? "selected" : null)">@y.YearName @(y.IsCurrent ? "(Active)" : "")</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Class / Standard <span class="text-danger">*</span></label>
                        <select name="StandardId" id="assignStandardSelect" class="form-select rounded-3" onchange="loadSectionsForAssign(this.value)" required>
                            <option value="">-- Select Class --</option>
                            @foreach (var s in standards)
                            {
                                <option value="@s.StandardId" selected="@(s.StandardId == selectedStandardId ? "selected" : null)">@s.StandardName</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Section <span class="text-danger">*</span></label>
                        <select name="SectionId" id="assignSectionSelect" class="form-select rounded-3" required>
                            <option value="">-- Select Section --</option>
                            @foreach (var sec in sections)
                            {
                                <option value="@sec.SectionId" selected="@(sec.SectionId == selectedSectionId ? "selected" : null)">Section @sec.SectionName</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Subject <span class="text-danger">*</span></label>
                        <select name="SubjectId" class="form-select rounded-3" required>
                            <option value="">-- Select Subject --</option>
                            @foreach (var sub in subjects)
                            {
                                <option value="@sub.SubjectId">@sub.SubjectName @(!string.IsNullOrEmpty(sub.SubjectCode) ? $"({sub.SubjectCode})" : "")</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Teacher <span class="text-danger">*</span></label>
                        <select name="TeacherId" class="form-select rounded-3" required>
                            <option value="">-- Select Teacher --</option>
                            @foreach (var t in teachers)
                            {
                                <option value="@t.TeacherId">@t.FullName (@t.Email)</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary rounded-3 px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-3 px-4"><i class="bi bi-check-lg me-1"></i>Save Assignment</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editMappingModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square text-primary me-2"></i>Edit Class Subject & Teacher Mapping</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Update" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="editMappingId" />
                <div class="modal-body py-3">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Academic Session <span class="text-danger">*</span></label>
                        <select name="AcademicYearId" id="editAcademicYearId" class="form-select rounded-3" required>
                            <option value="">-- Select Academic Session --</option>
                            @foreach (var y in years)
                            {
                                <option value="@y.AcademicYearId">@y.YearName</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Class / Standard <span class="text-danger">*</span></label>
                        <select name="StandardId" id="editStandardId" class="form-select rounded-3" onchange="loadSectionsForEdit(this.value)" required>
                            <option value="">-- Select Class --</option>
                            @foreach (var s in standards)
                            {
                                <option value="@s.StandardId">@s.StandardName</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Section <span class="text-danger">*</span></label>
                        <select name="SectionId" id="editSectionId" class="form-select rounded-3" required>
                            <option value="">-- Select Section --</option>
                            @foreach (var sec in sections)
                            {
                                <option value="@sec.SectionId">Section @sec.SectionName</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Subject <span class="text-danger">*</span></label>
                        <select name="SubjectId" id="editSubjectId" class="form-select rounded-3" required>
                            <option value="">-- Select Subject --</option>
                            @foreach (var sub in subjects)
                            {
                                <option value="@sub.SubjectId">@sub.SubjectName @(!string.IsNullOrEmpty(sub.SubjectCode) ? $"({sub.SubjectCode})" : "")</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Teacher <span class="text-danger">*</span></label>
                        <select name="TeacherId" id="editTeacherId" class="form-select rounded-3" required>
                            <option value="">-- Select Teacher --</option>
                            @foreach (var t in teachers)
                            {
                                <option value="@t.TeacherId">@t.FullName (@t.Email)</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary rounded-3 px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-3 px-4"><i class="bi bi-check-lg me-1"></i>Update Assignment</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function loadFilterSections(stdId) {
            const sel = document.getElementById('filterSectionSelect');
            if (!sel) return;
            sel.innerHTML = '<option value="">Loading sections...</option>';
            if (!stdId) {
                sel.innerHTML = '<option value="">-- Select Section --</option>';
                return;
            }
            fetch('/SuperAdmin/Section/GetSectionsByStandard?standardId=' + stdId)
                .then(r => r.json())
                .then(data => {
                    sel.innerHTML = '<option value="">-- Select Section --</option>';
                    if (Array.isArray(data)) {
                        data.forEach(sec => {
                            const secId = sec.sectionId ?? sec.SectionId;
                            const secName = sec.sectionName ?? sec.SectionName;
                            const opt = document.createElement('option');
                            opt.value = secId;
                            opt.textContent = 'Section ' + secName;
                            sel.appendChild(opt);
                        });
                    }
                })
                .catch(err => {
                    console.error('Error fetching sections:', err);
                    sel.innerHTML = '<option value="">-- Select Section --</option>';
                });
        }

        function loadSectionsForAssign(stdId) {
            const sel = document.getElementById('assignSectionSelect');
            if (!sel) return;
            sel.innerHTML = '<option value="">Loading sections...</option>';
            if (!stdId) {
                sel.innerHTML = '<option value="">-- Select Section --</option>';
                return;
            }
            fetch('/SuperAdmin/Section/GetSectionsByStandard?standardId=' + stdId)
                .then(r => r.json())
                .then(data => {
                    sel.innerHTML = '<option value="">-- Select Section --</option>';
                    if (Array.isArray(data)) {
                        data.forEach(sec => {
                            const secId = sec.sectionId ?? sec.SectionId;
                            const secName = sec.sectionName ?? sec.SectionName;
                            const opt = document.createElement('option');
                            opt.value = secId;
                            opt.textContent = 'Section ' + secName;
                            sel.appendChild(opt);
                        });
                    }
                })
                .catch(err => {
                    console.error('Error fetching sections:', err);
                    sel.innerHTML = '<option value="">-- Select Section --</option>';
                });
        }

        function loadSectionsForEdit(stdId, preSelectSecId) {
            const sel = document.getElementById('editSectionId');
            if (!sel) return;
            sel.innerHTML = '<option value="">Loading sections...</option>';
            if (!stdId) {
                sel.innerHTML = '<option value="">-- Select Section --</option>';
                return;
            }
            fetch('/SuperAdmin/Section/GetSectionsByStandard?standardId=' + stdId)
                .then(r => r.json())
                .then(data => {
                    sel.innerHTML = '<option value="">-- Select Section --</option>';
                    if (Array.isArray(data)) {
                        data.forEach(sec => {
                            const secId = sec.sectionId ?? sec.SectionId;
                            const secName = sec.sectionName ?? sec.SectionName;
                            const opt = document.createElement('option');
                            opt.value = secId;
                            opt.textContent = 'Section ' + secName;
                            if (preSelectSecId && secId == preSelectSecId) {
                                opt.selected = true;
                            }
                            sel.appendChild(opt);
                        });
                        if (preSelectSecId) {
                            sel.value = preSelectSecId;
                        }
                    }
                })
                .catch(err => {
                    console.error('Error fetching sections:', err);
                    sel.innerHTML = '<option value="">-- Select Section --</option>';
                });
        }

        document.querySelectorAll('.btn-edit-mapping').forEach(btn => {
            btn.addEventListener('click', function() {
                const stdId = this.dataset.standard;
                const secId = this.dataset.section || '';

                document.getElementById('editMappingId').value = this.dataset.id;
                document.getElementById('editAcademicYearId').value = this.dataset.year;
                document.getElementById('editStandardId').value = stdId;
                document.getElementById('editSubjectId').value = this.dataset.subject;
                document.getElementById('editTeacherId').value = this.dataset.teacher;

                loadSectionsForEdit(stdId, secId);

                const modal = new bootstrap.Modal(document.getElementById('editMappingModal'));
                modal.show();
            });
        });
    </script>
}
