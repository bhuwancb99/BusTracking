@model BusTracking.Common.DTOs.Trip.CreateTripDto
@{
    ViewData["Title"] = "Create New Trip";
}

<div class="container-fluid p-0">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="fw-bold m-0 text-dark">
                <i class="bi bi-bus-front text-primary me-2"></i>Create New Trip
            </h2>
            <nav aria-label="breadcrumb" class="mt-1">
                <ol class="breadcrumb mb-0 small text-muted">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Dashboard")" class="text-decoration-none text-muted">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("Index")" class="text-decoration-none text-muted">Trips</a></li>
                    <li class="breadcrumb-item active text-primary" aria-current="page">Create Trip</li>
                </ol>
            </nav>
        </div>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary rounded-3 px-3">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-body p-4">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2 border-0 rounded-3 mb-4" style="background-color: rgba(239, 68, 68, 0.15); color: #ef4444;">
                    <div asp-validation-summary="All"></div>
                </div>
            }

            <div class="alert alert-info border-0 rounded-3 py-3 mb-4 bg-info-subtle text-info border-start border-4 border-info">
                <div class="d-flex align-items-center">
                    <i class="bi bi-info-circle-fill me-2 fs-5"></i>
                    <div>
                        <strong>Automatic Roster Sync:</strong> Creating a trip will automatically associate assigned students and route stops for live boarding management.
                    </div>
                </div>
            </div>

            <form asp-action="Create" method="post" id="createTripForm">
                @Html.AntiForgeryToken()

                <!-- Section 1: Trip Schedule & Type -->
                <div class="mb-4">
                    <h6 class="fw-bold text-primary text-uppercase fs-7 mb-3"><i class="bi bi-calendar-event me-2"></i>Schedule & Trip Category</h6>
                    <div class="row g-3">
                        <div class="col-md-4 col-12">
                            <label asp-for="TripDate" class="form-label fw-bold">Trip Date <span class="text-danger">*</span></label>
                            <input asp-for="TripDate" type="date" class="form-control rounded-3"
                                   min="@DateTime.Today.AddDays(-7).ToString("yyyy-MM-dd")"
                                   max="@DateTime.Today.AddDays(30).ToString("yyyy-MM-dd")" required />
                            <span asp-validation-for="TripDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-8 col-12">
                            <label asp-for="TripType" class="form-label fw-bold">Trip Type <span class="text-danger">*</span></label>
                            <div class="d-flex gap-3 mt-1 flex-wrap">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="TripType" value="Morning" id="typeMorning" required />
                                    <label class="form-check-label fw-semibold text-warning" for="typeMorning">
                                        <i class="bi bi-sunrise me-1"></i>Morning Pickup
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="TripType" value="Evening" id="typeEvening" />
                                    <label class="form-check-label fw-semibold text-primary" for="typeEvening">
                                        <i class="bi bi-sunset me-1"></i>Evening Drop
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="TripType" value="SpecialEvent" id="typeSpecialEvent" />
                                    <label class="form-check-label fw-semibold text-danger" for="typeSpecialEvent">
                                        <i class="bi bi-star-fill me-1"></i>Special Event
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="TripType" value="ExamRoute" id="typeExamRoute" />
                                    <label class="form-check-label fw-semibold text-success" for="typeExamRoute">
                                        <i class="bi bi-journal-text me-1"></i>Exam Route
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Section 2: Bus, Driver & Route Selection -->
                <div class="mb-4 pt-3 border-top">
                    <h6 class="fw-bold text-primary text-uppercase fs-7 mb-3"><i class="bi bi-diagram-3 me-2"></i>Resource Assignment</h6>
                    <div class="row g-3">
                        <div class="col-md-12 col-12">
                            <label asp-for="BusId" class="form-label fw-bold">Select Bus <span class="text-danger">*</span></label>
                            <select asp-for="BusId" id="busSelect" class="form-select rounded-3"
                                    asp-items="@(ViewBag.Buses as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? [])" required>
                                <option value="">-- Select a Bus --</option>
                            </select>
                            <span asp-validation-for="BusId" class="text-danger small"></span>
                            <div id="busInfoPreview" class="mt-2 d-none">
                                <div class="p-2 bg-light rounded-3 small d-flex gap-3 border" id="busInfoBox"></div>
                            </div>
                        </div>

                        <div class="col-md-6 col-12">
                            <label asp-for="DriverId" class="form-label fw-bold">Assign Driver <span class="text-danger">*</span></label>
                            <select asp-for="DriverId" id="driverSelect" class="form-select rounded-3"
                                    asp-items="@(ViewBag.Drivers as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? [])" required>
                                <option value="">-- Select a Driver --</option>
                            </select>
                            <span asp-validation-for="DriverId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 col-12">
                            <label asp-for="RouteId" class="form-label fw-bold">Assign Route <span class="text-danger">*</span></label>
                            <select asp-for="RouteId" id="routeSelect" class="form-select rounded-3"
                                    asp-items="@(ViewBag.Routes as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? [])" required>
                                <option value="">-- Select a Route --</option>
                            </select>
                            <span asp-validation-for="RouteId" class="text-danger small"></span>
                        </div>

                        <div class="col-12" id="stopsPreview" style="display:none">
                            <label class="form-label fw-bold text-muted small"><i class="bi bi-geo-alt me-1"></i>Route Stops Preview</label>
                            <div id="stopsPreviewList" class="d-flex flex-wrap gap-2 p-3 bg-light rounded-4 border"></div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 border-top pt-4">
                    <a href="@Url.Action("Index")" class="btn btn-light rounded-3 px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary rounded-3 px-4 shadow-sm"><i class="bi bi-check-circle me-2"></i>Create Trip</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const areaPrefix = '@Url.Action("Index").Replace("/Index", "")';

        async function loadStopsForRoute(routeId) {
            const stopsBox = document.getElementById('stopsPreviewList');
            if (!routeId) {
                document.getElementById('stopsPreview').style.display = 'none';
                stopsBox.innerHTML = '';
                return;
            }
            try {
                const res = await fetch(`${areaPrefix}/StopsForRoute?routeId=${routeId}`);
                const stops = await res.json();
                stopsBox.innerHTML = '';
                if (stops && stops.length > 0) {
                    stops.forEach(s => {
                        stopsBox.innerHTML +=
                            `<span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-2">
                                <i class="bi bi-geo-alt me-1"></i>#${s.stopOrder} ${s.stopName}
                             </span>`;
                    });
                    document.getElementById('stopsPreview').style.display = 'block';
                } else {
                    document.getElementById('stopsPreview').style.display = 'none';
                }
            } catch (err) { console.error(err); }
        }

        document.getElementById('busSelect').addEventListener('change', async function() {
            const busId = this.value;
            const driverSelect = document.getElementById('driverSelect');
            const routeSelect = document.getElementById('routeSelect');

            driverSelect.innerHTML = '<option value="">-- Select a Driver --</option>';
            routeSelect.innerHTML = '<option value="">-- Select a Route --</option>';
            routeSelect.disabled = true;
            loadStopsForRoute(null);

            if (!busId) {
                document.getElementById('busInfoPreview').classList.add('d-none');
                return;
            }

            try {
                const driverRes = await fetch(`${areaPrefix}/GetDriversForBus?busId=${busId}`);
                const drivers = await driverRes.json();
                if (drivers && drivers.length > 0) {
                    drivers.forEach(d => {
                        const opt = document.createElement('option');
                        opt.value = d.userId;
                        opt.textContent = d.display;
                        driverSelect.appendChild(opt);
                    });
                    driverSelect.selectedIndex = 1;
                    driverSelect.dispatchEvent(new Event('change'));
                }
            } catch (err) { console.error(err); }

            const opt = this.options[this.selectedIndex];
            document.getElementById('busInfoBox').innerHTML =
                `<span><i class="bi bi-bus-front text-primary me-1"></i><strong>${opt.text}</strong></span>`;
            document.getElementById('busInfoPreview').classList.remove('d-none');
        });

        document.getElementById('driverSelect').addEventListener('change', async function() {
            const driverId = this.value;
            const busId = document.getElementById('busSelect').value;
            const routeSelect = document.getElementById('routeSelect');

            routeSelect.innerHTML = '<option value="">-- Select a Route --</option>';
            loadStopsForRoute(null);

            if (!busId || !driverId) {
                routeSelect.disabled = true;
                return;
            }

            routeSelect.disabled = false;

            try {
                const routeRes = await fetch(`${areaPrefix}/GetRoutesForBus?busId=${busId}`);
                const routes = await routeRes.json();
                if (routes && routes.length > 0) {
                    routes.forEach(r => {
                        const opt = document.createElement('option');
                        opt.value = r.routeId;
                        opt.textContent = `${r.routeName} (${r.routeCode})`;
                        routeSelect.appendChild(opt);
                    });
                    routeSelect.selectedIndex = 1;
                    loadStopsForRoute(routeSelect.value);
                }
            } catch (err) { console.error(err); }
        });

        document.getElementById('routeSelect').addEventListener('change', function() {
            loadStopsForRoute(this.value);
        });
    </script>
}
