@using BusTracking.Common.Helpers
@inject BusTracking.Common.Data.AppDbContext DbContext
@inject BusTracking.Common.Interfaces.ICurrentUserService CurrentUser
@inject BusTracking.Common.Interfaces.IAcademicYearService AcademicYearService
@{
    string? schoolName = null;
    string? schoolLogo = null;
    string? userPhoto = null;
    var sId = CurrentUser.SchoolId;
    var activeYears = sId.HasValue
        ? await AcademicYearService.GetAcademicYearsAsync(sId.Value, activeOnly: true)
        : new List<BusTracking.Common.DTOs.AcademicYear.AcademicYearDto>();
    var activeSession = activeYears.FirstOrDefault(y => y.IsCurrent) ?? activeYears.FirstOrDefault();
    string activeYearName = activeSession?.YearName ?? "No Active Session";
    if (sId.HasValue)
    {
        var school = DbContext.Schools.IgnoreQueryFilters().FirstOrDefault(s => s.SchoolId == sId.Value);
        if (school != null)
        {
            schoolName = school.SchoolName;
            schoolLogo = school.SchoolLogo;
        }
    }
    var uId = CurrentUser.UserId;
    if (uId.HasValue)
    {
        var dbUser = DbContext.Users.IgnoreQueryFilters().FirstOrDefault(u => u.UserId == uId.Value);
        if (dbUser != null)
        {
            userPhoto = dbUser.ProfileImageUrl;
        }
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1.0" />
    <title>@ViewData["Title"] – Super Admin | Bus Tracking</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex">

    <!-- ── Sidebar ──────────────────────────────────────────────────── -->
    <nav id="sidebar" class="sidebar d-flex flex-column">
        <div class="sidebar-brand">
            @if (!string.IsNullOrEmpty(schoolLogo))
            {
                <img src="@schoolLogo" alt="School Logo" class="me-2 rounded-circle" style="width: 32px; height: 32px; object-fit: cover;" />
            }
            else
            {
                <i class="bi bi-bus-front-fill me-2"></i>
            }

            @if (!string.IsNullOrEmpty(schoolName))
            {
                <span>@schoolName</span>
            }
            else
            {
                <span>BusTrack <small class="opacity-50 small">Admin</small></span>
            }
        </div>
        <ul class="sidebar-nav flex-grow-1">
            @{
                var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
                (string Lbl, string Icon, string C, string A)[] items =
                [
                    ("Dashboard",       "bi-speedometer2",   "Dashboard", "Index"),
                    ("App Config",      "bi-sliders",        "AppConfig", "Index"),
                    ("Academic Years",  "bi-calendar-event", "AcademicYear","Index"),
                    ("Classes/Standards","bi-bookmark-star", "Standard",  "Index"),
                    ("Bus Types",       "bi-truck-front",    "BusType",   "Index"),
                    ("Bus Coordinators","bi-person-badge",   "SubAdmin",  "Index"),
                    ("Teachers",        "bi-person-workspace","Teacher",  "Index"),
                    ("Routes",          "bi-map",            "Route",     "Index"),
                    ("Buses",           "bi-bus-front",      "Bus",       "Index"),
                    ("Drivers",         "bi-person-video2",  "Driver",    "Index"),
                    ("Parents",         "bi-people",         "Parent",    "Index"),
                    ("Students",        "bi-mortarboard",    "Student",   "Index"),
                    ("Fuel & Mileage",  "bi-fuel-pump-fill", "FuelLog",   "Index"),
                    ("Analytics & Reports", "bi-bar-chart-line-fill", "Report", "Index"),
                    ("Trips",           "bi-signpost-split", "Trip",      "Index"),
                    ("Broadcast Message","bi-megaphone-fill","Broadcast", "Index"),
                    ("Notifications",   "bi-bell",           "Notification","Index"),
                    ("Help & Support",  "bi-headset",        "Feedback",  "Index"),
                    ("System Logs",     "bi-journal-text",   "Logger",    "Index"),
            ];
            }
            @foreach (var (lbl, icon, c, a) in items)
            {
                <li class="sidebar-item @(ctrl == c ? "active" : "")">
                    <a class="sidebar-link" asp-area="SuperAdmin" asp-controller="@c" asp-action="@a">
                        <i class="bi @icon"></i><span>@lbl</span>
                    </a>
                </li>
            }
        </ul>

        <!-- User footer info -->
        <div class="sidebar-footer border-top p-3 d-flex flex-column gap-2">
            <a asp-controller="Profile" asp-action="Index" asp-area="" class="text-decoration-none d-flex align-items-center gap-2 small text-light text-truncate">
                @if (!string.IsNullOrEmpty(userPhoto))
                {
                    <img src="@userPhoto" alt="Profile" class="rounded-circle border border-secondary" style="width: 24px; height: 24px; object-fit: cover;" />
                }
                else
                {
                    <i class="bi bi-person-circle"></i>
                }
                <span>@User.GetFullName()</span>
            </a>
            <form asp-controller="Auth" asp-action="Logout" asp-area="" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="sidebar-link w-100 border-0 bg-transparent text-start text-danger">
                    <i class="bi bi-box-arrow-left"></i><span>Logout</span>
                </button>
            </form>
        </div>
    </nav>

    <!-- ── Main ──────────────────────────────────────────────────────── -->
    <div class="main-wrapper flex-grow-1 d-flex flex-column">
        <header class="top-navbar">
            <button class="sidebar-toggle btn btn-sm btn-link" id="sidebarToggle"><i class="bi bi-list fs-4"></i></button>
            <span class="badge bg-warning-subtle text-warning ms-1 small">Super Admin</span>
            <div class="ms-auto d-flex align-items-center gap-3">
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-primary dropdown-toggle d-flex align-items-center gap-1 rounded-pill px-3 py-1 fw-bold" data-bs-toggle="dropdown" aria-expanded="false" title="Switch Active Academic Session">
                        <i class="bi bi-calendar-event me-1"></i>
                        <span>Session: @activeYearName</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-4 p-2" style="min-width: 210px;">
                        <li><h6 class="dropdown-header text-uppercase fs-7 fw-bold text-muted px-2 py-1">Select Academic Session</h6></li>
                        @if (activeYears != null && activeYears.Any())
                        {
                            foreach (var year in activeYears)
                            {
                                <li>
                                    <form method="post" asp-area="SuperAdmin" asp-controller="AcademicYear" asp-action="SwitchSession" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@year.AcademicYearId" />
                                        <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                                        <button type="submit" class="dropdown-item rounded-3 d-flex align-items-center justify-content-between py-2 px-2 @(year.AcademicYearId == activeSession?.AcademicYearId ? "active fw-bold" : "")">
                                            <span>@year.YearName</span>
                                            @if (year.AcademicYearId == activeSession?.AcademicYearId)
                                            {
                                                <i class="bi bi-check-circle-fill text-success ms-2"></i>
                                            }
                                        </button>
                                    </form>
                                </li>
                            }
                        }
                        else
                        {
                            <li><span class="dropdown-item disabled text-muted small">No active sessions</span></li>
                        }
                        <li><hr class="dropdown-divider my-1"></li>
                        <li>
                            <a class="dropdown-item small text-primary rounded-3 px-2 py-1" asp-area="SuperAdmin" asp-controller="AcademicYear" asp-action="Index">
                                <i class="bi bi-gear me-1"></i> Manage Sessions
                            </a>
                        </li>
                    </ul>
                </div>
                <a asp-area="SuperAdmin" asp-controller="Notification" asp-action="Index" class="btn btn-sm btn-outline-secondary position-relative">
                    <i class="bi bi-bell"></i>
                </a>
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle d-flex align-items-center gap-1" data-bs-toggle="dropdown">
                        @if (!string.IsNullOrEmpty(userPhoto))
                        {
                            <img src="@userPhoto" alt="Profile" class="rounded-circle border border-secondary" style="width: 18px; height: 18px; object-fit: cover;" />
                        }
                        else
                        {
                            <i class="bi bi-person-circle"></i>
                        }
                        <span>@User.GetFullName()</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index" asp-area=""><i class="bi bi-person me-2"></i>Profile</a></li>
                        <li><a class="dropdown-item" asp-controller="Auth" asp-action="ChangePassword" asp-area=""><i class="bi bi-key me-2"></i>Change Password</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form asp-controller="Auth" asp-action="Logout" asp-area="" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-left me-2"></i>Logout</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <main class="content-area flex-grow-1 p-4">
            @{
                var alert = BusTracking.Web.Helpers.AlertHelper.FromTempData(TempData);
            }
            @if (alert is not null)
            {
                <div class="alert @alert.CssClass alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
                    <i class="bi @alert.Icon"></i><span>@alert.Message</span>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()
        </main>

        <footer class="py-2 px-4 border-top text-muted small text-end">
            &copy; @DateTime.Now.Year Bus Tracking System – Super Admin
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
