@model BusTracking.Common.DTOs.AppConfig.AppConfigDto
@{
    ViewData["Title"] = "Config Details - " + Model.ConfigKey;
}

<div class="container-fluid p-0">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="fw-bold m-0 text-dark">
                <i class="bi bi-gear text-primary me-2"></i>App Configuration Details
            </h2>
            <nav aria-label="breadcrumb" class="mt-1">
                <ol class="breadcrumb mb-0 small text-muted">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Dashboard")" class="text-decoration-none text-muted">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("Index")" class="text-decoration-none text-muted">App Config</a></li>
                    <li class="breadcrumb-item active text-primary" aria-current="page">Config Details</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Edit", new { id = Model.ConfigId })" class="btn btn-primary rounded-3 px-3 shadow-sm">
                <i class="bi bi-pencil-fill me-1"></i> Edit Config
            </a>
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary rounded-3 px-3">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8 col-12">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                        <div class="rounded-circle bg-primary-subtle text-primary p-3 d-flex align-items-center justify-content-center border border-primary-subtle" style="width:52px; height:52px;">
                            <i class="bi bi-key-fill fs-4"></i>
                        </div>
                        <div>
                            <h4 class="fw-bold text-dark font-monospace mb-1">@Model.ConfigKey</h4>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace px-3 py-1">@Model.Platform</span>
                                <span class="badge @(Model.IsActive ? "bg-success-subtle text-success border border-success-subtle" : "bg-danger-subtle text-danger border border-danger-subtle") rounded-pill px-3 py-1">
                                    <i class="bi bi-circle-fill me-1 fs-7"></i>@(Model.IsActive ? "Active" : "Inactive")
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <h6 class="fw-bold text-primary text-uppercase fs-7 mb-2"><i class="bi bi-code-slash me-2"></i>Configuration Value</h6>
                        <div class="p-3 bg-light-subtle rounded-3 font-monospace text-dark border border-light-subtle" style="word-break: break-all;">
                            @Model.ConfigValue
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <div class="mb-4">
                            <h6 class="fw-bold text-primary text-uppercase fs-7 mb-2"><i class="bi bi-text-paragraph me-2"></i>Description</h6>
                            <div class="text-secondary">@Model.Description</div>
                        </div>
                    }

                    <h6 class="fw-bold text-primary text-uppercase fs-7 mb-3 pt-3 border-top"><i class="bi bi-info-circle me-2"></i>Metadata & Audit Info</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6 col-12">
                            <small class="text-muted d-block">Config ID</small>
                            <span class="fw-bold font-monospace text-dark">#@Model.ConfigId</span>
                        </div>
                        <div class="col-md-6 col-12">
                            <small class="text-muted d-block">Created By</small>
                            <span class="fw-semibold text-dark">@(string.IsNullOrWhiteSpace(Model.CreatedByName) ? "System" : Model.CreatedByName)</span>
                        </div>
                        <div class="col-md-6 col-12">
                            <small class="text-muted d-block">Created At</small>
                            <span class="fw-semibold text-dark">@Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</span>
                        </div>
                        <div class="col-md-6 col-12">
                            <small class="text-muted d-block">Last Updated</small>
                            <span class="fw-semibold text-dark">@Model.UpdatedAt.ToString("dd MMM yyyy, hh:mm tt")</span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end border-top pt-3">
                        <form asp-action="Delete" asp-route-id="@Model.ConfigId" method="post"
                              onsubmit="return confirm('Delete \'@Model.ConfigKey\'? This action cannot be undone.')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger rounded-3 px-4">
                                <i class="bi bi-trash-fill me-1"></i> Delete Config
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
