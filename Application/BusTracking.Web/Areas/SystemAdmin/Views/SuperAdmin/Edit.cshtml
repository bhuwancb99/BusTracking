@model BusTracking.Common.Entities.User
@{
    ViewData["Title"] = "Edit Super Admin";
}

<div class="container-fluid p-4">
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-primary text-white p-4 d-flex align-items-center justify-content-between">
            <div>
                <h4 class="mb-1 fw-bold"><i class="bi bi-person-gear me-2"></i>Edit Super Admin</h4>
                <p class="mb-0 text-white-50 small">Update school administrator account details and password</p>
            </div>
            <a href="@Url.Action("Index", "SuperAdmin", new { area = "SystemAdmin" })" class="btn btn-outline-light rounded-pill px-4">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit" method="post" id="editAdminForm" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="UserId" />

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2 border-0 rounded-3 mb-4" style="background-color: rgba(239, 68, 68, 0.15); color: #ef4444;">
                        <div asp-validation-summary="All"></div>
                    </div>
                }

                <div class="row g-4 mb-4">
                    <div class="col-md-4 col-12">
                        <label asp-for="FullName" class="form-label fw-bold">Full Name <span class="text-danger">*</span></label>
                        <input asp-for="FullName" class="form-control form-control-lg rounded-3" required />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4 col-12">
                        <label asp-for="UserName" class="form-label fw-bold">Username <span class="text-danger">*</span></label>
                        <input asp-for="UserName" class="form-control form-control-lg rounded-3" id="UserNameInput" required autocomplete="off" />
                        <span asp-validation-for="UserName" class="text-danger small"></span>
                        <div id="usernameCheckMsg" class="small mt-1"></div>
                    </div>

                    <div class="col-md-4 col-12">
                        <label for="password" class="form-label fw-bold">Password (Optional)</label>
                        <input type="password" id="password" name="password" class="form-control form-control-lg rounded-3" placeholder="Leave blank to keep unchanged" />
                    </div>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-md-3 col-12">
                        <label asp-for="SchoolId" class="form-label fw-bold">Assign School <span class="text-danger">*</span></label>
                        <select asp-for="SchoolId" asp-items="ViewBag.Schools" class="form-select form-select-lg rounded-3" required>
                            <option value="">-- Select School --</option>
                        </select>
                        <span asp-validation-for="SchoolId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-3 col-12">
                        <label asp-for="Email" class="form-label fw-bold">Email Address</label>
                        <input asp-for="Email" type="email" class="form-control form-control-lg rounded-3" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-md-3 col-12">
                        <label asp-for="PhoneNumber" class="form-label fw-bold">Phone Number</label>
                        <input asp-for="PhoneNumber" class="form-control form-control-lg rounded-3" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="col-md-3 col-12">
                        <label class="form-label fw-bold">Account Status</label>
                        <div class="form-control form-control-lg rounded-3 d-flex align-items-center justify-content-between bg-body">
                            <span class="fw-semibold text-secondary fs-6">Active Status</span>
                            <div class="form-check form-switch mb-0">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="isActiveSwitch" style="width: 44px; height: 22px; cursor: pointer;" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-12">
                        <label for="profileImage" class="form-label fw-bold">Profile Image (Optional)</label>
                        <div class="premium-file-upload border border-dashed rounded-3 p-3 text-center position-relative bg-light-subtle" style="cursor: pointer; border-style: dashed !important; border-color: #3d5af1 !important; transition: background-color 0.2s;">
                            <input type="file" id="profileImage" name="profileImage" class="position-absolute top-0 start-0 w-100 h-100 opacity-0" style="cursor: pointer;" accept="image/*" onchange="previewFile(this, 'profilePreview', 'profileFileName')" />
                            <div class="upload-content">
                                <i class="bi bi-cloud-arrow-up-fill text-primary fs-3 d-block mb-1"></i>
                                <span class="fw-semibold text-secondary d-block" id="profileFileName">Choose new profile image...</span>
                                <span class="text-muted small">PNG, JPG or WebP (max. 5MB)</span>
                            </div>
                            <div id="profilePreview" class="mt-2 @(string.IsNullOrEmpty(Model.ProfileImageUrl) ? "d-none" : "")">
                                <img src="@Model.ProfileImageUrl" class="rounded-circle border border-secondary" style="height: 50px; width: 50px; object-fit: cover;" />
                                @if (!string.IsNullOrEmpty(Model.ProfileImageUrl))
                                {
                                    <div class="text-secondary small mt-1">Current Active Photo</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 border-top pt-4 mt-2">
                    <a href="@Url.Action("Index", "SuperAdmin", new { area = "SystemAdmin" })" class="btn btn-light rounded-pill px-4">Cancel</a>
                    <button type="submit" id="submitBtn" class="btn btn-primary rounded-pill px-4 shadow-sm"><i class="bi bi-save me-2"></i>Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            var timeout = null;
            $('#UserNameInput').on('keyup input', function() {
                var val = $(this).val().trim();
                var currentUserId = '@Model.UserId';
                clearTimeout(timeout);

                if (val.length === 0) {
                    $('#usernameCheckMsg').text('');
                    $('#submitBtn').prop('disabled', false);
                    return;
                }

                timeout = setTimeout(function() {
                    $.ajax({
                        url: '@Url.Action("CheckUsername", "SuperAdmin", new { area = "SystemAdmin" })',
                        type: 'GET',
                        data: { userName: val, excludeUserId: currentUserId },
                        success: function(res) {
                            if (res.success) {
                                $('#usernameCheckMsg').html('<i class="bi bi-check-circle-fill me-1"></i>Username is available').removeClass('text-danger').addClass('text-success');
                                $('#submitBtn').prop('disabled', false);
                            } else {
                                $('#usernameCheckMsg').html('<i class="bi bi-x-circle-fill me-1"></i>' + res.message).removeClass('text-success').addClass('text-danger');
                                $('#submitBtn').prop('disabled', true);
                            }
                        }
                    });
                }, 400);
            });
        });
        function previewFile(input, previewId, nameId) {
            const file = input.files[0];
            const previewDiv = document.getElementById(previewId);
            const nameSpan = document.getElementById(nameId);
            if (file) {
                nameSpan.textContent = file.name;
                const reader = new FileReader();
                reader.onload = function(e) {
                    previewDiv.querySelector('img').src = e.target.result;
                    previewDiv.classList.remove('d-none');
                    const helper = previewDiv.querySelector('.text-secondary');
                    if (helper) helper.textContent = "New Selected Photo";
                };
                reader.readAsDataURL(file);
            } else {
                nameSpan.textContent = "Choose profile image...";
                previewDiv.classList.add('d-none');
            }
        }
    </script>
}
