@model BusTracking.Common.Entities.RegionMaster
@{
    ViewData["Title"] = "Edit Region";
}

<div class="container-fluid p-4">
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-primary text-white p-4 d-flex align-items-center justify-content-between">
            <div>
                <h4 class="mb-1 fw-bold"><i class="bi bi-pencil-square me-2"></i>Edit Region / State</h4>
                <p class="mb-0 text-white-50 small">Update state or province details and active status</p>
            </div>
            <a asp-action="Index" asp-route-countryId="@Model.CountryId" class="btn btn-outline-light rounded-pill px-4">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="RegionId" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>

                <div class="row g-4 mb-4">
                    <div class="col-md-3 col-12">
                        <label asp-for="CountryId" class="form-label fw-bold">Country <span class="text-danger">*</span></label>
                        <select asp-for="CountryId" class="form-select form-select-lg rounded-3" asp-items="ViewBag.Countries" required>
                            <option value="">-- Select Country --</option>
                        </select>
                        <span asp-validation-for="CountryId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-3 col-12">
                        <label asp-for="RegionName" class="form-label fw-bold">Region / State Name <span class="text-danger">*</span></label>
                        <input asp-for="RegionName" class="form-control form-control-lg rounded-3" required />
                        <span asp-validation-for="RegionName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-3 col-12">
                        <label asp-for="RegionCode" class="form-label fw-bold">Region Code</label>
                        <input asp-for="RegionCode" class="form-control form-control-lg rounded-3 text-uppercase" maxlength="20" />
                        <span asp-validation-for="RegionCode" class="text-danger small"></span>
                    </div>

                    <div class="col-md-3 col-12">
                        <label class="form-label fw-bold">Status</label>
                        <div class="form-control form-control-lg rounded-3 d-flex align-items-center justify-content-between bg-body">
                            <span class="fw-semibold text-secondary fs-6">Active Status</span>
                            <div class="form-check form-switch mb-0">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="isActiveSwitch" style="width: 44px; height: 22px; cursor: pointer;" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex align-items-center justify-content-end gap-2 border-top pt-4 mt-2">
                    <a asp-action="Index" asp-route-countryId="@Model.CountryId" class="btn btn-light rounded-pill px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm"><i class="bi bi-save me-2"></i>Update Region</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
