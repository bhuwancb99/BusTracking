@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Region Masters";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;
    string search = ViewBag.Search ?? "";
    int? selectedCountryId = ViewBag.SelectedCountryId;
}

<div class="container-fluid p-4">
    <!-- Header Card -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-map text-primary me-2"></i>Region Masters</h2>
            <p class="text-muted mb-0">Manage states, provinces, and regional territories mapped to countries</p>
        </div>
        <div>
            <a asp-action="Create" asp-route-countryId="@selectedCountryId" class="btn btn-primary rounded-pill px-4 shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Add Region
            </a>
        </div>
    </div>

    <!-- Main Data Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white p-3 border-bottom">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-md-4 col-12">
                    <select name="countryId" class="form-select bg-light" asp-items="ViewBag.Countries" onchange="this.form.submit()">
                        <option value="">-- Filter by Country (All) --</option>
                    </select>
                </div>
                <div class="col-md-5 col-12">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="search" value="@search" class="form-control bg-light border-start-0 ps-0" placeholder="Search region name or code..." />
                    </div>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-secondary rounded-3">Search</button>
                    @if (!string.IsNullOrEmpty(search) || selectedCountryId.HasValue)
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-3 ms-1">Reset</a>
                    }
                </div>
                <div class="col text-end text-muted small d-none d-md-block">
                    Total Regions: <span class="fw-bold text-dark">@totalItems</span>
                </div>
            </form>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-secondary text-uppercase fs-7 fw-semibold">
                        <tr>
                            <th class="ps-4">Region / State Name</th>
                            <th>Country</th>
                            <th>Region Code</th>
                            <th class="text-center">Status</th>
                            <th class="pe-4 text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold text-dark">
                                        <i class="bi bi-geo-alt-fill me-2 text-danger opacity-75"></i>@item.RegionName
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            <i class="bi bi-flag me-1 text-primary"></i>@item.CountryName
                                        </span>
                                    </td>
                                    <td><code class="text-primary fw-bold">@(item.RegionCode ?? "-")</code></td>
                                    <td class="text-center">
                                        <div class="form-check form-switch d-inline-block">
                                            <input class="form-check-input toggle-active-btn" type="checkbox" role="switch" data-id="@item.RegionId" @(item.IsActive ? "checked" : "") />
                                        </div>
                                    </td>
                                    <td class="pe-4 text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Edit" asp-route-id="@item.RegionId" class="btn btn-outline-primary rounded-start-3" title="Edit">
                                                <i class="bi bi-pencil-square"></i> Edit
                                            </a>
                                            <button type="button" class="btn btn-outline-danger rounded-end-3" onclick="confirmDelete(@item.RegionId, '@item.RegionName')" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="bi bi-map display-6 d-block mb-2 opacity-50"></i>
                                    No regions found matching your criteria.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (totalPages > 1)
        {
            <div class="card-footer bg-white p-3 border-top">
                <partial name="_Pagination" />
            </div>
        }
    </div>
</div>

<!-- Delete Form Modal / Handler -->
<form id="deleteForm" method="post" asp-action="Delete">
    @Html.AntiForgeryToken()
    <input type="hidden" id="deleteRegionId" name="id" />
</form>

@section Scripts {
    <script>
        function confirmDelete(id, name) {
            if (confirm("Are you sure you want to delete region '" + name + "'?")) {
                document.getElementById("deleteRegionId").value = id;
                document.getElementById("deleteForm").submit();
            }
        }

        document.querySelectorAll('.toggle-active-btn').forEach(btn => {
            btn.addEventListener('change', function () {
                const regionId = this.getAttribute('data-id');
                fetch('@Url.Action("ToggleActive")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: 'id=' + regionId
                })
                .then(res => res.json())
                .then(data => {
                    if (!data.success) {
                        this.checked = !this.checked;
                        alert('Failed to update status.');
                    }
                })
                .catch(() => {
                    this.checked = !this.checked;
                    alert('Error connecting to server.');
                });
            });
        });
    </script>
}
