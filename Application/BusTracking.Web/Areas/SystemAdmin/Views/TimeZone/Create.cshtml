@model BusTracking.Common.Entities.TimeZoneMaster
@{
    ViewData["Title"] = "Add New Time Zone";
}

<div class="container-fluid p-4">
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-primary text-white p-4 d-flex align-items-center justify-content-between">
            <div>
                <h4 class="mb-1 fw-bold"><i class="bi bi-clock-history me-2"></i>Add New Time Zone</h4>
                <p class="mb-0 text-white-50 small">Create a global time zone record with IANA and Windows IDs</p>
            </div>
            <a href="@Url.Action("Index", "TimeZone", new { area = "SystemAdmin" })" class="btn btn-outline-light rounded-pill px-4">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        </div>
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2 border-0 rounded-3 mb-4" style="background-color: rgba(239, 68, 68, 0.15); color: #ef4444;">
                        <div asp-validation-summary="All"></div>
                    </div>
                }

                <div class="row g-4 mb-4">
                    <div class="col-md-8 col-12">
                        <label asp-for="TimeZoneName" class="form-label fw-bold">Time Zone Display Name</label>
                        <input asp-for="TimeZoneName" class="form-control form-control-lg rounded-3" placeholder="e.g. (UTC+05:30) India Standard Time - New Delhi" required />
                        <span asp-validation-for="TimeZoneName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4 col-12">
                        <label asp-for="UtcOffset" class="form-label fw-bold">UTC Offset</label>
                        <input asp-for="UtcOffset" class="form-control form-control-lg rounded-3" placeholder="e.g. +05:30" required />
                        <span asp-validation-for="UtcOffset" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-md-4 col-12">
                        <label asp-for="IanaTimeZoneId" class="form-label fw-bold">IANA TimeZone ID</label>
                        <input asp-for="IanaTimeZoneId" class="form-control form-control-lg rounded-3" placeholder="e.g. Asia/Kolkata" required />
                        <span asp-validation-for="IanaTimeZoneId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4 col-12">
                        <label asp-for="WindowsTimeZoneId" class="form-label fw-bold">Windows TimeZone ID</label>
                        <input asp-for="WindowsTimeZoneId" class="form-control form-control-lg rounded-3" placeholder="e.g. India Standard Time" required />
                        <span asp-validation-for="WindowsTimeZoneId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-2 col-6">
                        <label asp-for="DisplayOrder" class="form-label fw-bold">Display Order</label>
                        <input asp-for="DisplayOrder" type="number" class="form-control form-control-lg rounded-3" required />
                        <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
                    </div>

                    <div class="col-md-2 col-6 d-flex align-items-end">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" asp-for="IsActive" id="IsActiveSwitch" style="cursor: pointer; width: 45px; height: 22px;">
                            <label class="form-check-label ms-2 fw-semibold fs-6" for="IsActiveSwitch">Active</label>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 border-top pt-4 mt-2">
                    <a href="@Url.Action("Index", "TimeZone", new { area = "SystemAdmin" })" class="btn btn-light rounded-pill px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm"><i class="bi bi-check-circle me-2"></i>Create Time Zone</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
