@model List<BusTracking.Common.DTOs.GlobalConfig.GlobalConfigDto>
@{
    ViewData["Title"] = "Global Configurations";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h2 class="fw-bold m-0"><i class="bi bi-gear-wide-connected text-primary me-2"></i>Global Configurations</h2>
    <a href="@Url.Action("Create", "GlobalConfig", new { area = "SystemAdmin" })" class="btn btn-primary rounded-3">
        <i class="bi bi-plus-circle me-2"></i>Add Configuration
    </a>
</div>


<div class="premium-card rounded-4 border-0 p-4 mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-5">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by Key or Description..." />
        </div>
        <div class="col-md-3">
            <select name="isActive" class="form-select">
                <option value="">-- All Statuses --</option>
                <option value="true" selected="@(ViewBag.IsActive == true ? "selected" : null)">Active</option>
                <option value="false" selected="@(ViewBag.IsActive == false ? "selected" : null)">Inactive</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100 rounded-3"><i class="bi bi-search me-2"></i>Search</button>
        </div>
        <div class="col-md-2">
            <a href="@Url.Action("Index", "GlobalConfig", new { area = "SystemAdmin" })" class="btn btn-secondary w-100 rounded-3"><i class="bi bi-x-circle me-2"></i>Clear</a>
        </div>
    </form>
</div>

<div class="premium-card rounded-4 border-0 p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="premium-table m-0">
            <thead>
                <tr>
                    <th style="width: 60px;">#</th>
                    <th>Configuration Key</th>
                    <th>Configuration Value</th>
                    <th>Description</th>
                    <th style="width: 120px; text-align: center;">Status</th>
                    <th style="width: 130px; text-align: center;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-secondary py-5">
                            <i class="bi bi-gear text-muted" style="font-size: 2.5rem;"></i>
                            <p class="mt-2">No global configurations found.</p>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold text-secondary">@item.GlobalConfigId</td>
                            <td class="fw-bold text-dark">
                                <code class="text-primary bg-light px-2 py-1 rounded fs-6">@item.GlobalConfigKey</code>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border px-2 py-1">@item.GlobalConfigValue</span>
                            </td>
                            <td class="text-secondary small">@(item.Description ?? "-")</td>
                            <td class="text-center">
                                <form action="@Url.Action("Toggle", "GlobalConfig", new { area = "SystemAdmin", id = item.GlobalConfigId })" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-success" : "btn-outline-secondary") rounded-pill px-3 py-1">
                                        @(item.IsActive ? "Active" : "Inactive")
                                    </button>
                                </form>
                            </td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-1">
                                    <a href="@Url.Action("Edit", "GlobalConfig", new { area = "SystemAdmin", id = item.GlobalConfigId })" class="btn btn-outline-primary btn-sm rounded-3">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pagination" />
