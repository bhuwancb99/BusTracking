@model BusTracking.Common.DTOs.GlobalConfig.CreateGlobalConfigDto
@{
    ViewData["Title"] = "Create Global Configuration";
}

<div class="container-fluid p-4">
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-primary text-white p-4 d-flex align-items-center justify-content-between">
            <div>
                <h4 class="mb-1 fw-bold"><i class="bi bi-plus-circle me-2"></i>Create Global Configuration</h4>
                <p class="mb-0 text-white-50 small">Add a system-wide configuration key and value</p>
            </div>
            <a href="@Url.Action("Index", "GlobalConfig", new { area = "SystemAdmin" })" class="btn btn-outline-light rounded-pill px-4">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        </div>
        <div class="card-body p-4">
            <form action="@Url.Action("Create", "GlobalConfig", new { area = "SystemAdmin" })" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-3"></div>

                <div class="row g-4 mb-4">
                    <div class="col-md-4 col-12">
                        <label asp-for="GlobalConfigKey" class="form-label fw-bold">Configuration Key <span class="text-danger">*</span></label>
                        <input asp-for="GlobalConfigKey" class="form-control form-control-lg rounded-3" placeholder="e.g. MinSupportedAppVersion" required />
                        <span asp-validation-for="GlobalConfigKey" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4 col-12">
                        <label asp-for="Description" class="form-label fw-bold">Description</label>
                        <input asp-for="Description" class="form-control form-control-lg rounded-3" placeholder="Describe the purpose of this configuration..." />
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4 col-12">
                        <label class="form-label fw-bold">Status</label>
                        <div class="form-control form-control-lg rounded-3 d-flex align-items-center justify-content-between bg-body">
                            <span class="fw-semibold text-secondary fs-6">Active Status</span>
                            <div class="form-check form-switch mb-0">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="isActiveSwitch" style="width: 44px; height: 22px; cursor: pointer;" checked />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="GlobalConfigValue" class="form-label fw-bold">Configuration Value <span class="text-danger">*</span></label>
                    <textarea asp-for="GlobalConfigValue" class="form-control rounded-3" rows="3" placeholder="Enter configuration value..."></textarea>
                    <span asp-validation-for="GlobalConfigValue" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 border-top pt-4 mt-2">
                    <a href="@Url.Action("Index", "GlobalConfig", new { area = "SystemAdmin" })" class="btn btn-light rounded-pill px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm"><i class="bi bi-check-circle me-2"></i>Save Configuration</button>
                </div>
            </form>
        </div>
    </div>
</div>
