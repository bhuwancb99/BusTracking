@model List<BusTracking.Common.Entities.School>
@{
    ViewData["Title"] = "Schools Management";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h2 class="fw-bold m-0"><i class="bi bi-building text-primary me-2"></i>Schools Management</h2>
    <a href="@Url.Action("Create", "School", new { area = "SystemAdmin" })" class="btn btn-primary rounded-3">
        <i class="bi bi-plus-circle me-2"></i>Add School
    </a>
</div>

<div class="premium-card rounded-4 border-0 p-4 mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-6">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by name, code, principal, or city..." />
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary w-100 rounded-3"><i class="bi bi-search me-2"></i>Search</button>
        </div>
        <div class="col-md-3">
            <a href="@Url.Action("Index", "School", new { area = "SystemAdmin" })" class="btn btn-secondary w-100 rounded-3"><i class="bi bi-x-circle me-2"></i>Clear</a>
        </div>
    </form>
</div>

<div class="premium-card rounded-4 border-0 p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="premium-table m-0">
            <thead>
                <tr>
                    <th style="width: 80px;">Logo</th>
                    <th>School Code</th>
                    <th>School Name</th>
                    <th>Location</th>
                    <th>Principal</th>
                    <th>Contact</th>
                    <th>Time Zone</th>
                    <th style="width: 120px; text-align: center;">Active</th>
                    <th style="width: 100px; text-align: center;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="9" class="text-center text-secondary py-5">
                            <i class="bi bi-inbox text-muted" style="font-size: 2.5rem;"></i>
                            <p class="mt-2">No schools found.</p>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var school in Model)
                    {
                        var locationParts = new List<string>();
                        if (!string.IsNullOrWhiteSpace(school.City)) locationParts.Add(school.City);
                        if (school.Region != null) locationParts.Add(school.Region.RegionName);
                        if (school.Country != null) locationParts.Add(school.Country.CountryName);
                        string locationDisplay = locationParts.Count > 0 ? string.Join(", ", locationParts) : "-";

                        <tr>
                            <td class="text-center">
                                @if (!string.IsNullOrEmpty(school.SchoolLogo))
                                {
                                    <img src="@school.SchoolLogo" alt="Logo" class="rounded-circle border border-secondary shadow-sm" style="width: 45px; height: 45px; object-fit: cover;" onerror="this.onerror=null;this.src='/images/default-avatar.svg';" />
                                }
                                else
                                {
                                    <img src="/images/default-avatar.svg" alt="Logo" class="rounded-circle border border-secondary shadow-sm" style="width: 45px; height: 45px; object-fit: cover;" />
                                }
                            </td>
                            <td class="fw-semibold text-primary">@school.SchoolCode</td>
                            <td class="fw-semibold">@school.SchoolName</td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-geo-alt me-1 text-danger"></i>@locationDisplay
                                </span>
                            </td>
                            <td>@school.PrincipalName</td>
                            <td>@school.ContactNumber</td>
                            <td>
                                <span class="badge bg-secondary text-light">
                                    <i class="bi bi-clock me-1"></i>@(school.TimeZone?.TimeZoneName ?? school.TimeZoneInfoId ?? "India Standard Time")
                                </span>
                            </td>
                            <td class="text-center">
                                <label class="switch">
                                    <input type="checkbox" class="school-toggle" data-id="@school.SchoolId" @(school.IsActive ? "checked" : "") />
                                    <span class="slider"></span>
                                </label>
                            </td>
                            <td class="text-center">
                                <a href="@Url.Action("Edit", "School", new { area = "SystemAdmin", id = school.SchoolId })" class="btn btn-outline-primary btn-sm rounded-3">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Pagination -->
<partial name="_Pagination" />

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.school-toggle').change(function() {
                var schoolId = $(this).data('id');
                var isChecked = $(this).is(':checked');
                var $checkbox = $(this);

                $.ajax({
                    url: '@Url.Action("ToggleActive", "School", new { area = "SystemAdmin" })',
                    type: 'POST',
                    data: { id: schoolId },
                    success: function(response) {
                        if (!response.success) {
                            $checkbox.prop('checked', !isChecked);
                            alert('Failed to update school status.');
                        }
                    },
                    error: function() {
                        $checkbox.prop('checked', !isChecked);
                        alert('An error occurred while updating status.');
                    }
                });
            });
        });
    </script>
}
