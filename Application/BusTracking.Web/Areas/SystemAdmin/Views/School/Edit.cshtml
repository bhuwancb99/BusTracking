@model BusTracking.Common.Entities.School
@{
    ViewData["Title"] = "Edit School";
}

<div class="container-fluid p-4">
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-primary text-white p-4 d-flex align-items-center justify-content-between">
            <div>
                <h4 class="mb-1 fw-bold"><i class="bi bi-building-gear me-2"></i>Edit School</h4>
                <p class="mb-0 text-white-50 small">Update school configuration, contact information, and time zone</p>
            </div>
            <div class="d-flex align-items-center gap-2">
                @if (Model.SchoolId != 1)
                {
                    <form asp-area="SystemAdmin" asp-controller="School" asp-action="ImportAppConfigs" asp-route-id="@Model.SchoolId" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-light rounded-pill px-3 fw-semibold" onclick="return confirm('Import missing AppConfigurations from School #1 template for this school?');">
                            <i class="bi bi-download me-1"></i> Import App Configs
                        </button>
                    </form>
                }
                <a href="@Url.Action("Index", "School", new { area = "SystemAdmin" })" class="btn btn-outline-light rounded-pill px-4">
                    <i class="bi bi-arrow-left me-1"></i> Back to List
                </a>
            </div>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="SchoolId" />

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2 border-0 rounded-3 mb-4" style="background-color: rgba(239, 68, 68, 0.15); color: #ef4444;">
                        <div asp-validation-summary="All"></div>
                    </div>
                }

                <div class="row g-4 mb-4">
                    <div class="col-md-4 col-12">
                        <label asp-for="SchoolName" class="form-label fw-bold">School Name <span class="text-danger">*</span></label>
                        <input asp-for="SchoolName" class="form-control form-control-lg rounded-3" required />
                        <span asp-validation-for="SchoolName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4 col-12">
                        <label asp-for="SchoolCode" class="form-label fw-bold">School Code <span class="text-danger">*</span></label>
                        <input asp-for="SchoolCode" class="form-control form-control-lg rounded-3" required />
                        <span asp-validation-for="SchoolCode" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4 col-12">
                        <label asp-for="PrincipalName" class="form-label fw-bold">Principal Name <span class="text-danger">*</span></label>
                        <input asp-for="PrincipalName" class="form-control form-control-lg rounded-3" required />
                        <span asp-validation-for="PrincipalName" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-md-4 col-12">
                        <label asp-for="ContactNumber" class="form-label fw-bold">Contact Number <span class="text-danger">*</span></label>
                        <input asp-for="ContactNumber" class="form-control form-control-lg rounded-3" required />
                        <span asp-validation-for="ContactNumber" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4 col-12">
                        <label asp-for="EmailAddress" class="form-label fw-bold">Email Address <span class="text-danger">*</span></label>
                        <input asp-for="EmailAddress" type="email" class="form-control form-control-lg rounded-3" required />
                        <span asp-validation-for="EmailAddress" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4 col-12">
                        <label asp-for="Website" class="form-label fw-bold">Website</label>
                        <input asp-for="Website" type="url" class="form-control form-control-lg rounded-3" placeholder="https://example.com" />
                        <span asp-validation-for="Website" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-md-4 col-12">
                        <label asp-for="TimeZoneId" class="form-label fw-bold">School Time Zone</label>
                        <select asp-for="TimeZoneId" asp-items="(List<SelectListItem>)ViewBag.TimeZones" class="form-select form-select-lg rounded-3">
                            <option value="">-- Select Time Zone --</option>
                        </select>
                        <span asp-validation-for="TimeZoneId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 col-12">
                        <label for="logoFile" class="form-label fw-bold">School Logo</label>
                        <div class="premium-file-upload border border-dashed rounded-3 p-3 text-center position-relative bg-light-subtle" style="cursor: pointer; border-style: dashed !important; border-color: #3d5af1 !important; transition: background-color 0.2s;">
                            <input type="file" id="logoFile" name="logoFile" class="position-absolute top-0 start-0 w-100 h-100 opacity-0" style="cursor: pointer;" accept="image/*" onchange="previewFile(this, 'logoPreview', 'logoFileName')" />
                            <div class="upload-content d-flex align-items-center justify-content-center gap-3">
                                <i class="bi bi-cloud-arrow-up-fill text-primary fs-3"></i>
                                <span class="fw-semibold text-secondary" id="logoFileName">Choose new logo image...</span>
                            </div>
                            <div id="logoPreview" class="mt-2 @(string.IsNullOrEmpty(Model.SchoolLogo) ? "d-none" : "")">
                                <img src="@Model.SchoolLogo" class="rounded-circle border border-secondary shadow-sm" style="width: 50px; height: 50px; object-fit: cover;" onerror="this.onerror=null;this.src='/images/default-avatar.svg';" />
                                @if (!string.IsNullOrEmpty(Model.SchoolLogo))
                                {
                                    <div class="text-secondary small mt-1">Current Active Logo</div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="col-md-2 col-12 d-flex align-items-end">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" asp-for="IsActive" id="IsActiveSwitch" style="cursor: pointer; width: 45px; height: 22px;">
                            <label class="form-check-label ms-2 fw-semibold fs-6" for="IsActiveSwitch">Active</label>
                        </div>
                    </div>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-12">
                        <label asp-for="SchoolAddress" class="form-label fw-bold">School Address <span class="text-danger">*</span></label>
                        <textarea asp-for="SchoolAddress" class="form-control rounded-3" rows="3" required></textarea>
                        <span asp-validation-for="SchoolAddress" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 border-top pt-4 mt-2">
                    <a href="@Url.Action("Index", "School", new { area = "SystemAdmin" })" class="btn btn-light rounded-pill px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm"><i class="bi bi-save me-2"></i>Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewFile(input, previewId, nameId) {
            const file = input.files[0];
            const previewDiv = document.getElementById(previewId);
            const nameSpan = document.getElementById(nameId);
            if (file) {
                nameSpan.textContent = file.name;
                const reader = new FileReader();
                reader.onload = function(e) {
                    previewDiv.querySelector('img').src = e.target.result;
                    previewDiv.classList.remove('d-none');
                    const helper = previewDiv.querySelector('.text-secondary');
                    if (helper) helper.textContent = "New Selected Logo";
                };
                reader.readAsDataURL(file);
            } else {
                nameSpan.textContent = "Choose logo image...";
                previewDiv.classList.add('d-none');
            }
        }
    </script>
}
