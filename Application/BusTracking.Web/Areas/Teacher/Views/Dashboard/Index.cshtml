@{
    ViewData["Title"] = "Teacher Dashboard";
    var teacher = ViewBag.Teacher as BusTracking.Common.DTOs.Teacher.TeacherDto;
    int unreadNotifications = ViewBag.UnreadNotifications ?? 0;
}

<div class="container-fluid p-0">
    <div class="row g-4 mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-white" style="background: linear-gradient(135deg, #3d5af1 0%, #2241d7 100%);">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <img src="@(string.IsNullOrWhiteSpace(teacher?.ProfileImageUrl) ? "/images/default-avatar.svg" : teacher.ProfileImageUrl)" class="rounded-circle border border-2 border-white shadow-sm" style="width: 65px; height: 65px; object-fit: cover;" onerror="this.onerror=null;this.src='/images/default-avatar.svg';" />
                        <div>
                            <h3 class="fw-bold mb-1">Welcome back, @(teacher?.FullName ?? User.Identity?.Name)!</h3>
                            <p class="mb-0 text-white-50">@(string.IsNullOrWhiteSpace(teacher?.Designation) ? "Teacher" : teacher?.Designation) • @(string.IsNullOrWhiteSpace(teacher?.Department) ? "General" : teacher?.Department) Department</p>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <a href="@Url.Action("Index", "Notification", new { area = "Teacher" })" class="btn btn-light rounded-3 px-4 fw-semibold position-relative">
                            <i class="bi bi-bell me-2"></i>Notifications
                            @if (unreadNotifications > 0)
                            {
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                    @unreadNotifications
                                </span>
                            }
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-4 col-12">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h6 class="fw-bold text-primary text-uppercase fs-7 m-0"><i class="bi bi-person-badge me-2"></i>Profile Information</h6>
                    <i class="bi bi-person-workspace text-primary fs-4"></i>
                </div>
                <div class="mb-3"><small class="text-muted d-block">Employee Code</small><span class="fw-bold text-dark font-monospace">@(string.IsNullOrWhiteSpace(teacher?.EmployeeCode) ? "N/A" : teacher?.EmployeeCode)</span></div>
                <div class="mb-3"><small class="text-muted d-block">Qualification</small><span class="fw-semibold text-dark">@(string.IsNullOrWhiteSpace(teacher?.Qualification) ? "N/A" : teacher?.Qualification)</span></div>
                <div><small class="text-muted d-block">Contact Phone</small><span class="fw-semibold text-dark">@(string.IsNullOrWhiteSpace(teacher?.PhoneNumber) ? "N/A" : teacher?.PhoneNumber)</span></div>
            </div>
        </div>

        <div class="col-md-4 col-12">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h6 class="fw-bold text-primary text-uppercase fs-7 m-0"><i class="bi bi-easel me-2"></i>Classroom Workspace</h6>
                    <i class="bi bi-check-circle-fill text-success fs-4"></i>
                </div>
                <p class="text-secondary small mb-3">Welcome to your teacher dashboard workspace. Access system notices and profile controls.</p>
                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill fw-semibold d-inline-block">Account Active</span>
            </div>
        </div>

        <div class="col-md-4 col-12">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h6 class="fw-bold text-primary text-uppercase fs-7 m-0"><i class="bi bi-bell-fill me-2"></i>System Notices</h6>
                    <i class="bi bi-bell-fill text-warning fs-4"></i>
                </div>
                <h2 class="fw-bold text-dark mb-1">@unreadNotifications <span class="fs-6 text-muted fw-normal">Unread</span></h2>
                <p class="text-secondary small mb-0">Stay informed with real-time broadcast and school notices.</p>
            </div>
        </div>
    </div>
</div>
