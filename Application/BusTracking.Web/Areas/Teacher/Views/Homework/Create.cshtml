@model BusTracking.Common.DTOs.Homework.CreateHomeworkDto
@{
    ViewData["Title"] = "Create Homework Assignment";
    var years = ViewBag.AcademicYears as List<BusTracking.Common.DTOs.AcademicYear.AcademicYearDto> ?? new();
    var standards = ViewBag.Standards as List<BusTracking.Common.DTOs.Standard.StandardDto> ?? new();
    var subjects = ViewBag.Subjects as List<BusTracking.Common.DTOs.Subject.SubjectDto> ?? new();
    int activeYearId = ViewBag.ActiveYearId ?? 0;
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold m-0 text-dark">
            <i class="bi bi-plus-circle text-primary me-2"></i>Create New Homework Assignment
        </h3>
        <span class="small text-muted">Assign homework to a class and section with instant FCM push notification broadcast.</span>
    </div>
    <div>
        <a href="@Url.Action("Index", "Homework", new { area = "Teacher" })" class="btn btn-outline-secondary rounded-3 px-3 fw-bold">
            <i class="bi bi-arrow-left me-1"></i>Back to List
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 max-w-700">
    <div class="card-body p-4">
        <form method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="row g-3">
                <div class="col-md-6">
                    <div class="outlined-field">
                        <label>Academic Session</label>
                        <select name="AcademicYearId" class="form-select" required>
                            @foreach (var y in years)
                            {
                                <option value="@y.AcademicYearId" selected="@(y.AcademicYearId == activeYearId ? "selected" : null)">@y.YearName @(y.IsCurrent ? "(Active)" : "")</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="outlined-field">
                        <label>Subject</label>
                        <select name="SubjectId" class="form-select">
                            <option value="">-- General / Optional --</option>
                            @foreach (var sub in subjects)
                            {
                                <option value="@sub.SubjectId">@sub.SubjectName</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="outlined-field">
                        <label>Class / Standard</label>
                        <select id="standardSelect" name="StandardId" class="form-select" required onchange="loadSections()">
                            <option value="">-- Select Class --</option>
                            @foreach (var s in standards)
                            {
                                <option value="@s.StandardId">@s.StandardName</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="outlined-field">
                        <label>Section</label>
                        <select id="sectionSelect" name="SectionId" class="form-select">
                            <option value="">-- All Sections --</option>
                        </select>
                    </div>
                </div>

                <div class="col-12">
                    <div class="outlined-field">
                        <label>Homework Title</label>
                        <input type="text" name="Title" class="form-control" placeholder="e.g. Chapter 4 Mathematics Exercise 4.2" required />
                    </div>
                </div>

                <div class="col-12">
                    <div class="outlined-field">
                        <label>Instructions & Description</label>
                        <textarea name="Description" class="form-control" rows="4" placeholder="Enter detailed homework instructions..." required></textarea>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="outlined-field">
                        <label>Submission Due Date</label>
                        <input type="date" name="DueDate" value="@Model.DueDate.ToString("yyyy-MM-dd")" class="form-control" required />
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="outlined-field">
                        <label>Attachment File (PDF / Photo)</label>
                        <input type="file" name="attachmentFile" class="form-control" accept=".pdf,.jpg,.jpeg,.png,.docx" />
                    </div>
                </div>

                <div class="col-12">
                    <div class="p-3 bg-light rounded-3 border d-flex align-items-center justify-content-between">
                        <div>
                            <span class="fw-bold d-block text-dark">Active Status</span>
                            <span class="small text-muted">When active, homework is visible to students in their portal.</span>
                        </div>
                        <div class="form-check form-switch m-0">
                            <input class="form-check-input fs-5" type="checkbox" name="IsActive" value="true" id="isActiveSwitch" checked>
                            <input type="hidden" name="IsActive" value="false">
                        </div>
                    </div>
                </div>

                <div class="col-12 pt-3 text-end">
                    <button type="submit" class="btn btn-primary rounded-3 px-5 py-2 fw-bold">
                        <i class="bi bi-send me-1"></i>Publish Homework
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function loadSections() {
            var stdId = $('#standardSelect').val();
            if (!stdId) {
                $('#sectionSelect').empty().append('<option value="">-- All Sections --</option>');
                return;
            }
            $.get('@Url.Action("GetSectionsByStandard", "Attendance", new { area = "Teacher" })', { standardId: stdId }, function(data) {
                var $sec = $('#sectionSelect');
                $sec.empty().append('<option value="">-- All Sections --</option>');
                $.each(data, function(i, item) {
                    $sec.append('<option value="' + item.sectionId + '">Section ' + item.sectionName + '</option>');
                });
            });
        }
    </script>
}
