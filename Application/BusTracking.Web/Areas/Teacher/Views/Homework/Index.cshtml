@model List<BusTracking.Common.DTOs.Homework.HomeworkDto>
@{
    ViewData["Title"] = "Homework Management";
    var years = ViewBag.AcademicYears as List<BusTracking.Common.DTOs.AcademicYear.AcademicYearDto> ?? new();
    var standards = ViewBag.Standards as List<BusTracking.Common.DTOs.Standard.StandardDto> ?? new();
    var sections = ViewBag.Sections as List<BusTracking.Common.DTOs.Section.SectionDto> ?? new();

    int selectedYearId = ViewBag.SelectedYearId ?? 0;
    int? selectedStandardId = ViewBag.SelectedStandardId;
    int? selectedSectionId = ViewBag.SelectedSectionId;
    bool hasFilter = ViewBag.HasFilter ?? false;
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold m-0 text-dark">
            <i class="bi bi-journal-bookmark text-primary me-2"></i>Homework & Assignments
        </h3>
        <span class="small text-muted">Assign homework, manage due dates, and grade student submissions.</span>
    </div>
    <div>
        <a href="@Url.Action("Create", "Homework", new { area = "Teacher" })" class="btn btn-primary rounded-3 px-4 fw-bold">
            <i class="bi bi-plus-circle me-1"></i>Create Homework
        </a>
    </div>
</div>

<!-- Filters Card -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form id="homeworkFilterForm" method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="outlined-field">
                    <label>Academic Session</label>
                    <select name="academicYearId" class="form-select" onchange="this.form.submit()">
                        @foreach (var y in years)
                        {
                            <option value="@y.AcademicYearId" selected="@(y.AcademicYearId == selectedYearId ? "selected" : null)">@y.YearName @(y.IsCurrent ? "(Active)" : "")</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-md-4">
                <div class="outlined-field">
                    <label>Class / Standard</label>
                    <select id="standardSelect" name="standardId" class="form-select" onchange="onStandardChanged()">
                        <option value="">-- Select Class --</option>
                        @foreach (var s in standards)
                        {
                            <option value="@s.StandardId" selected="@(s.StandardId == selectedStandardId ? "selected" : null)">@s.StandardName</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-md-4">
                <div class="outlined-field">
                    <label>Section</label>
                    <select id="sectionSelect" name="sectionId" class="form-select" onchange="this.form.submit()">
                        <option value="">-- Select Section --</option>
                        @foreach (var sec in sections)
                        {
                            <option value="@sec.SectionId" selected="@(sec.SectionId == selectedSectionId ? "selected" : null)">Section @sec.SectionName</option>
                        }
                    </select>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Homework Cards Grid -->
<div class="row g-3">
    @if (!hasFilter)
    {
        <div class="col-12 text-center py-5 text-muted">
            <i class="bi bi-filter-circle display-3 text-primary opacity-50"></i>
            <h5 class="fw-bold mt-3 text-dark">Select Class & Section</h5>
            <p class="small text-muted">Please select an Academic Session, Class / Standard, and Section to load homework assignments.</p>
        </div>
    }
    else if (!Model.Any())
    {
        <div class="col-12 text-center py-5 text-muted">
            <i class="bi bi-journal-x display-3 opacity-50"></i>
            <h5 class="fw-bold mt-3 text-dark">No Homework Found</h5>
            <p class="small text-muted">No homework assignments created for this Class and Section yet.</p>
        </div>
    }
    else
    {
        @foreach (var item in Model)
        {
            var isPastDue = item.DueDate.Date < DateTime.Today;
            <div class="col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <div class="d-flex align-items-center gap-1">
                            <span class="badge bg-primary-subtle text-primary fw-bold px-2 py-1 rounded-2">
                                @item.StandardName @(string.IsNullOrWhiteSpace(item.SectionName) ? "" : $"- Sec {item.SectionName}")
                            </span>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success text-white fw-bold px-2 py-1 rounded-2" title="Active - Visible to Students">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary text-white fw-bold px-2 py-1 rounded-2" title="Inactive / Draft - Hidden from Students">Draft/Inactive</span>
                            }
                        </div>
                        <span class="badge @(isPastDue ? "bg-danger-subtle text-danger" : "bg-success-subtle text-success") fw-bold px-2 py-1 rounded-2">
                            Due: @item.DueDate.ToString("dd MMM yyyy")
                        </span>
                    </div>

                    <h5 class="fw-bold text-dark mb-1">@item.Title</h5>
                    <p class="small text-muted mb-2 text-truncate" style="max-height: 40px;">@item.Description</p>

                    @if (!string.IsNullOrWhiteSpace(item.AttachmentUrl))
                    {
                        <div class="mb-3">
                            <a href="@item.AttachmentUrl" target="_blank" class="btn btn-sm btn-light rounded-2 text-primary fw-bold">
                                <i class="bi bi-paperclip me-1"></i>View Attachment
                            </a>
                        </div>
                    }

                    <div class="mt-auto pt-3 border-top d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <a href="@Url.Action("Submissions", "Homework", new { area = "Teacher", id = item.HomeworkId })" class="btn btn-sm btn-outline-primary rounded-3 fw-bold">
                            <i class="bi bi-people me-1"></i>Submissions (@item.SubmissionsCount)
                        </a>

                        <div class="d-flex align-items-center gap-1">
                            <a href="@Url.Action("Edit", "Homework", new { area = "Teacher", id = item.HomeworkId })" class="btn btn-sm btn-outline-secondary rounded-3" title="Edit Homework">
                                <i class="bi bi-pencil"></i>
                            </a>

                            <form method="post" action="@Url.Action("Delete", "Homework", new { area = "Teacher", id = item.HomeworkId })" onsubmit="return confirm('Are you sure you want to delete this homework?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-3" title="Delete Homework">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@section Scripts {
    <script>
        function onStandardChanged() {
            var stdId = $('#standardSelect').val();
            if (!stdId) {
                $('#sectionSelect').empty().append('<option value="">-- Select Section --</option>');
                return;
            }
            $.get('@Url.Action("GetSectionsByStandard", "Attendance", new { area = "Teacher" })', { standardId: stdId }, function(data) {
                var $sec = $('#sectionSelect');
                $sec.empty().append('<option value="">-- Select Section --</option>');
                $.each(data, function(i, item) {
                    $sec.append('<option value="' + item.sectionId + '">Section ' + item.sectionName + '</option>');
                });
            });
        }
    </script>
}
