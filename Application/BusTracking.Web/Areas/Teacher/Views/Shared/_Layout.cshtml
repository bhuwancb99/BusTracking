@using BusTracking.Web.Helpers
@{
    var menuItems = SidebarHelper.GetMenu(User);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Teacher Portal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --primary-bg: #f8fafc;
            --sidebar-width: 260px;
            --brand-primary: #3d5af1;
            --brand-secondary: #00e676;
            --dark-card: #ffffff;
        }

        body {
            background-color: var(--primary-bg);
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            color: #1e293b;
        }

        .teacher-layout {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: var(--sidebar-width);
            background: #ffffff;
            border-right: 1px solid #e2e8f0;
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            z-index: 1000;
        }

        .sidebar-brand {
            padding: 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            border-bottom: 1px solid #f1f5f9;
        }

        .nav-link {
            color: #64748b;
            padding: 0.85rem 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-weight: 500;
            transition: all 0.2s;
        }

        .nav-link:hover, .nav-link.active {
            color: var(--brand-primary);
            background: rgba(61, 90, 241, 0.08);
            border-left: 4px solid var(--brand-primary);
        }

        .main-wrapper {
            margin-left: var(--sidebar-width);
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .top-navbar {
            height: 70px;
            background: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 2rem;
            position: sticky;
            top: 0;
            z-index: 999;
        }

        .content-area {
            padding: 2rem;
            flex: 1;
        }
    </style>
</head>
<body>
    <div class="teacher-layout">
        <!-- Sidebar Navigation -->
        <aside class="sidebar shadow-sm">
            <div class="sidebar-brand">
                <i class="bi bi-mortarboard-fill fs-3 text-primary"></i>
                <div>
                    <h6 class="fw-bold m-0">Teacher Portal</h6>
                    <span class="text-muted small">@User.FindFirst("SchoolName")?.Value</span>
                </div>
            </div>

            <nav class="nav flex-column my-3">
                @foreach (var item in menuItems)
                {
                    var isCurrent = ViewContext.RouteData.Values["controller"]?.ToString() == item.Controller;
                    <a class="nav-link @(isCurrent ? "active" : "")" href="@Url.Action(item.Action, item.Controller, new { area = item.Area })">
                        <i class="bi @item.Icon"></i> @item.Label
                    </a>
                }
            </nav>

            <div class="mt-auto p-3 border-top">
                <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger w-100 rounded-3 text-start d-flex align-items-center gap-2">
                        <i class="bi bi-box-arrow-right"></i> Sign Out
                    </button>
                </form>
            </div>
        </aside>

        <!-- Main Wrapper -->
        <div class="main-wrapper">
            <header class="top-navbar">
                <h5 class="fw-bold m-0 text-secondary">School Teacher Workspace</h5>
                <div class="d-flex align-items-center gap-3">
                    <div class="d-flex align-items-center gap-2">
                        <img src="@User.FindFirst("ProfileImageUrl")?.Value" class="rounded-circle border shadow-sm" style="width: 40px; height: 40px; object-fit: cover;" onerror="this.onerror=null;this.src='/images/default-avatar.svg';" />
                        <div>
                            <div class="fw-bold small">@User.Identity?.Name</div>
                            <span class="badge bg-success-subtle text-success small">Teacher</span>
                        </div>
                    </div>
                </div>
            </header>

            <main class="content-area">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show rounded-3 border-0 shadow-sm" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
