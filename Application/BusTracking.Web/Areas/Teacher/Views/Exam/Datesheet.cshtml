@model List<BusTracking.Common.DTOs.Exam.ExamScheduleDto>
@{
    ViewData["Title"] = "Exam Datesheet";
    var terms = ViewBag.ExamTerms as List<BusTracking.Common.DTOs.Exam.ExamTermDto> ?? new();
    var standards = ViewBag.Standards as List<BusTracking.Common.DTOs.Standard.StandardDto> ?? new();

    int? selectedTermId = ViewBag.SelectedTermId;
    int? selectedStandardId = ViewBag.SelectedStandardId;
    string? validationMessage = ViewBag.ValidationMessage as string;
    bool hasBothSelected = selectedTermId.HasValue && selectedTermId.Value > 0 && selectedStandardId.HasValue && selectedStandardId.Value > 0;
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold m-0 text-dark">
            <i class="bi bi-calendar-event text-primary me-2"></i>Exam Datesheet Schedule
        </h3>
        <span class="small text-muted">View examination timetables, room numbers, and passing criteria.</span>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-primary rounded-3 fw-bold">
            <i class="bi bi-pencil-square me-1"></i>Enter Marks Grid
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(validationMessage))
{
    <div class="alert alert-warning alert-dismissible fade show border-0 shadow-sm rounded-4 mb-4" role="alert">
        <div class="d-flex align-items-center">
            <i class="bi bi-exclamation-triangle-fill fs-5 me-2 text-warning"></i>
            <span class="fw-semibold">@validationMessage</span>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Filter Selection Header -->
<div class="card border-0 shadow-sm rounded-4 p-3 mb-4">
    <form method="get" class="row g-3 align-items-end">
        <input type="hidden" name="isSubmitted" value="true" />
        <div class="col-md-5">
            <label class="form-label small fw-bold text-muted mb-1">Exam Term <span class="text-danger">*</span></label>
            <select name="examTermId" class="form-select rounded-3">
                <option value="">-- Select Exam Term --</option>
                @foreach (var t in terms)
                {
                    <option value="@t.ExamTermId" selected="@(t.ExamTermId == selectedTermId)">@t.TermName (@t.AcademicYearName)</option>
                }
            </select>
        </div>

        <div class="col-md-5">
            <label class="form-label small fw-bold text-muted mb-1">Class / Standard <span class="text-danger">*</span></label>
            <select name="standardId" class="form-select rounded-3">
                <option value="">-- Select Class / Standard --</option>
                @foreach (var s in standards)
                {
                    <option value="@s.StandardId" selected="@(s.StandardId == selectedStandardId)">@s.StandardName</option>
                }
            </select>
        </div>

        <div class="col-md-2 text-end">
            <button type="submit" class="btn btn-primary rounded-3 w-100 fw-bold">
                <i class="bi bi-funnel me-1"></i>Filter
            </button>
        </div>
    </form>
</div>

@if (!hasBothSelected)
{
    <div class="card border-0 shadow-sm rounded-4 p-5 text-center my-3 bg-white">
        <div class="py-3">
            <div class="mb-3">
                <span class="d-inline-flex align-items-center justify-content-center bg-light text-primary rounded-circle" style="width: 64px; height: 64px;">
                    <i class="bi bi-funnel-fill fs-3"></i>
                </span>
            </div>
            <h5 class="fw-bold text-dark mb-2">Select Filter Criteria</h5>
            <p class="text-secondary small m-0 max-w-md mx-auto">
                Please select both <strong>Exam Term</strong> and <strong>Class / Standard</strong> from above and click <strong>Filter</strong> to search and view the examination datesheet.
            </p>
        </div>
    </div>
}
else
{
    <!-- Datesheet Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small fw-bold">
                    <tr>
                        <th class="ps-4">Date</th>
                        <th>Term</th>
                        <th>Class</th>
                        <th>Subject</th>
                        <th>Time</th>
                        <th class="text-center">Max Marks</th>
                        <th class="text-center">Pass Marks</th>
                        <th>Room</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-3 d-block mb-2 text-secondary"></i>
                                No examination schedule items found for the selected criteria.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-primary">
                                    <i class="bi bi-calendar-check me-1"></i>@item.ExamDate.ToString("ddd, dd MMM yyyy")
                                </td>
                                <td><span class="badge bg-light text-dark border">@item.TermName</span></td>
                                <td><span class="badge bg-secondary">@item.StandardName</span></td>
                                <td class="fw-bold text-dark">@item.SubjectName</td>
                                <td class="small text-muted">
                                    @DateTime.Today.Add(item.StartTime).ToString("hh:mm tt") - @DateTime.Today.Add(item.EndTime).ToString("hh:mm tt")
                                </td>
                                <td class="text-center fw-bold">@item.MaxMarks</td>
                                <td class="text-center text-muted">@item.PassMarks</td>
                                <td>
                                    <span class="badge bg-info text-dark">Room: @(string.IsNullOrWhiteSpace(item.RoomNumber) ? "TBA" : item.RoomNumber)</span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}
