@model List<BusTracking.Common.DTOs.Notification.NotificationDto>
@{
    ViewData["Title"] = "My Notifications";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 class="fw-bold m-0"><i class="bi bi-bell-fill text-primary me-2"></i>Notifications</h3>
        <p class="text-muted small mb-0">View all school notices and system broadcasts</p>
    </div>
    <button type="button" id="markAllReadBtn" class="btn btn-outline-primary rounded-3">
        <i class="bi bi-check2-all me-1"></i> Mark All as Read
    </button>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-body p-0">
        @if (Model.Count == 0)
        {
            <div class="text-center py-5 text-secondary">
                <i class="bi bi-bell-slash text-muted" style="font-size: 3rem;"></i>
                <p class="mt-2 mb-0">You have no notifications at this time.</p>
            </div>
        }
        else
        {
            <div class="list-group list-group-flush">
                @foreach (var n in Model)
                {
                    <div class="list-group-item p-4 d-flex align-items-start justify-content-between gap-3 @(n.IsRead ? "bg-light-subtle" : "bg-white")">
                        <div class="d-flex gap-3">
                            <div class="rounded-circle p-3 d-flex align-items-center justify-content-center @(n.IsRead ? "bg-secondary-subtle text-secondary" : "bg-primary-subtle text-primary")" style="width: 48px; height: 48px;">
                                <i class="bi bi-bell fs-5"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1 text-dark">@n.Title</h6>
                                <p class="mb-1 text-secondary">@n.Body</p>
                                <span class="text-muted small"><i class="bi bi-clock me-1"></i>@n.SentAt.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt")</span>
                            </div>
                        </div>
                        @if (!n.IsRead)
                        {
                            <button class="btn btn-sm btn-light border rounded-pill mark-read-btn" data-id="@n.NotificationId">
                                Mark as Read
                            </button>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.mark-read-btn').click(function() {
                var btn = $(this);
                var id = btn.data('id');
                $.post('@Url.Action("MarkAsRead", "Notification", new { area = "Teacher" })', { notificationId: id }, function(res) {
                    if (res.success) {
                        btn.fadeOut();
                    }
                });
            });

            $('#markAllReadBtn').click(function() {
                $.post('@Url.Action("MarkAllAsRead", "Notification", new { area = "Teacher" })', function(res) {
                    if (res.success) {
                        location.reload();
                    }
                });
            });
        });
    </script>
}
