@model List<BusTracking.Common.DTOs.Section.SectionDto>
@{
    ViewData["Title"] = "Class Sections";
    var standards = ViewBag.Standards as List<BusTracking.Common.DTOs.Standard.StandardDto> ?? new();
    int selectedStandardId = ViewBag.SelectedStandardId ?? 0;
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
    <div>
        <h2 class="fw-bold m-0 text-dark">
            <i class="bi bi-diagram-3 text-primary me-2"></i>Class Sections
        </h2>
        <nav aria-label="breadcrumb" class="mt-1">
            <ol class="breadcrumb mb-0 small text-muted">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Dashboard")" class="text-decoration-none text-muted">Dashboard</a></li>
                <li class="breadcrumb-item active text-primary" aria-current="page">Class Sections</li>
            </ol>
        </nav>
    </div>
    @if (selectedStandardId > 0 && PermissionHelper.Can(User, "section.add"))
    {
        <a href="@Url.Action("Create", new { standardId = selectedStandardId })" class="btn btn-primary rounded-3 shadow-sm px-4">
            <i class="bi bi-plus-lg me-2"></i>Add Section
        </a>
    }
</div>

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-8 col-lg-9">
                <div class="input-group">
                    <label class="input-group-text bg-light border-0 fw-semibold text-muted" for="standardId">Select Class / Standard:</label>
                    <select name="standardId" id="standardId" class="form-select bg-light border-0" onchange="this.form.submit()">
                        @foreach (var s in standards)
                        {
                            <option value="@s.StandardId" selected="@(s.StandardId == selectedStandardId ? "selected" : null)">@s.StandardName</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-md-4 col-lg-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill rounded-3"><i class="bi bi-filter me-1"></i>Filter</button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary rounded-3"><i class="bi bi-arrow-counterclockwise"></i> Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light-subtle border-bottom">
                <tr class="text-uppercase fs-7 text-muted fw-bold">
                    <th style="width: 80px;" class="ps-4">ID</th>
                    <th>Section Name</th>
                    <th>Class / Standard</th>
                    <th style="width: 140px;" class="text-center">Default Section</th>
                    <th style="width: 100px;" class="text-center">Status</th>
                    @if (PermissionHelper.Can(User, "section.edit") || PermissionHelper.Can(User, "section.delete"))
                    {
                        <th style="width: 120px;" class="text-center pe-4">Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Model == null || Model.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-diagram-3 text-secondary opacity-50 display-4"></i>
                            <p class="mt-2 mb-0 fw-semibold fs-6">No sections found for selected class</p>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var sec in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <span class="badge bg-secondary-subtle text-dark border font-monospace">#@sec.SectionId</span>
                            </td>
                            <td class="fw-bold text-dark fs-6">Section @sec.SectionName</td>
                            <td class="text-muted fw-semibold">@sec.StandardName</td>
                            <td class="text-center">
                                @if (sec.IsDefault)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill">
                                        <i class="bi bi-check-circle-fill me-1"></i>Default Section 'A'
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border px-3 py-1 rounded-pill">Custom Section</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="form-check form-switch d-inline-block">
                                    <input type="checkbox" class="form-check-input btn-toggle-section" style="cursor: pointer; width: 38px; height: 20px;" data-id="@sec.SectionId" @(sec.IsActive ? "checked" : "") @(!PermissionHelper.Can(User, "section.edit") ? "disabled" : "") />
                                </div>
                            </td>
                            @if (PermissionHelper.Can(User, "section.edit") || PermissionHelper.Can(User, "section.delete"))
                            {
                                <td class="text-center pe-4">
                                    @if (PermissionHelper.Can(User, "section.edit"))
                                    {
                                        <a href="@Url.Action("Edit", new { id = sec.SectionId })" class="btn btn-outline-primary btn-sm rounded-3 px-2 py-1 me-1" title="Edit Section">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>
                                    }
                                    @if (PermissionHelper.Can(User, "section.delete"))
                                    {
                                        <form asp-action="Delete" asp-route-id="@sec.SectionId" asp-route-standardId="@sec.StandardId" method="post" class="d-inline" onsubmit="return confirm('Delete Section @sec.SectionName? This cannot be undone.')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-3 px-2 py-1" title="Delete Section" @(Model.Count <= 1 ? "disabled" : "")>
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </form>
                                    }
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.btn-toggle-section').forEach(btn => {
            btn.addEventListener('change', async function () {
                const id = this.dataset.id;
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
                const res = await fetch('@Url.Action("Toggle")/' + id, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token }
                });
                const data = await res.json();
                if (!data.success) {
                    this.checked = !this.checked;
                    alert(data.message || 'Failed to update status.');
                }
            });
        });
    </script>
}
