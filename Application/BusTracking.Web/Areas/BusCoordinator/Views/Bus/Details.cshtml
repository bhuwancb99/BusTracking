@model BusTracking.Common.DTOs.Bus.BusListDto
@{
    ViewData["Title"] = "Bus Details - " + Model.BusName;
    int imageCount = Model?.Images?.Count ?? 0;
    int maxImages = 5;
    int remaining = maxImages - imageCount;
}

<div class="container-fluid p-0">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="fw-bold m-0 text-dark">
                <i class="bi bi-bus-front text-primary me-2"></i>Bus Profile & Details
            </h2>
            <nav aria-label="breadcrumb" class="mt-1">
                <ol class="breadcrumb mb-0 small text-muted">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Dashboard")" class="text-decoration-none text-muted">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("Index")" class="text-decoration-none text-muted">Buses</a></li>
                    <li class="breadcrumb-item active text-primary" aria-current="page">Bus Details</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Edit", new { id = Model.BusId })" class="btn btn-primary rounded-3 px-3 shadow-sm">
                <i class="bi bi-pencil-fill me-1"></i> Edit Bus
            </a>
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary rounded-3 px-3">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        </div>
    </div>

    @if (Model is not null)
    {
        <div class="row g-4">
            <div class="col-lg-5 col-12">
                <!-- Bus Information -->
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                            <div class="rounded-circle bg-primary-subtle text-primary p-3 d-flex align-items-center justify-content-center border border-primary-subtle" style="width:52px; height:52px;">
                                <i class="bi bi-bus-front fs-3"></i>
                            </div>
                            <div>
                                <h4 class="fw-bold text-dark mb-1">@Model.BusName</h4>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace px-3 py-1">@Model.BusNumber</span>
                                    <span class="badge @(Model.IsActive ? "bg-success-subtle text-success border border-success-subtle" : "bg-danger-subtle text-danger border border-danger-subtle") rounded-pill px-3 py-1">
                                        <i class="bi bi-circle-fill me-1 fs-7"></i>@(Model.IsActive ? "Active" : "Inactive")
                                    </span>
                                </div>
                            </div>
                        </div>

                        <h6 class="fw-bold text-primary text-uppercase fs-7 mb-3"><i class="bi bi-info-circle me-2"></i>Bus Overview</h6>
                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <small class="text-muted d-block">Bus Type</small>
                                <span class="fw-bold text-dark">@(string.IsNullOrWhiteSpace(Model.BusTypeName) ? "N/A" : Model.BusTypeName)</span>
                            </div>
                            <div class="col-6">
                                <small class="text-muted d-block">Capacity</small>
                                <span class="fw-bold text-dark">@(Model.Capacity?.ToString() ?? "N/A") Seats</span>
                            </div>
                            <div class="col-12">
                                <small class="text-muted d-block">Assigned Route(s)</small>
                                <span class="fw-bold text-primary">@(string.IsNullOrWhiteSpace(Model.RouteName) ? "Unassigned" : Model.RouteName)</span>
                            </div>
                            <div class="col-12">
                                <small class="text-muted d-block">Enrolled Students</small>
                                <span class="badge bg-info-subtle text-info border border-info-subtle font-monospace px-3 py-1">@Model.StudentCount Students Assigned</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Compliance & Maintenance -->
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                    <div class="card-body p-4">
                        <h6 class="fw-bold text-primary text-uppercase fs-7 mb-3"><i class="bi bi-shield-check me-2"></i>Compliance & Expiry Dates</h6>
                        <div class="row g-3">
                            <div class="col-6">
                                <small class="text-muted d-block">Insurance Expiry</small>
                                <span class="fw-semibold text-dark">@(Model.InsuranceExpiryDate?.ToString("yyyy-MM-dd") ?? "N/A")</span>
                            </div>
                            <div class="col-6">
                                <small class="text-muted d-block">Fitness Certificate</small>
                                <span class="fw-semibold text-dark">@(Model.FitnessExpiryDate?.ToString("yyyy-MM-dd") ?? "N/A")</span>
                            </div>
                            <div class="col-6">
                                <small class="text-muted d-block">PUC Expiry</small>
                                <span class="fw-semibold text-dark">@(Model.PucExpiryDate?.ToString("yyyy-MM-dd") ?? "N/A")</span>
                            </div>
                            <div class="col-6">
                                <small class="text-muted d-block">Last Maintenance</small>
                                <span class="fw-semibold text-dark">@(Model.LastServiceDate?.ToString("yyyy-MM-dd") ?? "N/A")</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Bus Photos -->
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="fw-bold text-primary text-uppercase fs-7 m-0"><i class="bi bi-images me-2"></i>Bus Photos</h6>
                            <span class="badge bg-secondary-subtle text-secondary font-monospace" id="photoCount">@imageCount / @maxImages</span>
                        </div>

                        @if (remaining > 0)
                        {
                            <label for="busImgInput" class="btn btn-sm btn-outline-primary rounded-3 w-100 mb-3" id="addPhotoBtn">
                                <i class="bi bi-plus-lg me-1"></i>Add Photos
                                <input type="file" id="busImgInput" class="d-none" accept="image/jpeg,image/png,image/webp" multiple onchange="handleBusImageSelect(this)" />
                            </label>
                        }

                        <div id="uploadProgress" class="mb-3" style="display:none">
                            <div class="progress rounded-pill" style="height:6px;">
                                <div id="uploadProgressBar" class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width:0%"></div>
                            </div>
                            <div id="uploadProgressText" class="text-muted small mt-1"></div>
                        </div>

                        <div id="busImgAlert" style="display:none" class="alert alert-dismissible py-2 mb-2 small" role="alert">
                            <span id="busImgAlertText"></span>
                            <button type="button" class="btn-close btn-close-sm" onclick="hideAlert()"></button>
                        </div>

                        @if (imageCount > 0)
                        {
                            <div id="busGallery" class="d-flex gap-2 overflow-auto pb-1" style="scroll-snap-type:x mandatory;">
                                @{ int idx = 0; }
                                @foreach (var img in Model.Images.OrderBy(i => i.DisplayOrder))
                                {
                                    <div class="position-relative flex-shrink-0" id="busImgCard_@img.BusImageId" style="width:130px;scroll-snap-align:start;">
                                        <img src="@img.ImageUrl" alt="Bus photo @(idx + 1)" class="rounded-3 img-thumbnail w-100 @(img.IsPrimary ? "border-primary border-2" : "")" style="height:100px;object-fit:cover;cursor:pointer;" onclick="openLightbox(@idx)" data-lightbox-index="@idx" />
                                        @if (img.IsPrimary)
                                        {
                                            <span class="badge bg-primary position-absolute top-0 start-0 m-1" style="font-size:.6rem;pointer-events:none;">Cover</span>
                                        }
                                        <div class="d-flex gap-1 mt-1">
                                            @if (!img.IsPrimary)
                                            {
                                                <button type="button" class="btn btn-xs btn-outline-primary flex-fill" style="font-size:.62rem;padding:1px 3px;" onclick="setPrimary(@img.BusImageId)">Cover</button>
                                            }
                                            <button type="button" class="btn btn-xs btn-outline-danger flex-fill" style="font-size:.62rem;padding:1px 3px;" onclick="deleteBusImg(@img.BusImageId)"><i class="bi bi-trash"></i></button>
                                        </div>
                                    </div>
                                    idx++;
                                }
                            </div>
                        }
                        else
                        {
                            <div id="busGallery" class="d-flex gap-2 overflow-auto pb-1" style="scroll-snap-type:x mandatory;min-height:40px;"></div>
                            <div id="emptyMsg" class="text-center text-muted py-3">
                                <i class="bi bi-images fs-2 d-block mb-1 opacity-50"></i>
                                No photos uploaded. Click <strong>Add Photos</strong> to upload up to @maxImages images.
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-7 col-12">
                <!-- Driver Assignment -->
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                    <div class="card-body p-4">
                        <h6 class="fw-bold text-primary text-uppercase fs-7 mb-3"><i class="bi bi-person-video2 me-2"></i>Driver Assignment</h6>
                        <div class="p-3 bg-light-subtle rounded-4 border mb-3">
                            @if (Model.DriverName is not null)
                            {
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle bg-success-subtle text-success p-3 d-flex align-items-center justify-content-center border border-success-subtle" style="width:48px; height:48px;">
                                        <i class="bi bi-person-video2 fs-4"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark fs-6">@Model.DriverName</div>
                                        <span class="text-muted small">Phone: @(string.IsNullOrWhiteSpace(Model.DriverPhone) ? "N/A" : Model.DriverPhone)</span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="text-muted py-2">
                                    <i class="bi bi-info-circle me-1"></i>No driver assigned to this bus.
                                </div>
                            }
                        </div>

                        <div class="row g-2 align-items-center">
                            <div class="col-md-8 col-12 position-relative">
                                <input type="text" id="driverSearch" class="form-control rounded-3" placeholder="Type driver name to assign..." autocomplete="off" />
                                <div id="driverSug" class="dropdown-menu w-100 shadow-sm rounded-3"></div>
                            </div>
                            <div class="col-md-4 col-12 d-flex gap-2">
                                <button type="button" class="btn btn-success rounded-3 flex-fill" id="btnAssignDriver"><i class="bi bi-check2 me-1"></i>Assign</button>
                                @if (Model.DriverName is not null)
                                {
                                    <button type="button" class="btn btn-outline-danger rounded-3" id="btnRemoveDriver" title="Unassign Driver"><i class="bi bi-x-lg"></i></button>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Student Quick Assign -->
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="fw-bold text-primary text-uppercase fs-7 m-0"><i class="bi bi-mortarboard me-2"></i>Quick Assign Student</h6>
                            <span class="badge bg-info-subtle text-info border border-info-subtle font-monospace">@Model.StudentCount Enrolled</span>
                        </div>
                        <p class="text-muted small">Search and assign a student directly to this bus:</p>

                        <div class="row g-2 align-items-center mb-3">
                            <div class="col-md-8 col-12 position-relative">
                                <input type="text" id="studentSearch" class="form-control rounded-3" placeholder="Type student name or code..." autocomplete="off" />
                                <div id="studentSug" class="dropdown-menu w-100 shadow-sm rounded-3"></div>
                            </div>
                            <div class="col-md-4 col-12">
                                <button type="button" class="btn btn-info text-white rounded-3 w-100" id="btnAssignStudent"><i class="bi bi-plus-lg me-1"></i>Assign</button>
                            </div>
                        </div>

                        <div class="alert alert-info border-0 rounded-3 py-2 px-3 small mb-0 bg-info-subtle text-info">
                            <i class="bi bi-info-circle me-1"></i>To view the full roster of students on this bus, navigate to the <a href="@Url.Action("Index", "Student")" class="fw-bold text-info text-decoration-underline">Students Directory</a>.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Lightbox Modal -->
<div class="modal fade" id="lightboxModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content bg-dark border-0 rounded-4 overflow-hidden">
            <div class="modal-header border-0 py-2 px-3">
                <span class="text-white small" id="lbCounter"></span>
                <div class="d-flex gap-2 ms-auto align-items-center">
                    <button class="btn btn-sm btn-outline-light py-0 px-2" onclick="zoomIn()"><i class="bi bi-zoom-in"></i></button>
                    <button class="btn btn-sm btn-outline-light py-0 px-2" onclick="zoomOut()"><i class="bi bi-zoom-out"></i></button>
                    <button class="btn btn-sm btn-outline-light py-0 px-2" onclick="resetZoom()"><i class="bi bi-arrows-angle-contract"></i></button>
                    <button type="button" class="btn-close btn-close-white ms-2" data-bs-dismiss="modal"></button>
                </div>
            </div>
            <div class="modal-body p-0 d-flex align-items-center justify-content-center position-relative" style="height:75vh;overflow:hidden;background:#111;">
                <button class="btn btn-dark position-absolute start-0 top-50 translate-middle-y ms-2 z-1" style="opacity:.8;" onclick="lbPrev()"><i class="bi bi-chevron-left fs-5"></i></button>
                <div id="lbImgWrapper" style="overflow:hidden;width:100%;height:100%;display:flex;align-items:center;justify-content:center;cursor:grab;">
                    <img id="lbImg" src="" alt="" style="max-width:100%;max-height:100%;object-fit:contain;transform-origin:center center;transition:transform .2s ease;user-select:none;" />
                </div>
                <button class="btn btn-dark position-absolute end-0 top-50 translate-middle-y me-2 z-1" style="opacity:.8;" onclick="lbNext()"><i class="bi bi-chevron-right fs-5"></i></button>
            </div>
            <div class="modal-footer border-0 py-2 justify-content-center" id="lbThumbStrip" style="background:#111;gap:6px;flex-wrap:nowrap;overflow-x:auto;"></div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        const busId = @Model?.BusId;
        const MAX = @maxImages;
        const _tok = () => document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

        let lbImages = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.Images?.OrderBy(i => i.DisplayOrder).Select(i => i.ImageUrl).ToList() ?? new List<string>()));
        let lbIndex = 0;
        let lbZoom = 1;

        async function handleBusImageSelect(input) {
            const files = Array.from(input.files);
            const gallery = document.getElementById('busGallery');
            const current = gallery.querySelectorAll('.position-relative').length;
            const available = MAX - current;

            if (files.length === 0) return;
            if (available <= 0) { alert(`This bus already has ${MAX} photos.`); input.value = ''; return; }
            if (files.length > available) { alert(`Select at most ${available} photos.`); input.value = ''; return; }

            await uploadBusImages(files);
            input.value = '';
        }

        async function uploadBusImages(files) {
            const progressWrap = document.getElementById('uploadProgress');
            const progressBar = document.getElementById('uploadProgressBar');
            const progressText = document.getElementById('uploadProgressText');

            progressWrap.style.display = 'block';
            progressBar.style.width = '10%';
            progressText.textContent = `Uploading ${files.length} photos...`;

            const fd = new FormData();
            files.forEach(f => fd.append('files', f));

            try {
                const res = await fetch('/Image/UploadBusImages?busId=' + busId, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': _tok() },
                    body: fd
                });
                const json = await res.json();
                progressBar.style.width = '100%';

                if (json.success) {
                    location.reload();
                } else {
                    alert(json.message || 'Upload failed.');
                }
            } catch (err) { console.error(err); alert('Upload error.'); }
            finally { setTimeout(() => { progressWrap.style.display = 'none'; }, 600); }
        }

        async function deleteBusImg(busImageId) {
            if (!confirm('Delete this photo?')) return;
            try {
                const res = await fetch('/Image/DeleteBusImage?busImageId=' + busImageId, {
                    method: 'POST', headers: { 'RequestVerificationToken': _tok() }
                });
                const json = await res.json();
                if (json.success) location.reload();
            } catch { alert('Error deleting photo.'); }
        }

        async function setPrimary(busImageId) {
            try {
                const res = await fetch('/Image/SetPrimaryBusImage?busImageId=' + busImageId, {
                    method: 'POST', headers: { 'RequestVerificationToken': _tok() }
                });
                const json = await res.json();
                if (json.success) location.reload();
            } catch { alert('Error updating cover.'); }
        }

        function openLightbox(index) {
            if (!lbImages.length) return;
            lbIndex = index; lbZoom = 1; updateLbImage(); rebuildThumbStrip();
            new bootstrap.Modal(document.getElementById('lightboxModal')).show();
        }

        function updateLbImage() {
            const img = document.getElementById('lbImg');
            img.src = lbImages[lbIndex];
            img.style.transform = `scale(${lbZoom})`;
            document.getElementById('lbCounter').textContent = `${lbIndex + 1} / ${lbImages.length}`;
        }

        function lbPrev() { lbZoom = 1; lbIndex = (lbIndex - 1 + lbImages.length) % lbImages.length; updateLbImage(); }
        function lbNext() { lbZoom = 1; lbIndex = (lbIndex + 1) % lbImages.length; updateLbImage(); }
        function zoomIn() { lbZoom = Math.min(lbZoom + 0.3, 4); applyZoom(); }
        function zoomOut() { lbZoom = Math.max(lbZoom - 0.3, 0.5); applyZoom(); }
        function resetZoom() { lbZoom = 1; applyZoom(); }
        function applyZoom() { document.getElementById('lbImg').style.transform = `scale(${lbZoom})`; }

        function rebuildThumbStrip() {
            const strip = document.getElementById('lbThumbStrip');
            if (!strip) return;
            strip.innerHTML = '';
            lbImages.forEach((url, i) => {
                const img = document.createElement('img');
                img.src = url;
                img.style = `height:48px;width:64px;object-fit:cover;border-radius:4px;cursor:pointer;opacity:${i === lbIndex ? '1' : '0.45'};border:${i === lbIndex ? '2px solid #0d6efd' : '2px solid transparent'};`;
                img.onclick = () => { lbZoom = 1; lbIndex = i; updateLbImage(); };
                strip.appendChild(img);
            });
        }

        // Driver autocomplete
        let selDriverId = null, t1;
        const driverInput = document.getElementById('driverSearch');
        if (driverInput) {
            driverInput.addEventListener('input', function () {
                clearTimeout(t1); const q = this.value.trim();
                if (q.length < 1) { hideDrv(); return; }
                t1 = setTimeout(() => fetchDrivers(q), 250);
            });
        }
        document.addEventListener('click', e => { if (!e.target.closest('#driverSearch,#driverSug')) hideDrv(); });

        async function fetchDrivers(q) {
            const res = await fetch('@Url.Action("SearchDrivers")?q=' + encodeURIComponent(q));
            const data = await res.json();
            const box = document.getElementById('driverSug'); box.innerHTML = '';
            data.forEach(d => {
                const a = document.createElement('a'); a.className = 'dropdown-item py-2'; a.href = '#'; a.textContent = d.display;
                a.addEventListener('click', e => { e.preventDefault(); selDriverId = d.userId; document.getElementById('driverSearch').value = d.display; hideDrv(); });
                box.appendChild(a);
            });
            if (data.length) box.classList.add('show');
        }
        function hideDrv() { const box = document.getElementById('driverSug'); if (box) box.classList.remove('show'); }

        const assignDrvBtn = document.getElementById('btnAssignDriver');
        if (assignDrvBtn) {
            assignDrvBtn.addEventListener('click', async () => {
                if (!selDriverId) { alert('Select a driver first'); return; }
                const res = await fetch('@Url.Action("AssignDriver")', { method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': _tok() }, body: JSON.stringify({ busId, driverUserId: selDriverId }) });
                const data = await res.json();
                if (data.success) location.reload(); else alert(data.message);
            });
        }
        const removeDrvBtn = document.getElementById('btnRemoveDriver');
        if (removeDrvBtn) {
            removeDrvBtn.addEventListener('click', async () => {
                if (!confirm('Remove driver from this bus?')) return;
                const res = await fetch('@Url.Action("AssignDriver")', { method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': _tok() }, body: JSON.stringify({ busId, driverUserId: null }) });
                const data = await res.json();
                if (data.success) location.reload(); else alert(data.message);
            });
        }

        // Student autocomplete
        let selStudentId = null, t2;
        const stuInput = document.getElementById('studentSearch');
        if (stuInput) {
            stuInput.addEventListener('input', function () {
                clearTimeout(t2); const q = this.value.trim();
                if (q.length < 1) { hideStu(); return; }
                t2 = setTimeout(() => fetchStudents(q), 250);
            });
        }
        document.addEventListener('click', e => { if (!e.target.closest('#studentSearch,#studentSug')) hideStu(); });

        async function fetchStudents(q) {
            const res = await fetch('@Url.Action("Search", "Student")?q=' + encodeURIComponent(q));
            const data = await res.json();
            const box = document.getElementById('studentSug'); box.innerHTML = '';
            data.forEach(s => {
                const a = document.createElement('a'); a.className = 'dropdown-item d-flex gap-2 py-2'; a.href = '#';
                a.innerHTML = `<code class="small font-monospace">${s.studentCode}</code><span class="fw-bold">${s.fullName}</span>`;
                a.addEventListener('click', e => { e.preventDefault(); selStudentId = s.studentId; document.getElementById('studentSearch').value = `${s.fullName} (${s.studentCode})`; hideStu(); });
                box.appendChild(a);
            });
            if (data.length) box.classList.add('show');
        }
        function hideStu() { const box = document.getElementById('studentSug'); if (box) box.classList.remove('show'); }

        const assignStuBtn = document.getElementById('btnAssignStudent');
        if (assignStuBtn) {
            assignStuBtn.addEventListener('click', async () => {
                if (!selStudentId) { alert('Select a student first'); return; }
                const res = await fetch('@Url.Action("AssignStudent")', { method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': _tok() }, body: JSON.stringify({ busId, studentId: selStudentId }) });
                const data = await res.json();
                if (data.success) { alert('Student assigned successfully.'); location.reload(); } else alert(data.message);
            });
        }
    </script>
}
