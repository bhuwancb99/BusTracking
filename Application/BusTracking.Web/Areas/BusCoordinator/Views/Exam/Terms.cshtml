@using BusTracking.Web.Helpers
@model List<BusTracking.Common.DTOs.Exam.ExamTermDto>
@{
    ViewData["Title"] = "Exam Terms Management";
    var years = ViewBag.AcademicYears as List<BusTracking.Common.DTOs.AcademicYear.AcademicYearDto> ?? new();
    int? selectedYearId = ViewBag.SelectedYearId;

    bool canAdd = PermissionHelper.Can(User, "examterm.add");
    bool canEdit = PermissionHelper.Can(User, "examterm.edit");
    bool canDelete = PermissionHelper.Can(User, "examterm.delete");
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold m-0 text-dark">
            <i class="bi bi-award text-primary me-2"></i>Exam Terms Management
        </h3>
        <span class="small text-muted">Configure academic terms (Mid-Term, Final Exam, Unit Tests) for exams and report cards.</span>
    </div>
    <div>
        @if (canAdd)
        {
            <button type="button" class="btn btn-primary rounded-3 fw-bold" data-bs-toggle="modal" data-bs-target="#createTermModal">
                <i class="bi bi-plus-circle me-1"></i>Create Exam Term
            </button>
        }
    </div>
</div>

<!-- Terms Table -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-muted small fw-bold">
                <tr>
                    <th class="ps-4">Term Name</th>
                    <th>Academic Session</th>
                    <th>Date Range</th>
                    <th class="text-center">Schedules</th>
                    <th class="text-center">Status</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">No exam terms configured yet. Click 'Create Exam Term' to add one.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-dark fs-6">@item.TermName</td>
                            <td><span class="badge bg-light text-dark border">@item.AcademicYearName</span></td>
                            <td class="small text-muted">
                                @item.StartDate.ToString("dd MMM yyyy") — @item.EndDate.ToString("dd MMM yyyy")
                            </td>
                            <td class="text-center">
                                <span class="badge bg-primary rounded-pill px-3">@item.ScheduleCount Exams</span>
                            </td>
                            <td class="text-center">
                                <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                                    @(item.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                @if (canEdit)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-primary rounded-3 me-1"
                                            onclick="openEditTermModal(@item.ExamTermId, @item.AcademicYearId, '@item.TermName', '@(item.Description ?? "")', '@item.StartDate.ToString("yyyy-MM-dd")', '@item.EndDate.ToString("yyyy-MM-dd")', @item.IsActive.ToString().ToLower())"
                                            title="Edit Exam Term">
                                        <i class="bi bi-pencil"></i> Edit
                                    </button>
                                }
                                <a asp-action="Schedules" asp-route-examTermId="@item.ExamTermId" class="btn btn-sm btn-outline-info rounded-3 fw-bold me-1">
                                    <i class="bi bi-calendar3 me-1"></i>Datesheet
                                </a>
                                @if (canDelete)
                                {
                                    <form asp-action="DeleteTerm" asp-route-id="@item.ExamTermId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this exam term?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-3" title="Delete Term"><i class="bi bi-trash"></i></button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if (canAdd)
{
    <!-- Create Term Modal -->
    <div class="modal fade" id="createTermModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold"><i class="bi bi-award text-primary me-2"></i>Create New Exam Term</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form asp-action="CreateTerm" method="post">
                    <div class="modal-body py-3">
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">Academic Session</label>
                            <select name="AcademicYearId" class="form-select rounded-3" required>
                                @foreach (var y in years)
                                {
                                    <option value="@y.AcademicYearId" selected="@y.IsCurrent">@y.YearName</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">Term Name</label>
                            <input type="text" name="TermName" class="form-control rounded-3" placeholder="e.g. Mid-Term Exam 2026, Final Term" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">Description (Optional)</label>
                            <textarea name="Description" class="form-control rounded-3" rows="2" placeholder="Term summary or instructions..."></textarea>
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label small fw-bold text-muted">Start Date</label>
                                <input type="date" name="StartDate" class="form-control rounded-3" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-bold text-muted">End Date</label>
                                <input type="date" name="EndDate" class="form-control rounded-3" value="@DateTime.Today.AddDays(14).ToString("yyyy-MM-dd")" required />
                            </div>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" name="IsActive" value="true" class="form-check-input" checked id="isActiveChk" />
                            <label class="form-check-label small fw-bold" for="isActiveChk">Active Term Status</label>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-light rounded-3 fw-bold" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary rounded-3 fw-bold px-4">Create Term</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@if (canEdit)
{
    <!-- Edit Term Modal -->
    <div class="modal fade" id="editTermModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square text-primary me-2"></i>Edit Exam Term</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form asp-action="UpdateTerm" method="post">
                    <input type="hidden" name="ExamTermId" id="editExamTermId" />
                    <div class="modal-body py-3">
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">Academic Session</label>
                            <select name="AcademicYearId" id="editAcademicYearId" class="form-select rounded-3" required>
                                @foreach (var y in years)
                                {
                                    <option value="@y.AcademicYearId">@y.YearName</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">Term Name</label>
                            <input type="text" name="TermName" id="editTermName" class="form-control rounded-3" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">Description (Optional)</label>
                            <textarea name="Description" id="editDescription" class="form-control rounded-3" rows="2"></textarea>
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label small fw-bold text-muted">Start Date</label>
                                <input type="date" name="StartDate" id="editStartDate" class="form-control rounded-3" required />
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-bold text-muted">End Date</label>
                                <input type="date" name="EndDate" id="editEndDate" class="form-control rounded-3" required />
                            </div>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" name="IsActive" value="true" class="form-check-input" id="editIsActiveChk" />
                            <label class="form-check-label small fw-bold" for="editIsActiveChk">Active Term Status</label>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-light rounded-3 fw-bold" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary rounded-3 fw-bold px-4">Update Term</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function openEditTermModal(id, yearId, name, desc, startDate, endDate, isActive) {
            document.getElementById('editExamTermId').value = id;
            document.getElementById('editAcademicYearId').value = yearId;
            document.getElementById('editTermName').value = name;
            document.getElementById('editDescription').value = desc;
            document.getElementById('editStartDate').value = startDate;
            document.getElementById('editEndDate').value = endDate;
            document.getElementById('editIsActiveChk').checked = isActive;

            const modal = new bootstrap.Modal(document.getElementById('editTermModal'));
            modal.show();
        }
    </script>
}
