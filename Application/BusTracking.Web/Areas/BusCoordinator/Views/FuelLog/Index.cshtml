@model BusTracking.Common.DTOs.Common.PagedResult<BusTracking.Common.Entities.BusFuelLog>
@{
    ViewData["Title"] = "Fuel & Mileage Logs";
    var buses = ViewBag.Buses as List<BusTracking.Common.Entities.Bus> ?? new();
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h2 class="fw-bold m-0"><i class="bi bi-fuel-pump-fill text-primary me-2"></i>Fuel & Mileage Logs</h2>
        <p class="text-secondary small mb-0">Track fuel fills, expenditure, and km/liter mileage efficiency</p>
    </div>
    <button type="button" class="btn btn-primary rounded-3" data-bs-toggle="modal" data-bs-target="#addFuelModal">
        <i class="bi bi-plus-circle me-2"></i>Record Fuel Fill
    </button>
</div>

<div class="premium-card rounded-4 border-0 p-4 mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-8">
            <select name="busId" class="form-select">
                <option value="">-- All Buses --</option>
                @foreach (var b in buses)
                {
                    <option value="@b.BusId" selected="@(ViewBag.SelectedBusId == b.BusId ? "selected" : null)">
                        @b.BusName (@b.BusNumber)
                    </option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-primary w-100 rounded-3"><i class="bi bi-filter me-2"></i>Filter Logs</button>
        </div>
    </form>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Date</th>
                    <th>Bus</th>
                    <th>Driver</th>
                    <th>Odometer (km)</th>
                    <th>Fuel (Liters)</th>
                    <th>Total Cost</th>
                    <th>Notes</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="8" class="text-center text-secondary py-5"><i class="bi bi-fuel-pump fs-1 d-block mb-2"></i>No fuel logs found.</td></tr>
                }
                @foreach (var f in Model.Items)
                {
                    <tr>
                        <td class="fw-semibold">@f.FuelDate.ToString("yyyy-MM-dd")</td>
                        <td><span class="badge bg-primary-subtle text-primary fw-bold">@f.Bus?.BusNumber</span></td>
                        <td>@(f.Driver?.FullName ?? "–")</td>
                        <td>@f.OdometerReading.ToString("N0") km</td>
                        <td class="fw-bold text-success">@f.FuelLiters.ToString("N2") L</td>
                        <td class="fw-bold">@f.TotalCost.ToString("N2")</td>
                        <td class="small text-muted">@(f.Notes ?? "–")</td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-warning rounded-3 edit-fuel-btn"
                                    data-id="@f.FuelLogId"
                                    data-busid="@f.BusId"
                                    data-odometer="@f.OdometerReading"
                                    data-liters="@f.FuelLiters"
                                    data-cost="@f.TotalCost"
                                    data-date="@f.FuelDate.ToString("yyyy-MM-dd")"
                                    data-notes="@(f.Notes ?? "")"
                                    data-bs-toggle="modal"
                                    data-bs-target="#editFuelModal">
                                <i class="bi bi-pencil me-1"></i>Edit
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pagination" model="Model" />

<!-- Add Fuel Modal -->
<div class="modal fade" id="addFuelModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold"><i class="bi bi-fuel-pump me-2 text-primary"></i>Record Fuel Fill</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Bus</label>
                        <select name="BusId" class="form-select" required>
                            <option value="">-- Select Bus --</option>
                            @foreach (var b in buses)
                            {
                                <option value="@b.BusId">@b.BusName (@b.BusNumber)</option>
                            }
                        </select>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">Odometer Reading (km)</label>
                            <input type="number" step="0.1" name="OdometerReading" class="form-control" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Fuel Liters</label>
                            <input type="number" step="0.01" name="FuelLiters" class="form-control" required />
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">Total Cost</label>
                            <input type="number" step="0.01" name="TotalCost" class="form-control" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Fuel Date</label>
                            <input type="date" name="FuelDate" class="form-control" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Notes</label>
                        <textarea name="Notes" class="form-control" rows="2" placeholder="Optional notes..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-3">Save Log</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Fuel Modal -->
<div class="modal fade" id="editFuelModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square me-2 text-warning"></i>Edit Fuel Log</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="FuelLogId" id="editFuelLogId" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Bus</label>
                        <select name="BusId" id="editBusId" class="form-select" required>
                            <option value="">-- Select Bus --</option>
                            @foreach (var b in buses)
                            {
                                <option value="@b.BusId">@b.BusName (@b.BusNumber)</option>
                            }
                        </select>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">Odometer Reading (km)</label>
                            <input type="number" step="0.1" name="OdometerReading" id="editOdometerReading" class="form-control" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Fuel Liters</label>
                            <input type="number" step="0.01" name="FuelLiters" id="editFuelLiters" class="form-control" required />
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">Total Cost</label>
                            <input type="number" step="0.01" name="TotalCost" id="editTotalCost" class="form-control" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Fuel Date</label>
                            <input type="date" name="FuelDate" id="editFuelDate" class="form-control" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Notes</label>
                        <textarea name="Notes" id="editNotes" class="form-control" rows="2" placeholder="Optional notes..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning rounded-3 fw-bold">Update Log</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll(".edit-fuel-btn").forEach(btn => {
            btn.addEventListener("click", function () {
                document.getElementById("editFuelLogId").value = this.dataset.id;
                document.getElementById("editBusId").value = this.dataset.busid;
                document.getElementById("editOdometerReading").value = this.dataset.odometer;
                document.getElementById("editFuelLiters").value = this.dataset.liters;
                document.getElementById("editTotalCost").value = this.dataset.cost;
                document.getElementById("editFuelDate").value = this.dataset.date;
                document.getElementById("editNotes").value = this.dataset.notes;
            });
        });
    });
</script>
