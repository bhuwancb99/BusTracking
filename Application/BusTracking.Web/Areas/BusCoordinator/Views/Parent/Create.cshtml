@model BusTracking.Common.DTOs.Parent.CreateParentDto
@{
    ViewData["Title"] = "Register New Parent";
}

<div class="container-fluid p-0">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="fw-bold m-0 text-dark">
                <i class="bi bi-person-plus-fill text-primary me-2"></i>Register New Parent
            </h2>
            <nav aria-label="breadcrumb" class="mt-1">
                <ol class="breadcrumb mb-0 small text-muted">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Dashboard")" class="text-decoration-none text-muted">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("Index")" class="text-decoration-none text-muted">Parents</a></li>
                    <li class="breadcrumb-item active text-primary" aria-current="page">Register Parent</li>
                </ol>
            </nav>
        </div>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary rounded-3 px-3">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-body p-4">
            <form asp-action="Create" method="post" id="createForm">
                @Html.AntiForgeryToken()

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2 border-0 rounded-3 mb-4" style="background-color: rgba(239, 68, 68, 0.15); color: #ef4444;">
                        <div asp-validation-summary="All"></div>
                    </div>
                }

                <!-- Section 1: Account Credentials -->
                <div class="mb-4">
                    <h6 class="fw-bold text-primary text-uppercase fs-7 mb-3"><i class="bi bi-shield-lock me-2"></i>Account Credentials</h6>
                    <div class="row g-3">
                        <div class="col-md-4 col-12">
                            <label asp-for="FullName" class="form-label fw-bold">Full Name <span class="text-danger">*</span></label>
                            <input asp-for="FullName" class="form-control rounded-3" placeholder="e.g. John Doe" required />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 col-12">
                            <label asp-for="UserName" class="form-label fw-bold">Username <span class="text-danger">*</span></label>
                            <input asp-for="UserName" id="UserNameInput" class="form-control rounded-3" placeholder="e.g. john.parent" required autocomplete="off" />
                            <span asp-validation-for="UserName" class="text-danger small"></span>
                            <div id="usernameCheckMsg" class="small mt-1"></div>
                        </div>
                        <div class="col-md-4 col-12">
                            <label asp-for="Password" class="form-label fw-bold">Password <span class="text-muted fw-normal">(Optional)</span></label>
                            <input asp-for="Password" type="password" class="form-control rounded-3" placeholder="Leave blank to auto-generate" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- Section 2: Contact Details -->
                <div class="mb-4 pt-3 border-top">
                    <h6 class="fw-bold text-primary text-uppercase fs-7 mb-3"><i class="bi bi-telephone me-2"></i>Contact Details</h6>
                    <div class="row g-3">
                        <div class="col-md-4 col-12">
                            <label asp-for="Email" class="form-label fw-bold">Email Address</label>
                            <input asp-for="Email" type="email" class="form-control rounded-3" placeholder="parent@school.edu" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 col-12">
                            <label asp-for="PhoneNumber" class="form-label fw-bold">Phone Number</label>
                            <input asp-for="PhoneNumber" class="form-control rounded-3" placeholder="+91 9876543210" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- Section 3: Link Students -->
                <div class="mb-4 pt-3 border-top">
                    <h6 class="fw-bold text-primary text-uppercase fs-7 mb-3"><i class="bi bi-mortarboard me-2"></i>Link Students</h6>
                    <div class="mb-3">
                        <div class="input-group rounded-3 overflow-hidden">
                            <span class="input-group-text bg-light border-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" id="studentSearch" class="form-control bg-light border-0" placeholder="Type student name or code to search…" autocomplete="off" />
                        </div>
                        <div id="studentSuggestions" class="dropdown-menu w-100 shadow-sm rounded-3"></div>
                        <small class="text-muted">Select students from the dropdown. Selected students appear below.</small>
                    </div>
                    <div id="selectedStudents" class="d-flex flex-wrap gap-2 mb-3"></div>
                    <div id="studentInputs"></div>
                </div>

                <!-- Section 4: Additional Options -->
                <div class="mb-4 pt-3 border-top">
                    <h6 class="fw-bold text-primary text-uppercase fs-7 mb-3"><i class="bi bi-gear me-2"></i>Options</h6>
                    <div class="form-check form-switch">
                        <input asp-for="SendEmail" class="form-check-input" type="checkbox" role="switch" id="sendEmailChk" style="width: 40px; height: 20px; cursor: pointer;" />
                        <label class="form-check-label fw-semibold ms-2" for="sendEmailChk">
                            Send welcome email with login credentials
                        </label>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 border-top pt-4">
                    <a href="@Url.Action("Index")" class="btn btn-light rounded-3 px-4">Cancel</a>
                    <button type="submit" id="submitBtn" class="btn btn-primary rounded-3 px-4 shadow-sm"><i class="bi bi-check-circle me-2"></i>Register Parent</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Username check
            var input = document.getElementById('UserNameInput');
            var msg = document.getElementById('usernameCheckMsg');
            var btn = document.getElementById('submitBtn');
            var timeout = null;

            if (input) {
                input.addEventListener('input', function() {
                    var val = input.value.trim();
                    clearTimeout(timeout);
                    if (val.length === 0) { if (msg) msg.textContent = ''; if (btn) btn.disabled = false; return; }
                    timeout = setTimeout(function() {
                        fetch('/Auth/CheckUsername?userName=' + encodeURIComponent(val))
                            .then(function(r) { return r.json(); })
                            .then(function(res) {
                                if (res.success) {
                                    if (msg) { msg.className = 'small mt-1 text-success'; msg.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i>Username is available'; }
                                    if (btn) btn.disabled = false;
                                } else {
                                    if (msg) { msg.className = 'small mt-1 text-danger'; msg.innerHTML = '<i class="bi bi-x-circle-fill me-1"></i>' + res.message; }
                                    if (btn) btn.disabled = true;
                                }
                            }).catch(function() { if (btn) btn.disabled = false; });
                    }, 400);
                });
            }

            // Student autocomplete
            var selected = {};
            var t;
            var searchInput = document.getElementById('studentSearch');
            if (searchInput) {
                searchInput.addEventListener('input', function() {
                    clearTimeout(t);
                    var q = this.value.trim();
                    if (q.length < 1) { hideSug(); return; }
                    t = setTimeout(function() { searchStudents(q); }, 250);
                });
            }
            document.addEventListener('click', function(e) { if (!e.target.closest('#studentSearch,#studentSuggestions')) hideSug(); });

            function searchStudents(q) {
                fetch('@Url.Action("SearchStudents")?q=' + encodeURIComponent(q))
                    .then(function(r) { return r.json(); })
                    .then(function(data) {
                        var box = document.getElementById('studentSuggestions');
                        box.innerHTML = '';
                        if (!data.length) {
                            var li = document.createElement('div');
                            li.className = 'dropdown-item text-muted'; li.textContent = 'No students found';
                            box.appendChild(li); box.classList.add('show'); return;
                        }
                        data.forEach(function(s) {
                            var a = document.createElement('a');
                            a.className = 'dropdown-item d-flex align-items-center gap-2'; a.href = '#';
                            a.innerHTML = '<code class="small">' + s.studentCode + '</code><span>' + s.fullName + '</span>' + (s.standardName ? '<span class="badge bg-secondary-subtle text-secondary ms-auto">' + s.standardName + '</span>' : '');
                            a.addEventListener('click', function(e) { e.preventDefault(); addStudent(s); document.getElementById('studentSearch').value = ''; hideSug(); });
                            box.appendChild(a);
                        });
                        box.classList.add('show');
                    });
            }

            function hideSug() { document.getElementById('studentSuggestions').classList.remove('show'); }

            function addStudent(s) {
                if (selected[s.studentId]) return;
                selected[s.studentId] = s;
                var chip = document.createElement('span');
                chip.className = 'badge bg-info-subtle text-info px-3 py-2 d-flex align-items-center gap-2';
                chip.id = 'chip-' + s.studentId;
                chip.innerHTML = '<i class="bi bi-mortarboard"></i><span>' + s.fullName + ' <code class="bg-transparent">' + s.studentCode + '</code></span><button type="button" class="btn btn-sm p-0 ms-1 text-danger" onclick="removeStudent(' + s.studentId + ')"><i class="bi bi-x-circle"></i></button>';
                document.getElementById('selectedStudents').appendChild(chip);
                var inp = document.createElement('input');
                inp.type = 'hidden'; inp.name = 'StudentCodes'; inp.value = s.studentCode; inp.id = 'sinp-' + s.studentId;
                document.getElementById('studentInputs').appendChild(inp);
            }

            window.removeStudent = function(id) {
                delete selected[id];
                var chip = document.getElementById('chip-' + id); if (chip) chip.remove();
                var sinp = document.getElementById('sinp-' + id); if (sinp) sinp.remove();
            };
        });
    </script>
}
