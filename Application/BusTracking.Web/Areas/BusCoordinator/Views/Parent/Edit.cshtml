@model BusTracking.Common.DTOs.Parent.UpdateParentDto
@{
    ViewData["Title"] = "Edit Parent Profile";
    int parentId = ViewBag.ParentId ?? 0;
}

<div class="container-fluid p-0">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="fw-bold m-0 text-dark">
                <i class="bi bi-person-gear text-primary me-2"></i>Edit Parent Profile
            </h2>
            <nav aria-label="breadcrumb" class="mt-1">
                <ol class="breadcrumb mb-0 small text-muted">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Dashboard")" class="text-decoration-none text-muted">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("Index")" class="text-decoration-none text-muted">Parents</a></li>
                    <li class="breadcrumb-item active text-primary" aria-current="page">Edit Parent</li>
                </ol>
            </nav>
        </div>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary rounded-3 px-3">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-body p-4">
            <form asp-action="Edit" asp-route-id="@parentId" method="post" id="editForm">
                @Html.AntiForgeryToken()

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2 border-0 rounded-3 mb-4" style="background-color: rgba(239, 68, 68, 0.15); color: #ef4444;">
                        <div asp-validation-summary="All"></div>
                    </div>
                }

                <!-- Section 1: Account Credentials -->
                <div class="mb-4">
                    <h6 class="fw-bold text-primary text-uppercase fs-7 mb-3"><i class="bi bi-shield-lock me-2"></i>Account Credentials</h6>
                    <div class="row g-3">
                        <div class="col-md-4 col-12">
                            <label asp-for="FullName" class="form-label fw-bold">Full Name <span class="text-danger">*</span></label>
                            <input asp-for="FullName" class="form-control rounded-3" required />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 col-12">
                            <label asp-for="UserName" class="form-label fw-bold">Username <span class="text-danger">*</span></label>
                            <input asp-for="UserName" id="UserNameInput" class="form-control rounded-3" required autocomplete="off" />
                            <span asp-validation-for="UserName" class="text-danger small"></span>
                            <div id="usernameCheckMsg" class="small mt-1"></div>
                        </div>
                        <div class="col-md-4 col-12">
                            <label asp-for="NewPassword" class="form-label fw-bold">New Password <span class="text-muted fw-normal">(Optional)</span></label>
                            <input asp-for="NewPassword" type="password" class="form-control rounded-3" placeholder="Leave blank to keep unchanged" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- Section 2: Contact Details -->
                <div class="mb-4 pt-3 border-top">
                    <h6 class="fw-bold text-primary text-uppercase fs-7 mb-3"><i class="bi bi-telephone me-2"></i>Contact Details</h6>
                    <div class="row g-3">
                        <div class="col-md-4 col-12">
                            <label asp-for="Email" class="form-label fw-bold">Email Address</label>
                            <input asp-for="Email" type="email" class="form-control rounded-3" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 col-12">
                            <label asp-for="PhoneNumber" class="form-label fw-bold">Phone Number</label>
                            <input asp-for="PhoneNumber" class="form-control rounded-3" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 col-12">
                            <label class="form-label fw-bold">Account Status</label>
                            <div class="form-control rounded-3 d-flex align-items-center justify-content-between bg-light">
                                <span class="fw-semibold text-secondary small">Active Status</span>
                                <div class="form-check form-switch mb-0">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="isActiveSwitch" style="width: 40px; height: 20px; cursor: pointer;" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Section 3: Link Students -->
                <div class="mb-4 pt-3 border-top">
                    <h6 class="fw-bold text-primary text-uppercase fs-7 mb-3"><i class="bi bi-mortarboard me-2"></i>Linked Students</h6>
                    <p class="text-muted small mb-2">Current students are pre-selected. Search to add more or remove existing ones.</p>
                    <div class="mb-3">
                        <div class="input-group rounded-3 overflow-hidden">
                            <span class="input-group-text bg-light border-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" id="studentSearch" class="form-control bg-light border-0" placeholder="Type student name or code to search…" autocomplete="off" />
                        </div>
                        <div id="studentSuggestions" class="dropdown-menu w-100 shadow-sm rounded-3"></div>
                    </div>
                    <div id="selectedStudents" class="d-flex flex-wrap gap-2 mb-3">
                        @{
                            var studentMap = ViewBag.StudentMap as Dictionary<string, string> ?? new Dictionary<string, string>();
                        }
                        @foreach (var code in Model.StudentCodes)
                        {
                            var name = studentMap.TryGetValue(code, out var n) ? n : "";
                            <span class="badge bg-info-subtle text-info px-3 py-2 d-flex align-items-center gap-2 chip-student" data-code="@code">
                                <i class="bi bi-mortarboard"></i>
                                <span>@(name.Length > 0 ? $"{name} " : "")<code class="bg-transparent">@code</code></span>
                                <button type="button" class="btn btn-sm p-0 ms-1 text-danger" onclick="removeStudent(this)">
                                    <i class="bi bi-x-circle"></i>
                                </button>
                                <input type="hidden" name="StudentCodes" value="@code" />
                            </span>
                        }
                    </div>
                    <div id="studentInputs"></div>
                </div>

                <div class="d-flex justify-content-end gap-2 border-top pt-4">
                    <a href="@Url.Action("Index")" class="btn btn-light rounded-3 px-4">Cancel</a>
                    <button type="submit" id="submitBtn" class="btn btn-primary rounded-3 px-4 shadow-sm"><i class="bi bi-save me-2"></i>Save Changes</button>
                    <button type="button" class="btn btn-outline-danger rounded-3 px-3 ms-auto" onclick="confirmResetPassword()">
                        <i class="bi bi-key me-1"></i>Reset Password
                    </button>
                </div>
            </form>

            <div id="pwdResult" class="mt-4" style="display:none;">
                <div class="alert alert-success border-0 rounded-4 d-flex align-items-start gap-3 bg-success-subtle border-start border-4 border-success">
                    <i class="bi bi-shield-check fs-3 text-success mt-1"></i>
                    <div>
                        <div class="fw-bold mb-1 text-success">Password Reset Successfully</div>
                        <div class="mb-1 small text-muted">New generated password for <span id="pwdName" class="fw-bold text-dark"></span>:</div>
                        <div class="d-flex align-items-center gap-2 mt-2">
                            <code id="pwdValue" class="fs-5 px-3 py-1 bg-white border rounded text-danger fw-bold font-monospace"></code>
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-circle" onclick="copyPwd()" title="Copy Password">
                                <i class="bi bi-clipboard"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var parentId = '@parentId';

            // Username check
            var input = document.getElementById('UserNameInput');
            var msg = document.getElementById('usernameCheckMsg');
            var btn = document.getElementById('submitBtn');
            var timeout = null;

            if (input) {
                input.addEventListener('input', function() {
                    var val = input.value.trim();
                    clearTimeout(timeout);
                    if (val.length === 0) { if (msg) msg.textContent = ''; if (btn) btn.disabled = false; return; }
                    timeout = setTimeout(function() {
                        fetch('/Auth/CheckUsername?userName=' + encodeURIComponent(val) + '&excludeUserId=' + parentId)
                            .then(function(r) { return r.json(); })
                            .then(function(res) {
                                if (res.success) {
                                    if (msg) { msg.className = 'small mt-1 text-success'; msg.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i>Username is available'; }
                                    if (btn) btn.disabled = false;
                                } else {
                                    if (msg) { msg.className = 'small mt-1 text-danger'; msg.innerHTML = '<i class="bi bi-x-circle-fill me-1"></i>' + res.message; }
                                    if (btn) btn.disabled = true;
                                }
                            }).catch(function() { if (btn) btn.disabled = false; });
                    }, 400);
                });
            }

            // Student autocomplete
            var existingCodes = new Set(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StudentCodes)));
            var t;
            var searchInput = document.getElementById('studentSearch');
            if (searchInput) {
                searchInput.addEventListener('input', function() {
                    clearTimeout(t);
                    var q = this.value.trim();
                    if (q.length < 1) { hideSug(); return; }
                    t = setTimeout(function() { searchStudents(q); }, 250);
                });
            }
            document.addEventListener('click', function(e) { if (!e.target.closest('#studentSearch,#studentSuggestions')) hideSug(); });

            function searchStudents(q) {
                fetch('@Url.Action("SearchStudents")?q=' + encodeURIComponent(q))
                    .then(function(r) { return r.json(); })
                    .then(function(data) {
                        var box = document.getElementById('studentSuggestions');
                        box.innerHTML = '';
                        if (!data.length) {
                            var li = document.createElement('div');
                            li.className = 'dropdown-item text-muted'; li.textContent = 'No students found';
                            box.appendChild(li); box.classList.add('show'); return;
                        }
                        data.forEach(function(s) {
                            var already = existingCodes.has(s.studentCode);
                            var a = document.createElement('a');
                            a.className = 'dropdown-item d-flex align-items-center gap-2' + (already ? ' text-muted' : '');
                            a.href = '#';
                            a.innerHTML = '<span>' + s.fullName + ' <code class="small">' + s.studentCode + '</code>' + (s.standardName ? ' <span class="badge bg-secondary-subtle text-secondary">' + s.standardName + '</span>' : '') + '</span>' + (already ? ' <span class="badge bg-success-subtle text-success ms-auto">Added</span>' : '');
                            if (!already) a.addEventListener('click', function(e) { e.preventDefault(); addStudent(s); document.getElementById('studentSearch').value = ''; hideSug(); });
                            box.appendChild(a);
                        });
                        box.classList.add('show');
                    });
            }

            function hideSug() { document.getElementById('studentSuggestions').classList.remove('show'); }

            function addStudent(s) {
                if (existingCodes.has(s.studentCode)) return;
                existingCodes.add(s.studentCode);
                var chip = document.createElement('span');
                chip.className = 'badge bg-info-subtle text-info px-3 py-2 d-flex align-items-center gap-2 chip-student';
                chip.dataset.code = s.studentCode;
                chip.innerHTML = '<i class="bi bi-mortarboard"></i><span>' + s.fullName + ' <code class="bg-transparent">' + s.studentCode + '</code></span><button type="button" class="btn btn-sm p-0 ms-1 text-danger" onclick="removeStudent(this)"><i class="bi bi-x-circle"></i></button><input type="hidden" name="StudentCodes" value="' + s.studentCode + '"/>';
                document.getElementById('selectedStudents').appendChild(chip);
            }

            window.removeStudent = function(btn) {
                var chip = btn.closest('.chip-student');
                existingCodes.delete(chip.dataset.code);
                chip.remove();
            };
        });

        function confirmResetPassword() {
            if (!confirm('Reset password for this parent? A new password will be generated and shown once.')) return;
            doResetPassword();
        }

        async function doResetPassword() {
            var id = '@ViewBag.ParentId';
            var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            var res = await fetch('@Url.Action("ResetPassword")?id=' + id, {
                method: 'POST',
                headers: { 'RequestVerificationToken': token || '' }
            });
            var data = await res.json();
            if (data.success) {
                document.getElementById('pwdName').textContent = data.fullName + ' (' + data.email + ')';
                document.getElementById('pwdValue').textContent = data.password;
                document.getElementById('pwdResult').style.display = '';
                document.getElementById('pwdResult').scrollIntoView({ behavior: 'smooth' });
            } else {
                alert('Error: ' + data.message);
            }
        }

        function copyPwd() {
            navigator.clipboard.writeText(document.getElementById('pwdValue').textContent);
            alert('Password copied!');
        }
    </script>
}
