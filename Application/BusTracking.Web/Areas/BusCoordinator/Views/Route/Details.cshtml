@model BusTracking.Common.DTOs.Route.RouteDetailDto
@{
    ViewData["Title"] = "Route Details - " + Model.RouteName;
}

<div class="container-fluid p-0">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="fw-bold m-0 text-dark">
                <i class="bi bi-map text-primary me-2"></i>Route Overview & Stops
            </h2>
            <nav aria-label="breadcrumb" class="mt-1">
                <ol class="breadcrumb mb-0 small text-muted">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Dashboard")" class="text-decoration-none text-muted">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("Index")" class="text-decoration-none text-muted">Routes</a></li>
                    <li class="breadcrumb-item active text-primary" aria-current="page">Route Details</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Edit", new { id = Model.RouteId })" class="btn btn-primary rounded-3 px-3 shadow-sm">
                <i class="bi bi-pencil-fill me-1"></i> Edit Route
            </a>
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary rounded-3 px-3">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        </div>
    </div>

    @if (Model is not null)
    {
        <div class="row g-4">
            <div class="col-lg-4 col-12">
                <!-- Route Identification -->
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                            <div class="rounded-circle bg-primary-subtle text-primary p-3 d-flex align-items-center justify-content-center border border-primary-subtle" style="width:52px; height:52px;">
                                <i class="bi bi-map fs-3"></i>
                            </div>
                            <div>
                                <h4 class="fw-bold text-dark mb-1">@Model.RouteName</h4>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace px-3 py-1">@Model.RouteCode</span>
                                    <span class="badge @(Model.IsActive ? "bg-success-subtle text-success border border-success-subtle" : "bg-danger-subtle text-danger border border-danger-subtle") rounded-pill px-3 py-1">
                                        <i class="bi bi-circle-fill me-1 fs-7"></i>@(Model.IsActive ? "Active" : "Inactive")
                                    </span>
                                </div>
                            </div>
                        </div>

                        <h6 class="fw-bold text-primary text-uppercase fs-7 mb-3"><i class="bi bi-clock me-2"></i>Schedule & Information</h6>
                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <small class="text-muted d-block"><i class="bi bi-sunrise me-1 text-warning"></i>Morning Pickup</small>
                                <span class="fw-bold text-dark">@(string.IsNullOrWhiteSpace(Model.MorningTime) ? "N/A" : Model.MorningTime)</span>
                            </div>
                            <div class="col-6">
                                <small class="text-muted d-block"><i class="bi bi-sunset me-1 text-secondary"></i>Evening Drop</small>
                                <span class="fw-bold text-dark">@(string.IsNullOrWhiteSpace(Model.EveningTime) ? "N/A" : Model.EveningTime)</span>
                            </div>
                            <div class="col-12">
                                <small class="text-muted d-block">Description</small>
                                <span class="text-secondary small">@(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)</span>
                            </div>
                            <div class="col-12">
                                <small class="text-muted d-block">Total Route Stops</small>
                                <span class="badge bg-info-subtle text-info border border-info-subtle font-monospace px-3 py-1">@Model.StopCount Stops Defined</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Add Stop Panel -->
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                    <div class="card-body p-4">
                        <h6 class="fw-bold text-primary text-uppercase fs-7 mb-3"><i class="bi bi-pin-map me-2"></i>Add Route Stop</h6>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Stop Name <span class="text-danger">*</span></label>
                            <input type="text" id="stopName" class="form-control rounded-3" placeholder="e.g. City Park Gate" />
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label fw-bold small">Morning</label>
                                <input type="time" id="stopMorning" class="form-control rounded-3" />
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-bold small">Evening</label>
                                <input type="time" id="stopEvening" class="form-control rounded-3" />
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-bold small">Latitude</label>
                                <input type="number" step="0.0000001" id="stopLat" class="form-control rounded-3" placeholder="20.593…" />
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-bold small">Longitude</label>
                                <input type="number" step="0.0000001" id="stopLng" class="form-control rounded-3" placeholder="78.962…" />
                            </div>
                        </div>
                        <button class="btn btn-primary rounded-3 w-100 shadow-sm" id="btnAddStop">
                            <i class="bi bi-plus-circle me-1"></i>Add Stop
                        </button>
                    </div>
                </div>
            </div>

            <div class="col-lg-8 col-12">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="fw-bold text-primary text-uppercase fs-7 m-0"><i class="bi bi-signpost-split me-2"></i>Stops on this Route</h6>
                            @if (Model.Stops.Count > 0)
                            {
                                <div class="d-flex gap-2">
                                    <button class="btn btn-outline-primary btn-sm rounded-3" id="btnUpdateRecords">
                                        <i class="bi bi-pencil-square me-1"></i>Update Records
                                    </button>
                                    <button class="btn btn-success btn-sm rounded-3 d-none" id="btnSaveRecords">
                                        <i class="bi bi-check-lg me-1"></i>Save
                                    </button>
                                    <button class="btn btn-outline-secondary btn-sm rounded-3 d-none" id="btnCancelEdit">
                                        <i class="bi bi-x me-1"></i>Cancel
                                    </button>
                                </div>
                            }
                        </div>

                        @if (Model.Stops.Count == 0)
                        {
                            <div class="text-center text-muted py-5">
                                <i class="bi bi-geo text-secondary opacity-50 display-4 d-block mb-2"></i>
                                No stops added to this route yet. Use the form on the left to add a stop.
                            </div>
                        }
                        else
                        {
                            <div class="stop-cards-container" id="stopList">
                                @foreach (var stop in Model.Stops)
                                {
                                    var isFirst = stop.StopOrder == 1;
                                    var isLast = stop.StopOrder == Model.Stops.Count;
                                    var borderClass = isFirst ? "border-start border-4 border-success" : (isLast ? "border-start border-4 border-danger" : "border-start border-4 border-primary");
                                    var badgeClass = isFirst ? "bg-success text-white" : (isLast ? "bg-danger text-white" : "bg-primary text-white");

                                    <div class="stop-item card border-0 shadow-sm mb-3 position-relative rounded-4" id="stop-@stop.StopId" data-stop-id="@stop.StopId">
                                        <div class="view-mode card-body p-3 @borderClass rounded-4">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="badge @badgeClass rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-size: 14px;">@stop.StopOrder</span>
                                                    <h6 class="fw-bold mb-0 text-dark stop-name-text">@stop.StopName</h6>
                                                </div>
                                                <button class="btn btn-sm btn-light text-danger rounded-circle p-1 px-2 btn-del-stop" data-stop-id="@stop.StopId" title="Remove Stop">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                            <div class="d-flex flex-wrap gap-2 mt-2 align-items-center">
                                                <span class="badge bg-warning-subtle text-dark border border-warning-subtle p-2 fw-semibold rounded-3">
                                                    <i class="bi bi-sunrise-fill text-warning me-1"></i>Morning: <strong class="stop-morning-text ms-1">@(stop.MorningTime ?? "—")</strong>
                                                </span>
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle p-2 fw-semibold rounded-3">
                                                    <i class="bi bi-sunset-fill text-primary me-1"></i>Evening: <strong class="stop-evening-text ms-1">@(stop.EveningTime ?? "—")</strong>
                                                </span>
                                                <span class="badge bg-light text-secondary border p-2 fw-normal rounded-3">
                                                    <i class="bi bi-compass-fill text-info me-1"></i><span class="stop-coords-text">@(stop.Latitude.HasValue && stop.Longitude.HasValue ? $"{stop.Latitude}, {stop.Longitude}" : "—")</span>
                                                </span>
                                            </div>
                                        </div>

                                        <div class="edit-mode card-body p-3 bg-light-subtle border border-primary border-opacity-50 rounded-4 shadow-sm d-none">
                                            <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                                                <span class="fw-bold text-primary small"><i class="bi bi-sliders me-1"></i>Edit Stop Record</span>
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill">Stop #@stop.StopOrder</span>
                                            </div>
                                            <div class="row g-2">
                                                <div class="col-md-3 col-4">
                                                    <label class="form-label fw-bold text-muted small mb-1">Order #</label>
                                                    <input type="number" min="1" class="form-control rounded-3 stop-order-input fw-bold" value="@stop.StopOrder" />
                                                </div>
                                                <div class="col-md-9 col-8">
                                                    <label class="form-label fw-bold text-muted small mb-1">Stop Name <span class="text-danger">*</span></label>
                                                    <input type="text" class="form-control rounded-3 stop-name-input fw-bold" value="@stop.StopName" />
                                                </div>
                                                <div class="col-md-3 col-6">
                                                    <label class="form-label fw-bold text-muted small mb-1">Morning</label>
                                                    <input type="time" class="form-control rounded-3 stop-morning-input" value="@stop.MorningTime" />
                                                </div>
                                                <div class="col-md-3 col-6">
                                                    <label class="form-label fw-bold text-muted small mb-1">Evening</label>
                                                    <input type="time" class="form-control rounded-3 stop-evening-input" value="@stop.EveningTime" />
                                                </div>
                                                <div class="col-md-3 col-6">
                                                    <label class="form-label fw-bold text-muted small mb-1">Latitude</label>
                                                    <input type="number" step="0.0000001" class="form-control rounded-3 stop-lat-input" value="@stop.Latitude" />
                                                </div>
                                                <div class="col-md-3 col-6">
                                                    <label class="form-label fw-bold text-muted small mb-1">Longitude</label>
                                                    <input type="number" step="0.0000001" class="form-control rounded-3 stop-lng-input" value="@stop.Longitude" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        const routeId = @Model?.RouteId;

        const btnUpdateRecords = document.getElementById('btnUpdateRecords');
        const btnSaveRecords = document.getElementById('btnSaveRecords');
        const btnCancelEdit = document.getElementById('btnCancelEdit');

        btnUpdateRecords?.addEventListener('click', () => {
            document.querySelectorAll('.view-mode').forEach(el => el.classList.add('d-none'));
            document.querySelectorAll('.edit-mode').forEach(el => el.classList.remove('d-none'));
            btnUpdateRecords.classList.add('d-none');
            btnSaveRecords.classList.remove('d-none');
            btnCancelEdit.classList.remove('d-none');
        });

        btnCancelEdit?.addEventListener('click', () => {
            document.querySelectorAll('.view-mode').forEach(el => el.classList.remove('d-none'));
            document.querySelectorAll('.edit-mode').forEach(el => el.classList.add('d-none'));
            btnUpdateRecords.classList.remove('d-none');
            btnSaveRecords.classList.add('d-none');
            btnCancelEdit.classList.add('d-none');
        });

        btnSaveRecords?.addEventListener('click', async () => {
            const stopItems = document.querySelectorAll('.stop-item');
            const stopsData = [];
            let orders = [];
            let valid = true;

            stopItems.forEach(item => {
                const stopId = parseInt(item.dataset.stopId);
                const order = parseInt(item.querySelector('.stop-order-input').value);
                const name = item.querySelector('.stop-name-input').value.trim();
                const morning = item.querySelector('.stop-morning-input').value || null;
                const evening = item.querySelector('.stop-evening-input').value || null;
                const latVal = item.querySelector('.stop-lat-input').value;
                const lngVal = item.querySelector('.stop-lng-input').value;
                const lat = latVal === "" ? null : parseFloat(latVal);
                const lng = lngVal === "" ? null : parseFloat(lngVal);

                if (!name) {
                    alert('Stop name is required for all stops.');
                    valid = false;
                    return;
                }

                orders.push(order);
                stopsData.push({
                    stopId,
                    stopName: name,
                    stopOrder: order,
                    morningTime: morning,
                    eveningTime: evening,
                    latitude: lat,
                    longitude: lng
                });
            });

            if (!valid) return;

            if (new Set(orders).size !== orders.length) {
                alert('Order numbers must be unique.');
                return;
            }

            const payload = { routeId: routeId, stops: stopsData };
            const tok = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
            const res = await fetch('@Url.Action("UpdateStops")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': tok },
                body: JSON.stringify(payload)
            });
            const result = await res.json();
            if (result.success) {
                location.reload();
            } else {
                alert(result.message);
            }
        });

        document.getElementById('btnAddStop')?.addEventListener('click', async () => {
            const name = document.getElementById('stopName').value.trim();
            if (!name) { alert('Stop name is required.'); return; }
            const data = {
                routeId,
                stopName: name,
                morningTime: document.getElementById('stopMorning').value || null,
                eveningTime: document.getElementById('stopEvening').value || null,
                latitude: parseFloat(document.getElementById('stopLat').value) || null,
                longitude: parseFloat(document.getElementById('stopLng').value) || null
            };
            const tok = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
            const res = await fetch('@Url.Action("AddStop")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': tok },
                body: JSON.stringify(data)
            });
            const result = await res.json();
            if (result.success) location.reload();
            else alert(result.message);
        });

        document.querySelectorAll('.btn-del-stop').forEach(btn => {
            btn.addEventListener('click', async function() {
                if (!confirm('Remove this stop?')) return;
                const stopId = this.dataset.stopId;
                const tok = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
                const res = await fetch(`@Url.Action("DeleteStop")?stopId=${stopId}`, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': tok }
                });
                const result = await res.json();
                if (result.success) location.reload();
                else alert(result.message);
            });
        });
    </script>
}
