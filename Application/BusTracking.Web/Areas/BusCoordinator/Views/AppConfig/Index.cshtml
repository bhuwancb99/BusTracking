@model BusTracking.Common.DTOs.Common.PagedResult<BusTracking.Common.DTOs.AppConfig.AppConfigDto>
@{
    ViewData["Title"] = "App Configuration";
    var platformFilter = ViewBag.Platform as string;
    var searchFilter = ViewBag.Search as string;
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
    <div>
        <h2 class="fw-bold m-0 text-dark">
            <i class="bi bi-sliders text-primary me-2"></i>App Configuration
        </h2>
        <nav aria-label="breadcrumb" class="mt-1">
            <ol class="breadcrumb mb-0 small text-muted">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Dashboard")" class="text-decoration-none text-muted">Dashboard</a></li>
                <li class="breadcrumb-item active text-primary" aria-current="page">App Configuration</li>
            </ol>
        </nav>
    </div>
    <a href="@Url.Action("Create")" class="btn btn-primary rounded-3 shadow-sm px-4">
        <i class="bi bi-plus-lg me-2"></i>Add Configuration
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4 col-lg-3">
                <select name="platform" class="form-select bg-light border-0 rounded-3" onchange="this.form.submit()">
                    <option value="Both" selected="@(string.IsNullOrEmpty(platformFilter) || platformFilter == "Both")">Web & Mobile</option>
                    <option value="Web" selected="@(platformFilter == "Web")">Web only</option>
                    <option value="Mobile" selected="@(platformFilter == "Mobile")">Mobile only</option>
                </select>
            </div>
            <div class="col-md-5 col-lg-6">
                <div class="input-group">
                    <span class="input-group-text bg-light border-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" value="@searchFilter" class="form-control bg-light border-0" placeholder="Search config key or value..." />
                </div>
            </div>
            <div class="col-md-3 col-lg-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill rounded-3"><i class="bi bi-filter me-1"></i>Filter</button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary rounded-3"><i class="bi bi-arrow-counterclockwise"></i> Reset</a>
            </div>
        </form>
    </div>
</div>

@{
    var grouped = Model.Items.GroupBy(c => c.Platform).OrderBy(g => g.Key);
}

@if (!Model.Items.Any())
{
    <div class="card border-0 shadow-sm rounded-4 text-center py-5 mb-4">
        <i class="bi bi-sliders text-secondary opacity-50 display-4"></i>
        <p class="mt-2 mb-0 fw-semibold fs-6">No configurations found</p>
        <span class="small text-muted">Click <strong>Add Configuration</strong> to create the first setting.</span>
    </div>
}
else
{
    @foreach (var group in grouped)
    {
        var badgeStyle = group.Key switch
        {
            "Mobile" => "bg-primary-subtle text-primary border border-primary-subtle",
            "Web" => "bg-success-subtle text-success border border-success-subtle",
            _ => "bg-secondary-subtle text-secondary border"
        };
        var icon = group.Key switch
        {
            "Mobile" => "bi-phone",
            "Web" => "bi-globe",
            _ => "bi-layers"
        };

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
            <div class="card-header bg-light-subtle border-bottom py-3 px-4 d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi @icon text-primary fs-5"></i>
                    <span class="fw-bold text-dark fs-6">@group.Key Platform</span>
                </div>
                <span class="badge @badgeStyle rounded-pill px-3 py-2 fs-7">@group.Count() Keys</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light-subtle border-bottom">
                        <tr class="text-uppercase fs-7 text-muted fw-bold">
                            <th class="ps-4">Config Key</th>
                            <th>Value</th>
                            <th>Description</th>
                            <th style="width: 100px;" class="text-center">Status</th>
                            <th>Updated</th>
                            <th style="width: 160px;" class="text-center pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in group.OrderBy(x => x.ConfigKey))
                        {
                            <tr id="row-@c.ConfigId">
                                <td class="ps-4">
                                    <code class="fw-bold text-primary font-monospace fs-7">@c.ConfigKey</code>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border font-monospace text-wrap text-start" style="max-width:280px;" title="@c.ConfigValue">
                                        @(c.ConfigValue.Length > 40 ? c.ConfigValue[..40] + "…" : c.ConfigValue)
                                    </span>
                                </td>
                                <td class="text-secondary small">@(c.Description ?? "-")</td>
                                <td class="text-center">
                                    <div class="form-check form-switch d-inline-block">
                                        <input type="checkbox" class="form-check-input btn-toggle-config" style="cursor: pointer; width: 38px; height: 20px;" data-id="@c.ConfigId" @(c.IsActive ? "checked" : "") />
                                    </div>
                                </td>
                                <td class="text-secondary small">@c.UpdatedAt.ToString("dd MMM yyyy")</td>
                                <td class="text-center pe-4">
                                    <a href="@Url.Action("Details", new { id = c.ConfigId })" class="btn btn-outline-info btn-sm rounded-3 px-2 py-1 me-1" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a href="@Url.Action("Edit", new { id = c.ConfigId })" class="btn btn-outline-primary btn-sm rounded-3 px-2 py-1 me-1" title="Edit Configuration">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@c.ConfigId" method="post" class="d-inline" onsubmit="return confirm('Delete configuration key \'@c.ConfigKey\'?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-3 px-2 py-1" title="Delete Configuration">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <partial name="_Pagination" model="Model" />
}

@section Scripts {
    <script>
        document.querySelectorAll('.btn-toggle-config').forEach(btn => {
            btn.addEventListener('change', async function () {
                const id = this.dataset.id;
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
                const res = await fetch('@Url.Action("Toggle")/' + id, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token }
                });
                const data = await res.json();
                if (!data.success) {
                    this.checked = !this.checked;
                    alert(data.message || 'Failed to update status.');
                }
            });
        });
    </script>
}
