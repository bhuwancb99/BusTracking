@model BusTracking.Common.DTOs.AppConfig.UpdateAppConfigDto
@{
    ViewData["Title"] = "Edit App Configuration";
    int configId = ViewBag.ConfigId ?? 0;
}

<div class="container-fluid p-0">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="fw-bold m-0 text-dark">
                <i class="bi bi-pencil-square text-primary me-2"></i>Edit App Configuration
            </h2>
            <nav aria-label="breadcrumb" class="mt-1">
                <ol class="breadcrumb mb-0 small text-muted">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Dashboard")" class="text-decoration-none text-muted">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("Index")" class="text-decoration-none text-muted">App Configuration</a></li>
                    <li class="breadcrumb-item active text-primary" aria-current="page">Edit Config</li>
                </ol>
            </nav>
        </div>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary rounded-3 px-3">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-body p-4">
            <form asp-action="Edit" asp-route-id="@configId" method="post">
                @Html.AntiForgeryToken()

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2 border-0 rounded-3 mb-4" style="background-color: rgba(239, 68, 68, 0.15); color: #ef4444;">
                        <div asp-validation-summary="All"></div>
                    </div>
                }

                <div class="mb-4">
                    <h6 class="fw-bold text-primary text-uppercase fs-7 mb-3"><i class="bi bi-sliders me-2"></i>Configuration Settings</h6>
                    <div class="row g-3">
                        <div class="col-md-6 col-12">
                            <label asp-for="ConfigKey" class="form-label fw-bold">Config Key <span class="text-danger">*</span></label>
                            <input asp-for="ConfigKey" class="form-control rounded-3 font-monospace" required />
                            <span asp-validation-for="ConfigKey" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 col-12">
                            <label asp-for="Platform" class="form-label fw-bold">Target Platform</label>
                            <select asp-for="Platform" class="form-select rounded-3">
                                <option value="Both">Both (Web + Mobile)</option>
                                <option value="Web">Web only</option>
                                <option value="Mobile">Mobile only</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label asp-for="ConfigValue" class="form-label fw-bold">Config Value <span class="text-danger">*</span></label>
                            <textarea asp-for="ConfigValue" class="form-control rounded-3 font-monospace" rows="3" required></textarea>
                            <span asp-validation-for="ConfigValue" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-bold">Description</label>
                            <input asp-for="Description" class="form-control rounded-3" />
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 col-12 mt-3">
                            <label class="form-label fw-bold">Status</label>
                            <div class="form-control rounded-3 d-flex align-items-center justify-content-between bg-light">
                                <span class="fw-semibold text-secondary small">Active Config</span>
                                <div class="form-check form-switch mb-0">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" style="width: 40px; height: 20px; cursor: pointer;" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 border-top pt-4">
                    <a href="@Url.Action("Index")" class="btn btn-light rounded-3 px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary rounded-3 px-4 shadow-sm"><i class="bi bi-save me-2"></i>Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
