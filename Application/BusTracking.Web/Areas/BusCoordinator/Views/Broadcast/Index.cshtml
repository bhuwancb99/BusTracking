@model BusTracking.Common.Models.BroadcastModel
@{
    ViewData["Title"] = "Broadcast Message";
}

<div class="container-fluid p-0">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="fw-bold m-0 text-dark">
                <i class="bi bi-megaphone-fill text-primary me-2"></i>Broadcast Message
            </h2>
            <nav aria-label="breadcrumb" class="mt-1">
                <ol class="breadcrumb mb-0 small text-muted">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Dashboard")" class="text-decoration-none text-muted">Dashboard</a></li>
                    <li class="breadcrumb-item active text-primary" aria-current="page">Broadcast Message</li>
                </ol>
            </nav>
        </div>
    </div>



    <form asp-action="Send" method="post" id="broadcastForm">
        @Html.AntiForgeryToken()

        <div class="row g-4">
            <!-- Left Column: Role & Recipient Selection -->
            <div class="col-lg-7 col-xl-7">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4 d-flex flex-column">
                        <h6 class="fw-bold text-primary text-uppercase fs-7 mb-3">
                            <i class="bi bi-people-fill me-2"></i>1. Target Recipients
                        </h6>

                        <!-- Role Selector Dropdown -->
                        <div class="mb-4">
                            <label asp-for="SelectedRoleId" class="form-label fw-bold">Target Role <span class="text-danger">*</span></label>
                            <select id="roleSelect" asp-for="SelectedRoleId" asp-items="Model.Roles" class="form-select rounded-3">
                                <option value="">-- Select Target Role --</option>
                            </select>
                            <span asp-validation-for="SelectedRoleId" class="text-danger small"></span>
                        </div>

                        <!-- Users Filter & Actions Header -->
                        <div id="usersHeader" class="d-none mb-3">
                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 bg-light p-2 rounded-3 border">
                                <div class="input-group input-group-sm w-auto flex-grow-1" style="max-width: 260px;">
                                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                                    <input type="text" id="userSearchInput" class="form-control border-start-0" placeholder="Search user..." />
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <button type="button" id="selectAllBtn" class="btn btn-sm btn-outline-primary fw-bold rounded-3"><i class="bi bi-check-all me-1"></i>Select All</button>
                                    <button type="button" id="deselectAllBtn" class="btn btn-sm btn-outline-secondary fw-bold rounded-3"><i class="bi bi-x-circle me-1"></i>Deselect All</button>
                                    <span id="selectedBadge" class="badge bg-primary rounded-pill px-3 py-2">Selected: 0</span>
                                </div>
                            </div>
                        </div>

                        <!-- Users Scrollable Container -->
                        <div id="usersContainer" class="flex-grow-1 overflow-auto border rounded-3 p-3 bg-white" style="min-height: 280px; max-height: 380px;">
                            <div id="emptyState" class="text-center py-5 text-muted">
                                <i class="bi bi-person-lines-fill fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                <span class="fw-semibold">Select a Target Role above to view available users.</span>
                            </div>
                        </div>

                        <span asp-validation-for="SelectedUserIds" class="text-danger small mt-2 d-block"></span>
                    </div>
                </div>
            </div>

            <!-- Right Column: Message Details & Send Action -->
            <div class="col-lg-5 col-xl-5">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4 d-flex flex-column">
                        <h6 class="fw-bold text-primary text-uppercase fs-7 mb-3">
                            <i class="bi bi-envelope-paper-fill me-2"></i>2. Compose Broadcast
                        </h6>

                        <!-- Category/Type Dropdown -->
                        <div class="mb-3">
                            <label asp-for="NotificationType" class="form-label fw-bold">Notification Category</label>
                            <select asp-for="NotificationType" class="form-select rounded-3">
                                <option value="Broadcast">📢 General Broadcast</option>
                                <option value="ContentUpdate">ℹ️ Announcement</option>
                                <option value="ActivityUpdate">🔔 System Alert</option>
                                <option value="RouteChanged">🚌 Trip / Route Update</option>
                            </select>
                        </div>

                        <!-- Title Input -->
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <label asp-for="Title" class="form-label fw-bold">Title <span class="text-danger">*</span></label>
                                <span id="titleCounter" class="text-muted small">0 / 150</span>
                            </div>
                            <input asp-for="Title" id="msgTitle" class="form-control rounded-3" placeholder="e.g. Important Announcement" maxlength="150" required />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <!-- Message Body Input -->
                        <div class="mb-4 flex-grow-1">
                            <div class="d-flex justify-content-between align-items-center">
                                <label asp-for="Body" class="form-label fw-bold">Message Content <span class="text-danger">*</span></label>
                                <span id="bodyCounter" class="text-muted small">0 / 1000</span>
                            </div>
                            <textarea asp-for="Body" id="msgBody" class="form-control rounded-3" rows="5" placeholder="Write your message here..." maxlength="1000" required></textarea>
                            <span asp-validation-for="Body" class="text-danger small"></span>
                        </div>

                        <!-- Submit Button -->
                        <div class="pt-3 border-top mt-auto">
                            <button type="submit" id="sendBtn" class="btn btn-primary w-100 py-2.5 rounded-3 fw-bold shadow-sm">
                                <i class="bi bi-send-fill me-2"></i>Send Broadcast Message
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const roleSelect = document.getElementById('roleSelect');
            const usersHeader = document.getElementById('usersHeader');
            const usersContainer = document.getElementById('usersContainer');
            const userSearchInput = document.getElementById('userSearchInput');
            const selectAllBtn = document.getElementById('selectAllBtn');
            const deselectAllBtn = document.getElementById('deselectAllBtn');
            const selectedBadge = document.getElementById('selectedBadge');
            const msgTitle = document.getElementById('msgTitle');
            const msgBody = document.getElementById('msgBody');
            const titleCounter = document.getElementById('titleCounter');
            const bodyCounter = document.getElementById('bodyCounter');
            const broadcastForm = document.getElementById('broadcastForm');

            let currentUsersList = [];

            roleSelect.addEventListener('change', function() {
                const roleId = this.value;
                if (!roleId) {
                    resetUsersContainer('Please select a Target Role above to view available users.');
                    return;
                }
                fetchUsersByRole(roleId);
            });

            function fetchUsersByRole(roleId) {
                usersContainer.innerHTML = `
                    <div class="text-center py-5 text-muted">
                        <div class="spinner-border text-primary mb-2" role="status"></div>
                        <div class="fw-semibold small">Loading users...</div>
                    </div>`;
                usersHeader.classList.add('d-none');

                fetch('@Url.Action("GetUsersByRole")?roleId=' + roleId)
                    .then(response => response.json())
                    .then(data => {
                        currentUsersList = data || [];
                        if (currentUsersList.length === 0) {
                            resetUsersContainer('No active users found for the selected role.');
                            return;
                        }
                        renderUsersList(currentUsersList);
                    })
                    .catch(err => {
                        console.error('Error fetching users:', err);
                        resetUsersContainer('Failed to load users. Please try again.');
                    });
            }

            function renderUsersList(users) {
                usersHeader.classList.remove('d-none');
                usersContainer.innerHTML = '';

                const rowDiv = document.createElement('div');
                rowDiv.className = 'row g-2';

                users.forEach(user => {
                    const col = document.createElement('div');
                    col.className = 'col-12 user-card-item';
                    col.setAttribute('data-name', (user.fullName + ' ' + user.userName).toLowerCase());

                    col.innerHTML = `
                        <label class="d-flex align-items-center p-2 rounded-3 border bg-light-subtle h-100 cursor-pointer user-select-none">
                            <input type="checkbox" name="SelectedUserIds" value="${user.userId}" class="form-check-input me-3 user-checkbox" style="transform: scale(1.15);" />
                            <div class="flex-grow-1 overflow-hidden">
                                <div class="fw-bold text-dark text-truncate">${escapeHtml(user.fullName)}</div>
                                <div class="text-muted extra-small">
                                    <span class="badge bg-secondary-subtle text-secondary me-1">&#64;${escapeHtml(user.userName)}</span>
                                    ${user.phoneNumber ? `<span class="me-1"><i class="bi bi-telephone text-muted"></i> ${escapeHtml(user.phoneNumber)}</span>` : ''}
                                    ${user.email ? `<span><i class="bi bi-envelope text-muted"></i> ${escapeHtml(user.email)}</span>` : ''}
                                </div>
                            </div>
                        </label>`;
                    rowDiv.appendChild(col);
                });

                usersContainer.appendChild(rowDiv);

                document.querySelectorAll('.user-checkbox').forEach(cb => {
                    cb.addEventListener('change', updateSelectedCount);
                });

                updateSelectedCount();
            }

            function resetUsersContainer(message) {
                usersHeader.classList.add('d-none');
                usersContainer.innerHTML = `
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-person-lines-fill fs-1 d-block mb-2 text-secondary opacity-50"></i>
                        <span class="fw-semibold">${message}</span>
                    </div>`;
                updateSelectedCount();
            }

            function updateSelectedCount() {
                const checkboxes = document.querySelectorAll('.user-checkbox');
                const checked = document.querySelectorAll('.user-checkbox:checked');
                selectedBadge.textContent = `Selected: ${checked.length} of ${checkboxes.length}`;
            }

            selectAllBtn.addEventListener('click', function() {
                document.querySelectorAll('.user-card-item:not(.d-none) .user-checkbox').forEach(cb => cb.checked = true);
                updateSelectedCount();
            });

            deselectAllBtn.addEventListener('click', function() {
                document.querySelectorAll('.user-checkbox').forEach(cb => cb.checked = false);
                updateSelectedCount();
            });

            userSearchInput.addEventListener('input', function() {
                const query = this.value.toLowerCase().trim();
                document.querySelectorAll('.user-card-item').forEach(item => {
                    const name = item.getAttribute('data-name');
                    if (!query || name.includes(query)) {
                        item.classList.remove('d-none');
                    } else {
                        item.classList.add('d-none');
                    }
                });
            });

            msgTitle.addEventListener('input', function() {
                titleCounter.textContent = `${this.value.length} / 150`;
            });

            msgBody.addEventListener('input', function() {
                bodyCounter.textContent = `${this.value.length} / 1000`;
            });

            broadcastForm.addEventListener('submit', function(e) {
                const checked = document.querySelectorAll('.user-checkbox:checked');
                if (checked.length === 0) {
                    e.preventDefault();
                    alert('Please select at least one recipient user.');
                }
            });

            function escapeHtml(str) {
                return (str || '').replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
            }
        });
    </script>
}
