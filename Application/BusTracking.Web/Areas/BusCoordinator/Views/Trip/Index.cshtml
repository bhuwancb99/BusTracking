@model BusTracking.Common.DTOs.Common.PagedResult<BusTracking.Common.DTOs.Trip.TripListDto>
@{
    ViewData["Title"] = "Trip Management";
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
    <div>
        <h2 class="fw-bold m-0 text-dark">
            <i class="bi bi-bus-front text-primary me-2"></i>Trip Management
        </h2>
        <nav aria-label="breadcrumb" class="mt-1">
            <ol class="breadcrumb mb-0 small text-muted">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Dashboard")" class="text-decoration-none text-muted">Dashboard</a></li>
                <li class="breadcrumb-item active text-primary" aria-current="page">Trips</li>
            </ol>
        </nav>
    </div>
    <a href="@Url.Action("Create")" class="btn btn-primary rounded-3 shadow-sm px-4">
        <i class="bi bi-plus-lg me-2"></i>Create Trip
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-8">
                <div class="d-flex gap-2 align-items-center flex-wrap">
                    <span class="fw-bold text-secondary small me-2">Status:</span>
                    @foreach (var s in new[] { ("All", "All"), ("Scheduled", "Scheduled"), ("InProgress", "In Progress"), ("Completed", "Completed"), ("Cancelled", "Cancelled") })
                    {
                        <div class="form-check form-check-inline mb-0">
                            <input class="form-check-input" type="radio" name="status" value="@s.Item1" id="st_@s.Item1" @((ViewBag.Status as string) == s.Item1 ? "checked" : "") onchange="this.form.submit()" />
                            <label class="form-check-label small fw-semibold text-dark" for="st_@s.Item1">@s.Item2</label>
                        </div>
                    }
                </div>
            </div>
            <div class="col-md-4 d-flex justify-content-end">
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary rounded-3 btn-sm"><i class="bi bi-arrow-counterclockwise me-1"></i>Reset Filter</a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light-subtle border-bottom">
                <tr class="text-uppercase fs-7 text-muted fw-bold">
                    <th style="width: 60px;" class="ps-4">#</th>
                    <th>Date</th>
                    <th>Trip Type</th>
                    <th>Bus</th>
                    <th>Driver</th>
                    <th>Route</th>
                    <th style="width: 120px;" class="text-center">Status</th>
                    <th>Started</th>
                    <th style="width: 180px;" class="text-center pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model?.Items.Count == 0)
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="bi bi-bus-front text-secondary opacity-50 display-4"></i>
                            <p class="mt-2 mb-0 fw-semibold fs-6">No trips found</p>
                            <span class="small">Try adjusting search criteria or create a new trip.</span>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var t in Model?.Items ?? [])
                    {
                        var statusCss = t.Status switch
                        {
                            "Scheduled" => "bg-info-subtle text-info border border-info-subtle",
                            "InProgress" => "bg-success-subtle text-success border border-success-subtle",
                            "Completed" => "bg-secondary-subtle text-dark border",
                            "Cancelled" => "bg-danger-subtle text-danger border border-danger-subtle",
                            _ => "bg-light text-dark border"
                        };
                        <tr>
                            <td class="ps-4 text-muted small">@t.TripId</td>
                            <td class="fw-bold text-dark fs-6">@t.TripDate</td>
                            <td>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace px-2 py-1">@t.TripType</span>
                            </td>
                            <td class="fw-semibold text-dark small">@t.BusNumber</td>
                            <td class="text-secondary small">@(string.IsNullOrWhiteSpace(t.DriverName) ? "Unassigned" : t.DriverName)</td>
                            <td class="text-secondary small">@(string.IsNullOrWhiteSpace(t.RouteName) ? "-" : t.RouteName)</td>
                            <td class="text-center">
                                <span class="badge @statusCss rounded-pill px-3 py-1">@t.Status</span>
                            </td>
                            <td class="text-muted small">@(t.StartedAt?.ToString("HH:mm") ?? "-")</td>
                            <td class="text-center pe-4">
                                <div class="d-flex justify-content-center gap-1">
                                    <a href="@Url.Action("Details", new { id = t.TripId })" class="btn btn-outline-info btn-sm rounded-3 px-2 py-1" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    @if (t.Status == "Scheduled")
                                    {
                                        <form asp-action="Start" asp-route-id="@t.TripId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-success btn-sm rounded-3 px-2 py-1" title="Start Trip">
                                                <i class="bi bi-play-fill"></i>
                                            </button>
                                        </form>
                                    }

                                    @if (t.Status == "InProgress")
                                    {
                                        <form asp-action="End" asp-route-id="@t.TripId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-success btn-sm rounded-3 px-2 py-1 text-white" title="End Trip">
                                                <i class="bi bi-stop-fill"></i>
                                            </button>
                                        </form>
                                    }

                                    @if (t.Status is "Scheduled" or "InProgress")
                                    {
                                        <form asp-action="Cancel" asp-route-id="@t.TripId" method="post" class="d-inline" onsubmit="return confirm('Cancel this trip?')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-warning btn-sm rounded-3 px-2 py-1" title="Cancel Trip">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </form>
                                    }

                                    @if (t.Status != "InProgress")
                                    {
                                        <form asp-action="Delete" asp-route-id="@t.TripId" method="post" class="d-inline" onsubmit="return confirm('Delete trip #@t.TripId?')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-3 px-2 py-1" title="Delete Trip">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pagination" model="Model" />
