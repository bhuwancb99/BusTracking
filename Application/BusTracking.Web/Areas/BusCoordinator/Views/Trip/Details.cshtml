@model BusTracking.Common.DTOs.Trip.TripListDto
@using BusTracking.Common.DTOs.Trip
@using System.Text.Encodings.Web
@{
    ViewData["Title"] = $"Trip #{Model?.TripId}";
    var students = ViewBag.Students as List<StudentTripStatusDto> ?? [];
    var stops = ViewBag.Stops as List<TripStopEventDto> ?? [];
    var isLive = Model?.Status == "InProgress";
    var statusStyle = Model?.Status switch
    {
        "Scheduled" => "bg-primary-subtle text-primary border border-primary-subtle",
        "InProgress" => "bg-success-subtle text-success border border-success-subtle",
        "Completed" => "bg-secondary-subtle text-secondary border border-secondary-subtle",
        "Cancelled" => "bg-danger-subtle text-danger border border-danger-subtle",
        _ => "bg-light text-dark border"
    };
}
<style>
    .spin-anim { animation: spin 0.6s linear infinite; }
    @@keyframes spin { 100% { transform: rotate(360deg); } }
</style>

<div class="container-fluid p-0">
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold m-0 text-dark">
                <i class="bi bi-bus-front text-primary me-2"></i>Trip #@Model?.TripId — @Model?.BusNumber
            </h2>
            <nav aria-label="breadcrumb" class="mt-1">
                <ol class="breadcrumb mb-0 small text-muted">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Dashboard")" class="text-decoration-none text-muted">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("Index")" class="text-decoration-none text-muted">Trips</a></li>
                    <li class="breadcrumb-item active text-primary" aria-current="page">Trip Details</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex gap-2 flex-wrap align-items-center">
            <span class="badge @statusStyle font-monospace px-3 py-2 fs-6">@Model?.Status</span>
            @if (Model?.Status == "Scheduled")
            {
                <form asp-action="Start" asp-route-id="@Model.TripId" method="post">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-success rounded-3 px-3 shadow-sm"><i class="bi bi-play-fill me-1"></i>Start Trip</button>
                </form>
            }
            @if (Model?.Status == "InProgress")
            {
                <form asp-action="End" asp-route-id="@Model.TripId" method="post" onsubmit="return confirm('End this trip?')">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-danger rounded-3 px-3 shadow-sm"><i class="bi bi-stop-fill me-1"></i>End Trip</button>
                </form>
            }
            @if (Model?.Status is "Scheduled" or "InProgress")
            {
                <form asp-action="Cancel" asp-route-id="@Model!.TripId" method="post" onsubmit="return confirm('Cancel this trip?')">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-outline-warning rounded-3 px-3"><i class="bi bi-x-lg me-1"></i>Cancel</button>
                </form>
            }
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary rounded-3 px-3">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Route Stops & Assigned Students -->
        <div class="col-lg-5 col-12">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold text-primary text-uppercase fs-7 m-0"><i class="bi bi-signpost-split me-2"></i>Stops & Boarding Roster</h6>
                        <button id="btnRefreshStops" type="button" class="btn btn-sm btn-outline-primary rounded-3 px-3" onclick="refreshStopsAndStudents()" title="Refresh Stops & Boarding Status">
                            <i class="bi bi-arrow-clockwise me-1" id="refreshIcon"></i>Refresh
                        </button>
                    </div>

                    @if (!stops.Any())
                    {
                        <div class="text-center text-muted py-4">No stops associated with this trip.</div>
                    }
                    else
                    {
                        var orderedStops = stops.OrderBy(s => s.StopOrder).ToList();
                        var firstStop = orderedStops.FirstOrDefault();
                        var lastStop = orderedStops.LastOrDefault();

                        <div class="stop-timeline">
                            @for (int idx = 0; idx < orderedStops.Count; idx++)
                            {
                                var stop = orderedStops[idx];
                                var isFirst = stop.StopId == firstStop?.StopId;
                                var isLast = stop.StopId == lastStop?.StopId;
                                var dotColor = stop.Status switch { "Departed" => "#1e8e3e", "Reached" => "#1a73e8", _ => "#dadce0" };
                                var dotIcon = isFirst ? "bi-geo-alt-fill" : isLast ? "bi-flag-fill" : (stop.Status switch { "Departed" => "bi-check-circle-fill", "Reached" => "bi-geo-alt-fill", _ => "bi-circle" });
                                var iconColor = isFirst ? "#ef4444" : isLast ? "#10b981" : dotColor;

                                var stopStudents = students
                                    .Where(st => st.StopOrder == stop.StopOrder ||
                                                 (!string.IsNullOrEmpty(st.StopName) && st.StopName.Equals(stop.StopName, StringComparison.OrdinalIgnoreCase)))
                                    .OrderBy(st => st.StudentName)
                                    .ToList();

                                var pendingStudentsCount = stopStudents.Count(st => st.BoardingStatus == "Pending");
                                var allStudentsUpdated = pendingStudentsCount == 0;
                                var canReach = stop.Status == "Pending" && (idx == 0 || orderedStops[idx - 1].Status == "Departed");
                                var isReached = stop.Status == "Reached";
                                var canDepart = isReached && allStudentsUpdated;
                                var canUpdateBoarding = isLive && isReached;

                                <div class="d-flex gap-3 mb-4 align-items-start stop-row" data-stop-id="@stop.StopId">
                                    <div class="flex-shrink-0 mt-1">
                                        <i class="bi @dotIcon fs-5" style="color:@iconColor"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="d-flex justify-content-between align-items-start bg-light-subtle p-3 rounded-4 border">
                                            <div>
                                                <span class="fw-bold text-dark fs-6">@stop.StopName</span>
                                                <span class="badge bg-secondary-subtle text-secondary font-monospace ms-1">Stop #@stop.StopOrder</span>
                                                <div class="d-flex gap-3 mt-1 small text-muted">
                                                    @if (stop.ReachedAt.HasValue)
                                                    {
                                                        <span><i class="bi bi-clock me-1 text-primary"></i>Reached @stop.ReachedAt.Value.ToString("HH:mm")</span>
                                                    }
                                                    @if (stop.DepartedAt.HasValue)
                                                    {
                                                        <span><i class="bi bi-arrow-right me-1 text-success"></i>Departed @stop.DepartedAt.Value.ToString("HH:mm")</span>
                                                    }
                                                </div>
                                            </div>
                                            <div class="text-end">
                                                <span class="badge rounded-pill px-3 py-1 mb-1" style="@(stop.Status == "Departed" ? "background:#e6f4ea;color:#1e8e3e" : stop.Status == "Reached" ? "background:#e8f0fe;color:#1a73e8" : "background:#f1f3f4;color:#5f6368")">
                                                    @stop.Status
                                                </span>
                                                @if (isLive)
                                                {
                                                    @if (canReach)
                                                    {
                                                        <div>
                                                            <button class="btn btn-sm btn-primary rounded-3 btn-reach-stop shadow-sm mt-1" data-trip-id="@Model!.TripId" data-stop-id="@stop.StopId">
                                                                <i class="bi bi-geo-alt me-1"></i>Mark Reached
                                                            </button>
                                                        </div>
                                                    }
                                                    else if (isReached)
                                                    {
                                                        if (canDepart)
                                                        {
                                                            <div>
                                                                <button class="btn btn-sm btn-success rounded-3 btn-depart-stop shadow-sm mt-1" data-trip-id="@Model!.TripId" data-stop-id="@stop.StopId">
                                                                    <i class="bi bi-arrow-right me-1"></i>Mark Departed
                                                                </button>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div>
                                                                <button class="btn btn-sm btn-secondary rounded-3 opacity-75 mt-1 disabled" title="Please update all @pendingStudentsCount pending student boarding status(es) first">
                                                                    <i class="bi bi-exclamation-triangle me-1"></i>Pending Students (@pendingStudentsCount)
                                                                </button>
                                                            </div>
                                                        }
                                                    }
                                                }
                                            </div>
                                        </div>

                                        <div class="mt-2 ms-2">
                                            @if (stopStudents.Any())
                                            {
                                                <div class="d-flex flex-column gap-2">
                                                    @foreach (var s in stopStudents)
                                                    {
                                                        var bsCss = s.BoardingStatus switch
                                                        {
                                                            "PickedUp" => "bg-success-subtle text-success border border-success-subtle",
                                                            "NoShow" => "bg-danger-subtle text-danger border border-danger-subtle",
                                                            "OnLeave" => "bg-warning-subtle text-dark border border-warning-subtle",
                                                            _ => "bg-light text-dark border"
                                                        };

                                                        <div class="d-flex align-items-center justify-content-between p-2 px-3 rounded-3 border bg-light-subtle" id="srow-@s.StudentId">
                                                            <div>
                                                                <span class="fw-bold text-dark small d-block">@s.StudentName</span>
                                                                <code class="font-monospace text-muted small">@s.StudentCode</code>
                                                            </div>
                                                            <span class="badge @bsCss font-monospace px-3 py-1">@s.BoardingStatus</span>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Live Map Tracking -->
        <div class="col-lg-7 col-12">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-body p-0 position-relative">
                    <div class="p-3 bg-white border-bottom d-flex justify-content-between align-items-center">
                        <span class="fw-bold text-primary text-uppercase fs-7 m-0"><i class="bi bi-map me-2"></i>Live Map GPS Tracking</span>
                        @if (isLive)
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle font-monospace px-3 py-1">
                                <i class="bi bi-circle-fill me-1 fs-7"></i>LIVE GPS
                            </span>
                        }
                    </div>
                    <div id="tripMap" style="height:520px;width:100%"></div>
                    <div id="liveOverlay" class="position-absolute bottom-0 start-0 end-0 px-3 py-2" style="background:linear-gradient(transparent,rgba(0,0,0,.75));pointer-events:none;z-index:500;display:none">
                        <div class="d-flex justify-content-between align-items-end text-white">
                            <div>
                                <div id="spdBig" style="font-size:2rem;font-weight:700;line-height:1">–</div>
                                <div style="font-size:.7rem;opacity:.8">km/h</div>
                            </div>
                            <div class="text-center">
                                <div id="busStatusLabel" style="font-size:.85rem;font-weight:600">–</div>
                                <div id="lastUpdLabel" style="font-size:.68rem;opacity:.75">–</div>
                            </div>
                            <div class="text-end">
                                <div id="coordLabel" style="font-size:.68rem;opacity:.75">–</div>
                                <div id="headingLabel" style="font-size:.75rem">–</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        const TRIP_ID = @Model?.TripId;
        const IS_LIVE = @(isLive ? "true" : "false");
        const TOKEN = () => document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        const STOPS = [
            @foreach (var stop in stops.OrderBy(s => s.StopOrder))
            {
                @:{ id: @stop.StopId, name: "@JavaScriptEncoder.Default.Encode(stop.StopName)", order: @stop.StopOrder, status: "@stop.Status", lat: @(stop.Latitude ?? 0), lng: @(stop.Longitude ?? 0) },
            }
        ];

        const map = L.map('tripMap').setView([20.5937, 78.9629], 5);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19, attribution: '© OpenStreetMap' }).addTo(map);

        const busIcon = L.divIcon({
            html: '<div style="background:#fbbc04;border:2.5px solid #ffffff;border-radius:50%;width:34px;height:34px;display:flex;align-items:center;justify-content:center;box-shadow:0 3px 10px rgba(0,0,0,.4)"><i class="bi bi-bus-front-fill" style="color:#000;font-size:18px"></i></div>',
            iconSize: [34, 34], iconAnchor: [17, 17], className: ''
        });

        const bounds = L.latLngBounds();
        const validStops = STOPS.filter(s => s.lat && s.lng && (s.lat !== 0 || s.lng !== 0));
        validStops.sort((a, b) => a.order - b.order);

        validStops.forEach(s => {
            const stopLatLng = [s.lat, s.lng];
            bounds.extend(stopLatLng);
            const color = s.status === 'Departed' ? '#10b981' : s.status === 'Reached' ? '#3b82f6' : '#6b7280';
            const stopIcon = L.divIcon({
                html: `<div style="background:${color};color:#fff;border:2px solid #fff;border-radius:50%;width:26px;height:26px;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:11px;box-shadow:0 2px 6px rgba(0,0,0,.3)">${s.order}</div>`,
                iconSize: [26, 26], iconAnchor: [13, 13], className: ''
            });
            L.marker(stopLatLng, { icon: stopIcon, title: `Stop #${s.order}: ${s.name}` }).addTo(map);
        });

        const firstStopPos = validStops.length > 0 ? [validStops[0].lat, validStops[0].lng] : [20.5937, 78.9629];
        const busMarker = L.marker(firstStopPos, { icon: busIcon, title: 'Bus', zIndexOffset: 2000 }).addTo(map);
        if (validStops.length > 0) { map.fitBounds(bounds, { padding: [50, 50] }); }

        document.querySelectorAll('.btn-reach-stop').forEach(btn => {
            btn.addEventListener('click', async function() {
                const res = await fetch(`@Url.Action("ReachStop")?tripId=${this.dataset.tripId}&stopId=${this.dataset.stopId}`, {
                    method: 'POST', headers: { 'RequestVerificationToken': TOKEN() }
                });
                const data = await res.json();
                if (data.success) location.reload(); else alert(data.message);
            });
        });

        document.querySelectorAll('.btn-depart-stop').forEach(btn => {
            btn.addEventListener('click', async function() {
                const res = await fetch(`@Url.Action("DepartStop")?tripId=${this.dataset.tripId}&stopId=${this.dataset.stopId}`, {
                    method: 'POST', headers: { 'RequestVerificationToken': TOKEN() }
                });
                const data = await res.json();
                if (data.success) location.reload(); else alert(data.message);
            });
        });
    </script>
}
