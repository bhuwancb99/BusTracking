@model BusTracking.Common.DTOs.Common.PagedResult<BusTracking.Common.DTOs.Notification.NotificationDto>
@{
    ViewData["Title"] = "Notifications";
    var fromDate = ViewBag.FromDate as string ?? DateTime.Today.ToString("yyyy-MM-dd");
    var toDate = ViewBag.ToDate as string ?? DateTime.Today.ToString("yyyy-MM-dd");
    var items = Model?.Items ?? [];
    var totalPages = Model?.TotalPages ?? 1;
    var currentPage = Model?.PageNumber ?? 1;
    var totalCount = Model?.TotalCount ?? 0;
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
            <div>
                <h4 class="fw-bold mb-1">
                    <i class="bi bi-bell-fill me-2 text-primary"></i>Notifications &amp; Alerts
                </h4>
                <span class="text-muted small">Search and view notifications sent to your account</span>
            </div>
            @if (items.Any(n => !n.IsRead))
            {
                <form asp-area="Parent" asp-controller="Notification" asp-action="MarkAllRead" method="post" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate" asp-route-page="@currentPage">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-primary btn-sm rounded-pill px-3 shadow-sm">
                        <i class="bi bi-check2-all me-1"></i>Mark All as Read
                    </button>
                </form>
            }
        </div>

        <!-- ── Top Header Date Range Filter ── -->
        <form method="get" asp-area="Parent" asp-controller="Notification" asp-action="Index" class="row g-3 align-items-end bg-light p-3 rounded-3 border">
            <div class="col-md-4 col-6">
                <label class="form-label small fw-semibold text-muted mb-1"><i class="bi bi-calendar3 me-1"></i>From Date:</label>
                <input type="date" name="fromDate" value="@fromDate" class="form-select form-select-sm shadow-sm" />
            </div>
            <div class="col-md-4 col-6">
                <label class="form-label small fw-semibold text-muted mb-1"><i class="bi bi-calendar3 me-1"></i>To Date:</label>
                <input type="date" name="toDate" value="@toDate" class="form-select form-select-sm shadow-sm" />
            </div>
            <div class="col-md-4 col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-grow-1 rounded-pill shadow-sm">
                    <i class="bi bi-search me-1"></i>Filter
                </button>
                <a asp-area="Parent" asp-controller="Notification" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3 shadow-sm" title="Reset to today's date">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>Today
                </a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (!items.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-bell-slash fs-1 d-block mb-2 text-secondary opacity-50"></i>
                <h6 class="fw-semibold mb-1">No Notifications Found</h6>
                <p class="small text-muted mb-0">No records found for the selected date range (@fromDate to @toDate).</p>
            </div>
        }
        else
        {
            <div class="list-group list-group-flush">
                @foreach (var n in items)
                {
                    var (icon, color) = n.NotificationType switch
                    {
                        "BusApproaching" => ("bi-bus-front-fill", "text-primary"),
                        "StudentPickedUp" => ("bi-check-circle-fill", "text-success"),
                        "NoShow" => ("bi-exclamation-circle-fill", "text-danger"),
                        "BusAssigned" => ("bi-bus-front", "text-info"),
                        "RouteChanged" => ("bi-map-fill", "text-warning"),
                        "Broadcast" => ("bi-megaphone-fill", "text-secondary"),
                        _ => ("bi-bell-fill", "text-muted")
                    };

                    <div class="list-group-item p-3 border-bottom @(!n.IsRead ? "bg-primary-subtle" : "")" style="transition:background .2s">
                        <div class="d-flex align-items-start gap-3">
                            <div class="mt-1 flex-shrink-0">
                                <i class="bi @icon @color fs-4"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                    <div>
                                        <span class="fw-bold fs-6 d-block">@n.Title</span>
                                        <span class="badge rounded-pill bg-light text-dark border me-2" style="font-size:.68rem">@n.NotificationType</span>
                                        @if (!n.IsRead)
                                        {
                                            <span class="badge rounded-pill bg-primary" style="font-size:.65rem">New</span>
                                        }
                                    </div>
                                    <span class="text-muted small" style="font-size:.78rem">
                                        <i class="bi bi-clock me-1"></i>@n.SentAt.ToString("dd MMM yyyy, hh:mm tt")
                                    </span>
                                </div>
                                <p class="mb-0 text-secondary mt-1 small" style="line-height:1.4">@n.Body</p>
                            </div>
                            @if (!n.IsRead)
                            {
                                <form asp-area="Parent" asp-controller="Notification" asp-action="MarkRead" asp-route-id="@n.NotificationId" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate" asp-route-page="@currentPage" method="post" class="flex-shrink-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-light border rounded-pill px-3" style="font-size:.75rem">
                                        <i class="bi bi-check2 me-1"></i>Mark Read
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- ── Pagination Footer ── -->
            @if (totalPages > 1)
            {
                <div class="card-footer bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <span class="small text-muted">
                        Showing page <strong>@currentPage</strong> of <strong>@totalPages</strong> (@totalCount total notifications)
                    </span>
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                <a class="page-link rounded-pill px-3 me-1" asp-area="Parent" asp-controller="Notification" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate">
                                    &laquo; Prev
                                </a>
                            </li>
                            @for (int p = 1; p <= totalPages; p++)
                            {
                                <li class="page-item @(p == currentPage ? "active" : "")">
                                    <a class="page-link me-1" asp-area="Parent" asp-controller="Notification" asp-action="Index" asp-route-page="@p" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate">@p</a>
                                </li>
                            }
                            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                <a class="page-link rounded-pill px-3" asp-area="Parent" asp-controller="Notification" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate">
                                    Next &raquo;
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
    </div>
</div>
