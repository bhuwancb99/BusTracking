@using System.Security.Claims
@using BusTracking.Common.Helpers
@inject BusTracking.Common.Data.AppDbContext DbContext
@inject BusTracking.Common.Interfaces.ICurrentUserService CurrentUser
@{
    ViewData["Title"] = "Parent Dashboard";
    var userName = User.FindFirstValue(ClaimTypes.Name) ?? "Parent";
    string? userPhoto = null;
    var uId = CurrentUser.UserId;
    if (uId.HasValue)
    {
        var dbUser = DbContext.Users.IgnoreQueryFilters().FirstOrDefault(u => u.UserId == uId.Value);
        if (dbUser != null)
        {
            userPhoto = dbUser.ProfileImageUrl;
        }
    }
}

<div class="container-fluid p-0">
    <div class="row g-4 mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-white" style="background: linear-gradient(135deg, #3d5af1 0%, #2241d7 100%);">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <img src="@(string.IsNullOrWhiteSpace(userPhoto) ? "/images/default-avatar.svg" : userPhoto)" class="rounded-circle border border-2 border-white shadow-sm" style="width: 65px; height: 65px; object-fit: cover;" onerror="this.onerror=null;this.src='/images/default-avatar.svg';" />
                        <div>
                            <h3 class="fw-bold mb-1">Welcome back, @userName!</h3>
                            <p class="mb-0 text-white-50">Parent Portal • Real-time Bus Tracking & Attendance</p>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <a href="@Url.Action("Index", "Notification", new { area = "Parent" })" class="btn btn-light rounded-3 px-4 fw-semibold position-relative">
                            <i class="bi bi-bell me-2"></i>Notifications
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick action cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-4 bg-white">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h6 class="fw-bold text-primary text-uppercase fs-7 m-0"><i class="bi bi-geo-alt-fill me-2"></i>Live Tracking</h6>
                    <i class="bi bi-map-fill text-danger fs-3"></i>
                </div>
                <p class="text-secondary small mb-4">See where your child's bus is in real time with live location updates.</p>
                <div class="mt-auto">
                    <a asp-area="Parent" asp-controller="Tracking" asp-action="Track" class="btn btn-danger rounded-3 px-4 shadow-sm w-100">
                        <i class="bi bi-map me-1"></i>Open Live Map
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-4 bg-white">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h6 class="fw-bold text-primary text-uppercase fs-7 m-0"><i class="bi bi-calendar-check-fill me-2"></i>Leave & Attendance</h6>
                    <i class="bi bi-calendar-event text-primary fs-3"></i>
                </div>
                <p class="text-secondary small mb-4">Mark planned leave, holiday, or parent pickup days in advance.</p>
                <div class="mt-auto">
                    <a asp-area="Parent" asp-controller="Home" asp-action="Availability" class="btn btn-primary rounded-3 px-4 shadow-sm w-100">
                        <i class="bi bi-calendar-plus me-1"></i>Manage Availability
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-4 bg-white">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h6 class="fw-bold text-primary text-uppercase fs-7 m-0"><i class="bi bi-headset me-2"></i>Help & Support</h6>
                    <i class="bi bi-headset text-success fs-3"></i>
                </div>
                <p class="text-secondary small mb-4">Have a question or concern about routes or schedules? Contact support.</p>
                <div class="mt-auto">
                    <a asp-area="Parent" asp-controller="Feedback" asp-action="Submit" class="btn btn-outline-primary rounded-3 px-4 w-100">
                        <i class="bi bi-send me-1"></i>Contact Support
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- My Children -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
            <span class="fw-bold text-dark fs-6"><i class="bi bi-mortarboard me-2 text-primary"></i>My Children</span>
            <span class="badge bg-info-subtle text-info border border-info-subtle font-monospace px-3 py-1" id="childrenCount">Loading…</span>
        </div>
        <div class="card-body p-4">
            <div id="childrenCards" class="d-flex flex-nowrap gap-3 overflow-x-auto pb-3 custom-horizontal-scroll">
                @for (int s = 0; s < 2; s++)
                {
                    <div class="skeleton-card" style="min-width:320px;max-width:360px;flex:0 0 auto;">
                        <div class="card border-0 bg-light h-100 rounded-3">
                            <div class="card-body p-4">
                                <div class="placeholder-glow">
                                    <span class="placeholder col-6 mb-2 d-block"></span>
                                    <span class="placeholder col-4 mb-3 d-block"></span>
                                    <span class="placeholder col-8 mb-1 d-block"></span>
                                    <span class="placeholder col-5 d-block"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div id="noChildrenMsg" class="text-center text-muted py-4 d-none">
                <i class="bi bi-mortarboard text-secondary opacity-50 display-4 d-block mb-2"></i>
                <p class="fw-semibold mb-0">No children linked to your account yet.</p>
                <small>Please contact the school administrator.</small>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        const _tok = () => document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

        (async function loadChildren() {
            try {
                const res = await fetch('/Parent/Home/MyChildren');
                const data = await res.json();

                document.querySelectorAll('.skeleton-card').forEach(el => el.remove());

                const container = document.getElementById('childrenCards');
                const noMsg = document.getElementById('noChildrenMsg');
                const badge = document.getElementById('childrenCount');

                if (!data || data.length === 0) {
                    noMsg.classList.remove('d-none');
                    badge.textContent = '0';
                    return;
                }

                badge.textContent = data.length + (data.length === 1 ? ' child' : ' children');
                data.forEach(child => renderChildCard(container, child));

            } catch (err) {
                document.querySelectorAll('.skeleton-card').forEach(el => el.remove());
                document.getElementById('noChildrenMsg').classList.remove('d-none');
                document.getElementById('childrenCount').textContent = 'Error';
                console.error('Failed to load children:', err);
            }
        })();

        function renderChildCard(container, child) {
            const busHtml = child.busNumber
                ? `<span class="badge bg-primary-subtle text-primary border border-primary-subtle me-1"><i class="bi bi-bus-front me-1"></i>${child.busNumber}</span>`
                : `<span class="text-muted small">No bus assigned</span>`;

            const stopHtml = child.stopName
                ? `<span class="badge bg-secondary-subtle text-dark border"><i class="bi bi-geo-alt me-1"></i>${child.stopName}</span>`
                : '';

            const statusCss = child.isActive ? 'bg-success-subtle text-success border border-success-subtle' : 'bg-danger-subtle text-danger border border-danger-subtle';

            const initials = child.fullName.split(' ').filter(Boolean)
                .map(p => p[0]).slice(0, 2).join('').toUpperCase();

            const avatarHtml = child.profileImageUrl
                ? `<img id="childAvatar_${child.userId}"
                        src="${child.profileImageUrl}?v=${Date.now()}"
                        alt="${child.fullName}"
                        class="rounded-circle border shadow-sm"
                        style="width:52px;height:52px;object-fit:cover;flex-shrink:0;" />`
                : `<div id="childAvatar_${child.userId}"
                        class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center
                               justify-content-center fw-bold border"
                        style="width:52px;height:52px;font-size:1.1rem;flex-shrink:0;">
                       ${initials}
                   </div>`;

            const col = document.createElement('div');
            col.style = 'min-width:320px;max-width:360px;flex:0 0 auto;';
            col.id = `childCol_${child.studentId}`;
            col.innerHTML = `
        <div class="card border-0 shadow-sm rounded-4 h-100 child-card">
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="position-relative" style="width:52px;height:52px;flex-shrink:0;">
                        ${avatarHtml}
                        <label for="childImgInput_${child.userId}"
                               class="position-absolute bottom-0 end-0 d-flex align-items-center justify-content-center
                                      btn btn-primary rounded-circle shadow-sm"
                               style="width:22px;height:22px;padding:0;cursor:pointer;"
                               title="Update ${child.fullName}'s photo">
                            <i class="bi bi-camera-fill" style="font-size:.6rem;"></i>
                            <input type="file" id="childImgInput_${child.userId}" class="d-none"
                                   accept="image/jpeg,image/png,image/webp"
                                   onchange="updateChildPhoto(${child.userId}, ${child.studentId}, this)" />
                        </label>
                    </div>

                    <div class="flex-grow-1 overflow-hidden">
                        <div class="fw-bold text-dark text-truncate fs-6">${child.fullName}</div>
                        <code class="small text-muted font-monospace">${child.studentCode}</code>
                    </div>
                    <span class="badge ${statusCss} flex-shrink-0">${child.isActive ? 'Active' : 'Inactive'}</span>
                </div>

                <div id="childImgMsg_${child.userId}" class="small mb-2" style="min-height:16px;"></div>

                <div class="small">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="bi bi-book text-muted" style="width:16px"></i>
                        <span class="text-muted">Class:</span>
                        <span class="fw-semibold text-dark">${child.standardName || '–'}</span>
                    </div>
                    <div class="d-flex align-items-start gap-2 mb-2">
                        <i class="bi bi-bus-front text-muted mt-1" style="width:16px"></i>
                        <span class="text-muted">Bus:</span>
                        <div>${busHtml}</div>
                    </div>
                    ${child.stopName ? `
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="bi bi-geo-alt text-muted" style="width:16px"></i>
                        <span class="text-muted">Stop:</span>
                        <div>${stopHtml}</div>
                    </div>` : ''}
                </div>
            </div>
            <div class="card-footer bg-transparent border-top-0 pt-0 pb-3 px-4 d-flex gap-2">
                <a href="/Parent/Tracking/Track?studentId=${child.studentId}"
                   class="btn btn-sm btn-outline-danger rounded-3 flex-grow-1">
                    <i class="bi bi-geo-alt me-1"></i>Track
                </a>
                <a href="/Parent/Home/Availability?studentId=${child.studentId}"
                   class="btn btn-sm btn-outline-primary rounded-3 flex-grow-1">
                    <i class="bi bi-calendar-check me-1"></i>Leave
                </a>
            </div>
        </div>`;
            container.appendChild(col);
        }

        async function updateChildPhoto(studentUserId, studentId, input) {
            if (!input.files || !input.files[0]) return;
            const msg = document.getElementById('childImgMsg_' + studentUserId);
            msg.innerHTML = '<span class="text-muted"><span class="spinner-border spinner-border-sm me-1"></span>Uploading…</span>';

            const fd = new FormData();
            fd.append('file', input.files[0]);
            fd.append('studentUserId', studentUserId);

            try {
                const res = await fetch(`/Parent/Home/UpdateChildPhoto?studentUserId=${studentUserId}`, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': _tok() },
                    body: fd
                });
                const json = await res.json();

                if (json.success) {
                    const avatar = document.getElementById('childAvatar_' + studentUserId);
                    const newSrc = json.imageUrl + '?v=' + Date.now();
                    const initials = input.closest('.card-body')
                        ?.querySelector('.fw-bold')?.textContent?.trim()
                        ?.split(' ').filter(Boolean).map(p => p[0]).slice(0, 2).join('').toUpperCase() ?? '?';

                    if (avatar.tagName === 'IMG') {
                        avatar.src = newSrc;
                    } else {
                        const img = document.createElement('img');
                        img.id = 'childAvatar_' + studentUserId;
                        img.src = newSrc;
                        img.alt = 'Photo';
                        img.className = 'rounded-circle border shadow-sm';
                        img.style = 'width:52px;height:52px;object-fit:cover;flex-shrink:0;';
                        avatar.replaceWith(img);
                    }

                    msg.innerHTML = '<span class="text-success"><i class="bi bi-check-circle me-1"></i>Photo updated.</span>';
                    setTimeout(() => { msg.innerHTML = ''; }, 3000);
                } else {
                    msg.innerHTML = `<span class="text-danger">${json.message}</span>`;
                }
            } catch {
                msg.innerHTML = '<span class="text-danger">Upload failed. Try again.</span>';
            }
            input.value = '';
        }
    </script>

    <style>
        .custom-horizontal-scroll {
            overflow-x: auto !important;
            scrollbar-width: thin;
            scrollbar-color: #cbd5e1 #f1f5f9;
        }
        .custom-horizontal-scroll::-webkit-scrollbar {
            height: 8px;
        }
        .custom-horizontal-scroll::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 4px;
        }
        .custom-horizontal-scroll::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        .custom-horizontal-scroll::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
        .child-card {
            transition: transform .15s, box-shadow .15s;
        }
        .child-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 .5rem 1.5rem rgba(0,0,0,.1) !important;
        }
    </style>
}
