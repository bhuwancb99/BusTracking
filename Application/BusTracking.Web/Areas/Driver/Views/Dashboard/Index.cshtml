@{
    ViewData["Title"] = "Driver Dashboard";
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
    <div>
        <h2 class="fw-bold m-0 text-dark">
            <i class="bi bi-speedometer2 text-primary me-2"></i>Welcome, @User.GetFullName()
        </h2>
        <nav aria-label="breadcrumb" class="mt-1">
            <ol class="breadcrumb mb-0 small text-muted">
                <li class="breadcrumb-item active text-primary" aria-current="page">Driver Dashboard</li>
            </ol>
        </nav>
    </div>
    <a asp-area="Driver" asp-controller="Trip" asp-action="Index" class="btn btn-primary rounded-3 shadow-sm px-4">
        <i class="bi bi-play-circle me-2"></i>Go to My Trip
    </a>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
            <div class="card-body">
                <h5 class="fw-bold text-dark mb-3"><i class="bi bi-bus-front text-primary me-2"></i>Quick Actions</h5>
                <p class="text-secondary mb-4">View your assigned bus, route, and start or manage today's trip with live GPS tracking.</p>
                <a asp-area="Driver" asp-controller="Trip" asp-action="Index" class="btn btn-primary rounded-3 px-4 shadow-sm">
                    <i class="bi bi-signpost-split me-2"></i>Start / View My Trip
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
            <div class="card-body">
                <h5 class="fw-bold text-dark mb-3"><i class="bi bi-info-circle text-info me-2"></i>Driver Guidelines</h5>
                <ul class="text-secondary ps-3 mb-0 d-flex flex-column gap-2">
                    <li>Open <strong>My Trip</strong> to check assigned bus, route, and stop schedule.</li>
                    <li>Tap <strong>Start Trip</strong> when you begin your morning/afternoon route.</li>
                    <li>Mark stops as <strong>Reached</strong> / <strong>Departed</strong> as students board/alight.</li>
                    <li>Tap <strong>End Trip</strong> when the route is complete.</li>
                </ul>
            </div>
        </div>
    </div>
</div>
