@using BusTracking.Common.Helpers
@inject BusTracking.Common.Data.AppDbContext DbContext
@inject BusTracking.Common.Interfaces.ICurrentUserService CurrentUser
@{
    ViewData["Title"] = "Driver Dashboard";
    string? userPhoto = null;
    var uId = CurrentUser.UserId;
    if (uId.HasValue)
    {
        var dbUser = DbContext.Users.IgnoreQueryFilters().FirstOrDefault(u => u.UserId == uId.Value);
        if (dbUser != null)
        {
            userPhoto = dbUser.ProfileImageUrl;
        }
    }
    var driverName = User.GetFullName();
}

<div class="container-fluid p-0">
    <div class="row g-4 mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-white" style="background: linear-gradient(135deg, #3d5af1 0%, #2241d7 100%);">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <img src="@(string.IsNullOrWhiteSpace(userPhoto) ? "/images/default-avatar.svg" : userPhoto)" class="rounded-circle border border-2 border-white shadow-sm" style="width: 65px; height: 65px; object-fit: cover;" onerror="this.onerror=null;this.src='/images/default-avatar.svg';" />
                        <div>
                            <h3 class="fw-bold mb-1">Welcome back, @driverName!</h3>
                            <p class="mb-0 text-white-50">Driver Portal • Live GPS Tracking & Route Schedule</p>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <a href="@Url.Action("Index", "Trip", new { area = "Driver" })" class="btn btn-light rounded-3 px-4 fw-semibold position-relative">
                            <i class="bi bi-play-circle me-2"></i>Go to My Trip
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-4 bg-white">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h5 class="fw-bold text-dark m-0"><i class="bi bi-bus-front text-primary me-2"></i>Quick Actions</h5>
                    <i class="bi bi-compass-fill text-primary fs-3"></i>
                </div>
                <p class="text-secondary small mb-4">View your assigned bus, route, and start or manage today's trip with live GPS tracking.</p>
                <div>
                    <a href="@Url.Action("Index", "Trip", new { area = "Driver" })" class="btn btn-primary rounded-3 px-4 shadow-sm">
                        <i class="bi bi-signpost-split me-2"></i>Start / View My Trip
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-4 bg-white">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h5 class="fw-bold text-dark m-0"><i class="bi bi-info-circle text-info me-2"></i>Driver Guidelines</h5>
                    <i class="bi bi-shield-check text-success fs-3"></i>
                </div>
                <ul class="text-secondary ps-3 mb-0 d-flex flex-column gap-2 small">
                    <li>Open <strong>My Trip</strong> to check assigned bus, route, and stop schedule.</li>
                    <li>Tap <strong>Start Trip</strong> when you begin your morning/afternoon route.</li>
                    <li>Mark stops as <strong>Reached</strong> / <strong>Departed</strong> as students board/alight.</li>
                    <li>Tap <strong>End Trip</strong> when the route is complete.</li>
                </ul>
            </div>
        </div>
    </div>
</div>
