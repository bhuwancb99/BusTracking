@model BusTracking.Common.DTOs.Common.PagedResult<BusTracking.Common.DTOs.Notification.NotificationDto>
@{
    ViewData["Title"] = "Notifications";
    var fromDate = ViewBag.FromDate as string ?? DateTime.Today.ToString("yyyy-MM-dd");
    var toDate = ViewBag.ToDate as string ?? DateTime.Today.ToString("yyyy-MM-dd");
    var items = Model?.Items ?? [];
    var totalPages = Model?.TotalPages ?? 1;
    var currentPage = Model?.PageNumber ?? 1;
    var totalCount = Model?.TotalCount ?? 0;
}

<div class="container-fluid p-0">
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
        <div>
            <h2 class="fw-bold m-0 text-dark">
                <i class="bi bi-bell-fill text-primary me-2"></i>My Notifications
            </h2>
            <nav aria-label="breadcrumb" class="mt-1">
                <ol class="breadcrumb mb-0 small text-muted">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Dashboard")" class="text-decoration-none text-muted">Dashboard</a></li>
                    <li class="breadcrumb-item active text-primary" aria-current="page">Notifications</li>
                </ol>
            </nav>
        </div>
        @if (items.Any(n => !n.IsRead))
        {
            <form asp-area="Student" asp-controller="Notification" asp-action="MarkAllRead" method="post" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate" asp-route-page="@currentPage">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-primary rounded-3 shadow-sm">
                    <i class="bi bi-check2-all me-1"></i>Mark All as Read
                </button>
            </form>
        }
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
        <div class="card-body p-3">
            <form method="get" asp-area="Student" asp-controller="Notification" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-md-4 col-6">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0"><i class="bi bi-calendar3 text-muted"></i></span>
                        <input type="date" name="fromDate" value="@fromDate" class="form-control bg-light border-0" />
                    </div>
                </div>
                <div class="col-md-4 col-6">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0"><i class="bi bi-calendar3 text-muted"></i></span>
                        <input type="date" name="toDate" value="@toDate" class="form-control bg-light border-0" />
                    </div>
                </div>
                <div class="col-md-4 col-12 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-fill rounded-3 shadow-sm">
                        <i class="bi bi-filter me-1"></i>Filter
                    </button>
                    <a asp-area="Student" asp-controller="Notification" asp-action="Index" class="btn btn-outline-secondary rounded-3">
                        <i class="bi bi-arrow-counterclockwise"></i> Reset
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-body p-0">
            @if (!items.Any())
            {
                <div class="text-center text-muted py-5">
                    <i class="bi bi-bell-slash text-secondary opacity-50 display-4 d-block mb-2"></i>
                    <p class="mb-0 fw-semibold fs-6">No notifications found</p>
                    <span class="small">No alert messages found for the selected date range (@fromDate to @toDate).</span>
                </div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var n in items)
                    {
                        var (icon, color) = n.NotificationType switch
                        {
                            "BusApproaching" => ("bi-bus-front-fill", "text-primary"),
                            "StudentPickedUp" => ("bi-check-circle-fill", "text-success"),
                            "NoShow" => ("bi-exclamation-circle-fill", "text-danger"),
                            "BusAssigned" => ("bi-bus-front", "text-info"),
                            "RouteChanged" => ("bi-map-fill", "text-warning"),
                            "Broadcast" => ("bi-megaphone-fill", "text-secondary"),
                            _ => ("bi-bell-fill", "text-muted")
                        };

                        <div class="list-group-item p-4 d-flex align-items-start justify-content-between gap-3 @(n.IsRead ? "bg-light-subtle" : "bg-white")">
                            <div class="d-flex gap-3">
                                <div class="rounded-circle p-3 d-flex align-items-center justify-content-center @(n.IsRead ? "bg-secondary-subtle text-secondary" : "bg-primary-subtle text-primary border border-primary-subtle")" style="width: 48px; height: 48px;">
                                    <i class="bi @icon fs-5 @color"></i>
                                </div>
                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <h6 class="fw-bold mb-0 text-dark">@n.Title</h6>
                                        <span class="badge bg-secondary-subtle text-dark border font-monospace" style="font-size:.68rem">@n.NotificationType</span>
                                    </div>
                                    <p class="mb-1 text-secondary">@n.Body</p>
                                    <span class="text-muted small"><i class="bi bi-clock me-1"></i>@n.SentAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</span>
                                </div>
                            </div>
                            @if (!n.IsRead)
                            {
                                <form asp-area="Student" asp-controller="Notification" asp-action="MarkRead" asp-route-id="@n.NotificationId" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate" asp-route-page="@currentPage" method="post" class="flex-shrink-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-primary rounded-3">
                                        Mark Read
                                    </button>
                                </form>
                            }
                        </div>
                    }
                </div>

                @if (totalPages > 1)
                {
                    <div class="card-footer bg-white border-top py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <span class="small text-muted">
                            Showing page <strong>@currentPage</strong> of <strong>@totalPages</strong> (@totalCount total notifications)
                        </span>
                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                    <a class="page-link rounded-3 px-3 me-1" asp-area="Student" asp-controller="Notification" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate">
                                        &laquo; Prev
                                    </a>
                                </li>
                                @for (int p = 1; p <= totalPages; p++)
                                {
                                    <li class="page-item @(p == currentPage ? "active" : "")">
                                        <a class="page-link rounded-3 me-1" asp-area="Student" asp-controller="Notification" asp-action="Index" asp-route-page="@p" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate">@p</a>
                                    </li>
                                }
                                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                    <a class="page-link rounded-3 px-3" asp-area="Student" asp-controller="Notification" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate">
                                        Next &raquo;
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            }
        </div>
    </div>
</div>
