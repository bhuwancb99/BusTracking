@model BusTracking.Common.DTOs.Exam.StudentReportCardDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Report Card - @Model.StudentName (@Model.TermName)</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
            @@media print {
                .no-print {
                    display: none !important;
                }

                body {
                    background: #ffffff !important;
                }

                .report-card-container {
                    box-shadow: none !important;
                    border: none !important;
                    padding: 0 !important;
                    margin: 0 !important;
                    max-width: 100% !important;
                }
            }
    </style>

</head>
<body>

    <!-- Printable Header Toolbar -->
    <div class="no-print bg-dark text-white p-3 text-center d-flex justify-content-between align-items-center">
        <span class="fw-bold"><i class="bi bi-file-earmark-pdf me-2"></i>Report Card Preview (PDF Export Mode)</span>
        <div>
            <button onclick="window.print()" class="btn btn-primary btn-sm px-4 fw-bold">
                <i class="bi bi-printer me-1"></i>Print / Save as PDF
            </button>
            <button onclick="window.close()" class="btn btn-outline-light btn-sm ms-2">Close</button>
        </div>
    </div>

    <div class="report-card-container">
        <!-- School Header -->
        <div class="school-header text-center">
            <h1 class="fw-bold text-primary mb-1">SCHOOL ERP ACADEMY</h1>
            <p class="text-muted small text-uppercase mb-1">Academic Year: <strong>@Model.AcademicYearName</strong></p>
            <h4 class="fw-bold mt-2"><span class="badge bg-primary px-4 py-2">@Model.TermName REPORT CARD</span></h4>
        </div>

        <!-- Student Info Box -->
        <div class="row g-3 p-3 bg-light rounded-3 border mb-4">
            <div class="col-6 col-md-3">
                <span class="small text-muted d-block">Student Name</span>
                <strong class="text-dark">@Model.StudentName</strong>
            </div>
            <div class="col-6 col-md-3">
                <span class="small text-muted d-block">Student ID / Code</span>
                <strong class="text-dark font-monospace">@Model.StudentCode</strong>
            </div>
            <div class="col-6 col-md-3">
                <span class="small text-muted d-block">Standard / Class</span>
                <strong class="text-dark">@Model.StandardName</strong>
            </div>
            <div class="col-6 col-md-3">
                <span class="small text-muted d-block">Section</span>
                <strong class="text-dark">@Model.SectionName</strong>
            </div>
        </div>

        <!-- Subject Marks Table -->
        <table class="table table-bordered table-report align-middle mb-4">
            <thead>
                <tr>
                    <th class="text-start ps-3">Subject</th>
                    <th class="col-w-100">Max Marks</th>
                    <th class="col-w-100">Pass Marks</th>
                    <th class="col-w-130">Marks Obtained</th>
                    <th class="col-w-80">Grade</th>
                    <th>Remarks</th>
                </tr>
            </thead>

            <tbody class="text-center">
                @foreach (var sub in Model.SubjectMarks)
                {
                    <tr>
                        <td class="text-start ps-3 fw-bold">@sub.SubjectName</td>
                        <td>@sub.MaxMarks</td>
                        <td>@sub.PassMarks</td>
                        <td class="fw-bold">
                            @(sub.IsAbsent ? "ABSENT" : (sub.MarksObtained?.ToString("G29") ?? "N/A"))
                        </td>
                        <td><span class="badge bg-secondary">@(sub.IsAbsent ? "ABS" : sub.Grade)</span></td>
                        <td class="text-start small text-muted">@(string.IsNullOrWhiteSpace(sub.Remarks) ? "-" : sub.Remarks)</td>
                    </tr>
                }
            </tbody>
            <tfoot class="bg-light text-center fw-bold">
                <tr>
                    <td class="text-start ps-3">TOTAL AGGREGATE</td>
                    <td>@Model.TotalMaxMarks</td>
                    <td>-</td>
                    <td class="text-primary fs-5">@Model.TotalMarksObtained</td>
                    <td><span class="badge bg-dark">@Model.OverallGrade</span></td>
                    <td class="text-start">Percentage: <strong>@Model.Percentage%</strong></td>
                </tr>
            </tfoot>
        </table>

        <!-- Summary & Status -->
        <div class="row align-items-center p-3 border rounded-3 bg-light">
            <div class="col-md-6">
                <h5 class="fw-bold m-0">
                    Final Result Status:
                    <span class="badge @(Model.ResultStatus == "PASS" ? "bg-success" : "bg-danger") px-3">
                        @Model.ResultStatus
                    </span>
                </h5>
            </div>
            <div class="col-md-6 text-md-end">
                <span class="small text-muted">Grade: <strong>@Model.OverallGrade</strong> | Overall Percentage: <strong>@Model.Percentage%</strong></span>
            </div>
        </div>

        <!-- Signature Section -->
        <div class="row mt-5 pt-4 text-center">
            <div class="col-4">
                <div class="border-top pt-2 small text-muted fw-bold">Class Teacher Signature</div>
            </div>
            <div class="col-4">
                <div class="border-top pt-2 small text-muted fw-bold">Exam Controller Signature</div>
            </div>
            <div class="col-4">
                <div class="border-top pt-2 small text-muted fw-bold">Principal Signature</div>
            </div>
        </div>
    </div>

</body>
</html>
