@model List<BusTracking.Common.DTOs.Availability.AvailabilityDto>
@{
    ViewData["Title"] = "My Availability";
}

<div class="container-fluid p-0">
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
        <div>
            <h2 class="fw-bold m-0 text-dark">
                <i class="bi bi-calendar-check text-primary me-2"></i>My Availability & Leave
            </h2>
            <nav aria-label="breadcrumb" class="mt-1">
                <ol class="breadcrumb mb-0 small text-muted">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Dashboard")" class="text-decoration-none text-muted">Dashboard</a></li>
                    <li class="breadcrumb-item active text-primary" aria-current="page">Availability</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row g-4">
        <!-- Add Leave Form -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 bg-white h-100">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-0 fw-bold text-primary text-uppercase fs-7">
                    Mark Unavailability / Leave
                </div>
                <div class="card-body p-4">
                    <form asp-area="Student" asp-controller="Home" asp-action="SetAvailability" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="StudentId" value="@ViewBag.StudentId" />
                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-muted">Reason <span class="text-danger">*</span></label>
                            <select name="AvailabilityType" class="form-select rounded-3">
                                <option value="OnLeave">On Leave</option>
                                <option value="NotGoingToSchool">Not Going to School</option>
                                <option value="ParentPickup">Parent Pickup</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-muted">From Date <span class="text-danger">*</span></label>
                            <input type="date" name="FromDate" class="form-control rounded-3" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-muted">To Date <span class="text-danger">*</span></label>
                            <input type="date" name="ToDate" class="form-control rounded-3" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-semibold small text-muted">Remarks</label>
                            <textarea name="Remarks" class="form-control rounded-3" rows="3" placeholder="Optional notes for driver…"></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary rounded-3 w-100 shadow-sm">
                            <i class="bi bi-check-circle me-1"></i>Save Availability
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Upcoming Records Table -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 bg-white h-100">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-0 fw-bold text-primary text-uppercase fs-7">
                    Upcoming Availability Records
                </div>
                <div class="card-body p-4">
                    @if (Model is null || Model.Count == 0)
                    {
                        <div class="text-center text-muted py-5">
                            <i class="bi bi-calendar-check text-secondary opacity-50 display-4 d-block mb-2"></i>
                            <p class="fw-semibold mb-0">No upcoming leave records</p>
                            <span class="small">You are currently marked available for all bus routes.</span>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table align-middle table-hover mb-0">
                                <thead class="bg-light-subtle border-bottom">
                                    <tr class="text-uppercase fs-7 text-muted fw-bold">
                                        <th>Reason</th>
                                        <th>From</th>
                                        <th>To</th>
                                        <th>Remarks</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var a in Model)
                                    {
                                        <tr>
                                            <td><span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-1">@a.AvailabilityType</span></td>
                                            <td class="fw-semibold text-dark">@a.FromDate</td>
                                            <td class="fw-semibold text-dark">@a.ToDate</td>
                                            <td class="text-secondary small">@(a.Remarks ?? "–")</td>
                                            <td class="text-end">
                                                <button type="button" class="btn btn-sm btn-outline-primary rounded-3 me-1" data-bs-toggle="modal" data-bs-target="#editModal_@a.AvailabilityId">
                                                    <i class="bi bi-pencil me-1"></i>Edit
                                                </button>
                                                <form asp-area="Student" asp-controller="Home" asp-action="DeleteAvailability" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this availability record?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="availabilityId" value="@a.AvailabilityId" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-3">
                                                        <i class="bi bi-trash me-1"></i>Delete
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>

                                        <!-- Edit Modal -->
                                        <div class="modal fade" id="editModal_@a.AvailabilityId" tabindex="-1" aria-labelledby="editModalLabel_@a.AvailabilityId" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content border-0 shadow-lg rounded-4">
                                                    <div class="modal-header border-0 pb-0">
                                                        <h5 class="modal-title fw-bold text-dark" id="editModalLabel_@a.AvailabilityId">
                                                            <i class="bi bi-pencil-square text-primary me-2"></i>Edit Leave / Unavailability
                                                        </h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <form asp-area="Student" asp-controller="Home" asp-action="UpdateAvailability" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="AvailabilityId" value="@a.AvailabilityId" />
                                                        <input type="hidden" name="StudentId" value="@ViewBag.StudentId" />
                                                        <div class="modal-body p-4">
                                                            <div class="mb-3">
                                                                <label class="form-label fw-semibold small text-muted">Reason <span class="text-danger">*</span></label>
                                                                <select name="AvailabilityType" class="form-select rounded-3">
                                                                    <option value="OnLeave" selected="@(a.AvailabilityType == "OnLeave")">On Leave</option>
                                                                    <option value="NotGoingToSchool" selected="@(a.AvailabilityType == "NotGoingToSchool")">Not Going to School</option>
                                                                    <option value="ParentPickup" selected="@(a.AvailabilityType == "ParentPickup")">Parent Pickup</option>
                                                                </select>
                                                            </div>
                                                            <div class="mb-3">
                                                                <label class="form-label fw-semibold small text-muted">From Date <span class="text-danger">*</span></label>
                                                                <input type="date" name="FromDate" value="@a.FromDate" class="form-control rounded-3" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                                                            </div>
                                                            <div class="mb-3">
                                                                <label class="form-label fw-semibold small text-muted">To Date <span class="text-danger">*</span></label>
                                                                <input type="date" name="ToDate" value="@a.ToDate" class="form-control rounded-3" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                                                            </div>
                                                            <div class="mb-3">
                                                                <label class="form-label fw-semibold small text-muted">Remarks</label>
                                                                <textarea name="Remarks" class="form-control rounded-3" rows="3" placeholder="Optional notes…">@a.Remarks</textarea>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer border-0 pt-0">
                                                            <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-primary rounded-3 px-4 shadow-sm">
                                                                <i class="bi bi-check-circle me-1"></i>Update Record
                                                            </button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
