@using BusTracking.Common.Helpers
@inject BusTracking.Common.Data.AppDbContext DbContext
@inject BusTracking.Common.Interfaces.ICurrentUserService CurrentUser
@{
    ViewData["Title"] = "Student Dashboard";
    string? userPhoto = null;
    var uId = CurrentUser.UserId;
    if (uId.HasValue)
    {
        var dbUser = DbContext.Users.IgnoreQueryFilters().FirstOrDefault(u => u.UserId == uId.Value);
        if (dbUser != null)
        {
            userPhoto = dbUser.ProfileImageUrl;
        }
    }
    var studentName = User.Identity?.Name ?? "Student";
}

<div class="container-fluid p-0">
    <div class="row g-4 mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-white" style="background: linear-gradient(135deg, #3d5af1 0%, #2241d7 100%);">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <img src="@(string.IsNullOrWhiteSpace(userPhoto) ? "/images/default-avatar.svg" : userPhoto)" class="rounded-circle border border-2 border-white shadow-sm" style="width: 65px; height: 65px; object-fit: cover;" onerror="this.onerror=null;this.src='/images/default-avatar.svg';" />
                        <div>
                            <h3 class="fw-bold mb-1">Welcome back, @studentName!</h3>
                            <p class="mb-0 text-white-50">Student Portal • Bus Tracking & Route Status</p>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <a href="@Url.Action("Index", "Notification", new { area = "Student" })" class="btn btn-light rounded-3 px-4 fw-semibold position-relative">
                            <i class="bi bi-bell me-2"></i>Notifications
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-4 bg-white">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h6 class="fw-bold text-primary text-uppercase fs-7 m-0"><i class="bi bi-geo-alt-fill me-2"></i>Live Bus Map</h6>
                    <i class="bi bi-map-fill text-danger fs-3"></i>
                </div>
                <p class="text-secondary small mb-4">View live location and arrival estimate of your assigned school bus.</p>
                <div class="mt-auto">
                    <a asp-area="Student" asp-controller="Tracking" asp-action="Track" asp-route-tripId="0" class="btn btn-danger rounded-3 px-4 shadow-sm w-100">
                        <i class="bi bi-map me-1"></i>Open Live Map
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-4 bg-white">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h6 class="fw-bold text-primary text-uppercase fs-7 m-0"><i class="bi bi-calendar-check-fill me-2"></i>My Availability</h6>
                    <i class="bi bi-calendar-event text-primary fs-3"></i>
                </div>
                <p class="text-secondary small mb-4">Mark planned leaves or absence days so your driver is notified in advance.</p>
                <div class="mt-auto">
                    <a asp-area="Student" asp-controller="Home" asp-action="Availability" class="btn btn-primary rounded-3 px-4 shadow-sm w-100">
                        <i class="bi bi-calendar-event me-1"></i>Manage Availability
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-4 bg-white">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h6 class="fw-bold text-primary text-uppercase fs-7 m-0"><i class="bi bi-headset me-2"></i>Help & Support</h6>
                    <i class="bi bi-chat-dots-fill text-success fs-3"></i>
                </div>
                <p class="text-secondary small mb-4">Need help or want to report an issue with bus tracking or stops?</p>
                <div class="mt-auto">
                    <a asp-area="Student" asp-controller="Feedback" asp-action="Submit" class="btn btn-outline-primary rounded-3 px-4 w-100">
                        <i class="bi bi-chat-dots me-1"></i>Contact Support
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
