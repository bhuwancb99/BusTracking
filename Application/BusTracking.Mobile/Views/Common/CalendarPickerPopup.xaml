<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="BusTracking.Mobile.Views.Common.CalendarPickerPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:calendar="clr-namespace:Syncfusion.Maui.Toolkit.Calendar;assembly=Syncfusion.Maui.Toolkit"
    xmlns:mct="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"
    x:Name="self">

    <Grid
        BackgroundColor="#90000000"
        IsVisible="{Binding IsOpen, Source={x:Reference self}}"
        ZIndex="99">

        <Border
            Margin="20"
            Padding="0"
            BackgroundColor="{AppThemeBinding Light=White,
                                              Dark=#1E293B}"
            HorizontalOptions="Center"
            Stroke="{AppThemeBinding Light=#E2E8F0,
                                     Dark=#334155}"
            StrokeShape="RoundRectangle 20"
            StrokeThickness="1.5"
            VerticalOptions="Center"
            WidthRequest="340">
            <Border.Shadow>
                <Shadow
                    Brush="Black"
                    Opacity="0.25"
                    Radius="20"
                    Offset="0,10" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="0">

                <!--  Stylish Premium Header  -->
                <Grid
                    Padding="16,14"
                    BackgroundColor="{AppThemeBinding Light=#F8FAFC,
                                                      Dark=#0F172A}"
                    ColumnDefinitions="Auto,*,Auto">

                    <Border
                        Grid.Column="0"
                        Padding="8"
                        BackgroundColor="{AppThemeBinding Light=#EFF6FF,
                                                          Dark=#1E3A8A}"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="0"
                        VerticalOptions="Center">
                        <Image
                            HeightRequest="18"
                            Source="calendar_icon.png"
                            WidthRequest="18">
                            <Image.Behaviors>
                                <mct:IconTintColorBehavior TintColor="{AppThemeBinding Light={StaticResource Primary}, Dark=White}" />
                            </Image.Behaviors>
                        </Image>
                    </Border>

                    <VerticalStackLayout
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        Spacing="2"
                        VerticalOptions="Center">
                        <Label
                            FontAttributes="Bold"
                            FontSize="14"
                            Text="{Binding Title, Source={x:Reference self}}"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                        Dark=White}" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="12"
                            Text="{Binding DisplaySelectedDate, Source={x:Reference self}}"
                            TextColor="{AppThemeBinding Light={StaticResource Primary},
                                                        Dark=#60A5FA}" />
                    </VerticalStackLayout>

                    <Border
                        Grid.Column="2"
                        Padding="6"
                        BackgroundColor="Transparent"
                        StrokeShape="RoundRectangle 16"
                        VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCancelClicked" />
                        </Border.GestureRecognizers>
                        <Image
                            HeightRequest="18"
                            Source="close.png"
                            WidthRequest="18">
                            <Image.Behaviors>
                                <mct:IconTintColorBehavior TintColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}" />
                            </Image.Behaviors>
                        </Image>
                    </Border>
                </Grid>

                <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" />

                <!--  Calendar Control Body  -->
                <VerticalStackLayout Padding="14,12,14,16" Spacing="14">
                    <calendar:SfCalendar
                        x:Name="CalendarControl"
                        HeightRequest="300"
                        MinimumDate="{Binding MinimumDate, Source={x:Reference self}}"
                        SelectionChanged="OnCalendarSelectionChanged"
                        SelectionMode="Single"
                        View="Month">
                        <calendar:SfCalendar.HeaderView>
                            <calendar:CalendarHeaderView Height="40" Background="Transparent">
                                <calendar:CalendarHeaderView.TextStyle>
                                    <calendar:CalendarTextStyle
                                        FontAttributes="Bold"
                                        FontSize="15"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                                    Dark=White}" />
                                </calendar:CalendarHeaderView.TextStyle>
                            </calendar:CalendarHeaderView>
                        </calendar:SfCalendar.HeaderView>
                        <calendar:SfCalendar.MonthView>
                            <calendar:CalendarMonthView>
                                <calendar:CalendarMonthView.HeaderView>
                                    <calendar:CalendarMonthHeaderView Background="Transparent">
                                        <calendar:CalendarMonthHeaderView.TextStyle>
                                            <calendar:CalendarTextStyle
                                                FontAttributes="Bold"
                                                FontSize="11"
                                                TextColor="{AppThemeBinding Light=#64748B,
                                                                            Dark=#94A3B8}" />
                                        </calendar:CalendarMonthHeaderView.TextStyle>
                                    </calendar:CalendarMonthHeaderView>
                                </calendar:CalendarMonthView.HeaderView>
                            </calendar:CalendarMonthView>
                        </calendar:SfCalendar.MonthView>
                    </calendar:SfCalendar>

                    <!--  Action Buttons  -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button
                            Grid.Column="0"
                            BackgroundColor="{AppThemeBinding Light=#F1F5F9,
                                                              Dark=#334155}"
                            Clicked="OnCancelClicked"
                            CornerRadius="10"
                            FontAttributes="Bold"
                            HeightRequest="44"
                            Text="Cancel"
                            TextColor="{AppThemeBinding Light=#475569,
                                                        Dark=#E2E8F0}" />
                        <Button
                            Grid.Column="1"
                            BackgroundColor="{StaticResource Primary}"
                            Clicked="OnOkClicked"
                            CornerRadius="10"
                            FontAttributes="Bold"
                            HeightRequest="44"
                            Text="OK"
                            TextColor="White">
                            <Button.Shadow>
                                <Shadow
                                    Brush="{StaticResource Primary}"
                                    Opacity="0.3"
                                    Radius="8"
                                    Offset="0,4" />
                            </Button.Shadow>
                        </Button>
                    </Grid>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>
