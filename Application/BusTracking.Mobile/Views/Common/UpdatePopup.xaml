<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="BusTracking.Mobile.Views.Common.UpdatePopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">

    <Border
        Margin="24"
        Padding="24"
        BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                          Dark={StaticResource CardBgDark}}"
        HorizontalOptions="Center"
        Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                 Dark={StaticResource BorderColorDark}}"
        StrokeShape="RoundRectangle 24"
        StrokeThickness="1.5"
        VerticalOptions="Center"
        WidthRequest="330">
        <Border.Shadow>
            <Shadow
                Brush="Black"
                Opacity="0.25"
                Radius="16"
                Offset="0,8" />
        </Border.Shadow>

        <VerticalStackLayout Spacing="18">

            <!--  Icon badge  -->
            <Border
                BackgroundColor="{AppThemeBinding Light=#F0F4FF,
                                                  Dark=#1A2440}"
                HeightRequest="64"
                HorizontalOptions="Center"
                StrokeShape="Ellipse"
                StrokeThickness="0"
                WidthRequest="64">
                <Label
                    FontSize="32"
                    HorizontalOptions="Center"
                    Text="🚀"
                    VerticalOptions="Center" />
            </Border>

            <!--  Title  -->
            <Label
                x:Name="TitleLabel"
                FontAttributes="Bold"
                FontSize="19"
                HorizontalTextAlignment="Center"
                Text="Update Available"
                TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                            Dark={StaticResource TextPrimaryDark}}" />

            <!--  Message  -->
            <Label
                x:Name="MessageLabel"
                FontSize="14"
                HorizontalTextAlignment="Center"
                LineBreakMode="WordWrap"
                Text="A newer version is available. Please update for the best experience."
                TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                            Dark={StaticResource TextSecondaryDark}}" />

            <!--  Version info pill  -->
            <Border
                Padding="14,8"
                BackgroundColor="{AppThemeBinding Light=#F7F9FB,
                                                  Dark=#191c1e}"
                HorizontalOptions="Center"
                StrokeShape="RoundRectangle 10"
                StrokeThickness="0">
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                    <Label
                        FontSize="12"
                        Text="Installed:"
                        TextColor="{AppThemeBinding Light={StaticResource TextMuted},
                                                    Dark={StaticResource TextMutedDark}}"
                        VerticalOptions="Center" />
                    <Label
                        x:Name="LblCurrentVersion"
                        FontAttributes="Bold"
                        FontSize="12"
                        Text="1.0.0"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                    Dark={StaticResource TextPrimaryDark}}"
                        VerticalOptions="Center" />
                    <Label
                        FontSize="12"
                        Text="→"
                        TextColor="{AppThemeBinding Light={StaticResource TextMuted},
                                                    Dark={StaticResource TextMutedDark}}"
                        VerticalOptions="Center" />
                    <Label
                        FontSize="12"
                        Text="Latest:"
                        TextColor="{AppThemeBinding Light={StaticResource TextMuted},
                                                    Dark={StaticResource TextMutedDark}}"
                        VerticalOptions="Center" />
                    <Label
                        x:Name="LblNewVersion"
                        FontAttributes="Bold"
                        FontSize="12"
                        Text="2.0.0"
                        TextColor="{StaticResource Primary}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <!--  Actions  -->
            <Grid
                x:Name="ActionGrid"
                Margin="0,4,0,0"
                ColumnDefinitions="*,*"
                ColumnSpacing="12">

                <!--  Later button (hidden when mandatory)  -->
                <Button
                    x:Name="LaterButton"
                    Grid.Column="0"
                    BackgroundColor="{StaticResource Primary}"
                    Clicked="OnLaterClicked"
                    CornerRadius="12"
                    FontAttributes="Bold"
                    HeightRequest="48"
                    Text="Later"
                    TextColor="White" />

                <!--  Update Now button  -->
                <Button
                    x:Name="UpdateButton"
                    Grid.Column="1"
                    BackgroundColor="{StaticResource Primary}"
                    Clicked="OnUpdateClicked"
                    CornerRadius="12"
                    FontAttributes="Bold"
                    HeightRequest="48"
                    Text="Update Now"
                    TextColor="White" />
            </Grid>

            <!--  Mandatory notice  -->
            <Label
                x:Name="MandatoryNotice"
                FontSize="11"
                HorizontalTextAlignment="Center"
                IsVisible="False"
                Text="This update is required to continue using the app."
                TextColor="{StaticResource Danger}" />

        </VerticalStackLayout>
    </Border>

</toolkit:Popup>
