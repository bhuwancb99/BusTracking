<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BusTracking.Mobile.Views.Common.MaintenancePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mct="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">

    <ContentPage.Behaviors>
        <mct:StatusBarBehavior StatusBarColor="{AppThemeBinding Light={StaticResource Primary}, Dark=#0a0e1a}" StatusBarStyle="LightContent" />
    </ContentPage.Behaviors>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0.0" Color="{AppThemeBinding Light={StaticResource Primary}, Dark=#0a0e1a}" />
                <GradientStop Offset="0.4" Color="{AppThemeBinding Light=#1a3a9e, Dark=#0d1630}" />
                <GradientStop Offset="1.0" Color="{AppThemeBinding Light=#0d1630, Dark=#060a18}" />
            </LinearGradientBrush>
        </Grid.Background>

        <VerticalStackLayout
            Padding="32,0"
            HorizontalOptions="Center"
            Spacing="0"
            VerticalOptions="Center">

            <!--  Glowing circle behind icon  -->
            <Border
                Margin="0,0,0,8"
                BackgroundColor="#1affffff"
                HeightRequest="120"
                HorizontalOptions="Center"
                StrokeShape="Ellipse"
                StrokeThickness="0"
                WidthRequest="120">
                <Border
                    BackgroundColor="#33ffffff"
                    HeightRequest="90"
                    HorizontalOptions="Center"
                    StrokeShape="Ellipse"
                    StrokeThickness="0"
                    VerticalOptions="Center"
                    WidthRequest="90">
                    <Label
                        FontSize="44"
                        HorizontalOptions="Center"
                        Text="🔧"
                        VerticalOptions="Center" />
                </Border>
            </Border>

            <!--  Title  -->
            <Label
                Margin="0,20,0,0"
                FontAttributes="Bold"
                FontFamily="InterSemiBold"
                FontSize="26"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                Text="Under Maintenance"
                TextColor="White" />

            <!--  Subtitle message  -->
            <Label
                x:Name="MessageLabel"
                Margin="0,12,0,0"
                FontSize="15"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                LineBreakMode="WordWrap"
                MaximumWidthRequest="320"
                Opacity="0.8"
                Text="We are under maintenance. Please check back soon."
                TextColor="White" />

            <!--  Decorative divider line  -->
            <BoxView
                Margin="0,28,0,28"
                BackgroundColor="#22ffffff"
                HeightRequest="1"
                HorizontalOptions="Fill"
                WidthRequest="200" />

            <!--  Info card  -->
            <Border
                Padding="20,16"
                BackgroundColor="#12ffffff"
                HorizontalOptions="Center"
                MaximumWidthRequest="340"
                StrokeShape="RoundRectangle 16"
                StrokeThickness="0">
                <VerticalStackLayout Spacing="12">
                    <Label
                        FontSize="14"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        Opacity="0.7"
                        Text="Our team is working hard to get things back up and running. Thank you for your patience!"
                        TextColor="White" />

                    <ActivityIndicator
                        HeightRequest="28"
                        IsRunning="True"
                        WidthRequest="28"
                        Color="White" />
                </VerticalStackLayout>
            </Border>

            <!--  Retry button  -->
            <Button
                x:Name="RetryButton"
                Margin="0,32,0,0"
                BackgroundColor="#22ffffff"
                Clicked="OnRetryClicked"
                CornerRadius="14"
                FontAttributes="Bold"
                FontSize="15"
                HeightRequest="50"
                HorizontalOptions="Center"
                Text="Retry"
                TextColor="White"
                WidthRequest="200" />

        </VerticalStackLayout>
    </Grid>

</ContentPage>
