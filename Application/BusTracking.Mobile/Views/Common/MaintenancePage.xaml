<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BusTracking.Mobile.Views.Common.MaintenancePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mct="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBg},
                                      Dark={StaticResource PageBgDark}}"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">

    <ContentPage.Behaviors>
        <mct:StatusBarBehavior StatusBarColor="{AppThemeBinding Light={StaticResource PageBg}, Dark={StaticResource PageBgDark}}" StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}" />
    </ContentPage.Behaviors>

    <Grid>
        <!--  ══════ LOADING STATE (shown first while checking config) ══════  -->
        <VerticalStackLayout
            x:Name="LoadingPanel"
            HorizontalOptions="Center"
            IsVisible="True"
            Spacing="20"
            VerticalOptions="Center">

            <ActivityIndicator
                HeightRequest="48"
                IsRunning="True"
                WidthRequest="48"
                Color="{StaticResource Primary}" />

            <Label
                FontSize="15"
                HorizontalOptions="Center"
                Text="Checking system status..."
                TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                            Dark={StaticResource TextPrimaryDark}}" />
        </VerticalStackLayout>

        <!--  ══════ MAINTENANCE STATE (shown if maintenance mode is ON) ══════  -->
        <VerticalStackLayout
            x:Name="MaintenancePanel"
            Padding="32,0"
            HorizontalOptions="Center"
            IsVisible="False"
            Spacing="0"
            VerticalOptions="Center">

            <!--  Icon Badge  -->
            <Border
                Margin="0,0,0,8"
                BackgroundColor="{AppThemeBinding Light=#F0F4FF,
                                                  Dark=#1A2440}"
                HeightRequest="110"
                HorizontalOptions="Center"
                StrokeShape="Ellipse"
                StrokeThickness="0"
                WidthRequest="110">
                <Border
                    BackgroundColor="{AppThemeBinding Light=#E0E9FF,
                                                      Dark=#253358}"
                    HeightRequest="80"
                    HorizontalOptions="Center"
                    StrokeShape="Ellipse"
                    StrokeThickness="0"
                    VerticalOptions="Center"
                    WidthRequest="80">
                    <Label
                        FontSize="40"
                        HorizontalOptions="Center"
                        Text="🔧"
                        VerticalOptions="Center" />
                </Border>
            </Border>

            <!--  Title  -->
            <Label
                Margin="0,20,0,0"
                FontAttributes="Bold"
                FontFamily="InterSemiBold"
                FontSize="24"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                Text="Under Maintenance"
                TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                            Dark={StaticResource TextPrimaryDark}}" />

            <!--  Subtitle message  -->
            <Label
                x:Name="MessageLabel"
                Margin="0,12,0,0"
                FontSize="14"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                LineBreakMode="WordWrap"
                MaximumWidthRequest="320"
                Text="We are under maintenance. Please check back soon."
                TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                            Dark={StaticResource TextSecondaryDark}}" />

            <!--  Info Card  -->
            <Border
                Margin="0,28,0,0"
                Padding="20,16"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                  Dark={StaticResource CardBgDark}}"
                HorizontalOptions="Center"
                MaximumWidthRequest="340"
                Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                         Dark={StaticResource BorderColorDark}}"
                StrokeShape="RoundRectangle 16"
                StrokeThickness="1">
                <Border.Shadow>
                    <Shadow
                        Brush="Black"
                        Opacity="0.08"
                        Radius="12"
                        Offset="0,4" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="14">
                    <Label
                        FontSize="13"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        Text="Our team is working hard to get things back up and running. Thank you for your patience!"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                    Dark={StaticResource TextSecondaryDark}}" />

                    <ActivityIndicator
                        HeightRequest="24"
                        IsRunning="True"
                        WidthRequest="24"
                        Color="{StaticResource Primary}" />
                </VerticalStackLayout>
            </Border>

            <!--  Retry Button  -->
            <Button
                x:Name="RetryButton"
                Margin="0,28,0,0"
                BackgroundColor="{StaticResource Primary}"
                Clicked="OnRetryClicked"
                CornerRadius="14"
                FontAttributes="Bold"
                FontSize="15"
                HeightRequest="48"
                HorizontalOptions="Center"
                Text="Retry"
                TextColor="White"
                WidthRequest="200" />

        </VerticalStackLayout>
    </Grid>

</ContentPage>
