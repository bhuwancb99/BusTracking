<?xml version="1.0" encoding="utf-8" ?>
<views:ViewBase
    x:Class="BusTracking.Mobile.Views.Coordinator.CoordClassMappingListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mct="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"
    xmlns:models="clr-namespace:BusTracking.Mobile.Models.ClassMapping"
    xmlns:views="clr-namespace:BusTracking.Mobile.Views"
    xmlns:vm="clr-namespace:BusTracking.Mobile.Viewmodels.Coordinator"
    x:DataType="vm:CoordClassMappingListViewModel"
    x:TypeArguments="vm:CoordClassMappingListViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBg},
                                      Dark={StaticResource PageBgDark}}">

    <views:ViewBase.Behaviors>
        <mct:StatusBarBehavior StatusBarColor="{AppThemeBinding Light={StaticResource LoginPageBgLight}, Dark={StaticResource LoginPageBgDark}}" StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}" />
    </views:ViewBase.Behaviors>

    <Shell.TitleView>
        <Grid Padding="0,0,8,0" ColumnDefinitions="*,Auto">
            <Label
                Grid.Column="0"
                FontAttributes="Bold"
                FontSize="17"
                Text="Class Subject &amp; Teacher Mapping"
                TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                            Dark=White}"
                VerticalOptions="Center" />
            <Border
                Grid.Column="1"
                Padding="8"
                BackgroundColor="White"
                IsVisible="{Binding CanAdd}"
                StrokeShape="RoundRectangle 20"
                StrokeThickness="0"
                VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AddCommand}" />
                </Border.GestureRecognizers>
                <Image
                    HeightRequest="20"
                    Source="add.png"
                    WidthRequest="20">
                    <Image.Behaviors>
                        <mct:IconTintColorBehavior TintColor="{StaticResource Primary}" />
                    </Image.Behaviors>
                </Image>
            </Border>
        </Grid>
    </Shell.TitleView>

    <Grid RowDefinitions="Auto,*">

        <!--  Top Filter Card (3 Options in 1 Line with Vertical Separators)  -->
        <Border
            Grid.Row="0"
            Margin="12,10,12,4"
            Padding="10,8"
            BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                              Dark={StaticResource CardBgDark}}"
            Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                     Dark={StaticResource BorderColorDark}}"
            StrokeShape="RoundRectangle 12"
            StrokeThickness="1">
            <Grid ColumnDefinitions="*,Auto,*,Auto,*" ColumnSpacing="6">

                <!--  Column 1: Academic Session  -->
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label
                        FontAttributes="Bold"
                        FontSize="10"
                        Text="Session"
                        TextColor="{AppThemeBinding Light={StaticResource TextMuted},
                                                    Dark={StaticResource TextMutedDark}}" />
                    <Picker
                        FontSize="12"
                        ItemDisplayBinding="{Binding YearName}"
                        ItemsSource="{Binding AcademicYears}"
                        SelectedItem="{Binding SelectedYear}" />
                </VerticalStackLayout>

                <!--  Separator 1  -->
                <BoxView
                    Grid.Column="1"
                    Margin="2,4"
                    VerticalOptions="Fill"
                    WidthRequest="1"
                    Color="{AppThemeBinding Light=#cbd5e1,
                                            Dark=#334155}" />

                <!--  Column 2: Class / Standard  -->
                <VerticalStackLayout Grid.Column="2" Spacing="2">
                    <Label
                        FontAttributes="Bold"
                        FontSize="10"
                        Text="Class"
                        TextColor="{AppThemeBinding Light={StaticResource TextMuted},
                                                    Dark={StaticResource TextMutedDark}}" />
                    <Picker
                        FontSize="12"
                        ItemDisplayBinding="{Binding StandardName}"
                        ItemsSource="{Binding Standards}"
                        SelectedItem="{Binding SelectedStandard}" />
                </VerticalStackLayout>

                <!--  Separator 2  -->
                <BoxView
                    Grid.Column="3"
                    Margin="2,4"
                    VerticalOptions="Fill"
                    WidthRequest="1"
                    Color="{AppThemeBinding Light=#cbd5e1,
                                            Dark=#334155}" />

                <!--  Column 3: Section (Optional)  -->
                <VerticalStackLayout Grid.Column="4" Spacing="2">
                    <Label
                        FontAttributes="Bold"
                        FontSize="10"
                        Text="Section"
                        TextColor="{AppThemeBinding Light={StaticResource TextMuted},
                                                    Dark={StaticResource TextMutedDark}}" />
                    <Picker
                        FontSize="12"
                        ItemDisplayBinding="{Binding SectionName}"
                        ItemsSource="{Binding Sections}"
                        SelectedItem="{Binding SelectedSection}" />
                </VerticalStackLayout>

            </Grid>
        </Border>

        <!--  Mappings List  -->
        <RefreshView
            Grid.Row="1"
            Margin="12,4,12,0"
            Command="{Binding RefreshCommand}"
            IsRefreshing="{Binding IsRefreshing}">
            <CollectionView ItemsSource="{Binding Items}">
                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        Padding="30"
                        HorizontalOptions="Center"
                        Spacing="12"
                        VerticalOptions="Center">
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            HorizontalOptions="Center"
                            Text="No Mappings Found"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                        Dark=White}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ClassMappingItem">
                        <Border
                            Margin="0,6"
                            Padding="16"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                              Dark={StaticResource CardBgDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                                     Dark={StaticResource BorderColorDark}}"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1">
                            <VerticalStackLayout Spacing="10">

                                <!--  Top Row: ID Badge + Subject Name + Actions (Edit & Unassign)  -->
                                <Grid
                                    ColumnDefinitions="Auto,*,Auto"
                                    ColumnSpacing="10"
                                    VerticalOptions="Center">

                                    <!--  Left: ID & Subject Name  -->
                                    <HorizontalStackLayout
                                        Grid.Column="0"
                                        Spacing="8"
                                        VerticalOptions="Center">
                                        <Border
                                            Padding="6,2"
                                            BackgroundColor="{AppThemeBinding Light=#f1f5f9,
                                                                              Dark=#1e293b}"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 6"
                                            VerticalOptions="Center">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="11"
                                                Text="{Binding Id, StringFormat='#{0}'}"
                                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                                            Dark=#94a3b8}" />
                                        </Border>
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="16"
                                            Text="{Binding SubjectName}"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                                        Dark=White}"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                    <!--  Right: Action Buttons (Edit & Unassign)  -->
                                    <HorizontalStackLayout
                                        Grid.Column="2"
                                        Spacing="8"
                                        VerticalOptions="Center">
                                        <!--  Edit Button  -->
                                        <Border
                                            Padding="8,5"
                                            BackgroundColor="{AppThemeBinding Light=#eff6ff,
                                                                              Dark=#1e3a8a}"
                                            Stroke="#bfdbfe"
                                            StrokeShape="RoundRectangle 6">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CoordClassMappingListViewModel}}, Path=EditCommand}" CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <HorizontalStackLayout Spacing="4">
                                                <Image
                                                    HeightRequest="13"
                                                    Source="edit.png"
                                                    WidthRequest="13">
                                                    <Image.Behaviors>
                                                        <mct:IconTintColorBehavior TintColor="#2563eb" />
                                                    </Image.Behaviors>
                                                </Image>
                                                <Label
                                                    FontAttributes="Bold"
                                                    FontSize="12"
                                                    Text="Edit"
                                                    TextColor="#2563eb"
                                                    VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Border>

                                        <!--  Unassign Button  -->
                                        <Border
                                            Padding="8,5"
                                            BackgroundColor="{AppThemeBinding Light=#fef2f2,
                                                                              Dark=#7f1d1d}"
                                            Stroke="#fecaca"
                                            StrokeShape="RoundRectangle 6">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CoordClassMappingListViewModel}}, Path=DeleteCommand}" CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <HorizontalStackLayout Spacing="4">
                                                <Image
                                                    HeightRequest="13"
                                                    Source="delete.png"
                                                    WidthRequest="13">
                                                    <Image.Behaviors>
                                                        <mct:IconTintColorBehavior TintColor="#dc2626" />
                                                    </Image.Behaviors>
                                                </Image>
                                                <Label
                                                    FontAttributes="Bold"
                                                    FontSize="12"
                                                    Text="Unassign"
                                                    TextColor="#dc2626"
                                                    VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Border>
                                    </HorizontalStackLayout>
                                </Grid>

                                <!--  Middle Row: Class & Section  -->
                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="13"
                                        Text="{Binding StandardName}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                                    Dark=#cbd5e1}"
                                        VerticalOptions="Center" />
                                    <Border
                                        Padding="8,3"
                                        BackgroundColor="{AppThemeBinding Light=#f1f5f9,
                                                                          Dark=#334155}"
                                        Stroke="Transparent"
                                        StrokeShape="RoundRectangle 12">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="11"
                                            Text="{Binding SectionName, StringFormat='Section {0}'}"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                                        Dark=White}" />
                                    </Border>
                                </HorizontalStackLayout>

                                <!--  Divider  -->
                                <BoxView
                                    Margin="0,2"
                                    HeightRequest="1"
                                    Color="{AppThemeBinding Light=#f1f5f9,
                                                            Dark=#334155}" />

                                <!--  Bottom Row: Assigned Teacher Avatar + Name  -->
                                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                    <!--  Avatar initial  -->
                                    <Border
                                        BackgroundColor="#dbeafe"
                                        HeightRequest="28"
                                        HorizontalOptions="Center"
                                        Stroke="Transparent"
                                        StrokeShape="RoundRectangle 14"
                                        VerticalOptions="Center"
                                        WidthRequest="28">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="12"
                                            HorizontalOptions="Center"
                                            Text="{Binding TeacherInitial}"
                                            TextColor="#1e40af"
                                            VerticalOptions="Center" />
                                    </Border>

                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="13"
                                        Text="{Binding TeacherDisplayName}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                                    Dark=White}"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>

</views:ViewBase>
