<?xml version="1.0" encoding="utf-8" ?>
<views:ViewBase
    x:Class="BusTracking.Mobile.Views.Coordinator.CoordAcademicYearPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mct="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"
    xmlns:models="clr-namespace:BusTracking.Mobile.Models.AcademicYear"
    xmlns:views="clr-namespace:BusTracking.Mobile.Views"
    xmlns:vm="clr-namespace:BusTracking.Mobile.Viewmodels.Coordinator"
    Title="Academic Years"
    x:DataType="vm:CoordAcademicYearViewModel"
    x:TypeArguments="vm:CoordAcademicYearViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBg},
                                      Dark={StaticResource PageBgDark}}">

    <views:ViewBase.Behaviors>
        <mct:StatusBarBehavior StatusBarColor="{AppThemeBinding Light={StaticResource LoginPageBgLight}, Dark={StaticResource LoginPageBgDark}}" StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}" />
    </views:ViewBase.Behaviors>

    <Shell.TitleView>
        <Grid Padding="0,0,8,0" ColumnDefinitions="*,Auto">
            <Label
                Grid.Column="0"
                FontAttributes="Bold"
                FontSize="18"
                Text="Academic Years"
                TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                            Dark=White}"
                VerticalOptions="Center" />
            <Border
                Grid.Column="1"
                Padding="8"
                BackgroundColor="White"
                IsVisible="{Binding CanAdd}"
                StrokeShape="RoundRectangle 20"
                StrokeThickness="0"
                VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AddCommand}" />
                </Border.GestureRecognizers>
                <Image
                    HeightRequest="20"
                    Source="add.png"
                    WidthRequest="20">
                    <Image.Behaviors>
                        <mct:IconTintColorBehavior TintColor="{StaticResource Primary}" />
                    </Image.Behaviors>
                </Image>
            </Border>
        </Grid>
    </Shell.TitleView>

    <RefreshView Command="{Binding LoadAcademicYearsCommand}" IsRefreshing="{Binding IsRefreshing}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="14">

                <!--  Error Banner  -->
                <Border IsVisible="{Binding HasError}" Style="{StaticResource ErrorBannerBorder}">
                    <Label
                        FontSize="13"
                        Text="{Binding ErrorMessage}"
                        TextColor="{AppThemeBinding Light={StaticResource ErrorTextLight},
                                                    Dark={StaticResource ErrorTextDark}}" />
                </Border>

                <!--  Academic Years List  -->
                <CollectionView ItemsSource="{Binding AcademicYears}">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout
                            Padding="40"
                            HorizontalOptions="Center"
                            Spacing="12"
                            VerticalOptions="Center">
                            <Image
                                HeightRequest="64"
                                Source="calendar.png"
                                WidthRequest="64">
                                <Image.Behaviors>
                                    <mct:IconTintColorBehavior TintColor="{StaticResource TextMuted}" />
                                </Image.Behaviors>
                            </Image>
                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                HorizontalOptions="Center"
                                Text="No Academic Years Found"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                            Dark=White}" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:AcademicYearItem">
                            <Border
                                Margin="0,0,0,12"
                                Padding="16"
                                BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                                  Dark={StaticResource CardBgDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                                         Dark={StaticResource BorderColorDark}}"
                                StrokeShape="RoundRectangle 16"
                                StrokeThickness="1">
                                <Border.Triggers>
                                    <!--  Highlight active current session card background & stroke  -->
                                    <DataTrigger
                                        Binding="{Binding IsCurrent}"
                                        TargetType="Border"
                                        Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#ECFDF5, Dark=#064E3B}" />
                                        <Setter Property="Stroke" Value="{AppThemeBinding Light=#10B981, Dark=#059669}" />
                                        <Setter Property="StrokeThickness" Value="1.5" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CoordAcademicYearViewModel}}, Path=SetActiveSessionCommand}" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="*,Auto">
                                    <!--  Left: Year Info  -->
                                    <VerticalStackLayout
                                        Grid.Column="0"
                                        Spacing="4"
                                        VerticalOptions="Center">
                                        <HorizontalStackLayout Spacing="8">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="16"
                                                Text="{Binding YearName}"
                                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                                            Dark=White}" />
                                            <Border
                                                Padding="8,2"
                                                BackgroundColor="#ecfdf5"
                                                IsVisible="{Binding IsCurrent}"
                                                Stroke="#10b981"
                                                StrokeShape="RoundRectangle 12"
                                                StrokeThickness="1">
                                                <Label
                                                    FontAttributes="Bold"
                                                    FontSize="11"
                                                    Text="Active Session"
                                                    TextColor="#047857" />
                                            </Border>
                                        </HorizontalStackLayout>
                                        <Label
                                            FontSize="12"
                                            Text="{Binding StartDate, StringFormat='Start: {0:dd MMM yyyy}'}"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                                        Dark={StaticResource TextSecondaryDark}}" />
                                        <Label
                                            FontSize="12"
                                            Text="{Binding EndDate, StringFormat='End: {0:dd MMM yyyy}'}"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                                        Dark={StaticResource TextSecondaryDark}}" />
                                    </VerticalStackLayout>

                                    <!--  Right: Small Compact Edit Icon Button  -->
                                    <Border
                                        Grid.Column="1"
                                        Padding="6"
                                        BackgroundColor="{AppThemeBinding Light=#EFF6FF,
                                                                          Dark=#1E293B}"
                                        HeightRequest="28"
                                        IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:CoordAcademicYearViewModel}}, Path=CanEdit}"
                                        Stroke="{AppThemeBinding Light=#DBEAFE,
                                                                 Dark=#334155}"
                                        StrokeShape="RoundRectangle 8"
                                        StrokeThickness="1"
                                        VerticalOptions="Center"
                                        WidthRequest="28">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CoordAcademicYearViewModel}}, Path=EditCommand}" CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Image
                                            Aspect="AspectFit"
                                            HeightRequest="15"
                                            HorizontalOptions="Center"
                                            Source="edit.png"
                                            VerticalOptions="Center"
                                            WidthRequest="15">
                                            <Image.Behaviors>
                                                <mct:IconTintColorBehavior TintColor="{AppThemeBinding Light={StaticResource Primary}, Dark=White}" />
                                            </Image.Behaviors>
                                        </Image>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</views:ViewBase>
