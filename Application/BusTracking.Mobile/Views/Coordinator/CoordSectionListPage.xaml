<?xml version="1.0" encoding="utf-8" ?>
<views:ViewBase
    x:Class="BusTracking.Mobile.Views.Coordinator.CoordSectionListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mct="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"
    xmlns:models="clr-namespace:BusTracking.Mobile.Models.Section"
    xmlns:views="clr-namespace:BusTracking.Mobile.Views"
    xmlns:vm="clr-namespace:BusTracking.Mobile.Viewmodels.Coordinator"
    x:DataType="vm:CoordSectionListViewModel"
    x:TypeArguments="vm:CoordSectionListViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBg},
                                      Dark={StaticResource PageBgDark}}">

    <views:ViewBase.Behaviors>
        <mct:StatusBarBehavior StatusBarColor="{AppThemeBinding Light={StaticResource LoginPageBgLight}, Dark={StaticResource LoginPageBgDark}}" StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}" />
    </views:ViewBase.Behaviors>

    <Shell.TitleView>
        <Grid Padding="0,0,8,0" ColumnDefinitions="*,Auto">
            <Label
                Grid.Column="0"
                FontAttributes="Bold"
                FontSize="18"
                Text="Class Sections"
                TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                            Dark=White}"
                VerticalOptions="Center" />
            <Border
                Grid.Column="1"
                Padding="8"
                BackgroundColor="White"
                IsVisible="{Binding CanAdd}"
                StrokeShape="RoundRectangle 20"
                StrokeThickness="0"
                VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AddCommand}" />
                </Border.GestureRecognizers>
                <Image
                    HeightRequest="20"
                    Source="add.png"
                    WidthRequest="20">
                    <Image.Behaviors>
                        <mct:IconTintColorBehavior TintColor="{StaticResource Primary}" />
                    </Image.Behaviors>
                </Image>
            </Border>
        </Grid>
    </Shell.TitleView>

    <Grid RowDefinitions="Auto,*">

        <!--  Standard Selector Picker Card  -->
        <Border
            Grid.Row="0"
            Margin="12,12,12,6"
            Padding="14,10"
            BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                              Dark={StaticResource CardBgDark}}"
            Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                     Dark={StaticResource BorderColorDark}}"
            StrokeShape="RoundRectangle 12"
            StrokeThickness="1">
            <Grid
                ColumnDefinitions="Auto,*"
                ColumnSpacing="12"
                VerticalOptions="Center">
                <Label
                    Grid.Column="0"
                    FontAttributes="Bold"
                    FontSize="14"
                    Text="Class / Standard:"
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                Dark=White}"
                    VerticalOptions="Center" />
                <Picker
                    Grid.Column="1"
                    FontSize="14"
                    ItemDisplayBinding="{Binding StandardName}"
                    ItemsSource="{Binding Standards}"
                    SelectedItem="{Binding SelectedStandard}"
                    VerticalOptions="Center" />
            </Grid>
        </Border>

        <!--  Sections List  -->
        <RefreshView
            Grid.Row="1"
            Margin="12,4,12,0"
            Command="{Binding RefreshCommand}"
            IsRefreshing="{Binding IsRefreshing}">
            <CollectionView ItemsSource="{Binding Items}">
                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        Padding="30"
                        HorizontalOptions="Center"
                        Spacing="12"
                        VerticalOptions="Center">
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            HorizontalOptions="Center"
                            Text="No Sections Found"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                        Dark=White}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:SectionItem">
                        <Border
                            Margin="0,6"
                            Padding="16"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                              Dark={StaticResource CardBgDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                                     Dark={StaticResource BorderColorDark}}"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1">

                            <VerticalStackLayout Spacing="10">

                                <!--  Header Row: ID + Name + Status Pill + Actions  -->
                                <Grid
                                    ColumnDefinitions="Auto,*,Auto"
                                    ColumnSpacing="10"
                                    VerticalOptions="Center">

                                    <!--  Left: ID & Title & Status Pill  -->
                                    <HorizontalStackLayout
                                        Grid.Column="0"
                                        Spacing="8"
                                        VerticalOptions="Center">
                                        <Border
                                            Padding="8,3"
                                            BackgroundColor="{AppThemeBinding Light=#f1f5f9,
                                                                              Dark=#1e293b}"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 6"
                                            VerticalOptions="Center">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="11"
                                                Text="{Binding SectionId, StringFormat='#{0}'}"
                                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                                            Dark=#94a3b8}" />
                                        </Border>

                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="16"
                                            Text="{Binding SectionName, StringFormat='Section {0}'}"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                                        Dark=White}"
                                            VerticalOptions="Center" />

                                        <Border
                                            Padding="8,3"
                                            BackgroundColor="{Binding StatusBgColor}"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 20"
                                            VerticalOptions="Center">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="10"
                                                Text="{Binding StatusLabel}"
                                                TextColor="{Binding StatusTextColor}" />
                                        </Border>
                                    </HorizontalStackLayout>

                                    <!--  Right: Actions (Edit & Delete)  -->
                                    <HorizontalStackLayout
                                        Grid.Column="2"
                                        Spacing="10"
                                        VerticalOptions="Center">
                                        <!--  Edit Button  -->
                                        <Border
                                            Padding="7"
                                            BackgroundColor="{AppThemeBinding Light=#eff6ff,
                                                                              Dark=#1e3a8a}"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 8">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CoordSectionListViewModel}}, Path=EditCommand}" CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Image
                                                HeightRequest="16"
                                                Source="edit.png"
                                                WidthRequest="16">
                                                <Image.Behaviors>
                                                    <mct:IconTintColorBehavior TintColor="{StaticResource Primary}" />
                                                </Image.Behaviors>
                                            </Image>
                                        </Border>

                                        <!--  Delete Button  -->
                                        <Border
                                            Padding="7"
                                            BackgroundColor="{AppThemeBinding Light=#fef2f2,
                                                                              Dark=#7f1d1d}"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 8">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CoordSectionListViewModel}}, Path=DeleteCommand}" CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Image
                                                HeightRequest="16"
                                                Source="delete.png"
                                                WidthRequest="16">
                                                <Image.Behaviors>
                                                    <mct:IconTintColorBehavior TintColor="{StaticResource Danger}" />
                                                </Image.Behaviors>
                                            </Image>
                                        </Border>
                                    </HorizontalStackLayout>
                                </Grid>

                                <!--  Divider Line  -->
                                <BoxView
                                    Margin="0,2"
                                    HeightRequest="1"
                                    Color="{AppThemeBinding Light=#f1f5f9,
                                                            Dark=#334155}" />

                                <!--  Class Teacher Info Row  -->
                                <Label
                                    FontSize="13"
                                    Text="{Binding TeacherDisplayName}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                                Dark=#94a3b8}" />

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>

</views:ViewBase>
