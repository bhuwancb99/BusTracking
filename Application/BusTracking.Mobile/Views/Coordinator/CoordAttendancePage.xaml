<?xml version="1.0" encoding="utf-8" ?>
<views:ViewBase
    x:Class="BusTracking.Mobile.Views.Coordinator.CoordAttendancePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mct="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"
    xmlns:models="clr-namespace:BusTracking.Mobile.Models.Attendance"
    xmlns:views="clr-namespace:BusTracking.Mobile.Views"
    xmlns:vm="clr-namespace:BusTracking.Mobile.Viewmodels.Coordinator"
    x:DataType="vm:CoordAttendanceViewModel"
    x:TypeArguments="vm:CoordAttendanceViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBg},
                                      Dark={StaticResource PageBgDark}}">

    <views:ViewBase.Behaviors>
        <mct:StatusBarBehavior StatusBarColor="{AppThemeBinding Light={StaticResource LoginPageBgLight}, Dark={StaticResource LoginPageBgDark}}" StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}" />
    </views:ViewBase.Behaviors>

    <Grid
        Padding="12"
        RowDefinitions="Auto,Auto,Auto,*,Auto"
        RowSpacing="10">

        <!--  Top Filters Header  -->
        <Border
            Grid.Row="0"
            Padding="12"
            BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                              Dark={StaticResource CardBgDark}}"
            Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                     Dark={StaticResource BorderColorDark}}"
            StrokeShape="RoundRectangle 12"
            StrokeThickness="1">
            <Grid
                ColumnDefinitions="*,*,*"
                ColumnSpacing="8"
                RowDefinitions="Auto,Auto"
                RowSpacing="8">
                <!--  Academic Session  -->
                <VerticalStackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Spacing="2">
                    <Label
                        FontAttributes="Bold"
                        FontSize="11"
                        Text="Session"
                        TextColor="{AppThemeBinding Light={StaticResource TextMuted},
                                                    Dark={StaticResource TextMutedDark}}" />
                    <Picker
                        FontSize="13"
                        ItemDisplayBinding="{Binding YearName}"
                        ItemsSource="{Binding AcademicYears}"
                        SelectedItem="{Binding SelectedYear}" />
                </VerticalStackLayout>

                <!--  Class/Standard  -->
                <VerticalStackLayout
                    Grid.Row="0"
                    Grid.Column="1"
                    Spacing="2">
                    <Label
                        FontAttributes="Bold"
                        FontSize="11"
                        Text="Class"
                        TextColor="{AppThemeBinding Light={StaticResource TextMuted},
                                                    Dark={StaticResource TextMutedDark}}" />
                    <Picker
                        FontSize="13"
                        ItemDisplayBinding="{Binding StandardName}"
                        ItemsSource="{Binding Standards}"
                        SelectedItem="{Binding SelectedStandard}" />
                </VerticalStackLayout>

                <!--  Section  -->
                <VerticalStackLayout
                    Grid.Row="0"
                    Grid.Column="2"
                    Spacing="2">
                    <Label
                        FontAttributes="Bold"
                        FontSize="11"
                        Text="Section"
                        TextColor="{AppThemeBinding Light={StaticResource TextMuted},
                                                    Dark={StaticResource TextMutedDark}}" />
                    <Picker
                        FontSize="13"
                        ItemDisplayBinding="{Binding SectionName}"
                        ItemsSource="{Binding Sections}"
                        SelectedItem="{Binding SelectedSection}" />
                </VerticalStackLayout>

                <!--  Date Picker  -->
                <VerticalStackLayout
                    Grid.Row="1"
                    Grid.ColumnSpan="3"
                    Spacing="2">
                    <Label
                        FontAttributes="Bold"
                        FontSize="11"
                        Text="Attendance Date"
                        TextColor="{AppThemeBinding Light={StaticResource TextMuted},
                                                    Dark={StaticResource TextMutedDark}}" />
                    <DatePicker
                        Date="{Binding SelectedDate}"
                        FontSize="13"
                        Format="yyyy-MM-dd" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!--  Summary Stats Card  -->
        <Grid
            Grid.Row="1"
            ColumnDefinitions="*,*,*,*"
            ColumnSpacing="8">
            <Border
                Grid.Column="0"
                Padding="8"
                BackgroundColor="{AppThemeBinding Light=#f1f5f9,
                                                  Dark=#334155}"
                StrokeShape="RoundRectangle 10">
                <VerticalStackLayout HorizontalOptions="Center">
                    <Label
                        FontAttributes="Bold"
                        FontSize="18"
                        HorizontalOptions="Center"
                        Text="{Binding TotalStudentsCount}"
                        TextColor="{AppThemeBinding Light=#0f172a,
                                                    Dark=White}" />
                    <Label
                        FontSize="11"
                        HorizontalOptions="Center"
                        Text="Total"
                        TextColor="#64748b" />
                </VerticalStackLayout>
            </Border>
            <Border
                Grid.Column="1"
                Padding="8"
                BackgroundColor="#d1fae5"
                StrokeShape="RoundRectangle 10">
                <VerticalStackLayout HorizontalOptions="Center">
                    <Label
                        FontAttributes="Bold"
                        FontSize="18"
                        HorizontalOptions="Center"
                        Text="{Binding PresentCount}"
                        TextColor="#065f46" />
                    <Label
                        FontSize="11"
                        HorizontalOptions="Center"
                        Text="Present"
                        TextColor="#047857" />
                </VerticalStackLayout>
            </Border>
            <Border
                Grid.Column="2"
                Padding="8"
                BackgroundColor="#fee2e2"
                StrokeShape="RoundRectangle 10">
                <VerticalStackLayout HorizontalOptions="Center">
                    <Label
                        FontAttributes="Bold"
                        FontSize="18"
                        HorizontalOptions="Center"
                        Text="{Binding AbsentCount}"
                        TextColor="#991b1b" />
                    <Label
                        FontSize="11"
                        HorizontalOptions="Center"
                        Text="Absent"
                        TextColor="#b91c1c" />
                </VerticalStackLayout>
            </Border>
            <Border
                Grid.Column="3"
                Padding="8"
                BackgroundColor="#fef3c7"
                StrokeShape="RoundRectangle 10">
                <VerticalStackLayout HorizontalOptions="Center">
                    <Label
                        FontAttributes="Bold"
                        FontSize="18"
                        HorizontalOptions="Center"
                        Text="{Binding LateCount}"
                        TextColor="#92400e" />
                    <Label
                        FontSize="11"
                        HorizontalOptions="Center"
                        Text="Late"
                        TextColor="#b45309" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!--  Quick Action Buttons  -->
        <HorizontalStackLayout
            Grid.Row="2"
            HorizontalOptions="End"
            Spacing="8">
            <Button
                Padding="14,0"
                BackgroundColor="#10b981"
                Command="{Binding MarkAllPresentCommand}"
                CornerRadius="8"
                FontAttributes="Bold"
                FontSize="12"
                HeightRequest="36"
                Text="Mark All Present"
                TextColor="White" />
            <Button
                Padding="14,0"
                BackgroundColor="{StaticResource Secondary}"
                Command="{Binding StartFaceScanCommand}"
                CornerRadius="8"
                FontAttributes="Bold"
                FontSize="12"
                HeightRequest="36"
                Text="Face Scan"
                TextColor="White" />
        </HorizontalStackLayout>

        <!--  Students Attendance List  -->
        <CollectionView Grid.Row="3" ItemsSource="{Binding Students}">
            <CollectionView.EmptyView>
                <VerticalStackLayout
                    Padding="24"
                    HorizontalOptions="Center"
                    Spacing="8"
                    VerticalOptions="Center">
                    <Label
                        FontSize="14"
                        HorizontalOptions="Center"
                        Text="No students found for attendance."
                        TextColor="#94a3b8" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:StudentAttendanceRowDto">
                    <Border
                        Margin="0,3"
                        Padding="12"
                        BackgroundColor="{AppThemeBinding Light=White,
                                                          Dark=#1e293b}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                                 Dark={StaticResource BorderColorDark}}"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="1">
                        <Grid
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="12"
                            VerticalOptions="Center">
                            <!--  Student Code Badge  -->
                            <Border
                                Grid.Column="0"
                                BackgroundColor="{StaticResource Primary}"
                                HeightRequest="40"
                                HorizontalOptions="Center"
                                StrokeShape="RoundRectangle 20"
                                VerticalOptions="Center"
                                WidthRequest="40">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="10"
                                    HorizontalOptions="Center"
                                    Text="{Binding StudentCode}"
                                    TextColor="White"
                                    VerticalOptions="Center" />
                            </Border>

                            <!--  Student Info  -->
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2"
                                VerticalOptions="Center">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    Text="{Binding StudentName}"
                                    TextColor="{AppThemeBinding Light=#0f172a,
                                                                Dark=White}" />
                                <Label
                                    FontSize="12"
                                    Text="{Binding StudentCode, StringFormat='ID: {0}'}"
                                    TextColor="{AppThemeBinding Light=#64748b,
                                                                Dark=#94a3b8}" />
                            </VerticalStackLayout>

                            <!--  Status Toggle Button  -->
                            <Button
                                Grid.Column="2"
                                Padding="14,0"
                                BackgroundColor="{Binding StatusColor}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CoordAttendanceViewModel}}, Path=ToggleStatusCommand}"
                                CommandParameter="{Binding .}"
                                CornerRadius="6"
                                FontAttributes="Bold"
                                FontSize="12"
                                HeightRequest="34"
                                Text="{Binding Status}"
                                TextColor="White" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!--  Bottom Save Button  -->
        <Button
            Grid.Row="4"
            BackgroundColor="{StaticResource Primary}"
            Command="{Binding SaveAttendanceCommand}"
            CornerRadius="10"
            FontAttributes="Bold"
            FontSize="15"
            HeightRequest="46"
            Text="Save Attendance"
            TextColor="White" />

    </Grid>

</views:ViewBase>
