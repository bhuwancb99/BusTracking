<?xml version="1.0" encoding="utf-8" ?>
<views:ViewBase
    x:Class="BusTracking.Mobile.Views.Student.StudentReportCardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:exam="clr-namespace:BusTracking.Mobile.Models.Exam"
    xmlns:views="clr-namespace:BusTracking.Mobile.Views"
    xmlns:vm="clr-namespace:BusTracking.Mobile.Viewmodels.Student"
    Title="{Binding Title}"
    x:DataType="vm:StudentReportCardViewModel"
    x:TypeArguments="vm:StudentReportCardViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBg},
                                      Dark={StaticResource PageBgDark}}">


    <Grid RowDefinitions="Auto,*">
        <!--  Term Selector  -->
        <Border
            Grid.Row="0"
            Margin="16,12"
            BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                              Dark={StaticResource CardBgDark}}"
            Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                     Dark={StaticResource BorderColorDark}}"
            StrokeShape="RoundRectangle 12">
            <VerticalStackLayout Padding="12" Spacing="6">
                <Label
                    FontAttributes="Bold"
                    FontSize="12"
                    Text="SELECT EXAM TERM"
                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                Dark={StaticResource TextSecondaryDark}}" />
                <Picker
                    Title="Select Term..."
                    ItemDisplayBinding="{Binding TermName}"
                    ItemsSource="{Binding ExamTerms}"
                    SelectedItem="{Binding SelectedExamTerm}"
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                Dark={StaticResource TextPrimaryDark}}" />
            </VerticalStackLayout>
        </Border>

        <!--  Report Card Content  -->
        <ScrollView Grid.Row="1" Padding="16,0,16,16">
            <VerticalStackLayout Spacing="16">
                <!--  Empty State  -->
                <Border
                    Padding="24"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                      Dark={StaticResource CardBgDark}}"
                    IsVisible="{Binding IsEmpty}"
                    StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="8">

                        <Image
                            HeightRequest="48"
                            Source="report_card.png"
                            WidthRequest="48" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="15"
                            HorizontalOptions="Center"
                            Text="Report Card Not Available"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                        Dark={StaticResource TextPrimaryDark}}" />
                        <Label
                            FontSize="13"
                            HorizontalOptions="Center"
                            Text="Marks for this exam term have not been published yet."
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                        Dark={StaticResource TextSecondaryDark}}" />
                    </VerticalStackLayout>
                </Border>

                <!--  Report Card Card Header & Metrics  -->
                <VerticalStackLayout IsVisible="{Binding HasReportCard}" Spacing="16">
                    <Border
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                          Dark={StaticResource CardBgDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                                 Dark={StaticResource BorderColorDark}}"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="1">
                        <VerticalStackLayout Padding="16" Spacing="12">
                            <!--  Student & Class Header  -->
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="18"
                                        Text="{Binding ReportCard.StudentName}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                                    Dark={StaticResource TextPrimaryDark}}" />
                                    <Label
                                        FontSize="12"
                                        Text="{Binding ReportCard.AcademicYearName}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                                    Dark={StaticResource TextSecondaryDark}}" />
                                </VerticalStackLayout>

                                <Border
                                    Grid.Column="1"
                                    Padding="10,6"
                                    BackgroundColor="{Binding ReportCard.StatusColor}"
                                    StrokeShape="RoundRectangle 8">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="12"
                                        Text="{Binding ReportCard.ResultStatus}"
                                        TextColor="White" />
                                </Border>
                            </Grid>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource BorderColorDark}}" />

                            <!--  Summary Metrics Cards  -->
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <!--  Percentage  -->
                                <Border
                                    Grid.Column="0"
                                    Padding="8"
                                    BackgroundColor="{AppThemeBinding Light='#f0f9ff',
                                                                      Dark='#0c4a6e'}"
                                    StrokeShape="RoundRectangle 8">
                                    <VerticalStackLayout HorizontalOptions="Center" Spacing="2">

                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="16"
                                            HorizontalOptions="Center"
                                            Text="{Binding ReportCard.PercentageDisplay}"
                                            TextColor="{AppThemeBinding Light='#0284c7',
                                                                        Dark='#e0f2fe'}" />
                                        <Label
                                            FontSize="10"
                                            HorizontalOptions="Center"
                                            Text="PERCENTAGE"
                                            TextColor="{AppThemeBinding Light='#0369a1',
                                                                        Dark='#bae6fd'}" />
                                    </VerticalStackLayout>
                                </Border>

                                <!--  Grade  -->
                                <Border
                                    Grid.Column="1"
                                    Padding="8"
                                    BackgroundColor="{AppThemeBinding Light='#f0fdf4',
                                                                      Dark='#14532d'}"
                                    StrokeShape="RoundRectangle 8">
                                    <VerticalStackLayout HorizontalOptions="Center" Spacing="2">

                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="16"
                                            HorizontalOptions="Center"
                                            Text="{Binding ReportCard.OverallGrade}"
                                            TextColor="{AppThemeBinding Light='#16a34a',
                                                                        Dark='#dcfce7'}" />
                                        <Label
                                            FontSize="10"
                                            HorizontalOptions="Center"
                                            Text="GRADE"
                                            TextColor="{AppThemeBinding Light='#15803d',
                                                                        Dark='#86efac'}" />
                                    </VerticalStackLayout>
                                </Border>

                                <!--  Rank  -->
                                <Border
                                    Grid.Column="2"
                                    Padding="8"
                                    BackgroundColor="{AppThemeBinding Light='#fefce8',
                                                                      Dark='#713f12'}"
                                    StrokeShape="RoundRectangle 8">
                                    <VerticalStackLayout HorizontalOptions="Center" Spacing="2">

                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="16"
                                            HorizontalOptions="Center"
                                            Text="{Binding ReportCard.RankDisplay}"
                                            TextColor="{AppThemeBinding Light='#ca8a04',
                                                                        Dark='#fef08a'}" />
                                        <Label
                                            FontSize="10"
                                            HorizontalOptions="Center"
                                            Text="CLASS RANK"
                                            TextColor="{AppThemeBinding Light='#a16207',
                                                                        Dark='#fef08a'}" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!--  Subject-wise Performance Breakdown  -->
                    <Border
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                          Dark={StaticResource CardBgDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                                 Dark={StaticResource BorderColorDark}}"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="1">
                        <VerticalStackLayout Padding="16" Spacing="12">
                            <Label
                                FontAttributes="Bold"
                                FontSize="14"
                                Text="SUBJECT PERFORMANCE"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                            Dark={StaticResource TextPrimaryDark}}" />

                            <BindableLayout.ItemsSource>
                                <Binding Path="ReportCard.Subjects" />
                            </BindableLayout.ItemsSource>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="exam:ReportCardSubjectItem">
                                    <VerticalStackLayout Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label
                                                Grid.Column="0"
                                                FontAttributes="Bold"
                                                FontSize="14"
                                                Text="{Binding SubjectName}"
                                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                                            Dark={StaticResource TextPrimaryDark}}" />
                                            <Label
                                                Grid.Column="1"
                                                FontAttributes="Bold"
                                                FontSize="14"
                                                Text="{Binding DisplayMarks}"
                                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                                            Dark={StaticResource TextPrimaryDark}}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label
                                                Grid.Column="0"
                                                FontSize="11"
                                                Text="{Binding Grade, StringFormat='Grade: {0}'}"
                                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                                            Dark={StaticResource TextSecondaryDark}}" />
                                            <Label
                                                Grid.Column="1"
                                                FontSize="11"
                                                Text="{Binding PassMarks, StringFormat='Pass: {0:0.#}'}"
                                                TextColor="{AppThemeBinding Light={StaticResource TextMuted},
                                                                            Dark={StaticResource TextMutedDark}}" />
                                        </Grid>
                                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource BorderColorDark}}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</views:ViewBase>
