<?xml version="1.0" encoding="utf-8" ?>
<views:ViewBase
    x:Class="BusTracking.Mobile.Views.Student.StudentFullReportCardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:exam="clr-namespace:BusTracking.Mobile.Models.Exam"
    xmlns:mct="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"
    xmlns:views="clr-namespace:BusTracking.Mobile.Views"
    xmlns:vm="clr-namespace:BusTracking.Mobile.Viewmodels.Student"
    Title="Report Card Details"
    x:DataType="vm:StudentFullReportCardViewModel"
    x:TypeArguments="vm:StudentFullReportCardViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBg},
                                      Dark={StaticResource PageBgDark}}">

    <views:ViewBase.Behaviors>
        <mct:StatusBarBehavior StatusBarColor="{AppThemeBinding Light={StaticResource LoginPageBgLight}, Dark={StaticResource LoginPageBgDark}}" StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}" />
    </views:ViewBase.Behaviors>

    <ScrollView Padding="14,12">
        <VerticalStackLayout Spacing="14">

            <!--  Student & Term Profile Header Card  -->
            <Border
                Padding="16,14"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                  Dark={StaticResource CardBgDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                         Dark={StaticResource BorderColorDark}}"
                StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                Text="{Binding ReportCard.StudentName}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                            Dark=White}" />
                            <Label
                                FontSize="12"
                                Text="{Binding ReportCard.TermName}"
                                TextColor="#2563eb" />
                        </VerticalStackLayout>

                        <Border
                            Grid.Column="1"
                            Padding="10,4"
                            BackgroundColor="#f1f5f9"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 6">
                            <Label
                                FontAttributes="Bold"
                                FontSize="12"
                                Text="{Binding ReportCard.StudentCode}"
                                TextColor="#475569" />
                        </Border>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#e2e8f0, Dark=#334155}" />

                    <Grid
                        ColumnDefinitions="*,*"
                        RowDefinitions="Auto,Auto"
                        RowSpacing="6">
                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            FontSize="12"
                            Text="{Binding ReportCard.StandardName, StringFormat='Class: {0}'}"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                        Dark={StaticResource TextSecondaryDark}}" />
                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            FontSize="12"
                            Text="{Binding ReportCard.AcademicYearName, StringFormat='Session: {0}'}"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                        Dark={StaticResource TextSecondaryDark}}" />
                        <Label
                            Grid.Row="1"
                            Grid.Column="0"
                            FontSize="12"
                            Text="{Binding ReportCard.RollNumber, StringFormat='Roll No: {0}'}"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                        Dark={StaticResource TextSecondaryDark}}" />
                        <Label
                            Grid.Row="1"
                            Grid.Column="1"
                            FontSize="12"
                            Text="{Binding ReportCard.RankDisplay}"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                        Dark={StaticResource TextSecondaryDark}}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!--  Result Status Summary Banner  -->
            <Border
                Padding="16,14"
                BackgroundColor="#1d4ed8"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <Label
                            Grid.Column="0"
                            FontAttributes="Bold"
                            FontSize="18"
                            Text="Result Status"
                            TextColor="White" />

                        <Border
                            Grid.Column="1"
                            Padding="14,4"
                            BackgroundColor="#22c55e"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 12">
                            <Label
                                FontAttributes="Bold"
                                FontSize="14"
                                Text="{Binding ReportCard.ResultStatus}"
                                TextColor="White" />
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label
                                FontSize="11"
                                Text="TOTAL MARKS"
                                TextColor="#93c5fd" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="14"
                                Text="{Binding ReportCard.TotalMarksObtained, StringFormat='{0:0.##}'}"
                                TextColor="White" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label
                                FontSize="11"
                                Text="PERCENTAGE"
                                TextColor="#93c5fd" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="14"
                                Text="{Binding ReportCard.Percentage, StringFormat='{0:0.00}%'}"
                                TextColor="White" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="2" Spacing="2">
                            <Label
                                FontSize="11"
                                Text="GRADE"
                                TextColor="#93c5fd" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="14"
                                Text="{Binding ReportCard.OverallGrade}"
                                TextColor="White" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!--  Full Subject Marks Breakdown List  -->
            <Border
                Padding="14"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                  Dark={StaticResource CardBgDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                         Dark={StaticResource BorderColorDark}}"
                StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="12">
                    <Label
                        FontAttributes="Bold"
                        FontSize="15"
                        Text="Subject Marks Breakdown"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                    Dark=White}" />

                    <BindableLayout.ItemsSource>
                        <Binding Path="ReportCard.Subjects" />
                    </BindableLayout.ItemsSource>

                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="exam:ReportCardSubjectItem">
                            <Border
                                Margin="0,0,0,8"
                                Padding="12,10"
                                BackgroundColor="{AppThemeBinding Light=#f8fafc,
                                                                  Dark=#1e293b}"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 10">
                                <VerticalStackLayout Spacing="6">
                                    <Grid
                                        ColumnDefinitions="*,Auto,Auto"
                                        ColumnSpacing="10"
                                        VerticalOptions="Center">
                                        <Label
                                            Grid.Column="0"
                                            FontAttributes="Bold"
                                            FontSize="14"
                                            Text="{Binding SubjectName}"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                                        Dark=White}" />

                                        <Label
                                            Grid.Column="1"
                                            FontAttributes="Bold"
                                            FontSize="14"
                                            Text="{Binding MarksObtained, StringFormat='{0:0.##}'}"
                                            TextColor="#2563eb" />

                                        <Border
                                            Grid.Column="2"
                                            Padding="10,3"
                                            BackgroundColor="#0284c7"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 10">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="12"
                                                Text="{Binding Grade}"
                                                TextColor="White" />
                                        </Border>
                                    </Grid>

                                    <Label
                                        FontSize="11"
                                        IsVisible="{Binding Remarks, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                                        Text="{Binding Remarks, StringFormat='Remarks: {0}'}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                                    Dark={StaticResource TextSecondaryDark}}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>

            <!--  Teacher Remarks / Feedback Card  -->
            <Border
                Padding="14"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                  Dark={StaticResource CardBgDark}}"
                IsVisible="{Binding ReportCard.TeacherRemarks, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                         Dark={StaticResource BorderColorDark}}"
                StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="6">
                    <Label
                        FontAttributes="Bold"
                        FontSize="14"
                        Text="Teacher Remarks &amp; Feedback"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                    Dark=White}" />
                    <Label
                        FontSize="13"
                        Text="{Binding ReportCard.TeacherRemarks}"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                    Dark={StaticResource TextSecondaryDark}}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</views:ViewBase>
