<?xml version="1.0" encoding="utf-8" ?>
<views:ViewBase
    x:Class="BusTracking.Mobile.Views.Student.StudentFullReportCardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:exam="clr-namespace:BusTracking.Mobile.Models.Exam"
    xmlns:mct="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"
    xmlns:views="clr-namespace:BusTracking.Mobile.Views"
    xmlns:vm="clr-namespace:BusTracking.Mobile.Viewmodels.Student"
    Title="Report Card Details"
    x:DataType="vm:StudentFullReportCardViewModel"
    x:TypeArguments="vm:StudentFullReportCardViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBg},
                                      Dark={StaticResource PageBgDark}}">

    <views:ViewBase.Behaviors>
        <mct:StatusBarBehavior StatusBarColor="{AppThemeBinding Light={StaticResource LoginPageBgLight}, Dark={StaticResource LoginPageBgDark}}" StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}" />
    </views:ViewBase.Behaviors>

    <ScrollView Padding="10,12">
        <VerticalStackLayout Spacing="14">

            <!--  Official Report Card Header Card  -->
            <Border
                Padding="16,14"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                  Dark={StaticResource CardBgDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                         Dark={StaticResource BorderColorDark}}"
                StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                Text="{Binding ReportCard.StudentName}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                            Dark=White}" />
                            <Label
                                FontSize="12"
                                Text="{Binding ReportCard.TermName}"
                                TextColor="#2563eb" />
                        </VerticalStackLayout>

                        <Border
                            Grid.Column="1"
                            Padding="8,2"
                            BackgroundColor="{AppThemeBinding Light=#f1f5f9,
                                                              Dark=#1e293b}"
                            HeightRequest="24"
                            HorizontalOptions="End"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 6"
                            VerticalOptions="Center">
                            <Label
                                FontAttributes="Bold"
                                FontSize="11"
                                HorizontalOptions="Center"
                                Text="{Binding ReportCard.StudentCode}"
                                TextColor="{AppThemeBinding Light=#475569,
                                                            Dark=#94a3b8}"
                                VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#e2e8f0, Dark=#334155}" />

                    <Grid
                        ColumnDefinitions="*,*"
                        RowDefinitions="Auto,Auto"
                        RowSpacing="6">
                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            FontSize="12"
                            Text="{Binding ReportCard.StandardName, StringFormat='Class: {0}'}"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                        Dark={StaticResource TextSecondaryDark}}" />
                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            FontSize="12"
                            Text="{Binding ReportCard.SectionName, StringFormat='Section: {0}'}"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                        Dark={StaticResource TextSecondaryDark}}" />
                        <Label
                            Grid.Row="1"
                            Grid.Column="0"
                            FontSize="12"
                            Text="{Binding ReportCard.AcademicYearName, StringFormat='Session: {0}'}"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                        Dark={StaticResource TextSecondaryDark}}" />
                        <Label
                            Grid.Row="1"
                            Grid.Column="1"
                            FontSize="12"
                            Text="{Binding ReportCard.StudentCode, StringFormat='Roll No: {0}'}"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                        Dark={StaticResource TextSecondaryDark}}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!--  Result Status Summary Banner (Royal Blue Card)  -->
            <Border
                Padding="16,14"
                BackgroundColor="#1d4ed8"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <Label
                            Grid.Column="0"
                            FontAttributes="Bold"
                            FontSize="18"
                            Text="Result Status"
                            TextColor="White" />

                        <Border
                            Grid.Column="1"
                            Padding="14,4"
                            BackgroundColor="#22c55e"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 12">
                            <Label
                                FontAttributes="Bold"
                                FontSize="14"
                                Text="{Binding ReportCard.ResultStatus}"
                                TextColor="White" />
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label
                                FontSize="11"
                                Text="TOTAL MARKS"
                                TextColor="#93c5fd" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="14"
                                Text="{Binding ReportCard.TotalMarksObtained, StringFormat='{0:0.##}'}"
                                TextColor="White" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label
                                FontSize="11"
                                Text="PERCENTAGE"
                                TextColor="#93c5fd" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="14"
                                Text="{Binding ReportCard.Percentage, StringFormat='{0:0.00}%'}"
                                TextColor="White" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="2" Spacing="2">
                            <Label
                                FontSize="11"
                                Text="GRADE"
                                TextColor="#93c5fd" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="14"
                                Text="{Binding ReportCard.OverallGrade}"
                                TextColor="White" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!--  Full Subject Marks Breakdown List  -->
            <Border
                Padding="14"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                  Dark={StaticResource CardBgDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                         Dark={StaticResource BorderColorDark}}"
                StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="12">
                    <Label
                        FontAttributes="Bold"
                        FontSize="15"
                        Text="Subject Marks Breakdown"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                    Dark=White}" />

                    <BindableLayout.ItemsSource>
                        <Binding Path="ReportCard.SubjectMarks" />
                    </BindableLayout.ItemsSource>

                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="exam:ReportCardSubjectItem">
                            <Border
                                Margin="0,0,0,8"
                                Padding="12,10"
                                BackgroundColor="{AppThemeBinding Light=#f8fafc,
                                                                  Dark=#1e293b}"
                                Stroke="{AppThemeBinding Light=#e2e8f0,
                                                         Dark=#334155}"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="1">
                                <VerticalStackLayout Spacing="6">
                                    <!--  Top Row: Subject Name & Badges  -->
                                    <Grid
                                        ColumnDefinitions="*,Auto,Auto"
                                        ColumnSpacing="8"
                                        VerticalOptions="Center">
                                        <Label
                                            Grid.Column="0"
                                            FontAttributes="Bold"
                                            FontSize="14"
                                            Text="{Binding SubjectName}"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                                        Dark=White}" />

                                        <!--  Grade Badge  -->
                                        <Border
                                            Grid.Column="1"
                                            Padding="8,2"
                                            BackgroundColor="#0284c7"
                                            IsVisible="{Binding Grade, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 8">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="11"
                                                Text="{Binding Grade}"
                                                TextColor="White" />
                                        </Border>

                                        <!--  Pass/Fail Status Badge  -->
                                        <Border
                                            Grid.Column="2"
                                            Padding="8,2"
                                            BackgroundColor="{Binding StatusColor}"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 8">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="11"
                                                Text="{Binding StatusDisplay}"
                                                TextColor="White" />
                                        </Border>
                                    </Grid>

                                    <!--  Middle Row: Marks Detail  -->
                                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                        <HorizontalStackLayout Grid.Column="0" Spacing="6">
                                            <Label
                                                FontSize="12"
                                                Text="Marks Obtained:"
                                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                                            Dark={StaticResource TextSecondaryDark}}" />
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="12"
                                                Text="{Binding DisplayMarks}"
                                                TextColor="#2563eb" />
                                        </HorizontalStackLayout>

                                        <Label
                                            Grid.Column="1"
                                            FontSize="11"
                                            Text="{Binding PassMarks, StringFormat='Pass: {0:0.##}'}"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                                        Dark={StaticResource TextSecondaryDark}}" />
                                    </Grid>

                                    <!--  Remarks Row  -->
                                    <Label
                                        FontSize="11"
                                        IsVisible="{Binding Remarks, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                                        Text="{Binding Remarks, StringFormat='Remarks: {0}'}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                                    Dark={StaticResource TextSecondaryDark}}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>

            <!--  Summary Cards (3 Metrics)  -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Border
                    Grid.Column="0"
                    Padding="10"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                      Dark={StaticResource CardBgDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                             Dark={StaticResource BorderColorDark}}"
                    StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                        <Label
                            FontAttributes="Bold"
                            FontSize="10"
                            Text="PERCENTAGE"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                        Dark={StaticResource TextSecondaryDark}}" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="14"
                            Text="{Binding ReportCard.Percentage, StringFormat='{0:0.0}%'}"
                            TextColor="#2563eb" />
                    </VerticalStackLayout>
                </Border>

                <Border
                    Grid.Column="1"
                    Padding="10"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                      Dark={StaticResource CardBgDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                             Dark={StaticResource BorderColorDark}}"
                    StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                        <Label
                            FontAttributes="Bold"
                            FontSize="10"
                            Text="GRADE"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                        Dark={StaticResource TextSecondaryDark}}" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="14"
                            Text="{Binding ReportCard.OverallGrade}"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                        Dark=White}" />
                    </VerticalStackLayout>
                </Border>

                <Border
                    Grid.Column="2"
                    Padding="10"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                      Dark={StaticResource CardBgDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                             Dark={StaticResource BorderColorDark}}"
                    StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                        <Label
                            FontAttributes="Bold"
                            FontSize="10"
                            Text="MARKS"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                        Dark={StaticResource TextSecondaryDark}}" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="13"
                            Text="{Binding ReportCard.TotalMarksObtained, StringFormat='{0:0.##}'}"
                            TextColor="#16a34a" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</views:ViewBase>
