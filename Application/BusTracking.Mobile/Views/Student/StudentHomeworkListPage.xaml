<?xml version="1.0" encoding="utf-8" ?>
<views:ViewBase
    x:Class="BusTracking.Mobile.Views.Student.StudentHomeworkListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:common="clr-namespace:BusTracking.Mobile.Views.Common"
    xmlns:mct="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"
    xmlns:models="clr-namespace:BusTracking.Mobile.Models.Homework"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Toolkit.TextInputLayout;assembly=Syncfusion.Maui.Toolkit"
    xmlns:views="clr-namespace:BusTracking.Mobile.Views"
    xmlns:vm="clr-namespace:BusTracking.Mobile.Viewmodels.Student"
    x:DataType="vm:StudentHomeworkListViewModel"
    x:TypeArguments="vm:StudentHomeworkListViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBg},
                                      Dark={StaticResource PageBgDark}}">

    <views:ViewBase.Behaviors>
        <mct:StatusBarBehavior StatusBarColor="{AppThemeBinding Light={StaticResource LoginPageBgLight}, Dark={StaticResource LoginPageBgDark}}" StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}" />
    </views:ViewBase.Behaviors>

    <Shell.TitleView>
        <Label
            FontAttributes="Bold"
            FontSize="17"
            Text="My Homework &amp; Assignments"
            TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                        Dark=White}"
            VerticalOptions="Center" />
    </Shell.TitleView>

    <Grid Padding="10">
        <Grid RowDefinitions="Auto,*">
            <!--  Date Filter Card (From Date — To Date) using CalendarPickerPopup  -->
            <Border
                Grid.Row="0"
                Margin="0,0,0,8"
                Padding="10,6"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                  Dark={StaticResource CardBgDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                         Dark={StaticResource BorderColorDark}}"
                StrokeShape="RoundRectangle 10">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <!--  From Date Selector  -->
                    <Border
                        Grid.Column="0"
                        Padding="10,8"
                        BackgroundColor="{AppThemeBinding Light=White,
                                                          Dark=#1E293B}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                                 Dark={StaticResource BorderColorDark}}"
                        StrokeShape="RoundRectangle 8"
                        StrokeThickness="1">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenFromDateCalendarCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label
                                    FontSize="10"
                                    Text="From Date"
                                    TextColor="{StaticResource TextSecondary}" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    Text="{Binding FromDate, StringFormat='{0:yyyy-MM-dd}'}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                                Dark=White}" />
                            </VerticalStackLayout>
                            <Image
                                Grid.Column="1"
                                HeightRequest="16"
                                Source="calendar_icon.png"
                                VerticalOptions="Center"
                                WidthRequest="16">
                                <Image.Behaviors>
                                    <mct:IconTintColorBehavior TintColor="{AppThemeBinding Light={StaticResource Primary}, Dark=White}" />
                                </Image.Behaviors>
                            </Image>
                        </Grid>
                    </Border>

                    <!--  To Date Selector  -->
                    <Border
                        Grid.Column="1"
                        Padding="10,8"
                        BackgroundColor="{AppThemeBinding Light=White,
                                                          Dark=#1E293B}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                                 Dark={StaticResource BorderColorDark}}"
                        StrokeShape="RoundRectangle 8"
                        StrokeThickness="1">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenToDateCalendarCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label
                                    FontSize="10"
                                    Text="To Date"
                                    TextColor="{StaticResource TextSecondary}" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    Text="{Binding ToDate, StringFormat='{0:yyyy-MM-dd}'}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                                Dark=White}" />
                            </VerticalStackLayout>
                            <Image
                                Grid.Column="1"
                                HeightRequest="16"
                                Source="calendar_icon.png"
                                VerticalOptions="Center"
                                WidthRequest="16">
                                <Image.Behaviors>
                                    <mct:IconTintColorBehavior TintColor="{AppThemeBinding Light={StaticResource Primary}, Dark=White}" />
                                </Image.Behaviors>
                            </Image>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!--  Homework List  -->
            <CollectionView
                Grid.Row="1"
                ItemsSource="{Binding Homeworks}"
                SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        Padding="30"
                        Spacing="10"
                        VerticalOptions="Center">
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            HorizontalOptions="Center"
                            Text="No Active Homework Assignments"
                            TextColor="{StaticResource TextSecondary}" />
                        <Label
                            FontSize="13"
                            HorizontalOptions="Center"
                            Text="Enjoy your day! Active assignments for your class section will appear here."
                            TextColor="{StaticResource TextTertiary}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:HomeworkDto">
                        <Border
                            Margin="0,5"
                            Padding="14"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                              Dark={StaticResource CardBgDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                                     Dark={StaticResource BorderColorDark}}"
                            StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="8">
                                <!--  Top Row: Subject Badge (Left) & Due/Status Badge (Right)  -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <Border
                                        Grid.Column="0"
                                        Padding="8,4"
                                        BackgroundColor="{AppThemeBinding Light=#EFF6FF,
                                                                          Dark=#1E293B}"
                                        HorizontalOptions="Start"
                                        StrokeShape="RoundRectangle 6"
                                        StrokeThickness="0">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="11"
                                            Text="{Binding SubjectName, StringFormat='Subject: {0}', FallbackValue='Subject: General'}"
                                            TextColor="{StaticResource Primary}" />
                                    </Border>

                                    <Border
                                        Grid.Column="1"
                                        Padding="8,4"
                                        BackgroundColor="{Binding StudentBadgeBgColor}"
                                        HorizontalOptions="End"
                                        StrokeShape="RoundRectangle 6"
                                        StrokeThickness="0">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="11"
                                            Text="{Binding StudentBadgeText}"
                                            TextColor="{Binding StudentBadgeTextColor}" />
                                    </Border>
                                </Grid>

                                <!--  Homework Title  -->
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="{Binding Title}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                                Dark=White}" />

                                <!--  Teacher Name  -->
                                <Label
                                    FontSize="12"
                                    Text="{Binding TeacherName, StringFormat='Teacher: {0}'}"
                                    TextColor="{StaticResource TextSecondary}" />

                                <!--  Description  -->
                                <Label
                                    FontSize="13"
                                    LineBreakMode="WordWrap"
                                    Text="{Binding Description}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                                Dark={StaticResource TextSecondaryDark}}" />

                                <!--  View Paper / File Button (If attachment exists)  -->
                                <Button
                                    BackgroundColor="Transparent"
                                    BorderColor="{StaticResource Primary}"
                                    BorderWidth="1"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:StudentHomeworkListViewModel}}, Path=OpenAttachmentCommand}"
                                    CommandParameter="{Binding .}"
                                    CornerRadius="6"
                                    FontSize="12"
                                    HeightRequest="36"
                                    HorizontalOptions="Start"
                                    IsVisible="{Binding HasAttachment}"
                                    Text="📄 View Paper / File"
                                    TextColor="{StaticResource Primary}" />

                                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource BorderColorDark}}" />

                                <!--  Bottom Row: Status & Actions  -->
                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                    <!--  When SUBMITTED: '✔ Submission Uploaded' on left & 'Resubmit' button on right  -->
                                    <HorizontalStackLayout
                                        Grid.Column="0"
                                        IsVisible="{Binding IsSubmitted}"
                                        Spacing="4"
                                        VerticalOptions="Center">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="13"
                                            Text="✓ Submission Uploaded"
                                            TextColor="#15803D"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                    <Border
                                        Grid.Column="1"
                                        Padding="10,6"
                                        BackgroundColor="Transparent"
                                        IsVisible="{Binding IsSubmitted}"
                                        Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                                                 Dark={StaticResource BorderColorDark}}"
                                        StrokeShape="RoundRectangle 8"
                                        StrokeThickness="1"
                                        VerticalOptions="Center">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:StudentHomeworkListViewModel}}, Path=SubmitSolutionCommand}" CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                            <Image
                                                HeightRequest="14"
                                                Source="resubmit.svg"
                                                VerticalOptions="Center"
                                                WidthRequest="14" />
                                            <Label
                                                FontSize="12"
                                                Text="Resubmit"
                                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                                            Dark={StaticResource TextSecondaryDark}}"
                                                VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Border>


                                    <!--  When PENDING: Full-width 'Submit Solution' primary button  -->
                                    <Button
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        BackgroundColor="{StaticResource Primary}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:StudentHomeworkListViewModel}}, Path=SubmitSolutionCommand}"
                                        CommandParameter="{Binding .}"
                                        CornerRadius="8"
                                        FontAttributes="Bold"
                                        FontSize="13"
                                        HeightRequest="40"
                                        IsVisible="{Binding IsPending}"
                                        Text="Submit Solution"
                                        TextColor="White" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!--  Calendar Picker Popups for From Date & To Date  -->
        <common:CalendarPickerPopup
            Title="Select From Date"
            IsOpen="{Binding IsFromDateCalendarOpen, Mode=TwoWay}"
            SelectedDate="{Binding FromDate, Mode=TwoWay}" />
        <common:CalendarPickerPopup
            Title="Select To Date"
            IsOpen="{Binding IsToDateCalendarOpen, Mode=TwoWay}"
            SelectedDate="{Binding ToDate, Mode=TwoWay}" />
    </Grid>
</views:ViewBase>
