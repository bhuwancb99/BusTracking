<?xml version="1.0" encoding="utf-8" ?>
<views:ViewBase
    x:Class="BusTracking.Mobile.Views.Student.StudentExamsReportCardsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:exam="clr-namespace:BusTracking.Mobile.Models.Exam"
    xmlns:mct="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"
    xmlns:views="clr-namespace:BusTracking.Mobile.Views"
    xmlns:vm="clr-namespace:BusTracking.Mobile.Viewmodels.Student"
    Title="Exams &amp; Report Cards"
    x:DataType="vm:StudentExamsReportCardsViewModel"
    x:TypeArguments="vm:StudentExamsReportCardsViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBg},
                                      Dark={StaticResource PageBgDark}}">

    <views:ViewBase.Behaviors>
        <mct:StatusBarBehavior StatusBarColor="{AppThemeBinding Light={StaticResource LoginPageBgLight}, Dark={StaticResource LoginPageBgDark}}" StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}" />
    </views:ViewBase.Behaviors>

    <ScrollView Padding="14,12">
        <VerticalStackLayout Spacing="14">

            <!--  Page Header Subtitle  -->
            <VerticalStackLayout Spacing="2">
                <HorizontalStackLayout Spacing="6">
                    <Image
                        HeightRequest="20"
                        Source="exam_terms.png"
                        WidthRequest="20">
                        <Image.Behaviors>
                            <mct:IconTintColorBehavior TintColor="{StaticResource Primary}" />
                        </Image.Behaviors>
                    </Image>
                    <Label
                        FontAttributes="Bold"
                        FontSize="18"
                        Text="Examinations &amp; Report Cards"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                    Dark=White}" />
                </HorizontalStackLayout>
                <Label
                    FontSize="12"
                    Text="View exam timetables, datesheets, and official academic term report cards."
                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                Dark={StaticResource TextSecondaryDark}}" />
            </VerticalStackLayout>

            <!--  Filter Card: Select Exam Term (Auto-fetches on selection)  -->
            <Border
                Padding="12,10"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                  Dark={StaticResource CardBgDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                         Dark={StaticResource BorderColorDark}}"
                StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="2">
                    <Label
                        FontAttributes="Bold"
                        FontSize="11"
                        Text="Select Exam Term"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                    Dark={StaticResource TextSecondaryDark}}" />
                    <Picker
                        Title="-- Select Exam Term --"
                        FontSize="13"
                        ItemDisplayBinding="{Binding TermName}"
                        ItemsSource="{Binding ExamTerms}"
                        SelectedItem="{Binding SelectedExamTerm, Mode=TwoWay}"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                    Dark=White}"
                        TitleColor="{AppThemeBinding Light={StaticResource TextMuted},
                                                     Dark={StaticResource TextMutedDark}}" />
                </VerticalStackLayout>
            </Border>

            <!--  Result Status Banner (Vibrant Blue Card)  -->
            <Border
                Padding="16,14"
                BackgroundColor="#1d4ed8"
                IsVisible="{Binding HasReportCard}"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="10">

                    <!--  Top Pill Tag  -->
                    <Border
                        Padding="10,3"
                        BackgroundColor="White"
                        HorizontalOptions="Start"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 12">
                        <Label
                            FontAttributes="Bold"
                            FontSize="11"
                            Text="{Binding ReportCard.TermName, StringFormat='{0} Report Card'}"
                            TextColor="#1d4ed8" />
                    </Border>

                    <!--  Status Title & Result Pill  -->
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <HorizontalStackLayout
                            Grid.Column="0"
                            Spacing="8"
                            VerticalOptions="Center">
                            <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                Text="Result Status:"
                                TextColor="White"
                                VerticalOptions="Center" />
                            <Border
                                Padding="12,4"
                                BackgroundColor="#22c55e"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 12"
                                VerticalOptions="Center">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    Text="{Binding ReportCard.ResultStatus}"
                                    TextColor="White" />
                            </Border>
                        </HorizontalStackLayout>
                    </Grid>

                    <!--  Marks & Grade Stats Line  -->
                    <Label FontSize="12" TextColor="#e0e7ff">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Total Marks: " />
                                <Span FontAttributes="Bold" Text="{Binding ReportCard.TotalMarksObtained, StringFormat='{0:0.00}'}" />
                                <Span Text=" / " />
                                <Span FontAttributes="Bold" Text="{Binding ReportCard.TotalMaxMarks, StringFormat='{0:0.00}'}" />
                                <Span Text=" | Percentage: " />
                                <Span FontAttributes="Bold" Text="{Binding ReportCard.Percentage, StringFormat='{0:0.00}%'}" />
                                <Span Text=" | Grade: " />
                                <Span FontAttributes="Bold" Text="{Binding ReportCard.OverallGrade}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <!--  Open Full Report Card Page Button  -->
                    <Button
                        Margin="0,4,0,0"
                        BackgroundColor="White"
                        Command="{Binding ViewFullReportCardCommand}"
                        CornerRadius="8"
                        FontAttributes="Bold"
                        FontSize="13"
                        HeightRequest="42"
                        Text="👁 View Full Report Card Breakdown"
                        TextColor="#1d4ed8" />
                </VerticalStackLayout>
            </Border>

            <!--  Class Exam Timetable (Datesheet) Section Header  -->
            <VerticalStackLayout Spacing="4">
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Image
                        HeightRequest="18"
                        Source="calendar_check.png"
                        WidthRequest="18">
                        <Image.Behaviors>
                            <mct:IconTintColorBehavior TintColor="{StaticResource Primary}" />
                        </Image.Behaviors>
                    </Image>
                    <Label
                        FontAttributes="Bold"
                        FontSize="15"
                        Text="Class Exam Timetable (Datesheet)"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                    Dark=White}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!--  Empty Timetable Notice  -->
            <Border
                Padding="20"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                  Dark={StaticResource CardBgDark}}"
                IsVisible="{Binding HasSchedules, Converter={StaticResource InvertedBoolConverter}}"
                StrokeShape="RoundRectangle 12">
                <Label
                    FontSize="13"
                    HorizontalOptions="Center"
                    Text="No exam schedules available for the selected term."
                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                Dark={StaticResource TextSecondaryDark}}" />
            </Border>

            <!--  Exam Timetable Schedule List  -->
            <VerticalStackLayout IsVisible="{Binding HasSchedules}" Spacing="8">
                <BindableLayout.ItemsSource>
                    <Binding Path="ExamSchedules" />
                </BindableLayout.ItemsSource>

                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="exam:ExamScheduleItem">
                        <Border
                            Padding="12,10"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                              Dark={StaticResource CardBgDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                                     Dark={StaticResource BorderColorDark}}"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="1">
                            <VerticalStackLayout Spacing="6">
                                <!--  Top Line: Date & Room Badge  -->
                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                    <Label
                                        Grid.Column="0"
                                        FontAttributes="Bold"
                                        FontSize="13"
                                        Text="{Binding ExamDateDisplay}"
                                        TextColor="#2563eb" />

                                    <Border
                                        Grid.Column="1"
                                        Padding="8,2"
                                        BackgroundColor="#06b6d4"
                                        Stroke="Transparent"
                                        StrokeShape="RoundRectangle 10">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="11"
                                            Text="{Binding RoomDisplay}"
                                            TextColor="White" />
                                    </Border>
                                </Grid>

                                <!--  Middle Line: Subject Name & Time  -->
                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                    <Label
                                        Grid.Column="0"
                                        FontAttributes="Bold"
                                        FontSize="15"
                                        Text="{Binding SubjectName}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                                    Dark=White}" />

                                    <Label
                                        Grid.Column="1"
                                        FontSize="12"
                                        Text="{Binding TimeDisplay}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                                    Dark={StaticResource TextSecondaryDark}}" />
                                </Grid>

                                <!--  Bottom Line: Max & Pass Marks  -->
                                <HorizontalStackLayout Spacing="8">
                                    <Label
                                        FontSize="11"
                                        Text="{Binding MaxMarks, StringFormat='Max Marks: {0:0.##}'}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                                    Dark={StaticResource TextSecondaryDark}}" />
                                    <Label
                                        FontSize="11"
                                        Text="•"
                                        TextColor="{AppThemeBinding Light={StaticResource TextMuted},
                                                                    Dark={StaticResource TextMutedDark}}" />
                                    <Label
                                        FontSize="11"
                                        Text="{Binding PassMarks, StringFormat='Pass Marks: {0:0.##}'}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                                    Dark={StaticResource TextSecondaryDark}}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</views:ViewBase>
