<?xml version="1.0" encoding="utf-8" ?>
<views:ViewBase
    x:Class="BusTracking.Mobile.Views.Student.StudentDatesheetPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:exam="clr-namespace:BusTracking.Mobile.Models.Exam"
    xmlns:views="clr-namespace:BusTracking.Mobile.Views"
    xmlns:vm="clr-namespace:BusTracking.Mobile.Viewmodels.Student"
    Title="{Binding Title}"
    x:DataType="vm:StudentDatesheetViewModel"
    x:TypeArguments="vm:StudentDatesheetViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBg},
                                      Dark={StaticResource PageBgDark}}">


    <Grid RowDefinitions="Auto,*">
        <!--  Exam Term Selector Header  -->
        <Border
            Grid.Row="0"
            Margin="16,12"
            BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                              Dark={StaticResource CardBgDark}}"
            Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                     Dark={StaticResource BorderColorDark}}"
            StrokeShape="RoundRectangle 12">
            <VerticalStackLayout Padding="12" Spacing="6">
                <Label
                    FontAttributes="Bold"
                    FontSize="12"
                    Text="SELECT EXAM TERM"
                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                Dark={StaticResource TextSecondaryDark}}" />
                <Picker
                    Title="Select Term..."
                    ItemDisplayBinding="{Binding TermName}"
                    ItemsSource="{Binding ExamTerms}"
                    SelectedItem="{Binding SelectedExamTerm}"
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                Dark={StaticResource TextPrimaryDark}}" />
            </VerticalStackLayout>
        </Border>

        <!--  Schedules List  -->
        <ScrollView Grid.Row="1" Padding="16,0,16,16">
            <VerticalStackLayout Spacing="12">
                <!--  Empty State  -->
                <Border
                    Padding="24"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                      Dark={StaticResource CardBgDark}}"
                    IsVisible="{Binding IsEmpty}"
                    StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="8">

                        <Image
                            HeightRequest="48"
                            Source="exam_datesheet.png"
                            WidthRequest="48" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="15"
                            HorizontalOptions="Center"
                            Text="No Exam Schedules"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                        Dark={StaticResource TextPrimaryDark}}" />
                        <Label
                            FontSize="13"
                            HorizontalOptions="Center"
                            Text="There are no exam schedules published for this term."
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                        Dark={StaticResource TextSecondaryDark}}" />
                    </VerticalStackLayout>
                </Border>

                <BindableLayout.ItemsSource>
                    <Binding Path="ExamSchedules" />
                </BindableLayout.ItemsSource>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="exam:ExamScheduleItem">
                        <Border
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                              Dark={StaticResource CardBgDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                                     Dark={StaticResource BorderColorDark}}"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1">
                            <Grid
                                Padding="16"
                                ColumnDefinitions="*,Auto"
                                RowDefinitions="Auto,Auto,Auto">
                                <!--  Subject & Code  -->
                                <VerticalStackLayout
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Spacing="2">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        Text="{Binding SubjectName}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                                    Dark={StaticResource TextPrimaryDark}}" />
                                    <Label
                                        FontSize="12"
                                        Text="{Binding RoomDisplay}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                                    Dark={StaticResource TextSecondaryDark}}" />
                                </VerticalStackLayout>

                                <Border
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Padding="8,4"
                                    BackgroundColor="{AppThemeBinding Light='#e0f2fe',
                                                                      Dark='#0369a1'}"
                                    StrokeShape="RoundRectangle 6">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="11"
                                        Text="{Binding StandardName}"
                                        TextColor="{AppThemeBinding Light='#0284c7',
                                                                    Dark='#e0f2fe'}" />
                                </Border>

                                <!--  Date & Time  -->
                                <HorizontalStackLayout
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Margin="0,10,0,0"
                                    Spacing="16">
                                    <HorizontalStackLayout Spacing="6">
                                        <Image
                                            HeightRequest="14"
                                            Source="calendar_icon.png"
                                            WidthRequest="14" />
                                        <Label
                                            FontSize="12"
                                            Text="{Binding ExamDateDisplay}"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                                        Dark={StaticResource TextPrimaryDark}}" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Spacing="6">
                                        <Image
                                            HeightRequest="14"
                                            Source="calendar_check.png"
                                            WidthRequest="14" />
                                        <Label
                                            FontSize="12"
                                            Text="{Binding TimeDisplay}"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                                        Dark={StaticResource TextSecondaryDark}}" />
                                    </HorizontalStackLayout>
                                </HorizontalStackLayout>

                                <!--  Marks info  -->
                                <Label
                                    Grid.Row="2"
                                    Grid.ColumnSpan="2"
                                    Margin="0,8,0,0"
                                    FontSize="12"
                                    Text="{Binding MarksDisplay}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextMuted},
                                                                Dark={StaticResource TextMutedDark}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</views:ViewBase>
