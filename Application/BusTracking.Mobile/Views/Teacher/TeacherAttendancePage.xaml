<?xml version="1.0" encoding="utf-8" ?>
<views:ViewBase
    x:Class="BusTracking.Mobile.Views.Teacher.TeacherAttendancePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:common="clr-namespace:BusTracking.Mobile.Views.Common"
    xmlns:mct="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"
    xmlns:models="clr-namespace:BusTracking.Mobile.Models.Attendance"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Toolkit.TextInputLayout;assembly=Syncfusion.Maui.Toolkit"
    xmlns:views="clr-namespace:BusTracking.Mobile.Views"
    xmlns:vm="clr-namespace:BusTracking.Mobile.Viewmodels.Teacher"
    x:DataType="vm:TeacherAttendanceViewModel"
    x:TypeArguments="vm:TeacherAttendanceViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBg},
                                      Dark={StaticResource PageBgDark}}">

    <views:ViewBase.Behaviors>
        <mct:StatusBarBehavior StatusBarColor="{AppThemeBinding Light={StaticResource LoginPageBgLight}, Dark={StaticResource LoginPageBgDark}}" StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}" />
    </views:ViewBase.Behaviors>

    <Shell.TitleView>
        <Label
            FontAttributes="Bold"
            FontSize="17"
            Text="Mark Classroom Attendance"
            TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                        Dark=White}"
            VerticalOptions="Center" />
    </Shell.TitleView>

    <Grid>
        <!--  Left/Right Margin 5, Top/Bottom Padding 5  -->
        <Grid
            Padding="5"
            RowDefinitions="*,Auto"
            RowSpacing="5">

            <!--  Scrollable Body Content  -->
            <ScrollView Grid.Row="0">
                <VerticalStackLayout Spacing="5">

                    <!--  Top Filter Card: Padding 8,5 | Row Spacing 5  -->
                    <Border
                        Padding="8,5"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                          Dark={StaticResource CardBgDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                                 Dark={StaticResource BorderColorDark}}"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="1">
                        <VerticalStackLayout Spacing="5">
                            <!--  Row 1: Session & Class (ColumnSpacing 5)  -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="5">
                                <syncfusion:SfTextInputLayout
                                    Grid.Column="0"
                                    Hint="Academic Session"
                                    Style="{StaticResource AppOutlinedInputStyle}">
                                    <Picker
                                        Title="Select Session"
                                        FontSize="13"
                                        ItemDisplayBinding="{Binding YearName}"
                                        ItemsSource="{Binding AcademicYears}"
                                        SelectedItem="{Binding SelectedYear}"
                                        TextColor="{AppThemeBinding Light=#0f172a,
                                                                    Dark=White}"
                                        TitleColor="{AppThemeBinding Light=#94a3b8,
                                                                     Dark=#64748b}" />
                                </syncfusion:SfTextInputLayout>

                                <syncfusion:SfTextInputLayout
                                    Grid.Column="1"
                                    Hint="Class / Standard"
                                    Style="{StaticResource AppOutlinedInputStyle}">
                                    <Picker
                                        Title="Select Class"
                                        FontSize="13"
                                        ItemDisplayBinding="{Binding StandardName}"
                                        ItemsSource="{Binding Standards}"
                                        SelectedItem="{Binding SelectedStandard}"
                                        TextColor="{AppThemeBinding Light=#0f172a,
                                                                    Dark=White}"
                                        TitleColor="{AppThemeBinding Light=#94a3b8,
                                                                     Dark=#64748b}" />
                                </syncfusion:SfTextInputLayout>
                            </Grid>

                            <!--  Row 2: Section & Attendance Date (ColumnSpacing 5)  -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="5">
                                <syncfusion:SfTextInputLayout
                                    Grid.Column="0"
                                    Hint="Section"
                                    Style="{StaticResource AppOutlinedInputStyle}">
                                    <Picker
                                        Title="Select Section"
                                        FontSize="13"
                                        ItemDisplayBinding="{Binding SectionName}"
                                        ItemsSource="{Binding Sections}"
                                        SelectedItem="{Binding SelectedSection}"
                                        TextColor="{AppThemeBinding Light=#0f172a,
                                                                    Dark=White}"
                                        TitleColor="{AppThemeBinding Light=#94a3b8,
                                                                     Dark=#64748b}" />
                                </syncfusion:SfTextInputLayout>

                                <syncfusion:SfTextInputLayout
                                    Grid.Column="1"
                                    Hint="Attendance Date"
                                    Style="{StaticResource AppOutlinedInputStyle}">
                                    <Entry
                                        FontSize="13"
                                        IsReadOnly="True"
                                        Text="{Binding SelectedDate, StringFormat='{0:yyyy-MM-dd}'}"
                                        TextColor="{AppThemeBinding Light=#0f172a,
                                                                    Dark=White}" />
                                    <syncfusion:SfTextInputLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenDateCalendarCommand}" />
                                    </syncfusion:SfTextInputLayout.GestureRecognizers>
                                    <syncfusion:SfTextInputLayout.TrailingView>
                                        <Image
                                            HeightRequest="18"
                                            Source="calendar_check.png"
                                            WidthRequest="18">
                                            <Image.Behaviors>
                                                <mct:IconTintColorBehavior TintColor="{AppThemeBinding Light=#64748b, Dark=#94a3b8}" />
                                            </Image.Behaviors>
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OpenDateCalendarCommand}" />
                                            </Image.GestureRecognizers>
                                        </Image>
                                    </syncfusion:SfTextInputLayout.TrailingView>
                                </syncfusion:SfTextInputLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!--  Student Marking List  -->
                    <CollectionView ItemsSource="{Binding Students}">
                        <CollectionView.EmptyView>
                            <VerticalStackLayout
                                Padding="30"
                                HorizontalOptions="Center"
                                Spacing="8"
                                VerticalOptions="Center">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    HorizontalOptions="Center"
                                    Text="No students found for attendance."
                                    TextColor="#94a3b8" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:StudentAttendanceRowDto">
                                <Border
                                    Margin="0,3"
                                    Padding="10,8"
                                    BackgroundColor="{AppThemeBinding Light=White,
                                                                      Dark=#1e293b}"
                                    Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                                             Dark={StaticResource BorderColorDark}}"
                                    StrokeShape="RoundRectangle 10"
                                    StrokeThickness="1">
                                    <Grid
                                        ColumnDefinitions="Auto,*,Auto"
                                        ColumnSpacing="10"
                                        VerticalOptions="Center">
                                        <!--  Student Profile Photo / Default Avatar  -->
                                        <Border
                                            Grid.Column="0"
                                            BackgroundColor="#e2e8f0"
                                            HeightRequest="40"
                                            HorizontalOptions="Center"
                                            StrokeShape="RoundRectangle 20"
                                            StrokeThickness="0"
                                            VerticalOptions="Center"
                                            WidthRequest="40">
                                            <Image
                                                Aspect="AspectFill"
                                                HeightRequest="40"
                                                Source="{Binding DisplayAvatarUrl}"
                                                WidthRequest="40" />
                                        </Border>

                                        <!--  Student Full Name & Student Code  -->
                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            Spacing="2"
                                            VerticalOptions="Center">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="14"
                                                Text="{Binding StudentName}"
                                                TextColor="{AppThemeBinding Light=#0f172a,
                                                                            Dark=White}" />
                                            <Label
                                                FontSize="11"
                                                Text="{Binding StudentCode, StringFormat='ID: {0}'}"
                                                TextColor="#64748b" />
                                        </VerticalStackLayout>

                                        <!--  Status Toggle Button (Present / Absent)  -->
                                        <Button
                                            Grid.Column="2"
                                            Padding="14,0"
                                            BackgroundColor="{Binding StatusColor}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TeacherAttendanceViewModel}}, Path=ToggleStatusCommand}"
                                            CommandParameter="{Binding .}"
                                            CornerRadius="6"
                                            FontAttributes="Bold"
                                            FontSize="12"
                                            HeightRequest="36"
                                            Text="{Binding Status}"
                                            TextColor="White" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </ScrollView>

            <!--  Floating Face Scan Action Button  -->
            <Border
                Grid.Row="0"
                Margin="0,0,10,10"
                Padding="14,8"
                BackgroundColor="{StaticResource Secondary}"
                HorizontalOptions="End"
                IsVisible="{Binding HasStudents}"
                StrokeShape="RoundRectangle 20"
                StrokeThickness="0"
                VerticalOptions="End"
                ZIndex="10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding StartFaceScanCommand}" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Label
                        FontSize="14"
                        Text="📷"
                        VerticalOptions="Center" />
                    <Label
                        FontAttributes="Bold"
                        FontSize="13"
                        Text="Face Scan"
                        TextColor="White"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <!--  Fixed Bottom Buttons Bar: Mark All Present & Save Attendance (Visible ONLY if student records exist)  -->
            <Grid
                Grid.Row="1"
                ColumnDefinitions="*,*"
                ColumnSpacing="8"
                IsVisible="{Binding HasStudents}">
                <Button
                    Grid.Column="0"
                    BackgroundColor="#10b981"
                    Command="{Binding MarkAllPresentCommand}"
                    CornerRadius="8"
                    FontAttributes="Bold"
                    FontSize="14"
                    HeightRequest="44"
                    Text="Mark All Present"
                    TextColor="White" />
                <Button
                    Grid.Column="1"
                    BackgroundColor="{StaticResource Primary}"
                    Command="{Binding SaveAttendanceCommand}"
                    CornerRadius="8"
                    FontAttributes="Bold"
                    FontSize="14"
                    HeightRequest="44"
                    Text="Save Attendance"
                    TextColor="White" />
            </Grid>

        </Grid>

        <!--  Shared Calendar Popup Overlay  -->
        <common:CalendarPickerPopup
            Title="Select Attendance Date"
            Grid.Row="0"
            Grid.RowSpan="2"
            IsOpen="{Binding IsCalendarOpen, Mode=TwoWay}"
            SelectedDate="{Binding SelectedDate, Mode=TwoWay}" />
    </Grid>

</views:ViewBase>
