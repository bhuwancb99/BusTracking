<?xml version="1.0" encoding="utf-8" ?>
<views:ViewBase
    x:Class="BusTracking.Mobile.Views.Teacher.TeacherMarksEntryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:exam="clr-namespace:BusTracking.Mobile.Models.Exam"
    xmlns:mct="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Toolkit.TextInputLayout;assembly=Syncfusion.Maui.Toolkit"
    xmlns:views="clr-namespace:BusTracking.Mobile.Views"
    xmlns:vm="clr-namespace:BusTracking.Mobile.Viewmodels.Teacher"
    Title="{Binding Title}"
    x:DataType="vm:TeacherMarksEntryViewModel"
    x:TypeArguments="vm:TeacherMarksEntryViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBg},
                                      Dark={StaticResource PageBgDark}}">

    <views:ViewBase.Behaviors>
        <mct:StatusBarBehavior StatusBarColor="{AppThemeBinding Light={StaticResource LoginPageBgLight}, Dark={StaticResource LoginPageBgDark}}" StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}" />
    </views:ViewBase.Behaviors>

    <Grid RowDefinitions="Auto,Auto,*">

        <!--  Top Filter Card  -->
        <Border
            Grid.Row="0"
            Margin="5,8,5,8"
            Padding="10,8"
            BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                              Dark={StaticResource CardBgDark}}"
            Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                     Dark={StaticResource BorderColorDark}}"
            StrokeShape="RoundRectangle 12">
            <VerticalStackLayout Spacing="5">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="5">
                    <!--  Exam Term  -->
                    <syncfusion:SfTextInputLayout
                        Grid.Column="0"
                        Hint="Exam Term"
                        Style="{StaticResource AppOutlinedInputStyle}">
                        <Picker
                            Title="Select Term"
                            FontSize="13"
                            ItemDisplayBinding="{Binding TermName}"
                            ItemsSource="{Binding ExamTerms}"
                            SelectedItem="{Binding SelectedExamTerm, Mode=TwoWay}"
                            TextColor="{AppThemeBinding Light=#0f172a,
                                                        Dark=White}"
                            TitleColor="{AppThemeBinding Light=#94a3b8,
                                                         Dark=#64748b}" />
                    </syncfusion:SfTextInputLayout>

                    <!--  Standard / Class  -->
                    <syncfusion:SfTextInputLayout
                        Grid.Column="1"
                        Hint="Class / Standard"
                        Style="{StaticResource AppOutlinedInputStyle}">
                        <Picker
                            Title="Select Class"
                            FontSize="13"
                            ItemDisplayBinding="{Binding StandardName}"
                            ItemsSource="{Binding Standards}"
                            SelectedItem="{Binding SelectedStandard, Mode=TwoWay}"
                            TextColor="{AppThemeBinding Light=#0f172a,
                                                        Dark=White}"
                            TitleColor="{AppThemeBinding Light=#94a3b8,
                                                         Dark=#64748b}" />
                    </syncfusion:SfTextInputLayout>
                </Grid>

                <Grid
                    Margin="0,-10,0,-10"
                    ColumnDefinitions="*,*"
                    ColumnSpacing="5">
                    <!--  Section  -->
                    <syncfusion:SfTextInputLayout
                        Grid.Column="0"
                        Hint="Section"
                        Style="{StaticResource AppOutlinedInputStyle}">
                        <Picker
                            Title="Select Section"
                            FontSize="13"
                            ItemDisplayBinding="{Binding SectionName}"
                            ItemsSource="{Binding Sections}"
                            SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                            TextColor="{AppThemeBinding Light=#0f172a,
                                                        Dark=White}"
                            TitleColor="{AppThemeBinding Light=#94a3b8,
                                                         Dark=#64748b}" />
                    </syncfusion:SfTextInputLayout>

                    <!--  Subject / Schedule  -->
                    <syncfusion:SfTextInputLayout
                        Grid.Column="1"
                        Hint="Subject / Schedule"
                        Style="{StaticResource AppOutlinedInputStyle}">
                        <Picker
                            Title="Select Subject"
                            FontSize="13"
                            ItemDisplayBinding="{Binding SubjectName}"
                            ItemsSource="{Binding ExamSchedules}"
                            SelectedItem="{Binding SelectedSchedule, Mode=TwoWay}"
                            TextColor="{AppThemeBinding Light=#0f172a,
                                                        Dark=White}"
                            TitleColor="{AppThemeBinding Light=#94a3b8,
                                                         Dark=#64748b}" />
                    </syncfusion:SfTextInputLayout>
                </Grid>

                <Button
                    Margin="0,2,0,0"
                    Command="{Binding SearchGridCommand}"
                    CornerRadius="8"
                    FontAttributes="Bold"
                    HeightRequest="44"
                    Text="Search" />
            </VerticalStackLayout>
        </Border>

        <!--  Success Alert Banner  -->
        <Border
            Grid.Row="1"
            Margin="5,0,5,8"
            Padding="12,10"
            BackgroundColor="#dcfce7"
            IsVisible="{Binding ShowSuccessBanner}"
            Stroke="#22c55e"
            StrokeShape="RoundRectangle 8">
            <HorizontalStackLayout Spacing="8">
                <Image
                    HeightRequest="16"
                    Source="check.png"
                    WidthRequest="16" />
                <Label
                    FontAttributes="Bold"
                    FontSize="13"
                    Text="{Binding SuccessMessage}"
                    TextColor="#15803d" />
            </HorizontalStackLayout>
        </Border>

        <!--  Student Marks List Grid  -->
        <ScrollView Grid.Row="2" Padding="5,0,5,16">
            <VerticalStackLayout Spacing="12">

                <!--  Blue Schedule Summary & Save Banner Card (Always visible once Search clicked)  -->
                <Border
                    Padding="12"
                    BackgroundColor="#eff6ff"
                    IsVisible="{Binding IsGridLoaded}"
                    Stroke="#bfdbfe"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="1">
                    <Grid
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="10"
                        VerticalOptions="Center">
                        <!--  Left Blue Icon Container  -->
                        <Border
                            Grid.Column="0"
                            Padding="10"
                            BackgroundColor="#2563eb"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 10"
                            VerticalOptions="Center">
                            <Image
                                HeightRequest="22"
                                Source="exam_datesheet.png"
                                WidthRequest="22">
                                <Image.Behaviors>
                                    <mct:IconTintColorBehavior TintColor="White" />
                                </Image.Behaviors>
                            </Image>
                        </Border>

                        <!--  Middle Info: Subject - Class & Details  -->
                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="2"
                            VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="4">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    Text="{Binding SelectedSchedule.SubjectName}"
                                    TextColor="#1e3a8a" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    Text="—"
                                    TextColor="#1e3a8a" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    Text="{Binding SelectedStandard.StandardName}"
                                    TextColor="#1e3a8a" />
                            </HorizontalStackLayout>

                            <Label FontSize="11" TextColor="#2563eb">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Date: " />
                                        <Span FontAttributes="Bold" Text="{Binding SelectedSchedule.ExamDateDisplay}" />
                                        <Span Text=" | Max Marks: " />
                                        <Span FontAttributes="Bold" Text="{Binding SelectedSchedule.MaxMarks, StringFormat='{0:0.00}'}" />
                                        <Span Text=" | Pass Marks: " />
                                        <Span FontAttributes="Bold" Text="{Binding SelectedSchedule.PassMarks, StringFormat='{0:0.00}'}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </VerticalStackLayout>

                        <!--  Right Save Button  -->
                        <Button
                            Grid.Column="2"
                            Padding="10,0"
                            BackgroundColor="#15803d"
                            Command="{Binding SaveMarksCommand}"
                            CornerRadius="8"
                            FontAttributes="Bold"
                            FontSize="12"
                            HeightRequest="38"
                            Text="Save All Marks"
                            TextColor="White"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!--  Empty State  -->
                <Border
                    Padding="24"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                      Dark={StaticResource CardBgDark}}"
                    IsVisible="{Binding IsEmpty}"
                    StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                        <Image
                            HeightRequest="48"
                            Source="marks_entry.png"
                            WidthRequest="48" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="15"
                            HorizontalOptions="Center"
                            Text="Select Filters To Load Grid"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                        Dark={StaticResource TextPrimaryDark}}" />
                        <Label
                            FontSize="12"
                            HorizontalOptions="Center"
                            Text="Select Exam Term, Class, Section, and Subject to start scoring."
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                        Dark={StaticResource TextSecondaryDark}}" />
                    </VerticalStackLayout>
                </Border>

                <!--  Student List Items (Active Grid)  -->
                <VerticalStackLayout IsVisible="{Binding HasGridData}" Spacing="10">
                    <BindableLayout.ItemsSource>
                        <Binding Path="StudentGrid" />
                    </BindableLayout.ItemsSource>

                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="exam:StudentMarksGridItem">
                            <Border
                                Padding="10"
                                BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                                  Dark={StaticResource CardBgDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                                         Dark={StaticResource BorderColorDark}}"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="1">
                                <VerticalStackLayout Spacing="5">
                                    <!--  Row 1: Code Badge, Name, Absent Checkbox (Compact 1 Line)  -->
                                    <Grid
                                        ColumnDefinitions="Auto,*,Auto"
                                        ColumnSpacing="8"
                                        VerticalOptions="Center">
                                        <Border
                                            Grid.Column="0"
                                            Padding="6,0"
                                            BackgroundColor="{AppThemeBinding Light=#f1f5f9,
                                                                              Dark=#1e293b}"
                                            HeightRequest="24"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 4"
                                            VerticalOptions="Center">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="11"
                                                Text="{Binding StudentCode}"
                                                TextColor="{AppThemeBinding Light=#475569,
                                                                            Dark=#94a3b8}"
                                                VerticalOptions="Center" />
                                        </Border>

                                        <Label
                                            Grid.Column="1"
                                            FontAttributes="Bold"
                                            FontSize="14"
                                            LineBreakMode="TailTruncation"
                                            Text="{Binding StudentName}"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                                        Dark=White}"
                                            VerticalOptions="Center" />

                                        <HorizontalStackLayout
                                            Grid.Column="2"
                                            Spacing="2"
                                            VerticalOptions="Center">
                                            <Label
                                                FontSize="12"
                                                Text="Absent?"
                                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                                            Dark={StaticResource TextSecondaryDark}}"
                                                VerticalOptions="Center" />
                                            <CheckBox
                                                HeightRequest="24"
                                                IsChecked="{Binding IsAbsent}"
                                                VerticalOptions="Center"
                                                WidthRequest="24" />
                                        </HorizontalStackLayout>
                                    </Grid>

                                    <!--  Row 2: Marks Obtained & Grade Badge  -->
                                    <Grid
                                        ColumnDefinitions="*,Auto"
                                        ColumnSpacing="12"
                                        VerticalOptions="Center">
                                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="11"
                                                Text="MARKS OBTAINED"
                                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                                            Dark={StaticResource TextSecondaryDark}}" />
                                            <Border
                                                Padding="10,2"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource PageBg},
                                                                                  Dark={StaticResource CardBgDark}}"
                                                Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                                                         Dark={StaticResource BorderColorDark}}"
                                                StrokeShape="RoundRectangle 8">
                                                <Entry
                                                    FontAttributes="Bold"
                                                    FontSize="15"
                                                    Keyboard="Numeric"
                                                    Placeholder="Enter marks e.g. 78"
                                                    Text="{Binding MarksObtained}"
                                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                                                Dark=White}" />
                                            </Border>
                                        </VerticalStackLayout>

                                        <!--  Grade Badge e.g. A+ or B  -->
                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            Spacing="4"
                                            VerticalOptions="End">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="11"
                                                HorizontalOptions="Center"
                                                Text="GRADE"
                                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                                            Dark={StaticResource TextSecondaryDark}}" />
                                            <Border
                                                Padding="12,6"
                                                BackgroundColor="{Binding GradeColor}"
                                                IsVisible="{Binding Grade, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                                                Stroke="Transparent"
                                                StrokeShape="RoundRectangle 12">
                                                <Label
                                                    FontAttributes="Bold"
                                                    FontSize="13"
                                                    Text="{Binding Grade}"
                                                    TextColor="White" />
                                            </Border>
                                        </VerticalStackLayout>
                                    </Grid>

                                    <!--  Row 3: Remarks  -->
                                    <VerticalStackLayout Spacing="4">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="11"
                                            Text="REMARKS / FEEDBACK"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                                        Dark={StaticResource TextSecondaryDark}}" />
                                        <Border
                                            Padding="10,2"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource PageBg},
                                                                              Dark={StaticResource CardBgDark}}"
                                            Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                                                     Dark={StaticResource BorderColorDark}}"
                                            StrokeShape="RoundRectangle 8">
                                            <Entry
                                                FontSize="13"
                                                Placeholder="Optional comments or remarks..."
                                                Text="{Binding Remarks}"
                                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                                            Dark=White}" />
                                        </Border>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</views:ViewBase>
