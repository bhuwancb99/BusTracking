<?xml version="1.0" encoding="utf-8" ?>
<views:ViewBase
    x:Class="BusTracking.Mobile.Views.Teacher.TeacherMarksEntryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:exam="clr-namespace:BusTracking.Mobile.Models.Exam"
    xmlns:mct="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"
    xmlns:views="clr-namespace:BusTracking.Mobile.Views"
    xmlns:vm="clr-namespace:BusTracking.Mobile.Viewmodels.Teacher"
    Title="{Binding Title}"
    x:DataType="vm:TeacherMarksEntryViewModel"
    x:TypeArguments="vm:TeacherMarksEntryViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBg},
                                      Dark={StaticResource PageBgDark}}">

    <views:ViewBase.Behaviors>
        <mct:StatusBarBehavior StatusBarColor="{AppThemeBinding Light={StaticResource LoginPageBgLight}, Dark={StaticResource LoginPageBgDark}}" StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}" />
    </views:ViewBase.Behaviors>

    <Grid RowDefinitions="Auto,Auto,*">
        <!--  Filter Section  -->
        <Border
            Grid.Row="0"
            Margin="16,12"
            Padding="14"
            BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                              Dark={StaticResource CardBgDark}}"
            Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                     Dark={StaticResource BorderColorDark}}"
            StrokeShape="RoundRectangle 12">
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <!--  Term  -->
                    <Border
                        Grid.Column="0"
                        Padding="10,6"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PageBg},
                                                          Dark={StaticResource CardBgDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                                 Dark={StaticResource BorderColorDark}}"
                        StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout Spacing="2">
                            <Label
                                FontAttributes="Bold"
                                FontSize="11"
                                Text="EXAM TERM"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                            Dark={StaticResource TextSecondaryDark}}" />
                            <Picker
                                Title="Select Term"
                                FontSize="13"
                                ItemDisplayBinding="{Binding TermName}"
                                ItemsSource="{Binding ExamTerms}"
                                SelectedItem="{Binding SelectedExamTerm, Mode=TwoWay}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                            Dark=White}"
                                TitleColor="{AppThemeBinding Light={StaticResource TextMuted},
                                                             Dark={StaticResource TextMutedDark}}" />
                        </VerticalStackLayout>
                    </Border>

                    <!--  Standard / Class  -->
                    <Border
                        Grid.Column="1"
                        Padding="10,6"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PageBg},
                                                          Dark={StaticResource CardBgDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                                 Dark={StaticResource BorderColorDark}}"
                        StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout Spacing="2">
                            <Label
                                FontAttributes="Bold"
                                FontSize="11"
                                Text="CLASS / STANDARD"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                            Dark={StaticResource TextSecondaryDark}}" />
                            <Picker
                                Title="Select Class"
                                FontSize="13"
                                ItemDisplayBinding="{Binding StandardName}"
                                ItemsSource="{Binding Standards}"
                                SelectedItem="{Binding SelectedStandard, Mode=TwoWay}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                            Dark=White}"
                                TitleColor="{AppThemeBinding Light={StaticResource TextMuted},
                                                             Dark={StaticResource TextMutedDark}}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <!--  Section  -->
                    <Border
                        Grid.Column="0"
                        Padding="10,6"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PageBg},
                                                          Dark={StaticResource CardBgDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                                 Dark={StaticResource BorderColorDark}}"
                        StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout Spacing="2">
                            <Label
                                FontAttributes="Bold"
                                FontSize="11"
                                Text="SECTION"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                            Dark={StaticResource TextSecondaryDark}}" />
                            <Picker
                                Title="Select Section"
                                FontSize="13"
                                ItemDisplayBinding="{Binding SectionName}"
                                ItemsSource="{Binding Sections}"
                                SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                            Dark=White}"
                                TitleColor="{AppThemeBinding Light={StaticResource TextMuted},
                                                             Dark={StaticResource TextMutedDark}}" />
                        </VerticalStackLayout>
                    </Border>

                    <!--  Subject / Schedule  -->
                    <Border
                        Grid.Column="1"
                        Padding="10,6"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PageBg},
                                                          Dark={StaticResource CardBgDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                                 Dark={StaticResource BorderColorDark}}"
                        StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout Spacing="2">
                            <Label
                                FontAttributes="Bold"
                                FontSize="11"
                                Text="SUBJECT / SCHEDULE"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                            Dark={StaticResource TextSecondaryDark}}" />
                            <Picker
                                Title="Select Subject"
                                FontSize="13"
                                ItemDisplayBinding="{Binding SubjectName}"
                                ItemsSource="{Binding ExamSchedules}"
                                SelectedItem="{Binding SelectedSchedule, Mode=TwoWay}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                            Dark=White}"
                                TitleColor="{AppThemeBinding Light={StaticResource TextMuted},
                                                             Dark={StaticResource TextMutedDark}}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Button
                    Margin="0,4,0,0"
                    Command="{Binding SearchGridCommand}"
                    CornerRadius="8"
                    FontAttributes="Bold"
                    HeightRequest="46"
                    Text="Fetch Student Grid" />
            </VerticalStackLayout>
        </Border>

        <!--  Success Alert Banner  -->
        <Border
            Grid.Row="1"
            Margin="16,0,16,8"
            Padding="12,10"
            BackgroundColor="#dcfce7"
            IsVisible="{Binding ShowSuccessBanner}"
            Stroke="#22c55e"
            StrokeShape="RoundRectangle 8">
            <HorizontalStackLayout Spacing="8">
                <Image
                    HeightRequest="16"
                    Source="check.png"
                    WidthRequest="16" />
                <Label
                    FontAttributes="Bold"
                    FontSize="13"
                    Text="{Binding SuccessMessage}"
                    TextColor="#15803d" />
            </HorizontalStackLayout>
        </Border>

        <!--  Student Marks List Grid  -->
        <ScrollView Grid.Row="2" Padding="16,0,16,16">
            <VerticalStackLayout Spacing="12">
                <Border
                    Padding="24"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                      Dark={StaticResource CardBgDark}}"
                    IsVisible="{Binding IsEmpty}"
                    StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="8">

                        <Image
                            HeightRequest="48"
                            Source="marks_entry.png"
                            WidthRequest="48" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="15"
                            HorizontalOptions="Center"
                            Text="Select Filters To Load Grid"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                        Dark={StaticResource TextPrimaryDark}}" />
                        <Label
                            FontSize="12"
                            HorizontalOptions="Center"
                            Text="Select Exam Term, Class, Section, and Subject to start scoring."
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                        Dark={StaticResource TextSecondaryDark}}" />
                    </VerticalStackLayout>
                </Border>

                <!--  Grid Data  -->
                <VerticalStackLayout IsVisible="{Binding HasGridData}" Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <Label
                            Grid.Column="0"
                            FontAttributes="Bold"
                            FontSize="15"
                            Text="Student Marks Entry"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                        Dark=White}" />
                        <Button
                            Grid.Column="1"
                            Command="{Binding SaveMarksCommand}"
                            CornerRadius="8"
                            FontAttributes="Bold"
                            HeightRequest="36"
                            Text="Save All Marks" />
                    </Grid>

                    <BindableLayout.ItemsSource>
                        <Binding Path="StudentGrid" />
                    </BindableLayout.ItemsSource>

                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="exam:StudentMarksGridItem">
                            <Border
                                Padding="12"
                                BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                                  Dark={StaticResource CardBgDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                                         Dark={StaticResource BorderColorDark}}"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="1">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="14"
                                                Text="{Binding StudentName}"
                                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                                            Dark=White}" />
                                            <Label
                                                FontSize="11"
                                                Text="{Binding AdmissionNo, StringFormat='Adm: {0}'}"
                                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                                            Dark={StaticResource TextSecondaryDark}}" />
                                        </VerticalStackLayout>

                                        <HorizontalStackLayout
                                            Grid.Column="1"
                                            Spacing="6"
                                            VerticalOptions="Center">
                                            <Label
                                                FontSize="12"
                                                Text="Absent:"
                                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                                            Dark={StaticResource TextSecondaryDark}}"
                                                VerticalOptions="Center" />
                                            <CheckBox IsChecked="{Binding IsAbsent}" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label
                                                FontSize="11"
                                                Text="Theory Marks"
                                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                                            Dark={StaticResource TextSecondaryDark}}" />
                                            <Entry
                                                Keyboard="Numeric"
                                                Placeholder="e.g. 75"
                                                Text="{Binding TheoryMarks}" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label
                                                FontSize="11"
                                                Text="Practical Marks"
                                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                                            Dark={StaticResource TextSecondaryDark}}" />
                                            <Entry
                                                Keyboard="Numeric"
                                                Placeholder="e.g. 20"
                                                Text="{Binding PracticalMarks}" />
                                        </VerticalStackLayout>
                                    </Grid>

                                    <Entry Placeholder="Remarks (optional)" Text="{Binding Remarks}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</views:ViewBase>
