<?xml version="1.0" encoding="utf-8" ?>
<views:ViewBase
    x:Class="BusTracking.Mobile.Views.Teacher.TeacherHomeworkSubmissionsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mct="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"
    xmlns:models="clr-namespace:BusTracking.Mobile.Models.Homework"
    xmlns:views="clr-namespace:BusTracking.Mobile.Views"
    xmlns:vm="clr-namespace:BusTracking.Mobile.Viewmodels.Teacher"
    x:DataType="vm:TeacherHomeworkSubmissionsViewModel"
    x:TypeArguments="vm:TeacherHomeworkSubmissionsViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBg},
                                      Dark={StaticResource PageBgDark}}">

    <views:ViewBase.Behaviors>
        <mct:StatusBarBehavior StatusBarColor="{AppThemeBinding Light={StaticResource LoginPageBgLight}, Dark={StaticResource LoginPageBgDark}}" StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}" />
    </views:ViewBase.Behaviors>

    <Shell.TitleView>
        <VerticalStackLayout VerticalOptions="Center">
            <Label
                FontAttributes="Bold"
                FontSize="16"
                Text="Student Submissions"
                TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                            Dark=White}" />
            <Label
                FontSize="11"
                Text="{Binding Homework.Title}"
                TextColor="{StaticResource Primary}" />
        </VerticalStackLayout>
    </Shell.TitleView>

    <Grid Padding="8">
        <CollectionView ItemsSource="{Binding Submissions}" SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout
                    Padding="30"
                    Spacing="10"
                    VerticalOptions="Center">
                    <Label
                        FontAttributes="Bold"
                        FontSize="16"
                        HorizontalOptions="Center"
                        Text="No Student Submissions Yet"
                        TextColor="{StaticResource TextSecondary}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:HomeworkSubmissionDto">
                    <Border
                        Margin="0,4"
                        Padding="12"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                          Dark={StaticResource CardBgDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                                 Dark={StaticResource BorderColorDark}}"
                        StrokeShape="RoundRectangle 10">
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <!--  Student Initials / Avatar Circle  -->
                                <Border
                                    Grid.Column="0"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary},
                                                                      Dark={StaticResource PrimaryDark}}"
                                    HeightRequest="42"
                                    StrokeShape="RoundRectangle 21"
                                    StrokeThickness="0"
                                    VerticalOptions="Center"
                                    WidthRequest="42">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="15"
                                        HorizontalOptions="Center"
                                        Text="{Binding StudentInitials}"
                                        TextColor="White"
                                        VerticalOptions="Center" />
                                </Border>

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="14"
                                        Text="{Binding StudentName}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                                    Dark=White}" />
                                    <Label
                                        FontSize="11"
                                        Text="{Binding StudentCode}"
                                        TextColor="{StaticResource TextTertiary}" />
                                </VerticalStackLayout>

                                <!--  Status Badge Pill (Green / Blue / Yellow)  -->
                                <Border
                                    Grid.Column="2"
                                    Padding="8,3"
                                    BackgroundColor="{Binding StatusBadgeBgColor}"
                                    StrokeShape="RoundRectangle 6"
                                    StrokeThickness="0"
                                    VerticalOptions="Center">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="11"
                                        Text="{Binding StatusBadgeText}"
                                        TextColor="{Binding StatusBadgeTextColor}" />
                                </Border>
                            </Grid>

                            <Label
                                FontSize="12"
                                Text="{Binding SubmissionText, StringFormat='Note: {0}'}"
                                TextColor="{StaticResource TextSecondary}" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                <Label
                                    Grid.Column="0"
                                    FontSize="12"
                                    Text="{Binding MarksObtained, StringFormat='Marks: {0:F1}'}"
                                    TextColor="{StaticResource Primary}" />
                                <Label
                                    Grid.Column="1"
                                    FontSize="12"
                                    Text="{Binding TeacherRemarks, StringFormat='Remarks: {0}'}"
                                    TextColor="{StaticResource TextSecondary}" />
                            </Grid>

                            <Button
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TeacherHomeworkSubmissionsViewModel}}, Path=EvaluateCommand}"
                                CommandParameter="{Binding .}"
                                CornerRadius="6"
                                FontSize="12"
                                HeightRequest="36"
                                Text="Grade / Evaluate" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</views:ViewBase>
