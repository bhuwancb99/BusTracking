<?xml version="1.0" encoding="utf-8" ?>
<views:ViewBase
    x:Class="BusTracking.Mobile.Views.Teacher.TeacherHomeworkListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mct="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"
    xmlns:models="clr-namespace:BusTracking.Mobile.Models.Homework"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Toolkit.TextInputLayout;assembly=Syncfusion.Maui.Toolkit"
    xmlns:views="clr-namespace:BusTracking.Mobile.Views"
    xmlns:vm="clr-namespace:BusTracking.Mobile.Viewmodels.Teacher"
    x:DataType="vm:TeacherHomeworkListViewModel"
    x:TypeArguments="vm:TeacherHomeworkListViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBg},
                                      Dark={StaticResource PageBgDark}}">

    <views:ViewBase.Behaviors>
        <mct:StatusBarBehavior StatusBarColor="{AppThemeBinding Light={StaticResource LoginPageBgLight}, Dark={StaticResource LoginPageBgDark}}" StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}" />
    </views:ViewBase.Behaviors>

    <Shell.TitleView>
        <Grid ColumnDefinitions="*,Auto">
            <Label
                Grid.Column="0"
                FontAttributes="Bold"
                FontSize="17"
                Text="Homework Assignments"
                TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                            Dark=White}"
                VerticalOptions="Center" />
            <Border
                Grid.Column="1"
                Margin="0,0,8,0"
                Padding="8"
                BackgroundColor="White"
                StrokeShape="RoundRectangle 20"
                StrokeThickness="0"
                VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToCreateCommand}" />
                </Border.GestureRecognizers>
                <Image
                    HeightRequest="20"
                    Source="add.png"
                    WidthRequest="20">
                    <Image.Behaviors>
                        <mct:IconTintColorBehavior TintColor="{StaticResource Primary}" />
                    </Image.Behaviors>
                </Image>
            </Border>
        </Grid>
    </Shell.TitleView>

    <Grid Padding="8" RowDefinitions="Auto,*">
        <!--  3-Column Picker Filter Card (Auto-fetches on selection, Search Button Removed)  -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,8"
            Padding="10,8"
            BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                              Dark={StaticResource CardBgDark}}"
            Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                     Dark={StaticResource BorderColorDark}}"
            StrokeShape="RoundRectangle 10">
            <Grid
                ColumnDefinitions="*,*,*"
                ColumnSpacing="6"
                VerticalOptions="Center">
                <syncfusion:SfTextInputLayout
                    Grid.Column="0"
                    Hint="Session"
                    Style="{StaticResource AppOutlinedInputStyle}">
                    <Picker
                        ItemDisplayBinding="{Binding YearName}"
                        ItemsSource="{Binding AcademicYears}"
                        SelectedItem="{Binding SelectedAcademicYear}" />
                </syncfusion:SfTextInputLayout>
                <syncfusion:SfTextInputLayout
                    Grid.Column="1"
                    Hint="Class"
                    Style="{StaticResource AppOutlinedInputStyle}">
                    <Picker
                        ItemDisplayBinding="{Binding StandardName}"
                        ItemsSource="{Binding Standards}"
                        SelectedItem="{Binding SelectedStandard}" />
                </syncfusion:SfTextInputLayout>
                <syncfusion:SfTextInputLayout
                    Grid.Column="2"
                    Hint="Section"
                    Style="{StaticResource AppOutlinedInputStyle}">
                    <Picker
                        ItemDisplayBinding="{Binding SectionName}"
                        ItemsSource="{Binding Sections}"
                        SelectedItem="{Binding SelectedSection}" />
                </syncfusion:SfTextInputLayout>
            </Grid>
        </Border>

        <!--  Homework List  -->
        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Homeworks}"
            SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout
                    Padding="30"
                    Spacing="10"
                    VerticalOptions="Center">
                    <Label
                        FontAttributes="Bold"
                        FontSize="16"
                        HorizontalOptions="Center"
                        Text="No Homework Assignments Found"
                        TextColor="{StaticResource TextSecondary}" />
                    <Label
                        FontSize="13"
                        HorizontalOptions="Center"
                        Text="Select Session, Standard &amp; Section above to load assignments."
                        TextColor="{StaticResource TextTertiary}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:HomeworkDto">
                    <Border
                        Margin="0,4"
                        Padding="12"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                          Dark={StaticResource CardBgDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                                 Dark={StaticResource BorderColorDark}}"
                        StrokeShape="RoundRectangle 10">
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label
                                    Grid.Column="0"
                                    FontAttributes="Bold"
                                    FontSize="15"
                                    Text="{Binding Title}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                                Dark=White}" />
                                <Border
                                    Grid.Column="1"
                                    Padding="8,3"
                                    BackgroundColor="{Binding StatusBadgeBgColor}"
                                    StrokeShape="RoundRectangle 6"
                                    StrokeThickness="0">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="11"
                                        Text="{Binding StatusBadgeText}"
                                        TextColor="White" />
                                </Border>
                            </Grid>
                            <Label
                                FontSize="13"
                                LineBreakMode="WordWrap"
                                Text="{Binding Description}"
                                TextColor="{StaticResource TextSecondary}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label
                                    Grid.Column="0"
                                    FontSize="12"
                                    Text="{Binding DueDate, StringFormat='Due: {0:dd MMM yyyy}'}"
                                    TextColor="{StaticResource Primary}" />
                                <Label
                                    Grid.Column="1"
                                    FontSize="12"
                                    Text="{Binding SubmissionsCount, StringFormat='Submissions: {0}'}"
                                    TextColor="{StaticResource TextTertiary}" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" />
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                <Button
                                    Grid.Column="0"
                                    Padding="4,0"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TeacherHomeworkListViewModel}}, Path=GoToSubmissionsCommand}"
                                    CommandParameter="{Binding .}"
                                    CornerRadius="6"
                                    FontSize="11"
                                    HeightRequest="34"
                                    Text="Submissions" />
                                <Button
                                    Grid.Column="1"
                                    Padding="4,0"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TeacherHomeworkListViewModel}}, Path=GoToEditCommand}"
                                    CommandParameter="{Binding .}"
                                    CornerRadius="6"
                                    FontSize="11"
                                    HeightRequest="34"
                                    Text="Edit" />
                                <Button
                                    Grid.Column="2"
                                    Padding="4,0"
                                    BackgroundColor="#DC2626"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TeacherHomeworkListViewModel}}, Path=DeleteHomeworkCommand}"
                                    CommandParameter="{Binding .}"
                                    CornerRadius="6"
                                    FontSize="11"
                                    HeightRequest="34"
                                    Text="Delete"
                                    TextColor="White" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</views:ViewBase>
