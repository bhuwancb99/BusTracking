<?xml version="1.0" encoding="utf-8" ?>
<views:ViewBase
    x:Class="BusTracking.Mobile.Views.Teacher.TeacherDatesheetPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:exam="clr-namespace:BusTracking.Mobile.Models.Exam"
    xmlns:mct="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Toolkit.TextInputLayout;assembly=Syncfusion.Maui.Toolkit"
    xmlns:views="clr-namespace:BusTracking.Mobile.Views"
    xmlns:vm="clr-namespace:BusTracking.Mobile.Viewmodels.Teacher"
    Title="Exam Datesheets"
    x:DataType="vm:TeacherDatesheetViewModel"
    x:TypeArguments="vm:TeacherDatesheetViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBg},
                                      Dark={StaticResource PageBgDark}}">

    <views:ViewBase.Behaviors>
        <mct:StatusBarBehavior StatusBarColor="{AppThemeBinding Light={StaticResource LoginPageBgLight}, Dark={StaticResource LoginPageBgDark}}" StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}" />
    </views:ViewBase.Behaviors>

    <ScrollView Padding="10,12">
        <VerticalStackLayout Spacing="10">

            <!--  Header Banner Card  -->
            <Border
                Padding="12,10"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                  Dark={StaticResource CardBgDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                         Dark={StaticResource BorderColorDark}}"
                StrokeShape="RoundRectangle 12"
                StrokeThickness="1">
                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                    <Border
                        Padding="8"
                        BackgroundColor="{AppThemeBinding Light=#eff6ff,
                                                          Dark=#1e293b}"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 10"
                        VerticalOptions="Center">
                        <Image
                            HeightRequest="20"
                            Source="exam_datesheet.png"
                            WidthRequest="20">
                            <Image.Behaviors>
                                <mct:IconTintColorBehavior TintColor="#2563eb" />
                            </Image.Behaviors>
                        </Image>
                    </Border>

                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                        <Label
                            FontAttributes="Bold"
                            FontSize="15"
                            Text="Class Exam Datesheets"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                        Dark=White}" />
                        <Label
                            FontSize="12"
                            Text="Filter by Exam Term and Class to view timetables."
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                        Dark={StaticResource TextSecondaryDark}}" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>

            <!--  Filter Card with Proportional Inputs (Exam Term larger)  -->
            <Border
                Padding="6,2"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                  Dark={StaticResource CardBgDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                         Dark={StaticResource BorderColorDark}}"
                StrokeShape="RoundRectangle 12">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                    <syncfusion:SfTextInputLayout
                        Grid.Column="0"
                        Hint="Exam Term"
                        Style="{StaticResource AppOutlinedInputStyle}">
                        <Picker
                            Title="Select Term"
                            FontSize="13"
                            ItemDisplayBinding="{Binding TermName}"
                            ItemsSource="{Binding ExamTerms}"
                            SelectedItem="{Binding SelectedExamTerm, Mode=TwoWay}"
                            TextColor="{AppThemeBinding Light=#0f172a,
                                                        Dark=White}"
                            TitleColor="{AppThemeBinding Light=#94a3b8,
                                                         Dark=#64748b}" />
                    </syncfusion:SfTextInputLayout>

                    <syncfusion:SfTextInputLayout
                        Grid.Column="1"
                        Hint="Class / Standard"
                        Style="{StaticResource AppOutlinedInputStyle}">
                        <Picker
                            Title="Select Class"
                            FontSize="13"
                            ItemDisplayBinding="{Binding StandardName}"
                            ItemsSource="{Binding Standards}"
                            SelectedItem="{Binding SelectedStandard, Mode=TwoWay}"
                            TextColor="{AppThemeBinding Light=#0f172a,
                                                        Dark=White}"
                            TitleColor="{AppThemeBinding Light=#94a3b8,
                                                         Dark=#64748b}" />
                    </syncfusion:SfTextInputLayout>
                </Grid>
            </Border>

            <!--  Empty State Notice  -->
            <Border
                Padding="20"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                  Dark={StaticResource CardBgDark}}"
                IsVisible="{Binding HasSchedules, Converter={StaticResource InvertedBoolConverter}}"
                StrokeShape="RoundRectangle 12">
                <Label
                    FontSize="13"
                    HorizontalOptions="Center"
                    Text="No exam schedules available for the selected filters."
                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                Dark={StaticResource TextSecondaryDark}}" />
            </Border>

            <!--  Exam Timetable Schedule List  -->
            <VerticalStackLayout IsVisible="{Binding HasSchedules}" Spacing="8">
                <BindableLayout.ItemsSource>
                    <Binding Path="Schedules" />
                </BindableLayout.ItemsSource>

                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="exam:ExamScheduleItem">
                        <Border
                            Padding="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                              Dark={StaticResource CardBgDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                                     Dark={StaticResource BorderColorDark}}"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1">
                            <Grid ColumnDefinitions="4,*">
                                <!--  Left Accent Blue Bar  -->
                                <BoxView Grid.Column="0" Color="#2563eb" />

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Padding="12,10"
                                    Spacing="6">

                                    <!--  Top Row: Date with Day & Room Badge  -->
                                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                        <HorizontalStackLayout
                                            Grid.Column="0"
                                            Spacing="6"
                                            VerticalOptions="Center">
                                            <Image
                                                HeightRequest="14"
                                                Source="calendar_check.png"
                                                WidthRequest="14">
                                                <Image.Behaviors>
                                                    <mct:IconTintColorBehavior TintColor="#2563eb" />
                                                </Image.Behaviors>
                                            </Image>
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="13"
                                                Text="{Binding ExamDateDisplay}"
                                                TextColor="#2563eb"
                                                VerticalOptions="Center" />
                                        </HorizontalStackLayout>

                                        <!--  Room Badge  -->
                                        <Border
                                            Grid.Column="1"
                                            Padding="8,3"
                                            BackgroundColor="#0284c7"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 8">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="11"
                                                Text="{Binding RoomDisplay}"
                                                TextColor="White" />
                                        </Border>
                                    </Grid>

                                    <!--  Middle Row: Subject Name & Time  -->
                                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                        <Label
                                            Grid.Column="0"
                                            FontAttributes="Bold"
                                            FontSize="15"
                                            Text="{Binding SubjectName}"
                                            TextColor="{AppThemeBinding Light=#0f172a,
                                                                        Dark=White}" />

                                        <HorizontalStackLayout
                                            Grid.Column="1"
                                            Spacing="4"
                                            VerticalOptions="Center">
                                            <Label
                                                FontSize="12"
                                                Text="🕒"
                                                VerticalOptions="Center" />
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="12"
                                                Text="{Binding TimeDisplay}"
                                                TextColor="{AppThemeBinding Light=#475569,
                                                                            Dark=#94a3b8}"
                                                VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Grid>

                                    <!--  Bottom Row: Marks Pills  -->
                                    <HorizontalStackLayout Spacing="8">
                                        <Border
                                            Padding="8,3"
                                            BackgroundColor="{AppThemeBinding Light=#e0f2fe,
                                                                              Dark=#075985}"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 6">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="11"
                                                Text="{Binding MaxMarks, StringFormat='Max Marks: {0:0.##}'}"
                                                TextColor="{AppThemeBinding Light=#0369a1,
                                                                            Dark=#bae6fd}" />
                                        </Border>

                                        <Border
                                            Padding="8,3"
                                            BackgroundColor="{AppThemeBinding Light=#dcfce7,
                                                                              Dark=#166534}"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 6">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="11"
                                                Text="{Binding PassMarks, StringFormat='Pass Marks: {0:0.##}'}"
                                                TextColor="{AppThemeBinding Light=#15803d,
                                                                            Dark=#bbf7d0}" />
                                        </Border>
                                    </HorizontalStackLayout>

                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</views:ViewBase>
