<?xml version="1.0" encoding="utf-8" ?>
<views:ViewBase
    x:Class="BusTracking.Mobile.Views.Teacher.TeacherDashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mct="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"
    xmlns:views="clr-namespace:BusTracking.Mobile.Views"
    xmlns:vm="clr-namespace:BusTracking.Mobile.Viewmodels.Teacher"
    Title="Teacher Dashboard"
    x:DataType="vm:TeacherDashboardViewModel"
    x:TypeArguments="vm:TeacherDashboardViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBg},
                                      Dark={StaticResource PageBgDark}}">

    <views:ViewBase.Behaviors>
        <mct:StatusBarBehavior StatusBarColor="{AppThemeBinding Light={StaticResource LoginPageBgLight}, Dark={StaticResource LoginPageBgDark}}" StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}" />
    </views:ViewBase.Behaviors>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">
            <!--  Welcome Header Card  -->
            <Border
                Padding="20"
                Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                         Dark={StaticResource BorderColorDark}}"
                StrokeShape="RoundRectangle 16"
                StrokeThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0.0" Color="{AppThemeBinding Light=#1e3a8a, Dark=#0f172a}" />
                        <GradientStop Offset="1.0" Color="{AppThemeBinding Light=#3b82f6, Dark=#1e293b}" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        FontSize="14"
                        Text="{Binding GreetingMessage}"
                        TextColor="#93c5fd" />
                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        FontAttributes="Bold"
                        FontSize="22"
                        Text="{Binding Profile.FullName, FallbackValue='Teacher'}"
                        TextColor="White" />
                    <Label
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="0,4,0,0"
                        FontSize="13"
                        Text="{Binding Profile.DesignationDisplay, FallbackValue='Faculty Member'}"
                        TextColor="#cbd5e1" />

                    <Button
                        Grid.Row="0"
                        Grid.RowSpan="3"
                        Grid.Column="1"
                        Padding="16,0"
                        BackgroundColor="#ffffff"
                        Command="{Binding GoToProfileCommand}"
                        CornerRadius="20"
                        FontAttributes="Bold"
                        HeightRequest="38"
                        Text="Profile"
                        TextColor="#1e3a8a"
                        VerticalOptions="Center" />
                </Grid>
            </Border>

            <!--  Quick Details Card  -->
            <Border
                Padding="20"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                  Dark={StaticResource CardBgDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                         Dark={StaticResource BorderColorDark}}"
                StrokeShape="RoundRectangle 16"
                StrokeThickness="1">
                <VerticalStackLayout Spacing="12">
                    <Label
                        FontAttributes="Bold"
                        FontSize="16"
                        Text="Academic Overview"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                    Dark={StaticResource TextPrimaryDark}}" />
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource BorderColorDark}}" />

                    <Grid
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="12"
                        RowDefinitions="Auto,Auto,Auto,Auto"
                        RowSpacing="10">
                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            FontAttributes="Bold"
                            Text="Employee Code:"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                        Dark={StaticResource TextSecondaryDark}}" />
                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            Text="{Binding Profile.EmployeeCode, FallbackValue='–'}"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                        Dark={StaticResource TextPrimaryDark}}" />

                        <Label
                            Grid.Row="1"
                            Grid.Column="0"
                            FontAttributes="Bold"
                            Text="Department:"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                        Dark={StaticResource TextSecondaryDark}}" />
                        <Label
                            Grid.Row="1"
                            Grid.Column="1"
                            Text="{Binding Profile.DepartmentDisplay, FallbackValue='–'}"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                        Dark={StaticResource TextPrimaryDark}}" />

                        <Label
                            Grid.Row="2"
                            Grid.Column="0"
                            FontAttributes="Bold"
                            Text="Qualification:"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                        Dark={StaticResource TextSecondaryDark}}" />
                        <Label
                            Grid.Row="2"
                            Grid.Column="1"
                            Text="{Binding Profile.Qualification, FallbackValue='–'}"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                        Dark={StaticResource TextPrimaryDark}}" />

                        <Label
                            Grid.Row="3"
                            Grid.Column="0"
                            FontAttributes="Bold"
                            Text="Email Address:"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                        Dark={StaticResource TextSecondaryDark}}" />
                        <Label
                            Grid.Row="3"
                            Grid.Column="1"
                            Text="{Binding Profile.Email, FallbackValue='–'}"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                        Dark={StaticResource TextPrimaryDark}}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</views:ViewBase>
