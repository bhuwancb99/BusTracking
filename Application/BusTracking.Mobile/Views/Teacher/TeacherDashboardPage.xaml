<?xml version="1.0" encoding="utf-8" ?>
<views:ViewBase
    x:Class="BusTracking.Mobile.Views.Teacher.TeacherDashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mct="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"
    xmlns:views="clr-namespace:BusTracking.Mobile.Views"
    xmlns:vm="clr-namespace:BusTracking.Mobile.Viewmodels.Teacher"
    Title="Teacher Portal"
    x:DataType="vm:TeacherDashboardViewModel"
    x:TypeArguments="vm:TeacherDashboardViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBg},
                                      Dark={StaticResource PageBgDark}}">

    <views:ViewBase.Behaviors>
        <mct:StatusBarBehavior StatusBarColor="{AppThemeBinding Light={StaticResource LoginPageBgLight}, Dark={StaticResource LoginPageBgDark}}" StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}" />
    </views:ViewBase.Behaviors>

    <Shell.TitleView>
        <Grid Padding="0,0,10,0" ColumnDefinitions="*,Auto">
            <Label
                Grid.Column="0"
                FontAttributes="Bold"
                FontSize="18"
                Text="Teacher Portal"
                TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                            Dark=White}"
                VerticalOptions="Center" />
            <Grid
                Grid.Column="1"
                HeightRequest="32"
                HorizontalOptions="End"
                VerticalOptions="Center"
                WidthRequest="32">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToNotificationCommand}" />
                </Grid.GestureRecognizers>
                <Image
                    Aspect="AspectFit"
                    HeightRequest="22"
                    HorizontalOptions="Center"
                    Source="notification.png"
                    VerticalOptions="Center"
                    WidthRequest="22">
                    <Image.Behaviors>
                        <mct:IconTintColorBehavior TintColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark=White}" />
                    </Image.Behaviors>
                </Image>
            </Grid>
        </Grid>
    </Shell.TitleView>

    <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
        <ScrollView>
            <VerticalStackLayout Padding="16,20,16,40" Spacing="16">

                <!--  Notification Permission Warning Card  -->
                <Border
                    Padding="14,12"
                    BackgroundColor="{AppThemeBinding Light=#FEF2F2,
                                                      Dark=#2C1414}"
                    IsVisible="{Binding IsNotificationPermissionDenied}"
                    Stroke="{AppThemeBinding Light=#FCA5A5,
                                             Dark=#7F1D1D}"
                    StrokeShape="RoundRectangle 14"
                    StrokeThickness="1">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenNotificationSettingsCommand}" />
                    </Border.GestureRecognizers>
                    <Grid
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="12"
                        VerticalOptions="Center">
                        <Border
                            Grid.Column="0"
                            BackgroundColor="{AppThemeBinding Light=#FEE2E2,
                                                              Dark=#450A0A}"
                            HeightRequest="36"
                            StrokeShape="RoundRectangle 18"
                            StrokeThickness="0"
                            WidthRequest="36">
                            <Image
                                HeightRequest="20"
                                HorizontalOptions="Center"
                                Source="notification_warning.png"
                                VerticalOptions="Center"
                                WidthRequest="20" />
                        </Border>
                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="2"
                            VerticalOptions="Center">
                            <Label
                                FontAttributes="Bold"
                                FontSize="13"
                                Text="Notification Permission Disabled"
                                TextColor="{AppThemeBinding Light=#991B1B,
                                                            Dark=#FCA5A5}" />
                            <Label
                                FontSize="11"
                                Text="Enable notifications to receive important school &amp; trip updates."
                                TextColor="{AppThemeBinding Light=#B91C1C,
                                                            Dark=#F87171}" />
                        </VerticalStackLayout>
                        <Button
                            Grid.Column="2"
                            Padding="12,0"
                            BackgroundColor="#EF4444"
                            Command="{Binding OpenNotificationSettingsCommand}"
                            CornerRadius="10"
                            FontAttributes="Bold"
                            FontSize="11"
                            HeightRequest="34"
                            Text="Enable ➔"
                            TextColor="White"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!--  Welcome Header  -->
                <VerticalStackLayout Spacing="4">
                    <Label Style="{StaticResource HeadingLabel}" Text="{Binding WelcomeText}" />
                    <Label Style="{StaticResource SubLabel}" Text="{Binding TodayDate}" />
                </VerticalStackLayout>

                <!--  Hero Teacher Profile Card  -->
                <Border Style="{StaticResource StatCardBorder}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0.0" Color="{AppThemeBinding Light={StaticResource DrawerItemActiveLight}, Dark=#0c1f4e}" />
                            <GradientStop Offset="1.0" Color="{AppThemeBinding Light={StaticResource CardBg}, Dark={StaticResource CardBgDark}}" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid
                        Padding="4,2"
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="14"
                        VerticalOptions="Center">
                        <!--  Initials / Avatar Circle  -->
                        <Border
                            Grid.Column="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Primary},
                                                              Dark={StaticResource PrimaryDark}}"
                            HeightRequest="52"
                            HorizontalOptions="Center"
                            StrokeShape="RoundRectangle 26"
                            StrokeThickness="0"
                            VerticalOptions="Center"
                            WidthRequest="52">
                            <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                HorizontalOptions="Center"
                                Text="{Binding Profile.InitialsDisplay}"
                                TextColor="White"
                                VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="2"
                            VerticalOptions="Center">
                            <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                Text="{Binding Profile.FullName, FallbackValue='Teacher'}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                            Dark=White}" />
                            <Label
                                FontSize="13"
                                Text="{Binding Profile.DesignationDisplay, FallbackValue='Faculty Member'}"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                            Dark={StaticResource TextSecondaryDark}}" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="12"
                                Text="{Binding Profile.DepartmentDisplay, FallbackValue='General'}"
                                TextColor="{StaticResource Primary}" />
                        </VerticalStackLayout>

                        <Button
                            Grid.Column="2"
                            Padding="14,0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Primary},
                                                              Dark={StaticResource PrimaryDark}}"
                            Command="{Binding GoToProfileCommand}"
                            CornerRadius="16"
                            FontAttributes="Bold"
                            FontSize="12"
                            HeightRequest="36"
                            Text="Profile"
                            TextColor="White"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!--  Academic Details Card  -->
                <Border Style="{StaticResource StatCardBorder}">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <Label
                                Grid.Column="0"
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="Academic Overview"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                            Dark=White}" />
                            <Border
                                Grid.Column="1"
                                Padding="8,4"
                                BackgroundColor="{Binding Profile.StatusBgColor}"
                                StrokeShape="RoundRectangle 8"
                                StrokeThickness="0">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="11"
                                    Text="{Binding Profile.StatusLabel}"
                                    TextColor="{Binding Profile.StatusTextColor}" />
                            </Border>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource BorderColorDark}}" />

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="14"
                            RowDefinitions="Auto,Auto,Auto,Auto"
                            RowSpacing="12">
                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                FontAttributes="Bold"
                                FontSize="13"
                                Text="Employee Code:"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                            Dark={StaticResource TextSecondaryDark}}" />
                            <Label
                                Grid.Row="0"
                                Grid.Column="1"
                                FontAttributes="Bold"
                                FontSize="13"
                                Text="{Binding Profile.EmployeeCode, FallbackValue='–'}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                            Dark=White}" />

                            <Label
                                Grid.Row="1"
                                Grid.Column="0"
                                FontAttributes="Bold"
                                FontSize="13"
                                Text="Department:"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                            Dark={StaticResource TextSecondaryDark}}" />
                            <Label
                                Grid.Row="1"
                                Grid.Column="1"
                                FontSize="13"
                                Text="{Binding Profile.DepartmentDisplay, FallbackValue='–'}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                            Dark=White}" />

                            <Label
                                Grid.Row="2"
                                Grid.Column="0"
                                FontAttributes="Bold"
                                FontSize="13"
                                Text="Qualification:"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                            Dark={StaticResource TextSecondaryDark}}" />
                            <Label
                                Grid.Row="2"
                                Grid.Column="1"
                                FontSize="13"
                                Text="{Binding Profile.Qualification, FallbackValue='–'}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                            Dark=White}" />

                            <Label
                                Grid.Row="3"
                                Grid.Column="0"
                                FontAttributes="Bold"
                                FontSize="13"
                                Text="Email Address:"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                            Dark={StaticResource TextSecondaryDark}}" />
                            <Label
                                Grid.Row="3"
                                Grid.Column="1"
                                FontSize="13"
                                LineBreakMode="TailTruncation"
                                Text="{Binding Profile.Email, FallbackValue='–'}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                            Dark=White}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!--  Quick Action Cards (Bento Grid)  -->
                <Label
                    Margin="0,4,0,0"
                    FontAttributes="Bold"
                    FontSize="16"
                    Text="Quick Actions"
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                Dark=White}" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <!--  Card 1: Profile  -->
                    <Border
                        Grid.Column="0"
                        Padding="14,12"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                          Dark={StaticResource CardBgDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                                 Dark={StaticResource BorderColorDark}}"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="1">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToProfileCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="6">
                            <Border
                                BackgroundColor="{AppThemeBinding Light=#e0e7ff,
                                                                  Dark=#1e293b}"
                                HeightRequest="36"
                                HorizontalOptions="Start"
                                StrokeShape="RoundRectangle 18"
                                StrokeThickness="0"
                                WidthRequest="36">
                                <Image
                                    HeightRequest="18"
                                    HorizontalOptions="Center"
                                    Source="profile.png"
                                    VerticalOptions="Center"
                                    WidthRequest="18">
                                    <Image.Behaviors>
                                        <mct:IconTintColorBehavior TintColor="{StaticResource Primary}" />
                                    </Image.Behaviors>
                                </Image>
                            </Border>
                            <Label
                                FontAttributes="Bold"
                                FontSize="14"
                                Text="My Profile"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                            Dark=White}" />
                            <Label
                                FontSize="11"
                                LineBreakMode="TailTruncation"
                                MaxLines="2"
                                Text="View and manage profile settings"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                            Dark={StaticResource TextSecondaryDark}}" />
                        </VerticalStackLayout>
                    </Border>

                    <!--  Card 2: Notifications  -->
                    <Border
                        Grid.Column="1"
                        Padding="14,12"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                          Dark={StaticResource CardBgDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                                 Dark={StaticResource BorderColorDark}}"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="1">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToNotificationCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="6">
                            <Border
                                BackgroundColor="{AppThemeBinding Light=#dbeafe,
                                                                  Dark=#1e293b}"
                                HeightRequest="36"
                                HorizontalOptions="Start"
                                StrokeShape="RoundRectangle 18"
                                StrokeThickness="0"
                                WidthRequest="36">
                                <Image
                                    HeightRequest="18"
                                    HorizontalOptions="Center"
                                    Source="notification.png"
                                    VerticalOptions="Center"
                                    WidthRequest="18">
                                    <Image.Behaviors>
                                        <mct:IconTintColorBehavior TintColor="#0284c7" />
                                    </Image.Behaviors>
                                </Image>
                            </Border>
                            <Label
                                FontAttributes="Bold"
                                FontSize="14"
                                Text="Notifications"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                            Dark=White}" />
                            <Label
                                FontSize="11"
                                LineBreakMode="TailTruncation"
                                MaxLines="2"
                                Text="Check announcements &amp; alerts"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                            Dark={StaticResource TextSecondaryDark}}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</views:ViewBase>
