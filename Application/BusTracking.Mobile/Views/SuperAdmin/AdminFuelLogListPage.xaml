<?xml version="1.0" encoding="utf-8" ?>
<views:ViewBase
    x:Class="BusTracking.Mobile.Views.SuperAdmin.AdminFuelLogListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:fuelModel="clr-namespace:BusTracking.Mobile.Models.FuelLog"
    xmlns:mct="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"
    xmlns:views="clr-namespace:BusTracking.Mobile.Views"
    xmlns:vm="clr-namespace:BusTracking.Mobile.Viewmodels.SuperAdmin"
    x:DataType="vm:AdminFuelLogListViewModel"
    x:TypeArguments="vm:AdminFuelLogListViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBg},
                                      Dark={StaticResource PageBgDark}}">

    <views:ViewBase.Behaviors>
        <mct:StatusBarBehavior StatusBarColor="{AppThemeBinding Light={StaticResource LoginPageBgLight}, Dark={StaticResource LoginPageBgDark}}" StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}" />
    </views:ViewBase.Behaviors>

    <Shell.TitleView>
        <Grid Padding="0,0,8,0" ColumnDefinitions="*,Auto">
            <Label
                Grid.Column="0"
                FontAttributes="Bold"
                FontSize="18"
                Text="Fuel &amp; Mileage Logs"
                TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                            Dark=White}"
                VerticalOptions="Center" />
            <Border
                Grid.Column="1"
                Padding="8"
                BackgroundColor="White"
                IsVisible="{Binding CanAdd}"
                StrokeShape="RoundRectangle 20"
                StrokeThickness="0"
                VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AddCommand}" />
                </Border.GestureRecognizers>
                <Image
                    HeightRequest="20"
                    Source="add.png"
                    WidthRequest="20">
                    <Image.Behaviors>
                        <mct:IconTintColorBehavior TintColor="{StaticResource Primary}" />
                    </Image.Behaviors>
                </Image>
            </Border>
        </Grid>
    </Shell.TitleView>

    <Grid RowDefinitions="Auto,*">
        <!--  Error Banner  -->
        <Border
            Grid.Row="0"
            Margin="5,8"
            IsVisible="{Binding HasError}"
            Style="{StaticResource ErrorBannerBorder}">
            <Label
                FontSize="13"
                Text="{Binding ErrorMessage}"
                TextColor="{AppThemeBinding Light={StaticResource ErrorTextLight},
                                            Dark={StaticResource ErrorTextDark}}" />
        </Border>

        <!--  Empty State  -->
        <VerticalStackLayout
            Grid.Row="1"
            HorizontalOptions="Center"
            IsVisible="{Binding IsEmpty}"
            Spacing="14"
            VerticalOptions="Center">
            <Border
                BackgroundColor="{AppThemeBinding Light={StaticResource StatBusBg},
                                                  Dark={StaticResource StatBusBgDark}}"
                HeightRequest="72"
                HorizontalOptions="Center"
                StrokeShape="RoundRectangle 36"
                StrokeThickness="0"
                WidthRequest="72">
                <Image
                    HeightRequest="36"
                    HorizontalOptions="Center"
                    Source="fuel_pump.png"
                    VerticalOptions="Center"
                    WidthRequest="36">
                    <Image.Behaviors>
                        <mct:IconTintColorBehavior TintColor="{StaticResource Primary}" />
                    </Image.Behaviors>
                </Image>
            </Border>
            <Label
                FontSize="16"
                HorizontalOptions="Center"
                Text="No fuel logs found"
                TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                            Dark={StaticResource TextSecondaryDark}}" />
            <Button
                Padding="24,0"
                Command="{Binding AddCommand}"
                HorizontalOptions="Center"
                IsVisible="{Binding CanAdd}"
                Style="{StaticResource PrimaryButton}"
                Text="+ Add Fuel Log" />
        </VerticalStackLayout>

        <!--  List  -->
        <RefreshView
            Grid.Row="1"
            Margin="5,4,5,0"
            Command="{Binding RefreshCommand}"
            IsRefreshing="{Binding IsRefreshing}">
            <CollectionView ItemsSource="{Binding Items}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="fuelModel:FuelLogItem">
                        <Border Style="{StaticResource ListItemBorder}">
                            <Grid
                                Padding="14"
                                ColumnDefinitions="Auto,*,Auto"
                                ColumnSpacing="12">
                                <Border
                                    Grid.Column="0"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource StatBusBg},
                                                                      Dark={StaticResource StatBusBgDark}}"
                                    Style="{StaticResource IconTileBorder}"
                                    VerticalOptions="Center">
                                    <Image
                                        HeightRequest="22"
                                        HorizontalOptions="Center"
                                        Source="fuel_pump.png"
                                        VerticalOptions="Center"
                                        WidthRequest="22">
                                        <Image.Behaviors>
                                            <mct:IconTintColorBehavior TintColor="{StaticResource Primary}" />
                                        </Image.Behaviors>
                                    </Image>
                                </Border>
                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="4"
                                    VerticalOptions="Center">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="15"
                                        Text="{Binding BusNumber, StringFormat='Bus: {0}'}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                                    Dark={StaticResource TextPrimaryDark}}" />
                                    <Label FontSize="12">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="Date: " TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextSecondaryDark}}" />
                                                <Span
                                                    FontAttributes="Bold"
                                                    Text="{Binding FuelDate}"
                                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                                                Dark={StaticResource TextPrimaryDark}}" />
                                                <Span Text="  •  Odometer: " TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextSecondaryDark}}" />
                                                <Span Text="{Binding OdometerReading, StringFormat='{0:N0} km'}" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label FontSize="12">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="Fuel: " TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextSecondaryDark}}" />
                                                <Span
                                                    FontAttributes="Bold"
                                                    Text="{Binding FuelLiters, StringFormat='{0:N2} L'}"
                                                    TextColor="{StaticResource Success}" />
                                                <Span Text="  •  Cost: " TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextSecondaryDark}}" />
                                                <Span
                                                    FontAttributes="Bold"
                                                    Text="{Binding TotalCost, StringFormat='{0:N2}'}"
                                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                                                Dark={StaticResource TextPrimaryDark}}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>
                                <Border
                                    Grid.Column="2"
                                    BackgroundColor="Transparent"
                                    HeightRequest="36"
                                    HorizontalOptions="End"
                                    StrokeShape="RoundRectangle 18"
                                    StrokeThickness="0"
                                    VerticalOptions="Center"
                                    WidthRequest="36">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminFuelLogListViewModel}}, Path=EditCommand}" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Image
                                        HeightRequest="20"
                                        HorizontalOptions="Center"
                                        Source="edit.png"
                                        VerticalOptions="Center"
                                        WidthRequest="20">
                                        <Image.Behaviors>
                                            <mct:IconTintColorBehavior TintColor="{StaticResource Primary}" />
                                        </Image.Behaviors>
                                    </Image>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</views:ViewBase>
