<?xml version="1.0" encoding="utf-8" ?>
<views:ViewBase
    x:Class="BusTracking.Mobile.Views.SuperAdmin.AdminExamDatesheetPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mct="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"
    xmlns:models="clr-namespace:BusTracking.Mobile.Models.Exam"
    xmlns:views="clr-namespace:BusTracking.Mobile.Views"
    xmlns:vm="clr-namespace:BusTracking.Mobile.Viewmodels.SuperAdmin"
    Title="Exam Datesheet Scheduling"
    x:DataType="vm:AdminExamDatesheetViewModel"
    x:TypeArguments="vm:AdminExamDatesheetViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBg},
                                      Dark={StaticResource PageBgDark}}">

    <views:ViewBase.Behaviors>
        <mct:StatusBarBehavior StatusBarColor="{AppThemeBinding Light={StaticResource LoginPageBgLight}, Dark={StaticResource LoginPageBgDark}}" StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}" />
    </views:ViewBase.Behaviors>

    <Shell.TitleView>
        <Grid Padding="0,0,8,0" ColumnDefinitions="*,Auto">
            <Label
                Grid.Column="0"
                FontAttributes="Bold"
                FontSize="18"
                Text="Exam Datesheets"
                TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                            Dark=White}"
                VerticalOptions="Center" />
            <Border
                Grid.Column="1"
                Padding="8"
                BackgroundColor="White"
                StrokeShape="RoundRectangle 20"
                StrokeThickness="0"
                VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AddScheduleCommand}" />
                </Border.GestureRecognizers>
                <Image
                    HeightRequest="20"
                    Source="add.png"
                    WidthRequest="20">
                    <Image.Behaviors>
                        <mct:IconTintColorBehavior TintColor="{StaticResource Primary}" />
                    </Image.Behaviors>
                </Image>
            </Border>
        </Grid>
    </Shell.TitleView>

    <Grid RowDefinitions="Auto,*">

        <!--  Filter Section  -->
        <VerticalStackLayout
            Grid.Row="0"
            Padding="14,12,14,6"
            Spacing="8">
            <!--  Header Section matching Web UI  -->
            <Border
                Padding="12,10"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                  Dark={StaticResource CardBgDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                         Dark={StaticResource BorderColorDark}}"
                StrokeShape="RoundRectangle 12"
                StrokeThickness="1">
                <VerticalStackLayout Spacing="2">
                    <Label
                        FontAttributes="Bold"
                        FontSize="15"
                        Text="Exam Datesheet Scheduling"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                    Dark=White}" />
                    <Label
                        FontSize="12"
                        Text="Schedule subject exam dates, times, rooms, and maximum marks per class standard."
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                    Dark={StaticResource TextSecondaryDark}}" />
                </VerticalStackLayout>
            </Border>

            <!--  Error Banner  -->
            <Border IsVisible="{Binding HasError}" Style="{StaticResource ErrorBannerBorder}">
                <Label
                    FontSize="13"
                    Text="{Binding ErrorMessage}"
                    TextColor="{AppThemeBinding Light={StaticResource ErrorTextLight},
                                                Dark={StaticResource ErrorTextDark}}" />
            </Border>

            <!--  Filters Card (Exam Term & Class / Standard Pickers)  -->
            <Border
                Padding="12,8"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                  Dark={StaticResource CardBgDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                         Dark={StaticResource BorderColorDark}}"
                StrokeShape="RoundRectangle 12"
                StrokeThickness="1">
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="Auto,*" VerticalOptions="Center">
                        <Label
                            Grid.Column="0"
                            FontAttributes="Bold"
                            FontSize="13"
                            Text="Exam Term:"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                        Dark={StaticResource TextSecondaryDark}}"
                            VerticalOptions="Center" />
                        <Picker
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            ItemDisplayBinding="{Binding TermName}"
                            ItemsSource="{Binding ExamTerms}"
                            SelectedItem="{Binding SelectedExamTerm}"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                        Dark=White}"
                            VerticalOptions="Center" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" VerticalOptions="Center">
                        <Label
                            Grid.Column="0"
                            FontAttributes="Bold"
                            FontSize="13"
                            Text="Class / Standard:"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                        Dark={StaticResource TextSecondaryDark}}"
                            VerticalOptions="Center" />
                        <Picker
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            ItemDisplayBinding="{Binding StandardName}"
                            ItemsSource="{Binding Standards}"
                            SelectedItem="{Binding SelectedStandard}"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                        Dark=White}"
                            VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <!--  Schedules CollectionView  -->
        <RefreshView
            Grid.Row="1"
            Command="{Binding LoadSchedulesCommand}"
            IsRefreshing="{Binding IsRefreshing}">
            <CollectionView ItemsSource="{Binding Schedules}">
                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        Padding="30"
                        HorizontalOptions="Center"
                        Spacing="12"
                        VerticalOptions="Center">
                        <Image
                            HeightRequest="56"
                            Source="exam_datesheet.png"
                            WidthRequest="56">
                            <Image.Behaviors>
                                <mct:IconTintColorBehavior TintColor="{StaticResource TextMuted}" />
                            </Image.Behaviors>
                        </Image>
                        <Label
                            FontAttributes="Bold"
                            FontSize="15"
                            HorizontalOptions="Center"
                            Text="No Exam Schedules Found"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                        Dark=White}" />
                        <Label
                            FontSize="12"
                            HorizontalOptions="Center"
                            Text="Tap + button to add exam to datesheet"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                        Dark={StaticResource TextSecondaryDark}}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ExamScheduleItem">
                        <Border
                            Margin="14,0,14,8"
                            Padding="12,10"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                              Dark={StaticResource CardBgDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                                     Dark={StaticResource BorderColorDark}}"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1">
                            <VerticalStackLayout Spacing="6">

                                <!--  Date & Room Header Row  -->
                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                    <HorizontalStackLayout
                                        Grid.Column="0"
                                        Spacing="6"
                                        VerticalOptions="Center">
                                        <Image
                                            HeightRequest="15"
                                            Source="calendar_check.png"
                                            VerticalOptions="Center"
                                            WidthRequest="15">
                                            <Image.Behaviors>
                                                <mct:IconTintColorBehavior TintColor="{StaticResource Primary}" />
                                            </Image.Behaviors>
                                        </Image>
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="14"
                                            Text="{Binding ExamDateDisplay}"
                                            TextColor="{StaticResource Primary}"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                    <Border
                                        Grid.Column="1"
                                        Padding="8,3"
                                        BackgroundColor="{AppThemeBinding Light=#E0F2FE,
                                                                          Dark=#075985}"
                                        HorizontalOptions="End"
                                        StrokeShape="RoundRectangle 8"
                                        StrokeThickness="0"
                                        VerticalOptions="Center">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="11"
                                            Text="{Binding RoomDisplay}"
                                            TextColor="{AppThemeBinding Light=#0284C7,
                                                                        Dark=#38BDF8}"
                                            VerticalOptions="Center" />
                                    </Border>
                                </Grid>

                                <!--  Subject & Time  -->
                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                    <Label
                                        Grid.Column="0"
                                        FontAttributes="Bold"
                                        FontSize="15"
                                        Text="{Binding SubjectName}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                                    Dark=White}"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="1"
                                        FontAttributes="Bold"
                                        FontSize="12"
                                        Text="{Binding TimeDisplay}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                                    Dark={StaticResource TextSecondaryDark}}"
                                        VerticalOptions="Center" />
                                </Grid>

                                <!--  Badges: Term & Class / Section  -->
                                <HorizontalStackLayout Spacing="6">
                                    <Border
                                        Padding="6,2"
                                        BackgroundColor="{AppThemeBinding Light=#F1F5F9,
                                                                          Dark=#1E293B}"
                                        StrokeShape="RoundRectangle 6"
                                        StrokeThickness="0">
                                        <Label
                                            FontSize="11"
                                            Text="{Binding TermName}"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                                        Dark={StaticResource TextSecondaryDark}}" />
                                    </Border>

                                    <Border
                                        Padding="6,2"
                                        BackgroundColor="{AppThemeBinding Light=#F1F5F9,
                                                                          Dark=#1E293B}"
                                        StrokeShape="RoundRectangle 6"
                                        StrokeThickness="0">
                                        <Label
                                            FontSize="11"
                                            Text="{Binding StandardName}"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                                        Dark={StaticResource TextSecondaryDark}}" />
                                    </Border>

                                    <Border
                                        Padding="6,2"
                                        BackgroundColor="{AppThemeBinding Light=#F1F5F9,
                                                                          Dark=#1E293B}"
                                        StrokeShape="RoundRectangle 6"
                                        StrokeThickness="0">
                                        <Label
                                            FontSize="11"
                                            Text="{Binding SectionName}"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                                        Dark={StaticResource TextSecondaryDark}}" />
                                    </Border>
                                </HorizontalStackLayout>

                                <!--  Marks & Image Action Icons  -->
                                <Grid
                                    ColumnDefinitions="*,Auto"
                                    ColumnSpacing="8"
                                    VerticalOptions="Center">
                                    <Label
                                        Grid.Column="0"
                                        FontAttributes="Bold"
                                        FontSize="12"
                                        Text="{Binding MarksDisplay}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                                    Dark={StaticResource TextSecondaryDark}}"
                                        VerticalOptions="Center" />

                                    <HorizontalStackLayout
                                        Grid.Column="1"
                                        Spacing="8"
                                        VerticalOptions="Center">
                                        <!--  Edit Icon Button  -->
                                        <Border
                                            Padding="6"
                                            BackgroundColor="{AppThemeBinding Light=#EFF6FF,
                                                                              Dark=#1E3A8A}"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 6"
                                            VerticalOptions="Center">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminExamDatesheetViewModel}}, Path=EditScheduleCommand}" CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Image
                                                HeightRequest="15"
                                                Source="edit.png"
                                                WidthRequest="15">
                                                <Image.Behaviors>
                                                    <mct:IconTintColorBehavior TintColor="{StaticResource Primary}" />
                                                </Image.Behaviors>
                                            </Image>
                                        </Border>

                                        <!--  Delete Icon Button  -->
                                        <Border
                                            Padding="6"
                                            BackgroundColor="{AppThemeBinding Light=#FEF2F2,
                                                                              Dark=#7F1D1D}"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 6"
                                            VerticalOptions="Center">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminExamDatesheetViewModel}}, Path=DeleteScheduleCommand}" CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Image
                                                HeightRequest="15"
                                                Source="delete.png"
                                                WidthRequest="15">
                                                <Image.Behaviors>
                                                    <mct:IconTintColorBehavior TintColor="{StaticResource Danger}" />
                                                </Image.Behaviors>
                                            </Image>
                                        </Border>
                                    </HorizontalStackLayout>
                                </Grid>

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>
</views:ViewBase>
