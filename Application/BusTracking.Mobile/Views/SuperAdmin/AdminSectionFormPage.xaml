<?xml version="1.0" encoding="utf-8" ?>
<views:ViewBase
    x:Class="BusTracking.Mobile.Views.SuperAdmin.AdminSectionFormPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:BusTracking.Mobile.Views"
    xmlns:vm="clr-namespace:BusTracking.Mobile.Viewmodels.SuperAdmin"
    x:DataType="vm:AdminSectionFormViewModel"
    x:TypeArguments="vm:AdminSectionFormViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBg},
                                      Dark={StaticResource PageBgDark}}">

    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="16">
            <Border
                Padding="16"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                  Dark={StaticResource CardBgDark}}"
                StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="14">
                    <Label
                        FontAttributes="Bold"
                        FontSize="14"
                        Text="Standard / Class" />
                    <Entry
                        BackgroundColor="{AppThemeBinding Light=#f1f5f9,
                                                          Dark=#1e293b}"
                        IsReadOnly="True"
                        Text="{Binding StandardName}" />

                    <Label
                        FontAttributes="Bold"
                        FontSize="14"
                        Text="Section Name *" />
                    <Entry Placeholder="e.g. B, C, D" Text="{Binding SectionName}" />

                    <Label
                        FontAttributes="Bold"
                        FontSize="14"
                        Text="Class Teacher (Optional)" />
                    <Picker
                        Title="-- Select Class Teacher --"
                        ItemDisplayBinding="{Binding FullName}"
                        ItemsSource="{Binding Teachers}"
                        SelectedItem="{Binding SelectedTeacher}" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button
                    Grid.Column="0"
                    BackgroundColor="{StaticResource BorderColor}"
                    Command="{Binding CancelCommand}"
                    Text="Cancel"
                    TextColor="{StaticResource TextPrimary}" />
                <Button
                    Grid.Column="1"
                    BackgroundColor="{StaticResource Primary}"
                    Command="{Binding SaveCommand}"
                    Text="Save"
                    TextColor="White" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</views:ViewBase>
