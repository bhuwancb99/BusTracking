<?xml version="1.0" encoding="utf-8" ?>
<views:ViewBase
    x:Class="BusTracking.Mobile.Views.SuperAdmin.AdminSubjectFormPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:BusTracking.Mobile.Views"
    xmlns:vm="clr-namespace:BusTracking.Mobile.Viewmodels.SuperAdmin"
    x:DataType="vm:AdminSubjectFormViewModel"
    x:TypeArguments="vm:AdminSubjectFormViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBg},
                                      Dark={StaticResource PageBgDark}}">

    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="16">
            <Border
                Padding="16"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                  Dark={StaticResource CardBgDark}}"
                StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="14">
                    <Label
                        FontAttributes="Bold"
                        FontSize="14"
                        Text="Subject Name *" />
                    <Entry Placeholder="e.g. Mathematics" Text="{Binding SubjectName}" />

                    <Label
                        FontAttributes="Bold"
                        FontSize="14"
                        Text="Subject Code (Optional)" />
                    <Entry Placeholder="e.g. MATH101" Text="{Binding SubjectCode}" />

                    <HorizontalStackLayout
                        IsVisible="{Binding IsEditMode}"
                        Spacing="12"
                        VerticalOptions="Center">
                        <Switch IsToggled="{Binding IsActive}" />
                        <Label
                            FontAttributes="Bold"
                            Text="Active Status"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button
                    Grid.Column="0"
                    BackgroundColor="{StaticResource BorderColor}"
                    Command="{Binding CancelCommand}"
                    Text="Cancel"
                    TextColor="{StaticResource TextPrimary}" />
                <Button
                    Grid.Column="1"
                    BackgroundColor="{StaticResource Primary}"
                    Command="{Binding SaveCommand}"
                    Text="Save"
                    TextColor="White" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</views:ViewBase>
