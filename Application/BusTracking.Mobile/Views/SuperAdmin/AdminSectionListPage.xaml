<?xml version="1.0" encoding="utf-8" ?>
<views:ViewBase
    x:Class="BusTracking.Mobile.Views.SuperAdmin.AdminSectionListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mct="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"
    xmlns:models="clr-namespace:BusTracking.Mobile.Models.Section"
    xmlns:views="clr-namespace:BusTracking.Mobile.Views"
    xmlns:vm="clr-namespace:BusTracking.Mobile.Viewmodels.SuperAdmin"
    x:DataType="vm:AdminSectionListViewModel"
    x:TypeArguments="vm:AdminSectionListViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBg},
                                      Dark={StaticResource PageBgDark}}">

    <views:ViewBase.Behaviors>
        <mct:StatusBarBehavior StatusBarColor="{AppThemeBinding Light={StaticResource LoginPageBgLight}, Dark={StaticResource LoginPageBgDark}}" StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}" />
    </views:ViewBase.Behaviors>

    <Shell.TitleView>
        <Grid Padding="0,0,8,0" ColumnDefinitions="*,Auto">
            <Label
                Grid.Column="0"
                FontAttributes="Bold"
                FontSize="18"
                Text="Class Sections"
                TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                            Dark=White}"
                VerticalOptions="Center" />
            <Border
                Grid.Column="1"
                Padding="8"
                BackgroundColor="White"
                IsVisible="{Binding CanAdd}"
                StrokeShape="RoundRectangle 20"
                StrokeThickness="0"
                VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AddCommand}" />
                </Border.GestureRecognizers>
                <Image
                    HeightRequest="20"
                    Source="add.png"
                    WidthRequest="20">
                    <Image.Behaviors>
                        <mct:IconTintColorBehavior TintColor="{StaticResource Primary}" />
                    </Image.Behaviors>
                </Image>
            </Border>
        </Grid>
    </Shell.TitleView>

    <Grid RowDefinitions="Auto,*">

        <!--  Standard Selector Picker Card  -->
        <Border
            Grid.Row="0"
            Margin="12,12,12,6"
            Padding="14,10"
            BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                              Dark={StaticResource CardBgDark}}"
            Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                     Dark={StaticResource BorderColorDark}}"
            StrokeShape="RoundRectangle 12"
            StrokeThickness="1">
            <Grid
                ColumnDefinitions="Auto,*"
                ColumnSpacing="12"
                VerticalOptions="Center">
                <Label
                    Grid.Column="0"
                    FontAttributes="Bold"
                    FontSize="14"
                    Text="Class / Standard:"
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                Dark=White}"
                    VerticalOptions="Center" />
                <Picker
                    Grid.Column="1"
                    FontSize="14"
                    ItemDisplayBinding="{Binding StandardName}"
                    ItemsSource="{Binding Standards}"
                    SelectedItem="{Binding SelectedStandard}"
                    VerticalOptions="Center" />
            </Grid>
        </Border>

        <!--  Sections List  -->
        <RefreshView
            Grid.Row="1"
            Margin="12,4,12,0"
            Command="{Binding RefreshCommand}"
            IsRefreshing="{Binding IsRefreshing}">
            <CollectionView ItemsSource="{Binding Items}">
                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        Padding="30"
                        HorizontalOptions="Center"
                        Spacing="12"
                        VerticalOptions="Center">
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            HorizontalOptions="Center"
                            Text="No Sections Found"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                        Dark=White}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:SectionItem">
                        <Border
                            Margin="0,4"
                            Padding="14,12"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                              Dark={StaticResource CardBgDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                                     Dark={StaticResource BorderColorDark}}"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1">
                            <Grid
                                ColumnDefinitions="*,Auto,Auto"
                                ColumnSpacing="12"
                                VerticalOptions="Center">

                                <!--  Section Info  -->
                                <VerticalStackLayout
                                    Grid.Column="0"
                                    Spacing="3"
                                    VerticalOptions="Center">
                                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="15"
                                            Text="{Binding SectionName, StringFormat='Section {0}'}"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                                        Dark=White}" />
                                        <Border
                                            Padding="8,3"
                                            BackgroundColor="{Binding StatusBgColor}"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 20"
                                            VerticalOptions="Center">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="10"
                                                Text="{Binding StatusLabel}"
                                                TextColor="{Binding StatusTextColor}" />
                                        </Border>
                                    </HorizontalStackLayout>
                                    <Label
                                        FontSize="12"
                                        IsVisible="{Binding ClassTeacherName, Converter={StaticResource StringIsNotNullOrEmptyConverter}}"
                                        Text="{Binding ClassTeacherName, StringFormat='Class Teacher: {0}'}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                                    Dark=#94a3b8}" />
                                </VerticalStackLayout>

                                <!--  Delete Icon  -->
                                <Image
                                    Grid.Column="2"
                                    HeightRequest="20"
                                    Source="delete.png"
                                    VerticalOptions="Center"
                                    WidthRequest="20">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminSectionListViewModel}}, Path=DeleteCommand}" CommandParameter="{Binding .}" />
                                    </Image.GestureRecognizers>
                                    <Image.Behaviors>
                                        <mct:IconTintColorBehavior TintColor="{StaticResource Danger}" />
                                    </Image.Behaviors>
                                </Image>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>

</views:ViewBase>
