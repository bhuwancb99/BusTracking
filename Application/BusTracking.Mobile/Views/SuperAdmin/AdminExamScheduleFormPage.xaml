<?xml version="1.0" encoding="utf-8" ?>
<views:ViewBase
    x:Class="BusTracking.Mobile.Views.SuperAdmin.AdminExamScheduleFormPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:common="clr-namespace:BusTracking.Mobile.Views.Common"
    xmlns:mct="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"
    xmlns:views="clr-namespace:BusTracking.Mobile.Views"
    xmlns:vm="clr-namespace:BusTracking.Mobile.Viewmodels.SuperAdmin"
    Title="{Binding Title}"
    x:DataType="vm:ExamScheduleFormViewModel"
    x:TypeArguments="vm:ExamScheduleFormViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBg},
                                      Dark={StaticResource PageBgDark}}">

    <views:ViewBase.Behaviors>
        <mct:StatusBarBehavior StatusBarColor="{AppThemeBinding Light={StaticResource LoginPageBgLight}, Dark={StaticResource LoginPageBgDark}}" StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}" />
    </views:ViewBase.Behaviors>

    <Shell.TitleView>
        <Label
            FontAttributes="Bold"
            FontSize="17"
            Text="{Binding Title}"
            TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                        Dark=White}"
            VerticalOptions="Center" />
    </Shell.TitleView>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="16,16,16,32" Spacing="14">

                <!--  Error Banner  -->
                <Border
                    BackgroundColor="{AppThemeBinding Light={StaticResource ErrorBannerBgLight},
                                                      Dark={StaticResource ErrorBannerBgDark}}"
                    IsVisible="{Binding HasError}"
                    Stroke="{AppThemeBinding Light={StaticResource ErrorBannerBorderLight},
                                             Dark={StaticResource ErrorBannerBorderDark}}"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="1">
                    <Label
                        Padding="12,10"
                        FontSize="13"
                        Text="{Binding ErrorMessage}"
                        TextColor="{AppThemeBinding Light={StaticResource ErrorTextLight},
                                                    Dark={StaticResource ErrorTextDark}}" />
                </Border>

                <!--  Academic Year & Exam Term  -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border
                        Grid.Column="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                          Dark={StaticResource CardBgDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                                 Dark={StaticResource BorderColorDark}}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="1">
                        <VerticalStackLayout Padding="14" Spacing="6">
                            <Label
                                FontAttributes="Bold"
                                FontSize="12"
                                Text="Academic Year *"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                            Dark={StaticResource TextSecondaryDark}}" />
                            <Picker
                                ItemDisplayBinding="{Binding YearName}"
                                ItemsSource="{Binding AcademicYears}"
                                SelectedItem="{Binding SelectedAcademicYear}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                            Dark=White}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        Grid.Column="1"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                          Dark={StaticResource CardBgDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                                 Dark={StaticResource BorderColorDark}}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="1">
                        <VerticalStackLayout Padding="14" Spacing="6">
                            <Label
                                FontAttributes="Bold"
                                FontSize="12"
                                Text="Exam Term *"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                            Dark={StaticResource TextSecondaryDark}}" />
                            <Picker
                                ItemDisplayBinding="{Binding TermName}"
                                ItemsSource="{Binding ExamTerms}"
                                SelectedItem="{Binding SelectedExamTerm}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                            Dark=White}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!--  Class / Standard & Section  -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border
                        Grid.Column="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                          Dark={StaticResource CardBgDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                                 Dark={StaticResource BorderColorDark}}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="1">
                        <VerticalStackLayout Padding="14" Spacing="6">
                            <Label
                                FontAttributes="Bold"
                                FontSize="12"
                                Text="Class / Standard *"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                            Dark={StaticResource TextSecondaryDark}}" />
                            <Picker
                                ItemDisplayBinding="{Binding StandardName}"
                                ItemsSource="{Binding Standards}"
                                SelectedItem="{Binding SelectedStandard}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                            Dark=White}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        Grid.Column="1"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                          Dark={StaticResource CardBgDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                                 Dark={StaticResource BorderColorDark}}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="1">
                        <VerticalStackLayout Padding="14" Spacing="6">
                            <Label
                                FontAttributes="Bold"
                                FontSize="12"
                                Text="Section"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                            Dark={StaticResource TextSecondaryDark}}" />
                            <Picker
                                ItemDisplayBinding="{Binding SectionName}"
                                ItemsSource="{Binding Sections}"
                                SelectedItem="{Binding SelectedSection}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                            Dark=White}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!--  Subject  -->
                <Border
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                      Dark={StaticResource CardBgDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                             Dark={StaticResource BorderColorDark}}"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="1">
                    <VerticalStackLayout Padding="16" Spacing="8">
                        <Label
                            FontAttributes="Bold"
                            FontSize="12"
                            Text="Subject *"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                        Dark={StaticResource TextSecondaryDark}}" />
                        <Picker
                            ItemDisplayBinding="{Binding SubjectName}"
                            ItemsSource="{Binding Subjects}"
                            SelectedItem="{Binding SelectedSubject}"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                        Dark=White}" />
                    </VerticalStackLayout>
                </Border>

                <!--  Exam Date (Uses CalendarPickerPopup)  -->
                <Border
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                      Dark={StaticResource CardBgDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                             Dark={StaticResource BorderColorDark}}"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="1">
                    <VerticalStackLayout Padding="16" Spacing="8">
                        <Label
                            FontAttributes="Bold"
                            FontSize="12"
                            Text="Exam Date *"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                        Dark={StaticResource TextSecondaryDark}}" />
                        <Border
                            BackgroundColor="{AppThemeBinding Light={StaticResource PageBg},
                                                              Dark={StaticResource PageBgDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                                     Dark={StaticResource BorderColorDark}}"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="1">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenExamDateCalendarCommand}" />
                            </Border.GestureRecognizers>
                            <Grid Padding="12,10" ColumnDefinitions="*,Auto">
                                <Label
                                    Grid.Column="0"
                                    FontSize="14"
                                    Text="{Binding ExamDate, StringFormat='{0:dd MMM yyyy}'}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                                Dark={StaticResource TextPrimaryDark}}"
                                    VerticalOptions="Center" />
                                <Image
                                    Grid.Column="1"
                                    HeightRequest="18"
                                    Source="calendar_icon.png"
                                    VerticalOptions="Center"
                                    WidthRequest="18">
                                    <Image.Behaviors>
                                        <mct:IconTintColorBehavior TintColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextSecondaryDark}}" />
                                    </Image.Behaviors>
                                </Image>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!--  Start Time & End Time  -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border
                        Grid.Column="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                          Dark={StaticResource CardBgDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                                 Dark={StaticResource BorderColorDark}}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="1">
                        <VerticalStackLayout Padding="14" Spacing="6">
                            <Label
                                FontAttributes="Bold"
                                FontSize="12"
                                Text="Start Time"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                            Dark={StaticResource TextSecondaryDark}}" />
                            <TimePicker TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark=White}" Time="{Binding StartTime}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        Grid.Column="1"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                          Dark={StaticResource CardBgDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                                 Dark={StaticResource BorderColorDark}}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="1">
                        <VerticalStackLayout Padding="14" Spacing="6">
                            <Label
                                FontAttributes="Bold"
                                FontSize="12"
                                Text="End Time"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                            Dark={StaticResource TextSecondaryDark}}" />
                            <TimePicker TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark=White}" Time="{Binding EndTime}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!--  Max Marks & Pass Marks  -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border
                        Grid.Column="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                          Dark={StaticResource CardBgDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                                 Dark={StaticResource BorderColorDark}}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="1">
                        <VerticalStackLayout Padding="14" Spacing="6">
                            <Label
                                FontAttributes="Bold"
                                FontSize="12"
                                Text="Max Marks"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                            Dark={StaticResource TextSecondaryDark}}" />
                            <Entry
                                Keyboard="Numeric"
                                Text="{Binding MaxMarksText}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                            Dark=White}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        Grid.Column="1"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                          Dark={StaticResource CardBgDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                                 Dark={StaticResource BorderColorDark}}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="1">
                        <VerticalStackLayout Padding="14" Spacing="6">
                            <Label
                                FontAttributes="Bold"
                                FontSize="12"
                                Text="Pass Marks"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                            Dark={StaticResource TextSecondaryDark}}" />
                            <Entry
                                Keyboard="Numeric"
                                Text="{Binding PassMarksText}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                            Dark=White}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!--  Room Number  -->
                <Border
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                      Dark={StaticResource CardBgDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                             Dark={StaticResource BorderColorDark}}"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="1">
                    <VerticalStackLayout Padding="16" Spacing="8">
                        <Label
                            FontAttributes="Bold"
                            FontSize="12"
                            Text="Room Number / Hall"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                        Dark={StaticResource TextSecondaryDark}}" />
                        <Entry
                            Placeholder="e.g. Room 102"
                            Text="{Binding RoomNumber}"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                        Dark=White}" />
                    </VerticalStackLayout>
                </Border>

                <!--  Action Buttons  -->
                <Grid
                    Margin="0,12,0,0"
                    ColumnDefinitions="*,*"
                    ColumnSpacing="12">
                    <Button
                        Grid.Column="0"
                        BackgroundColor="{AppThemeBinding Light=#E0E0E0,
                                                          Dark=#333333}"
                        Command="{Binding CancelCommand}"
                        CornerRadius="12"
                        HeightRequest="48"
                        Text="Cancel"
                        TextColor="{AppThemeBinding Light=Black,
                                                    Dark=White}" />
                    <Button
                        Grid.Column="1"
                        Command="{Binding SaveCommand}"
                        CornerRadius="12"
                        HeightRequest="48"
                        IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBoolConverter}}"
                        Text="Save Schedule" />
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <!--  Shared Calendar Popup  -->
        <common:CalendarPickerPopup
            Title="Select Exam Date"
            IsOpen="{Binding IsExamDateCalendarOpen, Mode=TwoWay}"
            SelectedDate="{Binding ExamDate, Mode=TwoWay}" />
    </Grid>
</views:ViewBase>
