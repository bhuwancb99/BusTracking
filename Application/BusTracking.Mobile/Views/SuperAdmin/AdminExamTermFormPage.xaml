<?xml version="1.0" encoding="utf-8" ?>
<views:ViewBase
    x:Class="BusTracking.Mobile.Views.SuperAdmin.AdminExamTermFormPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:common="clr-namespace:BusTracking.Mobile.Views.Common"
    xmlns:mct="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"
    xmlns:views="clr-namespace:BusTracking.Mobile.Views"
    xmlns:vm="clr-namespace:BusTracking.Mobile.Viewmodels.SuperAdmin"
    Title="{Binding Title}"
    x:DataType="vm:ExamTermFormViewModel"
    x:TypeArguments="vm:ExamTermFormViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBg},
                                      Dark={StaticResource PageBgDark}}">

    <views:ViewBase.Behaviors>
        <mct:StatusBarBehavior StatusBarColor="{AppThemeBinding Light={StaticResource LoginPageBgLight}, Dark={StaticResource LoginPageBgDark}}" StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}" />
    </views:ViewBase.Behaviors>

    <Shell.TitleView>
        <Label
            FontAttributes="Bold"
            FontSize="17"
            Text="{Binding Title}"
            TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                        Dark=White}"
            VerticalOptions="Center" />
    </Shell.TitleView>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="16,16,16,32" Spacing="14">

                <!--  Error Banner  -->
                <Border
                    BackgroundColor="{AppThemeBinding Light={StaticResource ErrorBannerBgLight},
                                                      Dark={StaticResource ErrorBannerBgDark}}"
                    IsVisible="{Binding HasError}"
                    Stroke="{AppThemeBinding Light={StaticResource ErrorBannerBorderLight},
                                             Dark={StaticResource ErrorBannerBorderDark}}"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="1">
                    <Label
                        Padding="12,10"
                        FontSize="13"
                        Text="{Binding ErrorMessage}"
                        TextColor="{AppThemeBinding Light={StaticResource ErrorTextLight},
                                                    Dark={StaticResource ErrorTextDark}}" />
                </Border>

                <!--  Academic Year  -->
                <Border
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                      Dark={StaticResource CardBgDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                             Dark={StaticResource BorderColorDark}}"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="1">
                    <VerticalStackLayout Padding="16" Spacing="8">
                        <Label
                            FontAttributes="Bold"
                            FontSize="12"
                            Text="Academic Year *"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                        Dark={StaticResource TextSecondaryDark}}" />
                        <Picker
                            ItemDisplayBinding="{Binding YearName}"
                            ItemsSource="{Binding AcademicYears}"
                            SelectedItem="{Binding SelectedAcademicYear}"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                        Dark=White}" />
                    </VerticalStackLayout>
                </Border>

                <!--  Term Name  -->
                <Border
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                      Dark={StaticResource CardBgDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                             Dark={StaticResource BorderColorDark}}"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="1">
                    <VerticalStackLayout Padding="16" Spacing="8">
                        <Label
                            FontAttributes="Bold"
                            FontSize="12"
                            Text="Term Name *"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                        Dark={StaticResource TextSecondaryDark}}" />
                        <Entry
                            BackgroundColor="Transparent"
                            Placeholder="e.g. Mid - Term Exam - 2026"
                            Text="{Binding TermName}"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                        Dark={StaticResource TextPrimaryDark}}" />
                    </VerticalStackLayout>
                </Border>

                <!--  Start Date & End Date (Uses CalendarPickerPopup)  -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border
                        Grid.Column="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                          Dark={StaticResource CardBgDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                                 Dark={StaticResource BorderColorDark}}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="1">
                        <VerticalStackLayout Padding="14" Spacing="6">
                            <Label
                                FontAttributes="Bold"
                                FontSize="12"
                                Text="Start Date"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                            Dark={StaticResource TextSecondaryDark}}" />
                            <Border
                                BackgroundColor="{AppThemeBinding Light={StaticResource PageBg},
                                                                  Dark={StaticResource PageBgDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                                         Dark={StaticResource BorderColorDark}}"
                                StrokeShape="RoundRectangle 8"
                                StrokeThickness="1">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenStartDateCalendarCommand}" />
                                </Border.GestureRecognizers>
                                <Grid Padding="10,8" ColumnDefinitions="*,Auto">
                                    <Label
                                        Grid.Column="0"
                                        FontSize="13"
                                        Text="{Binding StartDate, StringFormat='{0:dd MMM yyyy}'}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                                    Dark={StaticResource TextPrimaryDark}}"
                                        VerticalOptions="Center" />
                                    <Image
                                        Grid.Column="1"
                                        HeightRequest="16"
                                        Source="calendar_icon.png"
                                        VerticalOptions="Center"
                                        WidthRequest="16">
                                        <Image.Behaviors>
                                            <mct:IconTintColorBehavior TintColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextSecondaryDark}}" />
                                        </Image.Behaviors>
                                    </Image>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        Grid.Column="1"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                          Dark={StaticResource CardBgDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                                 Dark={StaticResource BorderColorDark}}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="1">
                        <VerticalStackLayout Padding="14" Spacing="6">
                            <Label
                                FontAttributes="Bold"
                                FontSize="12"
                                Text="End Date"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                            Dark={StaticResource TextSecondaryDark}}" />
                            <Border
                                BackgroundColor="{AppThemeBinding Light={StaticResource PageBg},
                                                                  Dark={StaticResource PageBgDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                                         Dark={StaticResource BorderColorDark}}"
                                StrokeShape="RoundRectangle 8"
                                StrokeThickness="1">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenEndDateCalendarCommand}" />
                                </Border.GestureRecognizers>
                                <Grid Padding="10,8" ColumnDefinitions="*,Auto">
                                    <Label
                                        Grid.Column="0"
                                        FontSize="13"
                                        Text="{Binding EndDate, StringFormat='{0:dd MMM yyyy}'}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                                    Dark={StaticResource TextPrimaryDark}}"
                                        VerticalOptions="Center" />
                                    <Image
                                        Grid.Column="1"
                                        HeightRequest="16"
                                        Source="calendar_icon.png"
                                        VerticalOptions="Center"
                                        WidthRequest="16">
                                        <Image.Behaviors>
                                            <mct:IconTintColorBehavior TintColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextSecondaryDark}}" />
                                        </Image.Behaviors>
                                    </Image>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!--  Description  -->
                <Border
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                      Dark={StaticResource CardBgDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                             Dark={StaticResource BorderColorDark}}"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="1">
                    <VerticalStackLayout Padding="16" Spacing="8">
                        <Label
                            FontAttributes="Bold"
                            FontSize="12"
                            Text="Description"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary},
                                                        Dark={StaticResource TextSecondaryDark}}" />
                        <Editor
                            AutoSize="TextChanges"
                            HeightRequest="80"
                            Placeholder="Optional term details..."
                            Text="{Binding Description}"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                        Dark={StaticResource TextPrimaryDark}}" />
                    </VerticalStackLayout>
                </Border>

                <!--  Is Active Switch  -->
                <Border
                    Padding="16,12"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBg},
                                                      Dark={StaticResource CardBgDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderColor},
                                             Dark={StaticResource BorderColorDark}}"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="1">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            FontAttributes="Bold"
                            FontSize="14"
                            Text="Term Active Status"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                        Dark=White}"
                            VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding IsActive}" />
                    </Grid>
                </Border>

                <!--  Action Buttons  -->
                <Grid
                    Margin="0,12,0,0"
                    ColumnDefinitions="*,*"
                    ColumnSpacing="12">
                    <Button
                        Grid.Column="0"
                        BackgroundColor="{AppThemeBinding Light=#E0E0E0,
                                                          Dark=#333333}"
                        Command="{Binding CancelCommand}"
                        CornerRadius="12"
                        HeightRequest="48"
                        Text="Cancel"
                        TextColor="{AppThemeBinding Light=Black,
                                                    Dark=White}" />
                    <Button
                        Grid.Column="1"
                        Command="{Binding SaveCommand}"
                        CornerRadius="12"
                        HeightRequest="48"
                        IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBoolConverter}}"
                        Text="Save Term" />
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <!--  Shared Calendar Popups  -->
        <common:CalendarPickerPopup
            Title="Select Start Date"
            IsOpen="{Binding IsStartDateCalendarOpen, Mode=TwoWay}"
            SelectedDate="{Binding StartDate, Mode=TwoWay}" />
        <common:CalendarPickerPopup
            Title="Select End Date"
            IsOpen="{Binding IsEndDateCalendarOpen, Mode=TwoWay}"
            SelectedDate="{Binding EndDate, Mode=TwoWay}" />
    </Grid>
</views:ViewBase>
